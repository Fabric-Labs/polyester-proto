{
  "components": {
    "schemas": {
      "polyester.rest.RateLimitService_GetRateLimitConfig.Response": {
        "additionalProperties": false,
        "properties": {
          "effectiveFrom": {
            "description": "UTC time at which this policy version became effective.",
            "format": "date-time",
            "type": "string"
          },
          "policyVersion": {
            "description": "Positive identifier of the returned rate-limit policy version.",
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "rules": {
            "description": "Complete placement and cancellation catalog. Rules are ordered by policy class, then by tier ascending. The list contains one rule per class for each VIP0 through VIP10 tier and is not paginated.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "burstWeight": {
                  "description": "Maximum weighted capacity that may be consumed in a burst.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "periodMs": {
                  "description": "Policy period duration in milliseconds.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "policyClass": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/polyester.rest.enum.ratelimit.v1.TradingRateLimitClass"
                    }
                  ],
                  "description": "Trading operation family governed by this rule. REST responses contain PLACE or CANCEL."
                },
                "quotaWeight": {
                  "description": "Weighted request capacity available during each policy period. One operation consumes the weight assigned to that operation.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "vipTier": {
                  "description": "VIP tier for this rule, in the inclusive range 0 through 10.",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "burstWeight",
                "periodMs",
                "policyClass",
                "quotaWeight",
                "vipTier"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "effectiveFrom",
          "policyVersion",
          "rules"
        ],
        "type": "object"
      },
      "polyester.rest.RateLimitService_GetTradingRateLimits.Response": {
        "additionalProperties": false,
        "properties": {
          "apiKeyRules": {
            "description": "API-key-scoped placement and cancellation rules, ordered with placement first and cancellation second. Present only when the caller authenticated with an API key. Both this scope and the account scope are enforced.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "burstWeight": {
                  "description": "Maximum weighted capacity that may be consumed in a burst.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "periodMs": {
                  "description": "Policy period duration in milliseconds.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "policyClass": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/polyester.rest.enum.ratelimit.v1.TradingRateLimitClass"
                    }
                  ],
                  "description": "Trading operation family governed by this rule. REST responses contain PLACE or CANCEL."
                },
                "quotaWeight": {
                  "description": "Weighted request capacity available during each policy period. One operation consumes the weight assigned to that operation.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "vipTier": {
                  "description": "VIP tier for this rule, in the inclusive range 0 through 10.",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "burstWeight",
                "periodMs",
                "policyClass",
                "quotaWeight",
                "vipTier"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "effectiveFrom": {
            "description": "UTC time at which this policy version became effective.",
            "format": "date-time",
            "type": "string"
          },
          "policyVersion": {
            "description": "Positive identifier of the rate-limit policy version used for the returned rules.",
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "rules": {
            "description": "Account-scoped placement and cancellation rules for the selected account, ordered with placement first and cancellation second.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "burstWeight": {
                  "description": "Maximum weighted capacity that may be consumed in a burst.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "periodMs": {
                  "description": "Policy period duration in milliseconds.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "policyClass": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/polyester.rest.enum.ratelimit.v1.TradingRateLimitClass"
                    }
                  ],
                  "description": "Trading operation family governed by this rule. REST responses contain PLACE or CANCEL."
                },
                "quotaWeight": {
                  "description": "Weighted request capacity available during each policy period. One operation consumes the weight assigned to that operation.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "vipTier": {
                  "description": "VIP tier for this rule, in the inclusive range 0 through 10.",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "burstWeight",
                "periodMs",
                "policyClass",
                "quotaWeight",
                "vipTier"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "apiKeyRules",
          "effectiveFrom",
          "policyVersion",
          "rules"
        ],
        "type": "object"
      },
      "polyester.rest.enum.ratelimit.v1.TradingRateLimitClass": {
        "enum": [
          "PLACE",
          "CANCEL"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "CANCEL": "Order and trigger cancellation.",
          "PLACE": "New-order placement and order modification."
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/rate-limits": {
      "get": {
        "description": "Get the complete active placement and cancellation quota catalog for VIP0 through VIP10.",
        "operationId": "RateLimitService_GetRateLimitConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "effectiveFrom": "2025-01-01T00:00:00Z",
                  "policyVersion": "1",
                  "rules": [
                    {
                      "burstWeight": "1",
                      "periodMs": "1",
                      "policyClass": "PLACE",
                      "quotaWeight": "1",
                      "vipTier": 1
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.RateLimitService_GetRateLimitConfig.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "Get Rate Limit Config",
        "tags": [
          "Rate Limit Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.RateLimitService_GetRateLimitConfig",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "ratelimit.v1.GetRateLimitConfigRequest",
        "x-poly-response-type": "ratelimit.v1.GetRateLimitConfigResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/trading/rate-limits": {
      "get": {
        "description": "Get the effective placement and cancellation limits for the authenticated account target.",
        "operationId": "RateLimitService_GetTradingRateLimits",
        "parameters": [
          {
            "description": "Optional sub-account public identifier.",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccountId",
            "required": false,
            "schema": {
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "apiKeyRules": [
                    {
                      "burstWeight": "1",
                      "periodMs": "1",
                      "policyClass": "PLACE",
                      "quotaWeight": "1",
                      "vipTier": 1
                    }
                  ],
                  "effectiveFrom": "2025-01-01T00:00:00Z",
                  "policyVersion": "1",
                  "rules": [
                    {
                      "burstWeight": "1",
                      "periodMs": "1",
                      "policyClass": "PLACE",
                      "quotaWeight": "1",
                      "vipTier": 1
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.RateLimitService_GetTradingRateLimits.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Trading Rate Limits",
        "tags": [
          "Rate Limit Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.RateLimitService_GetTradingRateLimits",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "ratelimit.v1.GetTradingRateLimitsRequest",
        "x-poly-response-type": "ratelimit.v1.GetTradingRateLimitsResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
