        {
          "name": "CancelTrigger",
          "path": "triggers.v1.TriggersService/CancelTrigger",
          "requestType": "triggers.v1.CancelTriggerRequest",
          "responseType": "triggers.v1.CancelTriggerResponse",
          "summary": "Cancel a trigger: a standalone stop-loss, take-profit, trailing stop,",
          "doc": "Cancel a trigger: a standalone stop-loss, take-profit, trailing stop,\n TWAP or ladder, or an order's attached leg. Canceling a TWAP or a ladder\n also cancels its open child orders.\n OrdersService.CancelAllOrders and the dead-man switch\n (OrdersService.CancelAllAfter) cancel open orders only, never triggers:\n after either, armed stops and running TWAPs can still place orders. To\n stop them, cancel each live trigger with this method; ListTriggers lists\n them.\n A trigger that has ended (completed, canceled or failed) answers a\n cancel with ERROR_CODE_TRIGGER_STATUS_INVALID for at least 60 s after it\n ends, including a repeat of a cancel that succeeded and a cancel retried\n after a timeout: treat it as already done, and read the trigger to see\n how it ended. After that it may answer ERROR_CODE_TRIGGER_NOT_FOUND\n instead, which then means the same. Pausing, resuming or modifying an\n ended trigger answers the same way. A trigger ID that names none of the\n caller's triggers returns ERROR_CODE_TRIGGER_NOT_FOUND. Cancelling\n either leg of an OCO cancels both.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "triggers.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678",
              "triggerId": "9155001234567"
            },
            "response": {
              "status": "STATUS_CREATED",
              "triggerId": "9155001234567",
              "ts": "2025-01-01T00:00:00Z",
              "tsNs": "1735689600000000000"
            }
          }
        },
