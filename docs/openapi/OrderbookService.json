  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/orderbook/{symbol}": {
      "get": {
        "description": "Retrieve a spot order book depth snapshot for a symbol. Bids are ordered best price first (descending), asks are ordered best price first (ascending), and each level is returned as a [price, quantity] tuple of decimal strings.",
        "operationId": "OrderbookService_GetOrderBook",
        "parameters": [
          {
            "description": "Trading pair symbol, e.g. BTC-USDT.",
            "example": "BTC-USDT",
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Number of price levels per side. Defaults to 50 when omitted.",
            "example": "DEPTH_1",
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/polyester.rest.enum.orderbook.v1.Depth.integer"
                }
              ],
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "asks": [
                    [
                      "5",
                      "100000"
                    ]
                  ],
                  "bids": [
                    [
                      "5",
                      "100000"
                    ]
                  ],
                  "bookSeq": "984321",
                  "symbol": "BTC-USDT",
                  "ts": 1735689600000
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.OrderbookService_GetOrderBook.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "Get Order Book",
        "tags": [
          "Orderbook Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.OrderbookService_GetOrderBook",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "orderbook.v1.GetOrderBookRequest",
        "x-poly-response-type": "orderbook.v1.GetOrderBookResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
