{
  "services": [
    {
      "name": "transfer.v1.InternalTransferService",
      "doc": "InternalTransferService manages authenticated Trading to Trading internal\n transfer intake.",
      "methods": [
        {
          "name": "BatchCreateInternalTransfers",
          "path": "transfer.v1.InternalTransferService/BatchCreateInternalTransfers",
          "requestType": "transfer.v1.BatchCreateInternalTransfersRequest",
          "responseType": "transfer.v1.BatchCreateInternalTransfersResponse",
          "summary": "Submit up to 10 Trading to Trading transfers authorized by one MFA check.",
          "doc": "Submit up to 10 Trading to Trading transfers authorized by one MFA check.\n Every leg passes the same checks as CreateInternalTransfer before any leg\n runs; if one fails, the whole batch is refused, nothing moves and no\n step-up is used. Legs then run independently, in order, and are not\n atomic: a leg can be refused, for example for insufficient balance, after\n earlier legs were accepted. The batch accepts recent MFA when the root\n owner moves funds between its own accounts or to explicitly whitelisted\n destinations; any other leg requires one fresh step-up for the whole\n batch. Each leg is its own transfer, readable with GetInternalTransfer.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "transfer.v1",
          "errorCatalog": "internal-transfer-api:transfererrors",
          "examples": {
            "request": {
              "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
              "legs": [
                {
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetId": 100,
                  "destinationAccountId": "7563897446546",
                  "subaccountId": "6789012345678"
                }
              ]
            },
            "response": {
              "legs": [
                {
                  "acceptedAtTsNs": "1735689600000000000",
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetCode": "USDC",
                  "assetId": 100,
                  "destination": {
                    "rootAccountPublicId": "7563897446546",
                    "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                    "subaccountPublicId": "6789012345678"
                  },
                  "errorCode": "ERROR_CODE_INSUFFICIENT_FUNDS",
                  "errorMessage": "value",
                  "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhJ",
                  "legIndex": 1,
                  "requestId": "request_01J0EXAMPLE",
                  "status": "LEG_ACCEPTED",
                  "transferId": "9155001234569"
                }
              ],
              "requestId": "request_01J0EXAMPLE",
              "status": "BATCH_SUBMITTED"
            }
          }
        },
        {
          "name": "CreateInternalTransfer",
          "path": "transfer.v1.InternalTransferService/CreateInternalTransfer",
          "requestType": "transfer.v1.CreateInternalTransferRequest",
          "responseType": "transfer.v1.CreateInternalTransferResponse",
          "summary": "Create or return one accepted Trading to Trading transfer.",
          "doc": "Create or return one accepted Trading to Trading transfer.\n Root-owner same-owner transfers and root-owner transfers to explicitly\n whitelisted destinations accept recent MFA; delegated and other\n interactive transfers require fresh step-up.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "transfer.v1",
          "errorCatalog": "internal-transfer-api:transfererrors",
          "examples": {
            "request": {
              "amountE18": {
                "hi": "1",
                "lo": "1"
              },
              "assetId": 100,
              "destinationAccountId": "7563897446546",
              "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
              "subaccountId": "6789012345678"
            },
            "response": {
              "acceptedAtTsNs": "1735689600000000000",
              "amountE18": {
                "hi": "1",
                "lo": "1"
              },
              "assetCode": "USDC",
              "assetId": 100,
              "destination": {
                "rootAccountPublicId": "7563897446546",
                "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                "subaccountPublicId": "6789012345678"
              },
              "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhJ",
              "requestId": "request_01J0EXAMPLE",
              "status": "INTERNAL_TRANSFER_STATUS_ACCEPTED",
              "transferId": "9155001234569",
              "uAssetId": "100"
            }
          }
        },
        {
          "name": "GetInternalTransfer",
          "path": "transfer.v1.InternalTransferService/GetInternalTransfer",
          "requestType": "transfer.v1.GetInternalTransferRequest",
          "responseType": "transfer.v1.GetInternalTransferResponse",
          "summary": "Read an accepted transfer by request ID or transfer ID, scoped to its source",
          "doc": "Read an accepted transfer by request ID or transfer ID, scoped to its source\n account. JWT session authentication only; API keys are not supported.\n Returns NotFound for unknown, pending, or inaccessible transfers. This read\n does not submit or retry a transfer and requires no fresh MFA.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "transfer.v1",
          "errorCatalog": "internal-transfer-api:transfererrors",
          "examples": {
            "request": {
              "requestId": "request_01J0EXAMPLE",
              "subaccountId": "6789012345678"
            },
            "response": {
              "acceptedAtTsNs": "1735689600000000000",
              "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhJ",
              "requestId": "request_01J0EXAMPLE",
              "transferId": "9155001234569"
            }
          }
        }
      ]
    }
  ]
}
