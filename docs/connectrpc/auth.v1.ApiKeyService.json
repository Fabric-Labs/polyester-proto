          "name": "CreateApiKey",
          "path": "auth.v1.ApiKeyService/CreateApiKey",
          "requestType": "auth.v1.CreateApiKeyRequest",
          "responseType": "auth.v1.CreateApiKeyResponse",
          "summary": "Create a new API key for the caller. Account security settings may require",
          "doc": "Create a new API key for the caller. Account security settings may require\n MFA enrollment or a fresh step-up proof. The acting caller's root account\n must have accepted the current terms, including when targeting a shared\n subaccount; otherwise FailedPrecondition with AUTH_TERMS_NOT_ACCEPTED is returned.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "fresh_step_up",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "color": "#7C3AED",
              "icon": "💰",
              "ipWhitelist": [
                "203.0.113.0/24"
              ],
              "label": "Trading Bot",
              "publicKeyEd25519": "AA==",
