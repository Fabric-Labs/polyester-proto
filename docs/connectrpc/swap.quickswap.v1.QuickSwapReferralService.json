        {
          "name": "SetReferralCode",
          "path": "swap.quickswap.v1.QuickSwapReferralService/SetReferralCode",
          "requestType": "swap.quickswap.v1.SetReferralCodeRequest",
          "responseType": "swap.quickswap.v1.SetReferralCodeResponse",
