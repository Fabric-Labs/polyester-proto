{
  "components": {
    "schemas": {
      "auth.v1.GetSubaccountResponse": {
        "additionalProperties": false,
        "description": "Aggregated sub-account read view.",
        "properties": {
          "apiKeys": {
            "description": "API keys scoped to this sub-account when include_api_keys is true.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.ApiKey"
            },
            "title": "api_keys",
            "type": "array"
          },
          "balances": {
            "$ref": "#/components/schemas/ledger.read.v1.GetBalancesResponse",
            "description": "Current balances when include_balances is true.",
            "title": "balances"
          },
          "invites": {
            "description": "Invitations for the caller when include_invites is true.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.SubaccountInvite"
            },
            "title": "invites",
            "type": "array"
          },
          "members": {
            "description": "Members for this sub-account when include_members is true and the caller is owner or admin.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.SubaccountMemberView"
            },
            "title": "members",
            "type": "array"
          },
          "policy": {
            "$ref": "#/components/schemas/auth.v1.SubaccountPolicyView",
            "description": "Attached policy when include_policy is true and the sub-account has a policy.",
            "title": "policy"
          },
          "subaccount": {
            "$ref": "#/components/schemas/auth.v1.Subaccount",
            "description": "Requested sub-account summary.",
            "title": "subaccount"
          }
        },
        "title": "GetSubaccountResponse",
        "type": "object"
      },
      "auth.v1.ListSubaccountEventsResponse": {
        "additionalProperties": false,
        "description": "Response containing sub-account activity events.",
        "properties": {
          "events": {
            "description": "Activity events ordered newest first.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.ActivityEvent"
            },
            "title": "events",
            "type": "array"
          },
          "nextPageToken": {
            "description": "Opaque cursor for the next page. Empty when no more results exist.",
            "maxLength": 512,
            "title": "next_page_token",
            "type": "string"
          }
        },
        "title": "ListSubaccountEventsResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/subaccounts/{subaccount_id}": {
      "get": {
        "description": "Return a single payload containing the sub-account and requested related read models, such as members, API keys, invites, policy, and balances.",
        "operationId": "SubaccountViewService_GetSubaccount",
        "parameters": [
          {
            "description": "Target sub-account (opaque ID).",
            "example": "6789012345678",
            "in": "path",
            "name": "subaccount_id",
            "required": true,
            "schema": {
              "description": "Target sub-account (opaque ID).",
              "exclusiveMinimum": 0,
              "format": "int64",
              "title": "subaccount_id",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "description": "Include API keys scoped to this sub-account.",
            "example": false,
            "in": "query",
            "name": "includeApiKeys",
            "schema": {
              "description": "Include API keys scoped to this sub-account.",
              "title": "include_api_keys",
              "type": "boolean"
            }
          },
          {
            "description": "Include members for this sub-account. Only owner and admin callers receive members.",
            "example": false,
            "in": "query",
            "name": "includeMembers",
            "schema": {
              "description": "Include members for this sub-account. Only owner and admin callers receive members.",
              "title": "include_members",
              "type": "boolean"
            }
          },
          {
            "description": "Include invitations for the caller.",
            "example": false,
            "in": "query",
            "name": "includeInvites",
            "schema": {
              "description": "Include invitations for the caller.",
              "title": "include_invites",
              "type": "boolean"
            }
          },
          {
            "description": "Include the attached sub-account policy, when one is attached.",
            "example": false,
            "in": "query",
            "name": "includePolicy",
            "schema": {
              "description": "Include the attached sub-account policy, when one is attached.",
              "title": "include_policy",
              "type": "boolean"
            }
          },
          {
            "description": "Include current balances for this sub-account.",
            "example": false,
            "in": "query",
            "name": "includeBalances",
            "schema": {
              "description": "Include current balances for this sub-account.",
              "title": "include_balances",
              "type": "boolean"
            }
          },
          {
            "description": "Optional invitation direction filter. Use \"incoming\", \"outgoing\", or empty for both.",
            "example": "value",
            "in": "query",
            "name": "invitesDirection",
            "schema": {
              "description": "Optional invitation direction filter. Use \"incoming\", \"outgoing\", or empty for both.",
              "title": "invites_direction",
              "type": "string"
            }
          }
        ],
