{
  "components": {
    "schemas": {
      "polyester.rest.MarketDataService_GetCandles.Response": {
        "additionalProperties": false,
        "properties": {
          "candles": {
            "description": "Primary market candle series, ordered newest-first by ts_sec.",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "nextPageToken": {
            "description": "Opaque cursor for the next page. Empty when no more results exist.",
            "type": "string"
          },
          "referenceCandles": {
            "description": "Composite reference market candle series, ordered newest-first by ts_sec. Populated only when include_reference is true and reference data is available.",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "symbol": {
            "description": "Numeric spot market identifier echoed from the request.",
            "type": "string"
          },
          "timeframe": {
            "allOf": [
              {
                "$ref": "#/components/schemas/polyester.rest.enum.marketdata.v1.Timeframe"
              }
            ],
            "description": "Candle bucket size used for the returned series."
          }
        },
        "required": [
          "candles",
          "nextPageToken",
          "referenceCandles",
          "symbol",
          "timeframe"
        ],
        "type": "object"
      },
      "polyester.rest.MarketDataService_GetSpotConfig.Response": {
        "additionalProperties": false,
        "properties": {
          "assets": {
            "description": "Assets ordered by asset code in ascending alphabetical order.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "asset": {
                  "description": "Asset code, e.g. \"USDT\" or \"BTC\".",
                  "type": "string"
                },
                "ledgerId": {
                  "description": "Stable numeric asset id used by account, balance, and order APIs.",
                  "format": "int32",
                  "type": "integer"
                },
                "name": {
                  "description": "Human-friendly display name, e.g. \"Bitcoin\".",
                  "type": "string"
                },
                "quantityDisplayDecimals": {
                  "description": "Suggested decimal precision for displaying user-facing asset amounts.",
                  "format": "int32",
                  "type": "integer"
                },
                "quantityScale": {
                  "description": "Integer scale for quantities and balances in this asset (0..18). A scale of 8 means one whole asset is represented as 100000000 in scaled integer fields such as qty_scaled.",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "asset",
                "ledgerId",
                "name",
                "quantityDisplayDecimals",
                "quantityScale"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "pairs": {
            "description": "Pairs ordered by symbol in ascending alphabetical order.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "allowBuyFeeFromBase": {
                  "description": "Whether BUY order fees may be paid from the base asset instead of the spent quote asset when the order request selects the base fee asset.",
                  "type": "boolean"
                },
                "baseAsset": {
                  "description": "Base asset code. For BTC-USDT, this is \"BTC\".",
                  "type": "string"
                },
                "baseQuantityScale": {
                  "description": "Quantity scale for base-asset amounts in this pair.",
                  "format": "int32",
                  "type": "integer"
                },
                "defaultMarketSlippageBpsBuy": {
                  "description": "Default MARKET order slippage cap for BUY orders, in basis points (1 bp = 0.01%). A request-level slippage setting can override this value.",
                  "format": "int32",
                  "type": "integer"
                },
                "defaultMarketSlippageBpsSell": {
                  "description": "Default MARKET order slippage cap for SELL orders, in basis points (1 bp = 0.01%). A request-level slippage setting can override this value.",
                  "format": "int32",
                  "type": "integer"
                },
                "delistingAt": {
                  "description": "Scheduled delisting timestamp. When unset, the pair has no explicit delisting time.",
                  "type": "string"
                },
                "listingAt": {
                  "description": "Scheduled listing timestamp. When unset, the pair has no explicit future listing time.",
                  "type": "string"
                },
                "marketdata": {
                  "additionalProperties": false,
                  "description": "Market-data display settings for this pair.",
                  "properties": {
                    "orderbookPriceBuckets": {
                      "description": "Suggested order book aggregation bucket sizes in quote-asset price units, e.g. 0.01, 0.1, 1, or 10.",
                      "items": {
                        "format": "double",
                        "type": "number"
                      },
                      "type": "array"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "maxClientRefDriftBps": {
                  "description": "Maximum allowed drift between client reference price and server reference price for MARKET orders, in basis points (1 bp = 0.01%), when client reference pricing is used.",
                  "format": "int32",
                  "type": "integer"
                },
                "minNotionalQuote": {
                  "description": "Minimum order notional as a decimal string in quote-asset units.",
                  "type": "string"
                },
                "minQtyBase": {
                  "description": "Minimum order quantity as a decimal string in base-asset units.",
                  "type": "string"
                },
                "quoteAsset": {
                  "description": "Quote asset code. For BTC-USDT, this is \"USDT\".",
                  "type": "string"
                },
                "quoteQuantityScale": {
                  "description": "Quantity scale for quote-asset amounts in this pair.",
                  "format": "int32",
                  "type": "integer"
                },
                "status": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/polyester.rest.enum.marketdata.v1.PairStatus"
                    }
                  ],
                  "description": "Current trading status."
                },
                "stepSize": {
                  "description": "Minimum allowed quantity increment as a decimal string in base-asset units.",
                  "type": "string"
                },
                "symbol": {
                  "description": "Trading pair symbol, e.g. \"BTC-USDT\".",
                  "type": "string"
                },
                "symbolId": {
                  "description": "Stable numeric pair id used by low-latency ConnectRPC requests and streams.",
                  "format": "int32",
                  "type": "integer"
                },
                "tickSize": {
                  "description": "Minimum allowed price increment as a decimal string in quote-asset units. Prices use 6 decimal places in scaled integer fields; for example \"0.01\" means orders must be priced in 0.01 quote-asset increments.",
                  "type": "string"
                }
              },
              "required": [
                "allowBuyFeeFromBase",
                "baseAsset",
                "baseQuantityScale",
                "defaultMarketSlippageBpsBuy",
                "defaultMarketSlippageBpsSell",
                "delistingAt",
                "listingAt",
                "marketdata",
                "maxClientRefDriftBps",
                "minNotionalQuote",
                "minQtyBase",
                "quoteAsset",
                "quoteQuantityScale",
                "status",
                "stepSize",
                "symbol",
                "symbolId",
                "tickSize"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "tsSec": {
            "description": "Snapshot generation timestamp, in seconds since the Unix epoch (UTC).",
            "pattern": "^[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "assets",
          "pairs",
          "tsSec"
        ],
        "type": "object"
      },
      "polyester.rest.MarketDataService_GetTrades.Response": {
        "additionalProperties": false,
        "properties": {
          "nextPageToken": {
            "description": "Opaque cursor for the next page. Empty when no more results exist.",
            "type": "string"
          },
          "trades": {
            "description": "Trades ordered newest-first by execution timestamp, with match_id as a tie-breaker.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "executedAt": {
                  "description": "Trade execution timestamp, in nanoseconds since the Unix epoch (UTC).",
                  "format": "date-time",
                  "type": "string"
                },
                "matchId": {
                  "description": "Stable trade id within the symbol, suitable for pagination and de-duplication.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "price": {
                  "description": "Trade price in quote-asset units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "qty": {
                  "description": "Traded base-asset quantity scaled by the pair's base_quantity_scale from GetSpotConfig.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "side": {
                  "description": "True when the taker/aggressor bought the base asset; false when the taker/aggressor sold the base asset.",
                  "enum": [
                    "BUY",
                    "SELL"
                  ],
                  "type": "string"
                },
                "symbol": {
                  "description": "Stable numeric pair id from GetSpotConfig.",
                  "type": "string"
                }
              },
              "required": [
                "executedAt",
                "matchId",
                "price",
                "qty",
                "side",
                "symbol"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "nextPageToken",
          "trades"
        ],
        "type": "object"
      },
      "polyester.rest.enum.marketdata.v1.PairStatus": {
        "enum": [
          "ENABLED",
          "DISABLED",
          "CANCEL_ONLY",
          "POST_ONLY",
          "REDUCE_ONLY"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "CANCEL_ONLY": "Only cancellations are accepted.",
          "DISABLED": "New orders are temporarily disabled.",
          "ENABLED": "New orders and cancellations are accepted.",
          "POST_ONLY": "New orders must use a post-only execution variant.",
          "REDUCE_ONLY": "New spot orders are blocked by reduce-only policy."
        }
      },
      "polyester.rest.enum.marketdata.v1.SideFilter": {
        "enum": [
          "BUY",
          "SELL"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "BUY": "Return trades where the taker/aggressor was buying the base asset.",
          "SELL": "Return trades where the taker/aggressor was selling the base asset."
        }
      },
      "polyester.rest.enum.marketdata.v1.Timeframe": {
        "enum": [
          "1s",
          "1m",
          "5m",
          "15m",
          "30m",
          "1h",
          "4h",
          "1d",
          "12h",
          "1w",
          "1mo"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "12h": "12 hours",
          "15m": "15 minutes",
          "1d": "1 day",
          "1h": "1 hour",
          "1m": "1 minute",
          "1mo": "1 month (calendar month, UTC)",
          "1s": "1 second",
          "1w": "1 week",
          "30m": "30 minutes",
          "4h": "4 hours",
          "5m": "5 minutes"
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/spot/config": {
      "get": {
        "description": "Retrieve a cacheable snapshot of spot assets and pairs, including precision and trading constraints.",
        "operationId": "MarketDataService_GetSpotConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "assets": [
                    {
                      "asset": "BTC",
                      "ledgerId": 1,
                      "name": "Bitcoin",
                      "quantityDisplayDecimals": 8,
                      "quantityScale": 8
                    }
                  ],
                  "pairs": [
                    {
                      "allowBuyFeeFromBase": false,
                      "baseAsset": "BTC",
                      "baseQuantityScale": 8,
                      "defaultMarketSlippageBpsBuy": 1,
                      "defaultMarketSlippageBpsSell": 1,
                      "delistingAt": "2025-01-01T00:00:00Z",
                      "listingAt": "2025-01-01T00:00:00Z",
                      "marketdata": {
                        "orderbookPriceBuckets": [
                          0.1
                        ]
                      },
                      "maxClientRefDriftBps": 1,
                      "minNotionalQuote": "10",
                      "minQtyBase": "0.0001",
                      "quoteAsset": "USDT",
                      "quoteQuantityScale": 6,
                      "status": "ENABLED",
                      "stepSize": "0.0001",
                      "symbol": "BTC-USDT",
                      "symbolId": 1,
                      "tickSize": "0.01"
                    }
                  ],
                  "tsSec": "1735689600"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.MarketDataService_GetSpotConfig.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "Get Spot Config",
        "tags": [
          "Market Data Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.MarketDataService_GetSpotConfig",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "marketdata.v1.GetSpotConfigRequest",
        "x-poly-response-type": "marketdata.v1.GetSpotConfigResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/spot/markets/{symbol}/candles": {
      "get": {
        "description": "Retrieve OHLCV candles for a spot symbol and timeframe, ordered newest first. Supports inclusive time bounds, optional current open candle inclusion, and optional composite reference candles.",
        "operationId": "MarketDataService_GetCandles",
        "parameters": [
          {
            "description": "Trading pair symbol, e.g. BTC-USDT",
            "example": "BTC-USDT",
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter candles with bucket start time at or before this time (inclusive, RFC3339).",
            "example": "2025-01-01T00:00:00Z",
            "in": "query",
            "name": "endTime",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Include the current open candle when available. It is prepended to the newest-first candle list and does not count toward limit.",
            "example": false,
            "in": "query",
            "name": "includeIncomplete",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "Include the composite reference market candle series when available.",
            "example": false,
            "in": "query",
            "name": "includeReference",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "Maximum closed candles to return. Default 500, max 10000.",
            "example": 100,
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from the previous response.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "pageToken",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter candles with bucket start time at or after this time (inclusive, RFC3339).",
            "example": "2025-01-01T00:00:00Z",
            "in": "query",
            "name": "startTime",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Candle bucket timeframe, such as 1m, 5m, 1h, or 1d.",
            "example": "1s",
            "in": "query",
            "name": "timeframe",
            "required": true,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/polyester.rest.enum.marketdata.v1.Timeframe"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "candles": [
                    [
                      "1735689600",
                      "42000.5",
                      "42150",
                      "41900",
                      "42080",
                      "1234567890000000000",
                      "12.3456"
                    ]
                  ],
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0",
                  "referenceCandles": [
                    [
                      "1735689600",
                      "42000.5",
                      "42150",
                      "41900",
                      "42080",
                      "1234567890000000000"
                    ]
                  ],
                  "symbol": "BTC-USDT",
                  "timeframe": "1s"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.MarketDataService_GetCandles.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "Get Candles",
        "tags": [
          "Market Data Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.MarketDataService_GetCandles",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "marketdata.v1.GetCandlesRequest",
        "x-poly-response-type": "marketdata.v1.GetCandlesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/spot/markets/{symbol}/trades": {
      "get": {
        "description": "Retrieve recent public trades for a spot symbol, ordered newest first. Supports optional aggressor side, inclusive time-range, and opaque page-token pagination filters.",
        "operationId": "MarketDataService_GetTrades",
        "parameters": [
          {
            "description": "Trading pair symbol, e.g. BTC-USDT",
            "example": "BTC-USDT",
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter trades executed at or before this time (inclusive, RFC3339)",
            "example": "2025-01-01T00:00:00Z",
            "in": "query",
            "name": "endTime",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Maximum trades to return. Default 100, max 1000.",
            "example": 100,
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from the previous response.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "pageToken",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by aggressor side. BUY means the taker bought the base asset; SELL means the taker sold the base asset.",
            "example": "BUY",
            "in": "query",
            "name": "side",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/polyester.rest.enum.marketdata.v1.SideFilter"
                }
              ]
            }
          },
          {
            "description": "Filter trades executed at or after this time (inclusive, RFC3339)",
            "example": "2025-01-01T00:00:00Z",
            "in": "query",
            "name": "startTime",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0",
                  "trades": [
                    {
                      "executedAt": "2025-01-01T00:00:00Z",
                      "matchId": "100001",
                      "price": "5",
                      "qty": "100000",
                      "side": "BUY",
                      "symbol": "BTC-USDT"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.MarketDataService_GetTrades.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "Get Trades",
        "tags": [
          "Market Data Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.MarketDataService_GetTrades",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "marketdata.v1.GetTradesRequest",
        "x-poly-response-type": "marketdata.v1.GetTradesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
