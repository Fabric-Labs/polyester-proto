{
  "services": [
    {
      "name": "ledger.read.v1.StatementExportService",
      "doc": "StatementExportService is the account statement API. A statement covers\n one account, optionally one asset, for a period of at most 366 days, and is\n produced in the background as one CSV file, an account statement, a ledger\n or the account's balances: create an export, poll it with\n GetStatementExport until it is READY, then download its file (see\n StatementExport). API keys need the READ_STATEMENTS policy action. A root\n account has at most 5 exports QUEUED or PROCESSING at a time, one account\n produces one export at a time, and a READY file can be downloaded for 7\n days. CancelStatementExport stops a QUEUED or PROCESSING export, which\n frees its place for the account's next export and under the root's 5.",
      "methods": [
        {
          "name": "CancelStatementExport",
          "path": "ledger.read.v1.StatementExportService/CancelStatementExport",
          "requestType": "ledger.read.v1.CancelStatementExportRequest",
          "responseType": "ledger.read.v1.CancelStatementExportResponse",
          "summary": "Cancel Statement Export",
          "doc": "Cancel a QUEUED or PROCESSING statement export. It ends CANCELED at\n once: it no longer counts toward the root account's 5 exports in\n progress, the account's next queued export can start, and any partial\n file is deleted. Canceling a CANCELED export returns it as it is.\n\n Errors:\n - NOT_FOUND: no such export for the authenticated account.\n - PERMISSION_DENIED: the caller may not read statements.\n - FAILED_PRECONDITION (STATEMENT_EXPORT_NOT_CANCELABLE): the export\n   already finished, READY, FAILED or EXPIRED.\n - UNAVAILABLE: retry the same request.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "exportId": "4477789102458798759"
            },
            "response": {
              "export": {
                "assetId": 100,
                "bytes": "1",
                "completeThrough": "2025-01-01T00:00:00Z",
                "createdAt": "2025-01-01T00:00:00Z",
                "endTime": "2025-01-02T00:00:00Z",
                "expiresAt": "2025-01-01T00:00:00Z",
                "exportId": "4477789102458798759",
                "failureReason": "STATEMENT_EXPORT_FAILURE_REASON_TOO_LARGE",
                "historyAvailableFrom": "2025-01-01T00:00:00Z",
                "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                "movements": "1",
                "readyAt": "2025-01-01T00:00:00Z",
                "startTime": "2025-01-01T00:00:00Z",
                "status": "STATEMENT_EXPORT_STATUS_QUEUED",
                "subaccountId": "6789012345678",
                "type": "ACCOUNT_STATEMENT"
              }
            }
          }
        },
        {
          "name": "CreateStatementExport",
          "path": "ledger.read.v1.StatementExportService/CreateStatementExport",
          "requestType": "ledger.read.v1.CreateStatementExportRequest",
          "responseType": "ledger.read.v1.CreateStatementExportResponse",
          "summary": "Create Statement Export",
          "doc": "Create a statement export, or return the existing one for the same\n idempotency key.\n\n Errors:\n - INVALID_ARGUMENT: the period, asset, type or idempotency key is\n   invalid.\n - FAILED_PRECONDITION (IDEMPOTENCY_KEY_REUSED): the key was used for a\n   request with other fields.\n - FAILED_PRECONDITION (STATEMENT_HISTORY_UNAVAILABLE): a BALANCES\n   period starts before the earliest instant whose balances the account\n   history holds. The error detail's history_available_from is that\n   instant; REST answers `409` with it as `historyAvailableFrom`. Create\n   the export again with a start at or after it.\n - RESOURCE_EXHAUSTED (STATEMENT_EXPORT_LIMIT_REACHED): the root account\n   has 5 exports QUEUED or PROCESSING.\n - PERMISSION_DENIED, NOT_FOUND: the account cannot be read.\n - UNAVAILABLE: retry the same request.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "assetId": 100,
              "endTime": "2025-01-02T00:00:00Z",
              "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
              "startTime": "2025-01-01T00:00:00Z",
              "subaccountId": "6789012345678",
              "type": "ACCOUNT_STATEMENT"
            },
            "response": {
              "export": {
                "assetId": 100,
                "bytes": "1",
                "completeThrough": "2025-01-01T00:00:00Z",
                "createdAt": "2025-01-01T00:00:00Z",
                "endTime": "2025-01-02T00:00:00Z",
                "expiresAt": "2025-01-01T00:00:00Z",
                "exportId": "4477789102458798759",
                "failureReason": "STATEMENT_EXPORT_FAILURE_REASON_TOO_LARGE",
                "historyAvailableFrom": "2025-01-01T00:00:00Z",
                "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                "movements": "1",
                "readyAt": "2025-01-01T00:00:00Z",
                "startTime": "2025-01-01T00:00:00Z",
                "status": "STATEMENT_EXPORT_STATUS_QUEUED",
                "subaccountId": "6789012345678",
                "type": "ACCOUNT_STATEMENT"
              }
            }
          }
        },
        {
          "name": "GetStatementExport",
          "path": "ledger.read.v1.StatementExportService/GetStatementExport",
          "requestType": "ledger.read.v1.GetStatementExportRequest",
          "responseType": "ledger.read.v1.GetStatementExportResponse",
          "summary": "Get Statement Export",
          "doc": "Get one statement export.\n\n Errors:\n - NOT_FOUND: no such export for the authenticated account.\n - PERMISSION_DENIED: the export's account cannot be read.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "exportId": "4477789102458798759"
            },
            "response": {
              "export": {
                "assetId": 100,
                "bytes": "1",
                "completeThrough": "2025-01-01T00:00:00Z",
                "createdAt": "2025-01-01T00:00:00Z",
                "endTime": "2025-01-02T00:00:00Z",
                "expiresAt": "2025-01-01T00:00:00Z",
                "exportId": "4477789102458798759",
                "failureReason": "STATEMENT_EXPORT_FAILURE_REASON_TOO_LARGE",
                "historyAvailableFrom": "2025-01-01T00:00:00Z",
                "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                "movements": "1",
                "readyAt": "2025-01-01T00:00:00Z",
                "startTime": "2025-01-01T00:00:00Z",
                "status": "STATEMENT_EXPORT_STATUS_QUEUED",
                "subaccountId": "6789012345678",
                "type": "ACCOUNT_STATEMENT"
              }
            }
          }
        },
        {
          "name": "GetStatementExportDownloadUrl",
          "path": "ledger.read.v1.StatementExportService/GetStatementExportDownloadUrl",
          "requestType": "ledger.read.v1.GetStatementExportDownloadUrlRequest",
          "responseType": "ledger.read.v1.GetStatementExportDownloadUrlResponse",
          "summary": "Get Statement Export Download URL",
          "doc": "Get a URL valid for 60 seconds from signing that downloads a READY\n export's file without credentials, for a browser to save straight to\n disk. Each call returns a new URL.\n\n Errors:\n - NOT_FOUND: no such export for the authenticated account.\n - PERMISSION_DENIED: the caller may not read statements.\n - FAILED_PRECONDITION (STATEMENT_EXPORT_NOT_READY): the file is not ready\n   yet; poll GetStatementExport until it is READY.\n - FAILED_PRECONDITION (STATEMENT_EXPORT_FAILED): the export failed and has\n   no file.\n - FAILED_PRECONDITION (STATEMENT_EXPORT_CANCELED): the export was\n   canceled and has no file.\n - FAILED_PRECONDITION (STATEMENT_EXPORT_EXPIRED): the file expired, or\n   has less than 5 seconds left; create a new export.\n - UNAVAILABLE: retry the same request.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "exportId": "4477789102458798759"
            },
            "response": {
              "expiresAt": "2025-01-01T00:00:00Z",
              "filename": "value",
              "url": "value"
            }
          }
        },
        {
          "name": "ListStatementExports",
          "path": "ledger.read.v1.StatementExportService/ListStatementExports",
          "requestType": "ledger.read.v1.ListStatementExportsRequest",
          "responseType": "ledger.read.v1.ListStatementExportsResponse",
          "summary": "List Statement Exports",
          "doc": "List one account's statement exports, newest first.\n\n Errors:\n - INVALID_ARGUMENT: the limit or page token is invalid.\n - PERMISSION_DENIED, NOT_FOUND: the account cannot be read.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "limit": 100,
              "pageToken": "eyJvZmZzZXQiOjEwMH0",
              "subaccountId": "6789012345678"
            },
            "response": {
              "exports": [
                {
                  "assetId": 100,
                  "bytes": "1",
                  "completeThrough": "2025-01-01T00:00:00Z",
                  "createdAt": "2025-01-01T00:00:00Z",
                  "endTime": "2025-01-02T00:00:00Z",
                  "expiresAt": "2025-01-01T00:00:00Z",
                  "exportId": "4477789102458798759",
                  "failureReason": "STATEMENT_EXPORT_FAILURE_REASON_TOO_LARGE",
                  "historyAvailableFrom": "2025-01-01T00:00:00Z",
                  "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                  "movements": "1",
                  "readyAt": "2025-01-01T00:00:00Z",
                  "startTime": "2025-01-01T00:00:00Z",
                  "status": "STATEMENT_EXPORT_STATUS_QUEUED",
                  "subaccountId": "6789012345678",
                  "type": "ACCOUNT_STATEMENT"
                }
              ],
              "inProgressExports": 1,
              "maxInProgressExports": 1,
              "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
            }
          }
        }
      ]
    }
  ]
}
