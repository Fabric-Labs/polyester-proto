{
  "services": [
    {
      "name": "auth.v1.ApiKeyService",
      "doc": "ApiKeyService manages API keys for authenticated callers.",
      "methods": [
        {
          "name": "CreateApiKey",
          "path": "auth.v1.ApiKeyService/CreateApiKey",
          "requestType": "auth.v1.CreateApiKeyRequest",
          "responseType": "auth.v1.CreateApiKeyResponse",
          "summary": "Create API Key",
          "doc": "Create a new API key for the caller. Account security settings may require\n MFA enrollment or a fresh step-up proof. The acting caller's root account\n must have accepted the current terms, including when targeting a shared\n subaccount; otherwise FailedPrecondition with AUTH_TERMS_NOT_ACCEPTED is returned.\n Creating an admin key always takes a fresh step-up proof.\n\n An admin API key with MANAGE_API_KEYS may also create a standard key, for\n the main account or a sub-account it owns, without a session. The new key\n needs an ip_whitelist whose every entry lies within the admin key's own\n allowlist (else PermissionDenied with AUTH_ADMIN_KEY_SCOPE_EXCEEDED). A\n request for an admin key from any API key returns PermissionDenied with\n AUTH_ADMIN_KEY_ESCALATION_DENIED. Any other API key returns\n PermissionDenied with AUTH_ADMIN_KEY_REQUIRED.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "admin_api_key"
          ],
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "color": "#7C3AED",
              "icon": "💰",
              "ipWhitelist": [
                "203.0.113.0/24"
              ],
              "label": "Trading Bot",
              "publicKeyEd25519": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
              "purpose": "STANDARD",
              "subaccountId": "6789012345678"
            },
            "response": {
              "apiKey": {
                "color": "#7C3AED",
                "createdAt": "2025-01-01T00:00:00Z",
                "createdByActor": "dashboard",
                "expiresAt": "2025-01-01T00:00:00Z",
                "icon": "💰",
                "ipWhitelist": [
                  "203.0.113.0/24"
                ],
                "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542",
                "label": "Trading Bot",
                "lastUsedAt": "2025-01-01T00:00:00Z",
                "policyId": "2779655768052592500",
                "publicKeyEd25519": "AA==",
                "purpose": "STANDARD",
                "revision": "1",
                "status": "ACTIVE",
                "strategyBotId": "4237083536359433371",
                "subaccountId": "6789012345678",
                "updatedAt": "2025-01-01T00:00:00Z"
              }
            }
          }
        },
        {
          "name": "DeleteApiKey",
          "path": "auth.v1.ApiKeyService/DeleteApiKey",
          "requestType": "auth.v1.DeleteApiKeyRequest",
          "responseType": "auth.v1.DeleteApiKeyResponse",
          "summary": "Delete API Key",
          "doc": "Revoke an API key permanently.\n\n An admin API key with MANAGE_API_KEYS may also revoke a standard key of\n the main account or of a sub-account it owns, without a session. It can\n never revoke an admin or assistant key, itself included:\n PermissionDenied with AUTH_ADMIN_KEY_ESCALATION_DENIED or\n AUTH_ADMIN_KEY_FORBIDDEN_TARGET.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "admin_api_key"
          ],
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542"
            },
            "response": {}
          }
        },
        {
          "name": "DeleteAssistantKeys",
          "path": "auth.v1.ApiKeyService/DeleteAssistantKeys",
          "requestType": "auth.v1.DeleteAssistantKeysRequest",
          "responseType": "auth.v1.DeleteAssistantKeysResponse",
          "summary": "Delete Assistant Keys",
          "doc": "Revoke the caller's whole Polyester AI assistant key set. Revocation only\n removes access, so it needs no step-up proof. Revocation is permanent. As\n for DeleteApiKey, key management sees it at once, and requests signed with\n a revoked key are refused within a few seconds of the response.\n\n It revokes ASSISTANT keys only. A strategy bot is not the assistant: its\n STRATEGY_BOT key stays as it is. To cut a bot off, stop the bot, or\n disable its sub-account with UpdateSubaccount, which disables the bot's\n key at once; a strategy bot's sub-account cannot be enabled again.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "revokedKeyIds": [
                "ak_1a3c6de8153d5a5b04cd2a6529779542"
              ]
            }
          }
        },
        {
          "name": "GetApiKey",
          "path": "auth.v1.ApiKeyService/GetApiKey",
          "requestType": "auth.v1.GetApiKeyRequest",
          "responseType": "auth.v1.GetApiKeyResponse",
          "summary": "Get API Key",
          "doc": "Get a single API key owned by the caller or scoped to a sub-account the caller administers.\n An API key needs READ_API_KEYS; a key scoped to a sub-account reads only\n that sub-account's keys.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542"
            },
            "response": {
              "apiKey": {
                "color": "#7C3AED",
                "createdAt": "2025-01-01T00:00:00Z",
                "createdByActor": "dashboard",
                "expiresAt": "2025-01-01T00:00:00Z",
                "icon": "💰",
                "ipWhitelist": [
                  "203.0.113.0/24"
                ],
                "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542",
                "label": "Trading Bot",
                "lastUsedAt": "2025-01-01T00:00:00Z",
                "policyId": "2779655768052592500",
                "publicKeyEd25519": "AA==",
                "purpose": "STANDARD",
                "revision": "1",
                "status": "ACTIVE",
                "strategyBotId": "4237083536359433371",
                "subaccountId": "6789012345678",
                "updatedAt": "2025-01-01T00:00:00Z"
              }
            }
          }
        },
        {
          "name": "ListApiKeys",
          "path": "auth.v1.ApiKeyService/ListApiKeys",
          "requestType": "auth.v1.ListApiKeysRequest",
          "responseType": "auth.v1.ListApiKeysResponse",
          "summary": "List API Keys",
          "doc": "List non-revoked API keys visible to the caller, newest first. An API key\n needs READ_API_KEYS; a key scoped to a sub-account sees only that\n sub-account's keys.",
          "tags": [
