{
  "types": [
    {
      "name": "rewards.v1.ListMyRewardAwardsRequest",
      "kind": "message",
      "doc": "ListMyRewardAwardsRequest requests a page of awards for the authenticated root account.",
      "message": {
        "fields": [
          {
            "name": "limit",
            "jsonName": "limit",
            "number": 1,
            "doc": "Maximum awards to return. Zero uses 50; maximum 100.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32",
            "validate": {
              "number": {
                "lte": "100"
              }
            }
          },
          {
            "name": "page_token",
            "jsonName": "pageToken",
            "number": 2,
            "doc": "Opaque exclusive continuation token bound to the authenticated root account.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "maxLen": 256
              }
            }
          }
        ]
      }
    },
    {
      "name": "rewards.v1.ListMyRewardAwardsResponse",
      "kind": "message",
      "doc": "ListMyRewardAwardsResponse contains newest awards first.",
      "message": {
        "fields": [
          {
            "name": "awards",
            "jsonName": "awards",
            "number": 1,
            "doc": "Awards ordered by publication time and award identifier, newest first.",
            "repeated": true,
            "protoRef": "rewards.v1.RewardAward"
          },
          {
            "name": "next_page_token",
            "jsonName": "nextPageToken",
            "number": 2,
            "doc": "Opaque continuation token. Empty when no more results exist.",
            "protoScalar": "string",
            "jsonType": "string"
          }
        ]
      }
    },
    {
      "name": "rewards.v1.RewardAward",
      "kind": "message",
      "doc": "RewardAward contains immutable published terms and current delivery details for the authenticated root account.",
      "message": {
        "fields": [
          {
            "name": "award_id",
            "jsonName": "awardId",
            "number": 1,
            "doc": "Stable opaque award identifier.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "campaign_id",
            "jsonName": "campaignId",
            "number": 2,
            "doc": "Stable campaign identifier.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "campaign_name",
            "jsonName": "campaignName",
            "number": 3,
            "doc": "Campaign display name frozen at publication.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "asset_id",
            "jsonName": "assetId",
            "number": 4,
            "doc": "Canonical asset identifier.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "amount_base_units",
            "jsonName": "amountBaseUnits",
            "number": 5,
            "doc": "Exact integer amount in the asset's smallest base unit.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "fulfillment_method",
            "jsonName": "fulfillmentMethod",
            "number": 6,
            "doc": "Selected delivery method.",
            "protoRef": "rewards.v1.RewardFulfillmentMethod"
          },
          {
            "name": "fulfillment_state",
            "jsonName": "fulfillmentState",
            "number": 7,
            "doc": "Current delivery state.",
            "protoRef": "rewards.v1.RewardFulfillmentState"
          },
          {
            "name": "published_at",
            "jsonName": "publishedAt",
            "number": 8,
            "doc": "Publication time.",
            "protoRef": "google.protobuf.Timestamp",
            "jsonType": "string",
            "format": "date-time"
          },
          {
            "name": "network",
            "jsonName": "network",
            "number": 9,
            "doc": "Campaign payout network. Interpret destination_address in this network.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "fulfillment_revision",
            "jsonName": "fulfillmentRevision",
            "number": 10,
            "doc": "Current fulfillment revision for optimistic concurrency.",
            "protoScalar": "uint64",
            "jsonType": "string",
            "format": "uint64"
          },
          {
            "name": "destination_address",
            "jsonName": "destinationAddress",
            "number": 11,
            "doc": "Recipient payout destination once submitted. Empty until provided.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "transaction_id",
            "jsonName": "transactionId",
            "number": 12,
            "doc": "External transaction identifier once staff records delivery. Empty until delivered.",
            "protoScalar": "string",
            "jsonType": "string"
          }
        ]
      }
    },
    {
      "name": "rewards.v1.RewardFulfillmentMethod",
      "kind": "enum",
      "doc": "RewardFulfillmentMethod identifies how an award will be delivered.",
      "enum": {
        "values": [
          {
            "name": "EXTERNAL_TESTNET",
            "number": 1
          },
          {
            "name": "INTERNAL_TRADING",
            "number": 2
          }
        ]
      }
    },
    {
      "name": "rewards.v1.RewardFulfillmentState",
      "kind": "enum",
      "doc": "RewardFulfillmentState describes the current delivery state.",
      "enum": {
        "values": [
          {
            "name": "AWAITING_DESTINATION",
            "number": 1
          },
          {
            "name": "READY_FOR_PAYOUT",
            "number": 2
          },
          {
            "name": "PAID",
            "number": 3
          },
          {
            "name": "FAILED",
            "number": 4
          },
          {
            "name": "CANCELED",
            "number": 5
          }
        ]
      }
    },
    {
      "name": "rewards.v1.SetMyRewardDestinationRequest",
      "kind": "message",
      "doc": "SetMyRewardDestinationRequest records the authenticated recipient's payout destination.",
      "message": {
        "fields": [
          {
            "name": "award_id",
            "jsonName": "awardId",
            "number": 1,
            "doc": "Award owned by the authenticated root account.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "minLen": 1,
                "maxLen": 128
              }
            }
          },
          {
            "name": "destination_address",
            "jsonName": "destinationAddress",
            "number": 2,
            "doc": "Destination address interpreted according to the award campaign's network.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "minLen": 1,
                "maxLen": 512
              }
            }
          },
          {
            "name": "expected_revision",
            "jsonName": "expectedRevision",
            "number": 3,
            "doc": "Fulfillment revision observed by the recipient.",
            "protoScalar": "uint64",
            "jsonType": "string",
            "format": "uint64",
            "validate": {
              "number": {
                "gt": "0"
              }
            }
          },
          {
            "name": "request_id",
            "jsonName": "requestId",
            "number": 4,
            "doc": "Client-generated idempotency identifier. Maximum 128 characters.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "minLen": 1,
                "maxLen": 128
              }
            }
          }
        ]
      }
    },
    {
      "name": "rewards.v1.SetMyRewardDestinationResponse",
      "kind": "message",
      "doc": "SetMyRewardDestinationResponse returns the updated award.",
      "message": {
        "fields": [
          {
            "name": "award",
            "jsonName": "award",
            "number": 1,
            "doc": "Award with the persisted destination and updated fulfillment state.",
            "protoRef": "rewards.v1.RewardAward"
          }
        ]
      }
    }
  ]
}
