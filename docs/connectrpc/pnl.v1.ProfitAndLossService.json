              "unrealizedPnlUsd": "value",
              "volumeUsd": "12.3456",
              "windowStart": "2025-01-01T00:00:00Z"
            }
          }
        },
        {
          "name": "GetTradingStatistics",
          "path": "pnl.v1.ProfitAndLossService/GetTradingStatistics",
          "requestType": "pnl.v1.GetTradingStatisticsRequest",
          "responseType": "pnl.v1.GetTradingStatisticsResponse",
          "summary": "Get Trading Statistics",
          "doc": "Get the account's trading statistics over a period: trades, volume,\n fees and realized PnL, with the return, maximum drawdown and Sharpe\n ratio of its closed days.\n\n Errors:\n - INVALID_ARGUMENT: the window or subaccount is invalid.\n - PERMISSION_DENIED, NOT_FOUND: the account cannot be read.\n - UNAVAILABLE: retry the same request.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "pnl.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "product": "PROFIT_AND_LOSS_PRODUCT_SPOT",
              "subaccountId": "6789012345678",
              "symbolId": 1,
              "window": "PROFIT_AND_LOSS_WINDOW_TODAY"
            },
            "response": {
              "asOf": "2025-01-01T00:00:00Z",
              "feesUsd": "value",
