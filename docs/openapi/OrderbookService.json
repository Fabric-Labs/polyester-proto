              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "bookSeq": {
            "description": "Monotonic book sequence for this symbol.",
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "symbol": {
            "description": "Numeric symbol identifier (client resolves to symbol string).",
            "type": "string"
          },
