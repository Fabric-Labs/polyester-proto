{
  "components": {
    "schemas": {
      "chain.lifecycle.v1.FlowKind": {
        "description": "FlowKind identifies the product flow family.",
        "enum": [
          "KIND_UNSPECIFIED",
          "KIND_DEPOSIT",
          "KIND_WITHDRAW",
          "KIND_TRANSFER"
        ],
        "title": "FlowKind",
        "type": "string"
      },
      "chain.lifecycle.v1.FlowState": {
        "description": "FlowState is the latest lifecycle state after folding normalized facts.",
        "enum": [
          "STATE_UNSPECIFIED",
          "STATE_PENDING_SOURCE",
          "STATE_PENDING_POLYESTER_CHAIN",
          "STATE_PENDING_LEDGER",
          "STATE_COMPLETED",
          "STATE_FAILED",
          "STATE_DROPPED",
          "STATE_REFUNDED"
        ],
        "title": "FlowState",
        "type": "string"
      },
      "chain.lifecycle.v1.GetFlowResponse": {
        "additionalProperties": false,
        "description": "GetFlowResponse returns one lifecycle flow with summary, factual steps, and\n estimated timeline data when available.",
        "properties": {
          "flow": {
            "$ref": "#/components/schemas/chain.lifecycle.v1.FlowDetailView",
            "description": "Lifecycle flow detail for the requested intent id.",
            "title": "flow"
          }
        },
        "title": "GetFlowResponse",
        "type": "object"
      },
      "chain.lifecycle.v1.ListFlowsByTxResponse": {
        "additionalProperties": false,
        "description": "ListFlowsByTxResponse returns a page of lifecycle flows that reference one\n transaction hash.",
        "properties": {
          "matches": {
            "description": "Matching flows ordered by tx occurrence, flow kind, domains, activity time,\n and stable identifiers.",
            "items": {
              "$ref": "#/components/schemas/chain.lifecycle.v1.FlowTxMatchView"
            },
            "title": "matches",
            "type": "array"
          },
          "nextPageToken": {
            "description": "Opaque cursor for the next page. Empty when no more results exist.",
            "maxLength": 512,
            "title": "next_page_token",
            "type": "string"
          },
          "txHash": {
            "description": "Transaction hash searched by the request.",
            "title": "tx_hash",
            "type": "string"
          }
        },
        "title": "ListFlowsByTxResponse",
        "type": "object"
      },
      "chain.lifecycle.v1.ListFlowsResponse": {
        "additionalProperties": false,
        "description": "ListFlowsResponse returns one page of flow summaries.",
        "properties": {
          "flows": {
            "description": "Flow summaries ordered by the selected timestamp, then public flow id. Sort\n direction is controlled by the request `sort` field.",
            "items": {
              "$ref": "#/components/schemas/chain.lifecycle.v1.FlowSummaryView"
            },
            "title": "flows",
            "type": "array"
          },
          "nextPageToken": {
            "description": "Opaque cursor for the next page. Empty when no more results exist.",
            "maxLength": 512,
            "title": "next_page_token",
            "type": "string"
          }
        },
        "title": "ListFlowsResponse",
        "type": "object"
      },
      "chain.lifecycle.v1.ListOrderBy": {
        "description": "ListOrderBy selects which timestamp ListFlows uses for ordering and cursors.",
        "enum": [
          "ORDER_BY_UNSPECIFIED",
          "ORDER_BY_LAST_ACTIVITY",
          "ORDER_BY_STARTED_AT"
        ],
        "title": "ListOrderBy",
        "type": "string"
      },
      "chain.lifecycle.v1.ListScope": {
        "description": "ListScope selects which lifecycle state bucket should be returned.",
        "enum": [
          "LIST_UNSPECIFIED",
          "LIST_ALL",
          "LIST_OPEN_ONLY",
          "LIST_TERMINAL_ONLY"
        ],
        "title": "ListScope",
        "type": "string"
      },
      "chain.lifecycle.v1.Sort": {
        "description": "Sort selects lifecycle list direction.",
        "enum": [
          "SORT_UNSPECIFIED",
          "SORT_NEWEST",
          "SORT_OLDEST"
        ],
        "title": "Sort",
        "type": "string"
      },
      "chain.lifecycle.v1.TxLookupKind": {
        "description": "TxLookupKind controls which transaction reference fields are searched.",
        "enum": [
          "TX_UNSPECIFIED",
          "TX_SOURCE",
          "TX_ANY"
        ],
        "title": "TxLookupKind",
        "type": "string"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/chain/flows": {
      "get": {
        "description": "List lifecycle flows with optional account, chain, asset, and state filters.",
        "operationId": "LifecycleReadService_ListFlows",
        "parameters": [
          {
            "description": "Maximum number of flows to return. Defaults to 100 when omitted; maximum is\n 500.",
            "example": 100,
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum number of flows to return. Defaults to 100 when omitted; maximum is\n 500.",
              "maximum": 500,
              "title": "limit",
              "type": "integer"
            }
          },
          {
            "description": "Sort direction for the selected ordering timestamp.",
            "example": "SORT_NEWEST",
            "in": "query",
            "name": "sort",
            "schema": {
              "$ref": "#/components/schemas/chain.lifecycle.v1.Sort",
              "description": "Sort direction for the selected ordering timestamp.",
              "title": "sort"
            }
          },
          {
            "description": "Optional product flow kind filter. Unspecified includes all kinds.",
            "example": "KIND_DEPOSIT",
            "in": "query",
            "name": "flowKind",
            "schema": {
              "$ref": "#/components/schemas/chain.lifecycle.v1.FlowKind",
              "description": "Optional product flow kind filter. Unspecified includes all kinds.",
              "title": "flow_kind"
            }
          },
          {
            "description": "Optional lifecycle state filter. Unspecified includes all states permitted\n by the selected scope.",
            "example": "STATE_PENDING_SOURCE",
            "in": "query",
            "name": "flowState",
            "schema": {
              "$ref": "#/components/schemas/chain.lifecycle.v1.FlowState",
              "description": "Optional lifecycle state filter. Unspecified includes all states permitted\n by the selected scope.",
              "title": "flow_state"
            }
          },
          {
            "description": "Optional transaction reference filter. Matches source or latest activity\n transaction identifiers across supported chains.",
            "example": "0xabc123def4567890abc123def4567890abc123def4567890abc123def4567890",
            "in": "query",
            "name": "txRef",
            "schema": {
              "description": "Optional transaction reference filter. Matches source or latest activity\n transaction identifiers across supported chains.\nstring.chain_tx_identifier = true // transaction identifier must be a valid EVM hash or chain-native printable id\n",
              "title": "tx_ref",
              "type": "string"
            }
          },
          {
            "description": "Selects open, terminal, or all lifecycle flows.",
            "example": "LIST_ALL",
            "in": "query",
            "name": "scope",
            "schema": {
              "$ref": "#/components/schemas/chain.lifecycle.v1.ListScope",
              "description": "Selects open, terminal, or all lifecycle flows.",
              "title": "scope"
            }
          },
          {
            "description": "Public account identifier for a main account or subaccount.",
            "example": "7563897446546",
            "in": "query",
            "name": "ownerAccountId",
            "schema": {
              "description": "Public account identifier for a main account or subaccount.",
              "exclusiveMinimum": 0,
              "format": "int64",
              "title": "owner_account_id",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "description": "Smart account address on Polyester Chain.",
            "example": "0x2222222222222222222222222222222222222222",
            "in": "query",
            "name": "smartAccountAddress",
            "schema": {
              "description": "Smart account address on Polyester Chain.\nstring.evm_address = true // address must be a valid 0x-prefixed account address\n",
              "title": "smart_account_address",
              "type": "string"
            }
          },
          {
            "description": "Optional Polyester Chain ids to include. Maximum 100 unique ids.",
            "example": 1,
            "in": "query",
            "name": "polyesterChainIds",
            "schema": {
              "description": "Optional Polyester Chain ids to include. Maximum 100 unique ids.",
              "items": {
                "exclusiveMinimum": 0,
                "maxItems": 100,
                "type": "integer",
                "uniqueItems": true
              },
              "maxItems": 100,
              "title": "polyester_chain_ids",
              "type": "array",
              "uniqueItems": true
            }
          },
          {
            "description": "Optional chain asset mapping ids to include. Maximum 100 unique ids.",
            "example": 100,
            "in": "query",
            "name": "zippedAssetIds",
            "schema": {
              "description": "Optional chain asset mapping ids to include. Maximum 100 unique ids.",
              "items": {
                "exclusiveMinimum": 0,
                "maxItems": 100,
                "type": "integer",
                "uniqueItems": true
              },
              "maxItems": 100,
              "title": "zipped_asset_ids",
              "type": "array",
              "uniqueItems": true
            }
          },
          {
            "description": "Optional unified asset ids to include. Maximum 100 unique ids.",
            "example": 100,
            "in": "query",
            "name": "unifiedAssetIds",
            "schema": {
              "description": "Optional unified asset ids to include. Maximum 100 unique ids.",
              "items": {
                "exclusiveMinimum": 0,
                "maxItems": 100,
                "type": "integer",
                "uniqueItems": true
              },
              "maxItems": 100,
              "title": "unified_asset_ids",
              "type": "array",
              "uniqueItems": true
            }
          },
          {
            "description": "Opaque keyset cursor returned by a previous response. The cursor is\n exclusive and bound to the caller, filters, account selector, sort\n direction, and ordering timestamp.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "pageToken",
            "schema": {
              "description": "Opaque keyset cursor returned by a previous response. The cursor is\n exclusive and bound to the caller, filters, account selector, sort\n direction, and ordering timestamp.",
              "maxLength": 512,
              "title": "page_token",
              "type": "string"
            }
          },
          {
            "description": "Timestamp used for ordering and pagination. Defaults to last activity.",
            "example": "ORDER_BY_LAST_ACTIVITY",
            "in": "query",
            "name": "orderBy",
            "schema": {
              "$ref": "#/components/schemas/chain.lifecycle.v1.ListOrderBy",
              "description": "Timestamp used for ordering and pagination. Defaults to last activity.",
              "title": "order_by"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "flows": [
                    {
                      "amountE18": {
                        "hi": "1",
                        "lo": "1"
                      },
                      "assetIds": {
                        "unifiedAssetId": 100,
                        "zippedAssetId": 100
                      },
                      "currentProgress": {
                        "approveCount": 1,
                        "currentConfirmations": 1,
                        "currentStepExpectedDurationMs": "1",
                        "currentStepStartedAtUnixMs": "1",
                        "rejectCount": 1,
                        "requiredApprovals": 1,
                        "requiredConfirmations": 1,
                        "requiredRejections": 1,
                        "validatorCount": 1
                      },
                      "currentStep": "FLOW_STEP_SOURCE",
                      "currentStepSequence": 1,
                      "destinationAddress": "0x3333333333333333333333333333333333333333",
                      "destinationDomain": "DOMAIN_EXTERNAL_CHAIN",
                      "estimatedCompletionUnixMs": "1",
                      "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhI",
                      "flowKind": "KIND_DEPOSIT",
                      "isOpen": false,
                      "isTerminal": false,
                      "lastActivityAtUnixMs": "1",
                      "latestLifecycleSource": "SOURCE_RELAYER",
                      "latestTxRef": "0xabc123def4567890abc123def4567890abc123def4567890abc123def4567890",
                      "ownerAccountId": "7563897446546",
                      "polyesterChainId": 1,
                      "progressTimeline": [
                        {
                          "expectedDurationMs": "1",
                          "sequence": 1,
                          "status": "TIMELINE_STATUS_COMPLETED",
                          "step": "FLOW_STEP_SOURCE"
                        }
                      ],
                      "reasonCode": "FLOW_REASON_ZIPPER_VALIDATION_REJECTED",
                      "requestFee": {
                        "amountE18": {
                          "hi": "1",
                          "lo": "1"
                        },
                        "assetIds": {
                          "unifiedAssetId": 100,
                          "zippedAssetId": 100
                        },
                        "recipientAddress": "0x3333333333333333333333333333333333333333",
                        "status": "REQUEST_FEE_STATUS_LOCKED"
                      },
                      "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                      "sourceAddress": "0x4444444444444444444444444444444444444444",
                      "sourceDomain": "DOMAIN_EXTERNAL_CHAIN",
                      "sourceTxHash": "0xabc123def4567890abc123def4567890abc123def4567890abc123def4567890",
                      "startedAtUnixMs": "1",
                      "terminalAtUnixMs": "1",
                      "txOccurrenceIndex": "1",
                      "updatedAtUnixMs": "1"
                    }
                  ],
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.lifecycle.v1.ListFlowsResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "security": [],
        "summary": "List Flows",
        "tags": [
          "Lifecycle"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.lifecycle.v1",
        "x-poly-request-type": "chain.lifecycle.v1.ListFlowsRequest",
        "x-poly-response-type": "chain.lifecycle.v1.ListFlowsResponse"
      }
    },
    "/v1/chain/flows/by-tx/{tx_hash}/matches": {
      "get": {
        "description": "List lifecycle flows that reference a transaction hash.",
        "operationId": "LifecycleReadService_ListFlowsByTx",
        "parameters": [
          {
            "description": "Chain transaction identifier to search for. Accepts a 0x-prefixed 32-byte\n EVM hash or a printable chain-native transaction id such as a Solana\n signature, Bitcoin txid, Litecoin txid, Dogecoin txid, or XRP transaction\n hash.",
            "example": "0xabc123def4567890abc123def4567890abc123def4567890abc123def4567890",
            "in": "path",
            "name": "tx_hash",
            "required": true,
            "schema": {
              "description": "Chain transaction identifier to search for. Accepts a 0x-prefixed 32-byte\n EVM hash or a printable chain-native transaction id such as a Solana\n signature, Bitcoin txid, Litecoin txid, Dogecoin txid, or XRP transaction\n hash.\nstring.chain_tx_identifier = true // transaction identifier must be a valid EVM hash or chain-native printable id\n",
              "title": "tx_hash",
              "type": "string"
            }
          },
          {
            "description": "Lookup mode that determines which transaction references are searched.",
            "example": "TX_SOURCE",
            "in": "query",
            "name": "lookupKind",
            "schema": {
              "$ref": "#/components/schemas/chain.lifecycle.v1.TxLookupKind",
              "description": "Lookup mode that determines which transaction references are searched.",
              "title": "lookup_kind"
            }
          },
          {
            "description": "Maximum number of matches to return. Defaults to 100 when omitted; maximum\n is 500.",
            "example": 100,
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum number of matches to return. Defaults to 100 when omitted; maximum\n is 500.",
              "maximum": 500,
              "title": "limit",
              "type": "integer"
            }
          },
          {
            "description": "Opaque keyset cursor returned by a previous response. The cursor is\n exclusive and bound to the transaction hash and lookup mode.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "pageToken",
            "schema": {
              "description": "Opaque keyset cursor returned by a previous response. The cursor is\n exclusive and bound to the transaction hash and lookup mode.",
              "maxLength": 512,
              "title": "page_token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "matches": [
                    {
                      "amountE18": {
                        "hi": "1",
                        "lo": "1"
                      },
                      "assetIds": {
                        "unifiedAssetId": 100,
                        "zippedAssetId": 100
                      },
                      "currentStep": "FLOW_STEP_SOURCE",
                      "destinationAddress": "0x3333333333333333333333333333333333333333",
                      "destinationDomain": "DOMAIN_EXTERNAL_CHAIN",
                      "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhI",
                      "flowKind": "KIND_DEPOSIT",
                      "isOpen": false,
                      "isTerminal": false,
                      "lastActivityAtUnixMs": "1",
                      "latestTxRef": "0xabc123def4567890abc123def4567890abc123def4567890abc123def4567890",
                      "ownerAccountId": "7563897446546",
                      "polyesterChainId": 1,
                      "reasonCode": "FLOW_REASON_ZIPPER_VALIDATION_REJECTED",
                      "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                      "sourceAddress": "0x4444444444444444444444444444444444444444",
                      "sourceDomain": "DOMAIN_EXTERNAL_CHAIN",
                      "sourceTxHash": "0xabc123def4567890abc123def4567890abc123def4567890abc123def4567890",
                      "txOccurrenceIndex": "1"
                    }
                  ],
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0",
                  "txHash": "0xabc123def4567890abc123def4567890abc123def4567890abc123def4567890"
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.lifecycle.v1.ListFlowsByTxResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "security": [],
        "summary": "List Flows By Tx",
        "tags": [
          "Lifecycle"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.lifecycle.v1",
        "x-poly-request-type": "chain.lifecycle.v1.ListFlowsByTxRequest",
        "x-poly-response-type": "chain.lifecycle.v1.ListFlowsByTxResponse"
      }
    },
    "/v1/chain/flows/{flow_id}": {
      "get": {
        "description": "Retrieve one lifecycle flow by public flow id.",
        "operationId": "LifecycleReadService_GetFlowById",
        "parameters": [
          {
            "description": "Public, URL-safe lifecycle identifier returned by list/search responses.",
            "example": "flow_7YWHMfk9JZeLMgZauHuiSxhI",
            "in": "path",
            "name": "flow_id",
            "required": true,
            "schema": {
              "description": "Public, URL-safe lifecycle identifier returned by list/search responses.",
              "maxLength": 64,
              "minLength": 6,
              "pattern": "^flow_[1-9A-HJ-NP-Za-km-z]+$",
              "title": "flow_id",
              "type": "string"
            }
          }
        ],
