{
  "services": [
    {
      "name": "changelog.v1.ChangelogService",
      "doc": "ChangelogService serves the published changelog of this environment. It is\n public and caller-independent, and supports cacheable ConnectRPC GET.",
      "methods": [
        {
          "name": "GetPost",
          "path": "changelog.v1.ChangelogService/GetPost",
          "requestType": "changelog.v1.GetPostRequest",
          "responseType": "changelog.v1.GetPostResponse",
          "summary": "Get one complete published post by slug.",
          "doc": "Get one complete published post by slug.",
          "tags": [
            "changelog"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "changelog.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "slug": "example"
            },
            "response": {
              "post": {
                "sections": [
                  {
                    "changes": [
                      {
                        "actionRequired": false,
                        "audiences": [
                          "ALL_USERS"
                        ],
                        "category": "BREAKING_CHANGE",
                        "details": "value",
                        "id": "1",
                        "migrationGuidance": "value",
                        "summary": "value",
                        "surfaces": [
                          "TRADING"
                        ],
                        "title": "My Trading Board"
                      }
                    ],
                    "heading": "value",
                    "summary": "value"
                  }
                ],
                "summary": {
                  "actionRequiredCount": 1,
                  "breakingChangeCount": 1,
                  "bugFixCount": 1,
                  "changeCount": 1,
                  "coverageCutoff": "2025-01-01T00:00:00Z",
                  "improvementCount": 1,
                  "introduction": "value",
                  "newFeatureCount": 1,
                  "publishedAt": "2025-01-01T00:00:00Z",
                  "slug": "value",
                  "title": "My Trading Board"
                }
              }
            }
          }
        },
        {
          "name": "ListChanges",
          "path": "changelog.v1.ChangelogService/ListChanges",
          "requestType": "changelog.v1.ListChangesRequest",
          "responseType": "changelog.v1.ListChangesResponse",
          "summary": "List changes across published posts, for example every breaking change",
          "doc": "List changes across published posts, for example every breaking change\n since a given time.",
          "tags": [
            "changelog"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "changelog.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "actionRequired": false,
              "audiences": [
                "ALL_USERS"
              ],
              "categories": [
                "BREAKING_CHANGE"
              ],
              "endTime": "2025-01-01T00:00:00Z",
              "limit": 100,
              "pageToken": "eyJvZmZzZXQiOjEwMH0",
              "postSlug": "value",
              "sort": "SORT_ASC",
              "startTime": "2025-01-01T00:00:00Z",
              "surfaces": [
                "TRADING"
              ]
            },
            "response": {
              "changes": [
                {
                  "change": {
                    "actionRequired": false,
                    "audiences": [
                      "ALL_USERS"
                    ],
                    "category": "BREAKING_CHANGE",
                    "details": "value",
                    "id": "1",
                    "migrationGuidance": "value",
                    "summary": "value",
                    "surfaces": [
                      "TRADING"
                    ],
                    "title": "My Trading Board"
                  },
                  "postSlug": "value",
                  "publishedAt": "2025-01-01T00:00:00Z",
                  "sectionHeading": "value"
                }
              ],
              "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
            }
          }
        },
        {
          "name": "ListPosts",
          "path": "changelog.v1.ChangelogService/ListPosts",
          "requestType": "changelog.v1.ListPostsRequest",
          "responseType": "changelog.v1.ListPostsResponse",
          "summary": "List published post summaries, newest first. Use limit 1 to poll for the",
          "doc": "List published post summaries, newest first. Use limit 1 to poll for the\n latest post.",
          "tags": [
            "changelog"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "changelog.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "limit": 100,
              "pageToken": "eyJvZmZzZXQiOjEwMH0"
            },
            "response": {
              "nextPageToken": "eyJvZmZzZXQiOjIwMH0",
              "posts": [
                {
                  "actionRequiredCount": 1,
                  "breakingChangeCount": 1,
                  "bugFixCount": 1,
                  "changeCount": 1,
                  "coverageCutoff": "2025-01-01T00:00:00Z",
                  "improvementCount": 1,
                  "introduction": "value",
                  "newFeatureCount": 1,
                  "publishedAt": "2025-01-01T00:00:00Z",
                  "slug": "value",
                  "title": "My Trading Board"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
