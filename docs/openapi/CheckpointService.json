{
  "components": {
    "schemas": {
      "checkpoints.v1.ListMyCheckpointsResponse": {
        "additionalProperties": false,
        "description": "ListMyCheckpointsResponse contains the caller's checkpoints.",
        "properties": {
          "checkpoints": {
            "description": "Checkpoints of the root account, newest first. There is at most one per\n season, so the list is naturally bounded and not paginated. Empty when\n the account has no checkpoint, for example when it did not trade in any\n recorded season.",
            "items": {
              "$ref": "#/components/schemas/checkpoints.v1.Checkpoint"
            },
            "title": "checkpoints",
            "type": "array"
          }
        },
        "title": "ListMyCheckpointsResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "BrokerApiKeyAuth": {
        "description": "Broker API key, sent as a bearer token and accepted only by the QuickSwap broker API. The broker API key is a server credential. Call this API from the broker's backend, never from a browser or mobile app. The broker's members create, rotate and revoke keys through the QuickSwap broker API, and a key may rotate itself.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/checkpoints": {
      "get": {
        "description": "List every checkpoint of the authenticated caller's root account, newest first. Checkpoints are private to the account owner.",
        "operationId": "CheckpointService_ListMyCheckpoints",
        "parameters": [
          {
            "description": "Optional subaccount public identifier. Checkpoints cover a root account\n and all of its subaccounts, so a subaccount resolves to its root account,\n which must be the caller's own.",
            "in": "query",
            "name": "subaccountId",
            "schema": {
              "description": "Optional subaccount public identifier. Checkpoints cover a root account\n and all of its subaccounts, so a subaccount resolves to its root account,\n which must be the caller's own.",
              "example": "6789012345678",
              "exclusiveMinimum": 0,
              "format": "int64",
              "title": "subaccount_id",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
