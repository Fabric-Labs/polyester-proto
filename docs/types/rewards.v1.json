{
  "types": [
    {
      "name": "rewards.v1.ListMyRewardAwardsRequest",
      "kind": "message",
      "doc": "ListMyRewardAwardsRequest requests a page of awards for the authenticated root account.",
      "message": {
        "fields": [
          {
            "name": "limit",
            "jsonName": "limit",
            "number": 1,
            "doc": "Maximum awards to return. Zero uses 50; maximum 100.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32",
            "validate": {
              "number": {
                "lte": "100"
              }
            }
          },
          {
            "name": "page_token",
            "jsonName": "pageToken",
            "number": 2,
            "doc": "Opaque exclusive continuation token bound to the authenticated root account.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "maxLen": 256
              }
            }
          }
        ]
      }
    },
    {
      "name": "rewards.v1.ListMyRewardAwardsResponse",
      "kind": "message",
      "doc": "ListMyRewardAwardsResponse contains newest awards first.",
      "message": {
        "fields": [
          {
            "name": "awards",
            "jsonName": "awards",
            "number": 1,
            "doc": "Awards ordered by publication time and award identifier, newest first.",
            "repeated": true,
            "protoRef": "rewards.v1.RewardAward"
          },
          {
            "name": "next_page_token",
            "jsonName": "nextPageToken",
            "number": 2,
            "doc": "Opaque continuation token. Empty when no more results exist.",
            "protoScalar": "string",
            "jsonType": "string"
          }
        ]
      }
    },
    {
      "name": "rewards.v1.RewardAward",
      "kind": "message",
      "doc": "RewardAward is a published immutable award for the authenticated root account.",
      "message": {
        "fields": [
          {
            "name": "award_id",
            "jsonName": "awardId",
            "number": 1,
            "doc": "Stable opaque award identifier.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "campaign_id",
            "jsonName": "campaignId",
            "number": 2,
            "doc": "Stable campaign identifier.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "campaign_name",
            "jsonName": "campaignName",
            "number": 3,
            "doc": "Campaign display name frozen at publication.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "asset_id",
            "jsonName": "assetId",
            "number": 4,
            "doc": "Canonical asset identifier.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "amount_base_units",
            "jsonName": "amountBaseUnits",
            "number": 5,
            "doc": "Exact integer amount in the asset's smallest base unit.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "fulfillment_method",
            "jsonName": "fulfillmentMethod",
            "number": 6,
            "doc": "Selected delivery method.",
            "protoRef": "rewards.v1.RewardFulfillmentMethod"
          },
          {
            "name": "fulfillment_state",
            "jsonName": "fulfillmentState",
            "number": 7,
            "doc": "Current delivery state.",
            "protoRef": "rewards.v1.RewardFulfillmentState"
          },
          {
            "name": "published_at",
            "jsonName": "publishedAt",
            "number": 8,
            "doc": "Publication time.",
            "protoRef": "google.protobuf.Timestamp",
            "jsonType": "string",
            "format": "date-time"
          }
        ]
      }
    },
    {
      "name": "rewards.v1.RewardFulfillmentMethod",
      "kind": "enum",
      "doc": "RewardFulfillmentMethod identifies how an award will be delivered.",
      "enum": {
        "values": [
          {
            "name": "EXTERNAL_TESTNET",
            "number": 1
          },
          {
            "name": "INTERNAL_TRADING",
            "number": 2
          }
        ]
      }
    },
    {
      "name": "rewards.v1.RewardFulfillmentState",
      "kind": "enum",
      "doc": "RewardFulfillmentState describes the current delivery state.",
      "enum": {
        "values": [
          {
            "name": "AWAITING_DESTINATION",
            "number": 1
          },
          {
            "name": "READY_FOR_PAYOUT",
            "number": 2
          },
          {
            "name": "PAID",
            "number": 3
          },
          {
            "name": "FAILED",
            "number": 4
          },
          {
            "name": "CANCELED",
            "number": 5
          }
        ]
      }
    }
  ]
}
