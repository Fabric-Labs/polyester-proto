{
  "components": {
    "schemas": {
      "claims.v1.ClaimDailyRewardRequest": {
        "additionalProperties": false,
        "description": "ClaimDailyRewardRequest claims today's reward for the authenticated root account.",
        "title": "ClaimDailyRewardRequest",
        "type": "object"
      },
      "polyester.rest.ClaimsService_ClaimDailyReward.Response": {
        "additionalProperties": false,
        "properties": {
          "campaign": {
            "additionalProperties": false,
            "description": "Campaign associated with this claim, using the name and description that applied when the claim was created.",
            "properties": {
              "campaignId": {
                "description": "Stable campaign identifier.",
                "type": "string"
              },
              "claimPolicy": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/polyester.rest.enum.claims.v1.ClaimPolicy"
                  }
                ],
                "description": "How frequently each root account may claim from this campaign."
              },
              "description": {
                "description": "Campaign description. Existing claims retain the description that applied when they were created.",
                "type": "string"
              },
              "name": {
                "description": "Campaign name. Existing claims retain the name that applied when they were created.",
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          },
          "claimId": {
            "description": "Claim identifier.",
            "type": "string"
          },
          "claimedAt": {
            "description": "Time when the claim completed. Omitted while the claim is processing.",
            "format": "date-time",
            "type": "string"
          },
          "resetAt": {
            "description": "Start of the next UTC calendar day.",
            "format": "date-time",
            "type": "string"
          },
          "rewards": {
            "description": "Assets and amounts granted by this claim. They do not change after the claim is created.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "description": "Claim amount in 18-decimal unified asset units.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "assetCode": {
                  "description": "Asset code.",
                  "type": "string"
                },
                "assetId": {
                  "description": "Asset identifier.",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "amount",
                "assetCode",
                "assetId"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/polyester.rest.enum.claims.v1.DailyClaimState"
              }
            ],
            "description": "Current claim state."
          },
          "transfers": {
            "description": "Transfers created for each reward asset. Empty while the claim is processing.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "assetId": {
                  "description": "Asset identifier.",
                  "format": "int32",
                  "type": "integer"
                },
                "transferId": {
                  "description": "Transfer identifier.",
                  "type": "string"
                }
              },
              "required": [
                "assetId",
                "transferId"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "resetAt",
          "rewards",
          "state",
          "transfers"
        ],
        "type": "object"
      },
      "polyester.rest.ClaimsService_GetDailyClaimStatus.Response": {
        "additionalProperties": false,
        "properties": {
          "campaign": {
            "additionalProperties": false,
            "description": "Campaign associated with the current reward or existing claim. Omitted when no campaign applies.",
            "properties": {
              "campaignId": {
                "description": "Stable campaign identifier.",
                "type": "string"
              },
              "claimPolicy": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/polyester.rest.enum.claims.v1.ClaimPolicy"
                  }
                ],
                "description": "How frequently each root account may claim from this campaign."
              },
              "description": {
                "description": "Campaign description. Existing claims retain the description that applied when they were created.",
                "type": "string"
              },
              "name": {
                "description": "Campaign name. Existing claims retain the name that applied when they were created.",
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          },
          "claimId": {
            "description": "Claim identifier. Empty until a claim has been created.",
            "type": "string"
          },
          "resetAt": {
            "description": "Start of the next UTC calendar day.",
            "format": "date-time",
            "type": "string"
          },
          "rewards": {
            "description": "Assets and amounts available or already granted for the current UTC day. Future rewards are not returned.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "description": "Claim amount in 18-decimal unified asset units.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "assetCode": {
                  "description": "Asset code.",
                  "type": "string"
                },
                "assetId": {
                  "description": "Asset identifier.",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "amount",
                "assetCode",
                "assetId"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/polyester.rest.enum.claims.v1.DailyClaimState"
              }
            ],
            "description": "Current state of today's claim."
          }
        },
        "required": [
          "resetAt",
          "rewards",
          "state"
        ],
        "type": "object"
      },
      "polyester.rest.enum.claims.v1.ClaimPolicy": {
        "enum": [
          "UTC_DAILY"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "UTC_DAILY": "One claim is available to each root account per UTC calendar day."
        }
      },
      "polyester.rest.enum.claims.v1.DailyClaimState": {
        "enum": [
          "AVAILABLE",
          "PROCESSING",
          "CLAIMED",
          "UNAVAILABLE"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "AVAILABLE": "Today's reward is available to claim.",
          "CLAIMED": "Today's reward was claimed successfully.",
          "PROCESSING": "Today's claim is being processed. Retrying returns the same claim.",
          "UNAVAILABLE": "No reward is active for the current UTC day."
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/trading/daily-claim": {
      "get": {
        "description": "Get today's reward and claim status for the authenticated root account. Requires a session JWT; API keys are not accepted. Future reward schedules are not returned.",
        "operationId": "ClaimsService_GetDailyClaimStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "campaign": {
                    "campaignId": "value",
                    "claimPolicy": "UTC_DAILY",
                    "description": "Example configuration for the API playground.",
                    "name": "value"
                  },
                  "claimId": "value",
                  "resetAt": "2025-01-01T00:00:00Z",
                  "rewards": [
                    {
                      "amount": "18.446744073709551617",
                      "assetCode": "USDC",
                      "assetId": 100
                    }
                  ],
                  "state": "AVAILABLE"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.ClaimsService_GetDailyClaimStatus.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Daily Claim Status",
        "tags": [
          "Daily Claim"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.ClaimsService_GetDailyClaimStatus",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "claims.v1.GetDailyClaimStatusRequest",
        "x-poly-response-type": "claims.v1.GetDailyClaimStatusResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/trading/daily-claim/claim": {
      "post": {
        "description": "Claim today's reward once for the authenticated root account. Requires a session JWT; API keys are not accepted. All reward assets are transferred together, and retries return the same claim.",
        "operationId": "ClaimsService_ClaimDailyReward",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/polyester.rest.ClaimsService_ClaimDailyReward.Request"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/claims.v1.ClaimDailyRewardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "campaign": {
                    "campaignId": "value",
                    "claimPolicy": "UTC_DAILY",
                    "description": "Example configuration for the API playground.",
                    "name": "value"
                  },
                  "claimId": "value",
                  "claimedAt": "2025-01-01T00:00:00Z",
                  "resetAt": "2025-01-01T00:00:00Z",
                  "rewards": [
                    {
                      "amount": "18.446744073709551617",
                      "assetCode": "USDC",
                      "assetId": 100
                    }
                  ],
                  "state": "AVAILABLE",
                  "transfers": [
                    {
                      "assetId": 100,
                      "transferId": "9155001234569"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.ClaimsService_ClaimDailyReward.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Claim Daily Reward",
        "tags": [
          "Daily Claim"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "claims.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "claims.v1.ClaimDailyRewardRequest",
        "x-poly-response-type": "claims.v1.ClaimDailyRewardResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
