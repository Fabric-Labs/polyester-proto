          "doc": "List the account's available Trading balances with their eligibility and\n the payout the eligible ones would bring now. Reserves nothing.\n\n Errors:\n - INVALID_ARGUMENT: INVALID_REQUEST (target_asset_id is not a target) or\n   INVALID_SUBACCOUNT_ID.\n - NOT_FOUND: SUBACCOUNT_NOT_FOUND.\n - PERMISSION_DENIED: PERMISSION_DENIED or POLICY_DENIED.\n - UNAVAILABLE: SERVICE_UNAVAILABLE; retry later.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "transfer.v1",
          "errorCatalog": "internal-transfer-api:transfererrors",
          "examples": {
