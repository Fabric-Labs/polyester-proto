{
  "components": {
    "schemas": {
      "ledger.read.v1.GetHealthResponse": {
        "additionalProperties": false,
        "properties": {
          "ok": {
            "title": "ok",
            "type": "boolean"
          },
          "version": {
            "title": "version",
            "type": "string"
          }
        },
        "title": "GetHealthResponse",
        "type": "object"
      },
      "polyester.rest.LedgerReadService_GetBalanceHistory.Response": {
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "type": "string"
          },
          "endTsSec": {
            "format": "int32",
            "type": "integer"
          },
          "points": {
            "format": "int32",
            "type": "integer"
          },
          "range": {
            "enum": [
              "DAY_1",
              "DAY_7",
              "DAY_30",
              "DAY_90",
              "DAY_180",
              "DAY_365"
            ],
            "type": "string"
          },
          "series": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "accountCode": {
                  "description": "account bucket code",
                  "format": "int32",
                  "type": "integer"
                },
                "asset": {
                  "description": "public asset id",
                  "type": "string"
                },
                "balance": {
                  "description": "balance in asset units scaled by 1e7 (7 decimals). Aligned 1:1 with implicit timestamps.",
                  "items": {
                    "pattern": "^[0-9]+(\\.[0-9]+)?$",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "accountCode",
                "asset",
                "balance"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "startTsSec": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "range",
          "series"
        ],
        "type": "object"
      },
      "polyester.rest.LedgerReadService_GetBalances.Response": {
        "additionalProperties": false,
        "properties": {
          "balances": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "available": {
                  "description": "Available amount in the trading bucket (u128 base units). This is computed as max(trading - reserved, 0).",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "funding": {
                  "description": "Funding balance for this asset (u128 base units).",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "reserved": {
                  "description": "Reserved amount in the trading bucket (u128 base units).",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "symbol": {
                  "description": "public asset id (client resolves name/scale)",
                  "type": "string"
                },
                "trading": {
                  "description": "Trading/trading balance for this asset (u128 base units).",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                }
              },
              "required": [
                "available",
                "funding",
                "reserved",
                "symbol",
                "trading"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "balances"
        ],
        "type": "object"
      },
      "polyester.rest.LedgerReadService_GetEquityHistorySeries.Response": {
        "additionalProperties": false,
        "properties": {
          "btcPrices": {
            "description": "BTC price in USDT at each timestamp, scaled by 1e6 (price ticks). Enables client-side conversion to BTC denomination without refetch.",
            "items": {
              "pattern": "^[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            "type": "array"
          },
          "bucket": {
            "type": "string"
          },
          "endTsSec": {
            "format": "int32",
            "type": "integer"
          },
          "points": {
            "format": "int32",
            "type": "integer"
          },
          "quoteAsset": {
            "description": "Human-readable quote asset symbol (always \"USDT\").",
            "type": "string"
          },
          "range": {
            "enum": [
              "DAY_1",
              "DAY_7",
              "DAY_30",
              "DAY_90",
              "DAY_180",
              "DAY_365"
            ],
            "type": "string"
          },
          "series": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "account": {
                  "additionalProperties": false,
                  "description": "set when group_by = ACCOUNT",
                  "properties": {
                    "code": {
                      "description": "account bucket code",
                      "format": "int32",
                      "type": "integer"
                    },
                    "name": {
                      "description": "human-readable name (\"funding\", \"trading\")",
                      "type": "string"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "asset": {
                  "additionalProperties": false,
                  "description": "set when group_by = ASSET",
                  "properties": {
                    "id": {
                      "description": "public asset id (0 for \"OTHER\" bucket)",
                      "format": "int32",
                      "type": "integer"
                    },
                    "symbol": {
                      "description": "asset symbol (\"BTC\", \"ETH\", \"OTHER\")",
                      "type": "string"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "equity": {
                  "description": "Equity in quote currency scaled by 1e4 (4 decimals). Aligned 1:1 with timestamps.",
                  "items": {
                    "pattern": "^[0-9]+(\\.[0-9]+)?$",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "equity"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "startTsSec": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "btcPrices",
          "range",
          "series"
        ],
        "type": "object"
      },
      "polyester.rest.LedgerReadService_ListTransfers.Response": {
        "additionalProperties": false,
        "properties": {
          "nextCursor": {
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "transfers": {
            "description": "Transfer rows in requested order.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "account": {
                  "description": "account bucket code",
                  "type": "string"
                },
                "amount": {
                  "description": "base units (u128)",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "asset": {
                  "description": "public asset id; client resolves symbol/scale",
                  "type": "string"
                },
                "balanceAfter": {
                  "description": "post-transfer balance (u128)",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "flowId": {
                  "description": "related legs (0 when N/A)",
                  "type": "string"
                },
                "isDebit": {
                  "description": "true for debit legs, false for credit legs",
                  "type": "boolean"
                },
                "linkId": {
                  "description": "correlation id derived from ME matchId for grouping",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "onchain": {
                  "description": "true for on-chain transfers",
                  "type": "boolean"
                },
                "timestamp": {
                  "description": "cluster timestamp",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "txId": {
                  "description": "opaque transfer id (chain hash or internal id)",
                  "type": "string"
                },
                "type": {
                  "description": "reason code id",
                  "type": "string"
                }
              },
              "required": [
                "account",
                "amount",
                "asset",
                "balanceAfter",
                "flowId",
                "isDebit",
                "linkId",
                "onchain",
                "timestamp",
                "txId",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "nextCursor",
          "transfers"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/balances": {
      "get": {
        "description": "Retrieve the latest balances for an account. Supports optional subaccount scoping and returns asset symbols with decimal amounts.",
        "operationId": "LedgerReadService_GetBalances",
        "parameters": [
          {
            "description": "Optional subaccount public id (base58).",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccount_id",
            "required": false,
            "schema": {
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "balances": [
                    {
                      "available": {
                        "hi": "1",
                        "lo": "1"
                      },
                      "funding": {
                        "hi": "1",
                        "lo": "1"
                      },
                      "reserved": {
                        "hi": "1",
                        "lo": "1"
                      },
                      "symbol": 100,
                      "trading": {
                        "hi": "1",
                        "lo": "1"
                      }
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.LedgerReadService_GetBalances.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Balances",
        "tags": [
          "Ledger Read"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.LedgerReadService_GetBalances",
        "x-poly-request-type": "ledger.read.v1.GetBalancesRequest",
        "x-poly-response-type": "ledger.read.v1.GetBalancesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/balances/history": {
      "get": {
        "description": "Retrieve balance history buckets for an account. Supports optional subaccount, range, asset, and account-bucket filters.",
        "operationId": "LedgerReadService_GetBalanceHistory",
        "parameters": [
          {
            "description": "Optional account bucket filter (comma-separated codes or names: funding, trading).",
            "example": 1,
            "in": "query",
            "name": "account_code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional public asset filter.",
            "example": 1,
            "in": "query",
            "name": "ledger",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "History window (defaults to 1d).",
            "example": "DAY_1",
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "enum": [
                "1d",
                "7d",
                "30d",
                "90d",
                "180d",
                "365d"
              ],
              "type": "string"
            }
          },
          {
            "description": "Optional subaccount public id (base58).",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccount_id",
            "required": false,
            "schema": {
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "bucket": "1m",
                  "endTsSec": 1735689600,
                  "points": 1,
                  "range": "DAY_1",
                  "series": [
                    {
                      "accountCode": 1,
                      "asset": 100,
                      "balance": "[1]"
                    }
                  ],
                  "startTsSec": 1735689600
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.LedgerReadService_GetBalanceHistory.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Balance History",
        "tags": [
          "Ledger Read"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.LedgerReadService_GetBalanceHistory",
        "x-poly-request-type": "ledger.read.v1.GetBalanceHistoryRequest",
        "x-poly-response-type": "ledger.read.v1.GetBalanceHistoryResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/equity/history/series": {
      "get": {
        "description": "Retrieve equity history as columnar series data. Supports optional subaccount, range, account-bucket filtering, and grouping by account or asset.",
        "operationId": "LedgerReadService_GetEquityHistorySeries",
        "parameters": [
          {
            "description": "Optional account bucket filter (comma-separated codes or names: funding, trading).",
            "example": 1,
            "in": "query",
            "name": "account_code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Grouping mode (defaults to account).",
            "example": "GROUP_BY_ACCOUNT",
            "in": "query",
            "name": "group_by",
            "required": false,
            "schema": {
              "enum": [
                "account",
                "asset"
              ],
              "type": "string"
            }
          },
          {
            "description": "History window (defaults to 1d).",
            "example": "DAY_1",
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "enum": [
                "1d",
                "7d",
                "30d",
                "90d",
                "180d",
                "365d"
              ],
              "type": "string"
            }
          },
          {
            "description": "Optional subaccount public id (base58).",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccount_id",
            "required": false,
            "schema": {
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "btcPrices": "[5000000]",
                  "bucket": "1m",
                  "endTsSec": 1735689600,
                  "points": 1,
                  "quoteAsset": "value",
                  "range": "DAY_1",
                  "series": [
                    {
                      "account": {
                        "code": 1,
                        "name": "value"
                      },
                      "asset": {
                        "id": 1,
                        "symbol": "BTC-USDT"
                      },
                      "equity": "[1]"
                    }
                  ],
                  "startTsSec": 1735689600
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.LedgerReadService_GetEquityHistorySeries.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Equity History Series",
        "tags": [
          "Ledger Read"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.LedgerReadService_GetEquityHistorySeries",
        "x-poly-request-type": "ledger.read.v1.GetEquityHistorySeriesRequest",
        "x-poly-response-type": "ledger.read.v1.GetEquityHistorySeriesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/health": {
      "get": {
        "description": "Retrieve service health and version.",
        "operationId": "LedgerReadService_GetHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "version": "value"
                },
                "schema": {
                  "$ref": "#/components/schemas/ledger.read.v1.GetHealthResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "security": [],
        "summary": "Get Health",
        "tags": [
          "Ledger Read"
        ],
        "x-poly-error-catalog": "ledger-api-read:ledgererrors",
        "x-poly-error-proto-pkg": "ledger.read.v1",
        "x-poly-request-type": "ledger.read.v1.GetHealthRequest",
        "x-poly-response-type": "ledger.read.v1.GetHealthResponse"
      }
    },
    "/v1/transfers": {
      "get": {
        "description": "List transfer history for an account. Supports optional subaccount, asset, ordering, cursor, and hold-state filters.",
        "operationId": "LedgerReadService_ListTransfers",
        "parameters": [
          {
            "description": "Optional public asset filter.",
            "example": 1,
            "in": "query",
            "name": "ledger",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "Maximum rows to return (default 50).",
            "example": 100,
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "type": "integer"
            }
          },
          {
            "description": "true=newest first; false=oldest first.",
            "example": false,
            "in": "query",
            "name": "reversed",
            "required": false,
            "schema": {
              "default": true,
              "type": "boolean"
            }
          },
          {
            "description": "Cursor: return rows with timestamp \u003e since (uint64 microseconds as string).",
            "example": "1",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          },
          {
            "description": "Optional subaccount public id (base58).",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccount_id",
            "required": false,
            "schema": {
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "nextCursor": "1",
                  "transfers": [
                    {
                      "account": 1,
                      "amount": {
                        "hi": "1",
                        "lo": "1"
                      },
                      "asset": 100,
                      "balanceAfter": {
                        "hi": "1",
                        "lo": "1"
                      },
                      "flowId": "value",
                      "isDebit": false,
                      "linkId": "1",
                      "onchain": false,
                      "timestamp": "1735689600",
                      "txId": "0xabc123",
                      "type": 1
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.LedgerReadService_ListTransfers.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "List Transfers",
        "tags": [
          "Ledger Read"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.LedgerReadService_ListTransfers",
        "x-poly-request-type": "ledger.read.v1.ListTransfersRequest",
        "x-poly-response-type": "ledger.read.v1.ListTransfersResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
