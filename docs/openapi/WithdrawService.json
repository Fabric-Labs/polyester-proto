{
  "components": {
    "schemas": {
      "chain.withdraw.v1.CreateTradingWithdrawRequest": {
        "additionalProperties": false,
        "description": "CreateTradingWithdrawRequest creates or returns one durable backend-authorized\n Trading withdraw intent from typed protobuf fields and an API-key signature.",
        "properties": {
          "payload": {
            "$ref": "#/components/schemas/chain.withdraw.v1.TradingWithdrawIntentPayload",
            "description": "Client-signed withdraw details.",
            "title": "payload"
          },
          "payloadSignature": {
            "description": "User/API signature over deterministic TradingWithdrawIntentPayload bytes.\nbytes.const = []\n",
            "format": "byte",
            "minLength": 1,
            "title": "payload_signature",
            "type": "string"
          }
        },
        "required": [
          "payload"
        ],
        "title": "CreateTradingWithdrawRequest",
        "type": "object"
      },
      "chain.withdraw.v1.CreateTradingWithdrawResponse": {
        "additionalProperties": false,
        "description": "CreateTradingWithdrawResponse returns the accepted durable intent identifier\n for the withdraw lifecycle.",
        "properties": {
          "intentId": {
            "description": "Stable server-owned intent identifier for the accepted withdraw lifecycle.\n Clients use this id to follow later progress for the same withdraw flow.",
            "title": "intent_id",
            "type": "string"
          }
        },
        "title": "CreateTradingWithdrawResponse",
        "type": "object"
      },
      "chain.withdraw.v1.CreateWalletTradingWithdrawRequest": {
        "additionalProperties": false,
        "description": "CreateWalletTradingWithdrawRequest creates or returns one durable Trading\n withdraw intent from typed frontend fields plus a wallet EIP-712 signature.",
        "properties": {
          "payload": {
            "$ref": "#/components/schemas/chain.withdraw.v1.TradingWithdrawIntentPayload",
            "description": "Client-signed withdraw details.",
            "title": "payload"
          },
          "payloadSignature": {
            "description": "Wallet EIP-712 signature over the typed withdraw payload.\nbytes.const = []\n",
            "format": "byte",
            "minLength": 1,
            "title": "payload_signature",
            "type": "string"
          },
          "signerWallet": {
            "description": "Wallet address that produced payload_signature.",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "signer_wallet",
            "type": "string"
          },
          "subaccountId": {
            "description": "Optional public subaccount id. Omit to withdraw from the JWT root account.",
            "format": "int64",
            "title": "subaccount_id",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "payload"
        ],
        "title": "CreateWalletTradingWithdrawRequest",
        "type": "object"
      },
      "chain.withdraw.v1.CreateWalletTradingWithdrawResponse": {
        "additionalProperties": false,
        "description": "CreateWalletTradingWithdrawResponse returns the accepted durable intent\n identifier for a wallet-authorized withdraw lifecycle.",
        "properties": {
          "intentId": {
            "description": "Stable server-owned intent identifier for the accepted withdraw lifecycle.\n Clients use this id to follow later progress for the same withdraw flow.",
            "title": "intent_id",
            "type": "string"
          }
        },
        "title": "CreateWalletTradingWithdrawResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/chain/trading-withdraws": {
      "post": {
        "description": "Create or return one durable withdraw from Trading to Funding or to an external chain for the selected account target.",
        "operationId": "WithdrawService_CreateTradingWithdraw",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "payload": {
                  "action": "TO_FUNDING",
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetId": 100,
                  "deadlineTsSec": "1735689600",
                  "destinationAddress": "value",
                  "destinationChainId": "1",
                  "idempotencyKey": "a",
                  "nonce": "example-nonce-12345"
                },
                "payloadSignature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
              },
              "schema": {
                "$ref": "#/components/schemas/chain.withdraw.v1.CreateTradingWithdrawRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/chain.withdraw.v1.CreateTradingWithdrawRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "intentId": "value"
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.withdraw.v1.CreateTradingWithdrawResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Create Trading Withdraw",
        "tags": [
          "Trading Withdraws"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.withdraw.v1",
        "x-poly-request-type": "chain.withdraw.v1.CreateTradingWithdrawRequest",
        "x-poly-response-type": "chain.withdraw.v1.CreateTradingWithdrawResponse"
      }
    },
    "/v1/chain/trading-withdraws:wallet": {
      "post": {
        "description": "Create or return one durable Trading withdraw intent from typed frontend fields and a wallet EIP-712 signature.",
        "operationId": "WithdrawService_CreateWalletTradingWithdraw",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "payload": {
                  "action": "TO_FUNDING",
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetId": 100,
                  "deadlineTsSec": "1735689600",
                  "destinationAddress": "value",
                  "destinationChainId": "1",
                  "idempotencyKey": "a",
                  "nonce": "example-nonce-12345"
                },
                "payloadSignature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
                "signerWallet": "value",
                "subaccountId": "6789012345678"
              },
              "schema": {
                "$ref": "#/components/schemas/chain.withdraw.v1.CreateWalletTradingWithdrawRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/chain.withdraw.v1.CreateWalletTradingWithdrawRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "intentId": "value"
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.withdraw.v1.CreateWalletTradingWithdrawResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Create Wallet Trading Withdraw",
        "tags": [
          "Trading Withdraws"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.withdraw.v1",
        "x-poly-request-type": "chain.withdraw.v1.CreateWalletTradingWithdrawRequest",
        "x-poly-response-type": "chain.withdraw.v1.CreateWalletTradingWithdrawResponse"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
