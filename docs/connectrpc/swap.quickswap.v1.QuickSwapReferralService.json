                "chargedFeeBps": 1,
                "commission": [
                  {
                    "amount": {
                      "baseUnits": "1000000",
                      "decimals": 6
                    },
                    "assetId": 100
                  }
                ],
                "commissionBps": 1,
                "createdAt": "2025-01-01T00:00:00Z",
