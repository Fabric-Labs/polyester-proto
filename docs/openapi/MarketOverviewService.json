{
  "components": {
    "schemas": {
      "marketoverview.v1.MarketOrderBy": {
        "enum": [
          "MARKET_ORDER_BY_UNSPECIFIED",
          "ORDER_BY_CHANGE_24H_BPS",
          "ORDER_BY_VOLUME_24H_QUOTE",
          "ORDER_BY_LAST_PRICE",
          "ORDER_BY_DATE_ADDED"
        ],
        "title": "MarketOrderBy",
        "type": "string"
      },
      "marketoverview.v1.SparklineInterval": {
        "enum": [
          "SPARKLINE_INTERVAL_UNSPECIFIED",
          "SPARKLINE_1H",
          "SPARKLINE_24H",
          "SPARKLINE_1W",
          "SPARKLINE_1M"
        ],
        "title": "SparklineInterval",
        "type": "string"
      },
      "polyester.rest.MarketOverviewService_ListMarketOverview.Response": {
        "additionalProperties": false,
        "properties": {
          "markets": {
            "description": "Market overview rows for the requested page.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "bestAskQtyScaled": {
                  "description": "Best ask quantity scaled by the pair's base_quantity_scale from GetSpotConfig.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "bestAskTicks": {
                  "description": "Current best ask price in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "bestBidQtyScaled": {
                  "description": "Best bid quantity scaled by the pair's base_quantity_scale from GetSpotConfig.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "bestBidTicks": {
                  "description": "Current best bid price in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "change24hBps": {
                  "description": "Rolling 24h change expressed in basis points (bp). Example: +123 = +1.23%.",
                  "format": "int32",
                  "type": "integer"
                },
                "high24hTicks": {
                  "description": "Rolling 24h stats. Highest traded price in the 24h window, in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "lastPriceTicks": {
                  "description": "Last traded price in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "lastTradeTsNs": {
                  "description": "Last trade timestamp in nanoseconds since epoch.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "listedTsNs": {
                  "description": "Listing timestamp in nanoseconds since epoch.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "low24hTicks": {
                  "description": "Lowest traded price in the 24h window, in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "sparklines": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "closeTicks": {
                        "items": {
                          "pattern": "^[0-9]+(\\.[0-9]+)?$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "interval": {
                        "enum": [
                          "SPARKLINE_1H",
                          "SPARKLINE_24H",
                          "SPARKLINE_1W",
                          "SPARKLINE_1M"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "closeTicks",
                      "interval"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "symbol": {
                  "description": "Canonical pair symbol, e.g. \"BTC-USDT\".",
                  "type": "string"
                },
                "symbolId": {
                  "description": "Numeric spot market identifier.",
                  "format": "int32",
                  "type": "integer"
                },
                "volume24hBaseScaled": {
                  "description": "Rolling 24h base volume scaled by the pair's base_quantity_scale from GetSpotConfig.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "volume24hQuoteScaled": {
                  "description": "Rolling 24h quote volume scaled by the pair's quote_quantity_scale from GetSpotConfig.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                }
              },
              "required": [
                "bestAskQtyScaled",
                "bestAskTicks",
                "bestBidQtyScaled",
                "bestBidTicks",
                "change24hBps",
                "high24hTicks",
                "lastPriceTicks",
                "lastTradeTsNs",
                "listedTsNs",
                "low24hTicks",
                "sparklines",
                "symbol",
                "symbolId",
                "volume24hBaseScaled",
                "volume24hQuoteScaled"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "nextPageToken": {
            "description": "Opaque cursor for the next page. Empty when no more results exist.",
            "type": "string"
          }
        },
        "required": [
          "markets",
          "nextPageToken"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/spot/markets/overview": {
      "get": {
        "description": "List ticker-style market overview rows with optional sparklines. Supports symbol filtering, sorting, and pagination controls.",
        "operationId": "MarketOverviewService_ListMarketOverview",
        "parameters": [
          {
            "description": "When true, include sparklines in each MarketOverview.",
            "example": false,
            "in": "query",
            "name": "includeSparklines",
            "schema": {
              "description": "When true, include sparklines in each MarketOverview.",
              "title": "include_sparklines",
              "type": "boolean"
            }
          },
          {
            "description": "When true, include sparklines in each market.",
            "example": false,
            "in": "query",
            "name": "include_sparklines",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "Maximum markets to return (server default 50, max 2000).",
            "example": 100,
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "type": "integer"
            }
          },
          {
            "description": "Sort key. When unset/UNSPECIFIED, defaults to 24h quote volume.",
            "example": "ORDER_BY_CHANGE_24H_BPS",
            "in": "query",
            "name": "orderBy",
            "schema": {
              "$ref": "#/components/schemas/marketoverview.v1.MarketOrderBy",
              "description": "Sort key. When unset/UNSPECIFIED, defaults to 24h quote volume.",
              "title": "order_by"
            }
          },
          {
            "description": "Sort key.",
            "example": "ORDER_BY_CHANGE_24H_BPS",
            "in": "query",
            "name": "order_by",
            "required": false,
            "schema": {
              "enum": [
                "ORDER_BY_CHANGE_24H_BPS",
                "ORDER_BY_VOLUME_24H_QUOTE",
                "ORDER_BY_LAST_PRICE",
                "ORDER_BY_DATE_ADDED"
              ],
              "type": "string"
            }
          },
          {
            "description": "Opaque cursor from the previous response.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "pageToken",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sort direction.",
            "example": "SORT_ASC",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "enum": [
                "SORT_ASC",
                "SORT_DESC"
              ],
              "type": "string"
            }
          },
          {
            "description": "Which sparklines to include. If empty and include_sparklines is true,\n server defaults to 24h.",
            "example": "SPARKLINE_1H",
            "in": "query",
            "name": "sparklineIntervals",
            "schema": {
              "description": "Which sparklines to include. If empty and include_sparklines is true,\n server defaults to 24h.",
              "items": {
                "$ref": "#/components/schemas/marketoverview.v1.SparklineInterval"
              },
              "title": "sparkline_intervals",
              "type": "array"
            }
          },
          {
            "description": "Sparkline intervals; repeat query param.",
            "example": "SPARKLINE_1H",
            "in": "query",
            "name": "sparkline_intervals",
            "required": false,
            "schema": {
              "enum": [
                "SPARKLINE_1H",
                "SPARKLINE_24H",
                "SPARKLINE_1W",
                "SPARKLINE_1M"
              ],
              "type": "string"
            }
          },
          {
            "description": "Filter by specific symbols; repeat query param (e.g., ?symbols=BTC-USDT\u0026symbols=ETH-USDT).",
            "example": "BTC-USDT",
            "in": "query",
            "name": "symbols",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "markets": [
                    {
                      "bestAskQtyScaled": "0.612345678901234567",
                      "bestAskTicks": "42000.100000",
                      "bestBidQtyScaled": "0.523456789012345678",
                      "bestBidTicks": "42000.000000",
                      "change24hBps": 123,
                      "high24hTicks": "42500.000000",
                      "lastPriceTicks": "42000.050000",
                      "lastTradeTsNs": "1735689600000000000",
                      "listedTsNs": "1735689600000000000",
                      "low24hTicks": "41000.000000",
                      "symbol": "BTC-USDT",
                      "symbolId": 1,
                      "volume24hBaseScaled": "12.345678901234567890",
                      "volume24hQuoteScaled": "518230.123456"
                    }
                  ],
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.MarketOverviewService_ListMarketOverview.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "List Market Overviews",
        "tags": [
          "Market Overview Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.MarketOverviewService_ListMarketOverview",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "marketoverview.v1.ListMarketOverviewRequest",
        "x-poly-response-type": "marketoverview.v1.ListMarketOverviewResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
