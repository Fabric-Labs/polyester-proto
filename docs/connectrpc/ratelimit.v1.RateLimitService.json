{
  "services": [
    {
      "name": "ratelimit.v1.RateLimitService",
      "doc": "RateLimitService serves public trading quota reference data and authenticated\n effective trading limits. A trading read costs units of the read limit of\n the account it reads: one unit per call, or for a list, one unit per 100\n rows its limit asks for, rounded up (two for order history, fills and\n trigger events). A read over the limit is refused RESOURCE_EXHAUSTED (REST 429\n RATE_LIMIT_EXCEEDED) with its RateLimitDetail.",
      "methods": [
        {
          "name": "GetRateLimitConfig",
          "path": "ratelimit.v1.RateLimitService/GetRateLimitConfig",
          "requestType": "ratelimit.v1.GetRateLimitConfigRequest",
          "responseType": "ratelimit.v1.GetRateLimitConfigResponse",
          "summary": "Get Rate Limit Config",
          "doc": "Get the complete active placement, cancellation and read quota catalog\n for VIP0 through VIP10.\n This public, caller-independent catalog supports cacheable ConnectRPC GET.",
          "tags": [
            "trading"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ratelimit.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "effectiveFrom": "2025-01-01T00:00:00Z",
              "policyVersion": "1",
              "rules": [
                {
                  "burstWeight": "1",
                  "periodMs": "1",
                  "policyClass": "TRADING_RATE_LIMIT_CLASS_PLACE",
                  "quotaWeight": "1",
                  "vipTier": 1
                }
              ]
            }
          }
        },
        {
          "name": "GetTradingRateLimits",
          "path": "ratelimit.v1.RateLimitService/GetTradingRateLimits",
          "requestType": "ratelimit.v1.GetTradingRateLimitsRequest",
          "responseType": "ratelimit.v1.GetTradingRateLimitsResponse",
          "summary": "Get Trading Rate Limits",
          "doc": "Get the effective placement, cancellation and read limits for the\n authenticated caller's root account or selected subaccount. Costs one\n unit of the account's read limit.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ratelimit.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "apiKeyRules": [
                {
                  "burstWeight": "1",
                  "periodMs": "1",
                  "policyClass": "TRADING_RATE_LIMIT_CLASS_PLACE",
                  "quotaWeight": "1",
                  "vipTier": 1
                }
              ],
              "effectiveFrom": "2025-01-01T00:00:00Z",
              "policyVersion": "1",
              "rules": [
                {
                  "burstWeight": "1",
                  "periodMs": "1",
                  "policyClass": "TRADING_RATE_LIMIT_CLASS_PLACE",
                  "quotaWeight": "1",
                  "vipTier": 1
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
