{
  "services": [
    {
      "name": "swap.quickswap.v1.QuickSwapReferralService",
      "doc": "QuickSwapReferralService is a referral partner's own record, over\n ConnectRPC. A referral partner shares a link with their code; QuickSwaps\n made through it on Polyester's own QuickSwap app give the user a discount\n and pay the partner a commission, both out of the broker fee (see\n ReferralProgram). Referrals never apply to QuickSwaps through other\n brokers or the API.\n\n Every RPC takes the caller's interactive session token and acts only on\n the caller's own partner record; a broker API key is refused with\n PERMISSION_DENIED / ACTION_DENIED. A person who has not enrolled gets\n NOT_FOUND / REFERRAL_PARTNER_NOT_FOUND from every RPC but\n EnrollReferralPartner.\n\n A partner's code can be changed while it is not disabled, up to 9 times.\n The old code is retired and never given to anyone again; QuickSwaps\n already referred keep their partner.\n\n A partner reads the QuickSwaps it referred with ListReferredQuickSwaps\n and GetReferredQuickSwap, never another partner's or a QuickSwap without\n its referral. They return no identity of the person who swapped and no\n account, address, memo, transaction hash or flow ID; amounts are exact and\n times are rounded down to the minute.\n\n Commissions are credited to the partner's earnings sub-account, which the\n partner owns: its balance, payouts and payout addresses are managed like\n any sub-account's, with AutoWithdrawService and the withdraw whitelist.\n ListReferralLedger lists each commission credit with its QuickSwap and\n each auto-withdraw payout from that sub-account.\n\n GetReferralStats reads the activity of the QuickSwaps the partner\n referred and its commission over time, in GetBrokerStats' columns, with\n a breakdown by route, source or destination asset. It shows the\n partner's commission only, never the other fees of those QuickSwaps.\n\n Every RPC is rate limited per account: over the limit it fails with\n RESOURCE_EXHAUSTED, a RateLimitDetail and a Retry-After header.\n GetReferralStats instead shares GetBrokerStats' budget, the caller's read\n rate: over it the call fails with RESOURCE_EXHAUSTED / BROKER_LIMIT and a\n Retry-After header.",
      "methods": [
        {
          "name": "CheckReferralCode",
          "path": "swap.quickswap.v1.QuickSwapReferralService/CheckReferralCode",
          "requestType": "swap.quickswap.v1.CheckReferralCodeRequest",
          "responseType": "swap.quickswap.v1.CheckReferralCodeResponse",
          "summary": "Check referral code",
          "doc": "CheckReferralCode says whether the caller may take a referral code.\n\n Errors:\n - NOT_FOUND: REFERRAL_PARTNER_NOT_FOUND.",
          "tags": [
            "quickswap"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "swap-api:quickswaperrors:swap.quickswap.v1.QuickSwapReferralService/CheckReferralCode",
          "errorCodes": [
            "ACTION_DENIED",
            "REFERRAL_PARTNER_NOT_FOUND"
          ],
          "examples": {
