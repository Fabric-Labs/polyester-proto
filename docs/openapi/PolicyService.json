  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/api-keys/{key_id}/policy": {
      "patch": {
        "description": "Attach or clear an API key policy for the target key.",
        "operationId": "PolicyService_SetApiKeyPolicy",
        "parameters": [
          {
            "description": "Opaque API key identifier, formatted as \"ak_\" followed by 32 lowercase hex\n characters.",
            "example": "ak_1a3c6de8153d5a5b04cd2a6529779542",
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "description": "Opaque API key identifier, formatted as \"ak_\" followed by 32 lowercase hex\n characters.",
              "minLength": 1,
              "pattern": "^ak_[a-f0-9]{32}$",
              "title": "key_id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "policyId": "1"
              },
              "schema": {
                "additionalProperties": false,
                "description": "SetApiKeyPolicyRequest attaches or clears a policy template on an API key.",
                "properties": {
                  "policyId": {
                    "description": "Policy template to attach (opaque ID). A value of 0 clears the binding.\n An API key without an attached policy has no permissions.",
                    "format": "int64",
                    "title": "policy_id",
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                },
                "title": "SetApiKeyPolicyRequest",
                "type": "object"
              }
            },
            "application/proto": {
              "schema": {
                "additionalProperties": false,
                "description": "SetApiKeyPolicyRequest attaches or clears a policy template on an API key.",
                "properties": {
                  "policyId": {
                    "description": "Policy template to attach (opaque ID). A value of 0 clears the binding.\n An API key without an attached policy has no permissions.",
                    "format": "int64",
                    "title": "policy_id",
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                },
                "title": "SetApiKeyPolicyRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {},
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.SetApiKeyPolicyResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Set API Key Policy",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "fresh_step_up",
        "x-poly-request-type": "auth.v1.SetApiKeyPolicyRequest",
        "x-poly-response-type": "auth.v1.SetApiKeyPolicyResponse"
      }
    },
    "/v1/auth/policies/api-keys": {
      "get": {
        "description": "List API key policy templates available to the caller.",
        "operationId": "PolicyService_ListApiPolicies",
        "parameters": [
          {
            "description": "Optional API key context for delegated administration. When omitted, only\n policies owned by the caller's root account are returned.",
            "example": "ak_1a3c6de8153d5a5b04cd2a6529779542",
            "in": "query",
            "name": "keyId",
            "schema": {
              "description": "Optional API key context for delegated administration. When omitted, only\n policies owned by the caller's root account are returned.",
              "pattern": "^ak_[a-f0-9]{32}$",
              "title": "key_id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "policies": [
                    {
                      "actions": [
                        "TRADE_SPOT"
                      ],
                      "createdAt": "2025-01-01T00:00:00Z",
                      "description": "Allow market and account data reads.",
                      "id": "3bWwpxoPpm",
                      "isTemplate": false,
                      "name": "Read-Only Analytics",
                      "revision": "1",
                      "sourceTemplateId": "2w1GaSoskt",
                      "spotMarketScope": "ALL",
                      "spotMarkets": [
                        {
                          "symbolId": 1
                        }
                      ],
                      "updatedAt": "2025-01-01T00:00:00Z"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.ListApiPoliciesResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "List API Key Policies",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.ListApiPoliciesRequest",
        "x-poly-response-type": "auth.v1.ListApiPoliciesResponse"
