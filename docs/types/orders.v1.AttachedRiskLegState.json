{
  "types": [
    {
      "name": "orders.v1.AttachedRiskLegState.Status",
      "kind": "enum",
      "doc": "Runtime lifecycle for an attached-risk trigger leg.",
      "enum": {
        "values": [
          {
            "name": "NOT_CONFIGURED",
            "number": 1,
            "doc": "No leg configured on the parent order."
          },
          {
            "name": "CREATED",
            "number": 2,
            "doc": "Trigger persisted, waiting for admission/arming."
          },
          {
            "name": "ARMED",
            "number": 3,
            "doc": "Trigger is actively armed."
          },
          {
            "name": "RUNNING",
            "number": 4,
            "doc": "Trigger is executing runtime work (for example multi-step workflows)."
          },
          {
            "name": "COMPLETED",
            "number": 5,
            "doc": "Trigger finished successfully."
          },
          {
            "name": "CANCELED",
            "number": 6,
            "doc": "Trigger was canceled."
          },
          {
            "name": "FAILED",
            "number": 7,
            "doc": "Trigger failed."
          },
          {
            "name": "PAUSED",
            "number": 8,
            "doc": "Trigger is paused."
          }
        ]
      }
    }
  ]
}
