                "createdAt": "2025-01-01T00:00:00Z",
                "displayName": "value",
                "earningsSubaccountId": "6789012345678",
                "linkPath": "value",
                "partnerId": "1",
                "program": {
                  "bridging": {
                    "commissionBps": 1,
                    "discountBps": 1
                  },
                  "normal": {
                    "commissionBps": 1,
                    "discountBps": 1
                  },
                  "stablecoin": {
                    "commissionBps": 1,
                    "discountBps": 1
                  }
                },
                "status": "PARTNER_PENDING"
              }
            }
          }
        },
