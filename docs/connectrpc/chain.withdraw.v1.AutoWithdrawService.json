                "reason": "value"
              },
              "ruleVersion": 1,
              "status": "WILL_PAY"
            }
          }
        },
        {
          "name": "SetAutoWithdrawRule",
          "path": "chain.withdraw.v1.AutoWithdrawService/SetAutoWithdrawRule",
          "requestType": "chain.withdraw.v1.SetAutoWithdrawRuleRequest",
          "responseType": "chain.withdraw.v1.SetAutoWithdrawRuleResponse",
          "summary": "Create the account's rule, or replace its latest version with a new",
          "doc": "Create the account's rule, or replace its latest version with a new\n one. Requires a session login with withdraw rights on the account and\n a fresh single-use step-up; every destination must be on the account's\n external withdraw whitelist.\n\n A refused destination answers a typed code whose ErrorDetail.field_path\n names the field, such as destinations[0].min_amount_e18:\n EXTERNAL_DESTINATION_NOT_WHITELISTED, DESTINATION_INVALID (not a valid\n address on its chain), ROUTE_UNSUPPORTED (no enabled withdrawal route\n pays the asset to that chain) or MIN_AMOUNT_BELOW_FLOOR (its\n ErrorDetail.min_floor_e18 is the floor). A stale expected_version\n answers VERSION_CONFLICT.",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "fresh_step_up",
          "stability": "stable",
          "errorProtoPkg": "chain.withdraw.v1",
          "errorCatalog": "withdraw-api:withdrawerrors",
          "examples": {
            "request": {
              "destinations": [
                {
                  "assetId": 100,
                  "destinationAddress": "0x3333333333333333333333333333333333333333",
                  "destinationChainId": "1",
                  "maxAmountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "minAmountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "minFloorE18": {
                    "hi": "1",
                    "lo": "1"
                  }
                }
