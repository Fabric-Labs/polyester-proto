            "title": "initial_snapshot"
          },
          "title": {
            "description": "Board title, max 200 characters and 400 bytes.\nstring.max_bytes = 400\n",
            "maxLength": 200,
            "minLength": 1,
            "title": "title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "audience",
          "defaultRole"
        ],
        "title": "CreateBoardRequest",
        "type": "object"
      },
      "collab.v1.CreateBoardResponse": {
        "additionalProperties": false,
