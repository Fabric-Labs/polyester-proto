          "summary": "CreateKey creates an API key. A broker has at most two working keys.",
          "doc": "CreateKey creates an API key. A broker has at most two working keys.\n Session token and step-up proof only.\n\n Errors:\n - NOT_FOUND: BROKER_NOT_FOUND.\n - PERMISSION_DENIED: ACTION_DENIED or STEP_UP_REQUIRED.\n - FAILED_PRECONDITION: KEY_LIMIT.",
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
