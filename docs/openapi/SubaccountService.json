{
  "components": {
    "schemas": {
      "auth.v1.CreateSubaccountRequest": {
        "additionalProperties": false,
        "description": "Request to create a new sub-account under the caller's root account.",
        "properties": {
          "color": {
            "description": "Optional user-chosen color token for UI display. Tokens use lowercase letters, numbers, underscores, or hyphens.",
            "maxLength": 32,
            "title": "color",
            "type": "string"
          },
          "icon": {
            "description": "Optional user-chosen icon/emoji for UI display.",
            "maxLength": 32,
            "title": "icon",
            "type": "string"
          },
          "label": {
            "description": "Optional human label for display in UI.\nlabel.no_angle_brackets // label must not contain '\u003c' or '\u003e'\n",
            "examples": [
              "Treasury"
            ],
            "maxLength": 64,
            "title": "label",
            "type": "string"
          },
          "nonce": {
            "description": "Auth challenge nonce returned by GetNonce for this smart account. This is\n not the smart-account derivation salt nonce.",
            "minLength": 1,
            "title": "nonce",
            "type": "string"
          },
          "primaryWalletAddress": {
            "description": "Optional primary wallet address supplied by the client. Sub-account ownership is proven by the Smart Account signature.",
            "examples": [
              "0x0000000000000000000000000000000000000000"
            ],
            "maxLength": 42,
            "minLength": 42,
            "nullable": true,
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "primary_wallet_address",
            "type": "string"
          },
          "signature": {
            "description": "Signature over the canonical login message containing the nonce.",
            "minLength": 1,
            "title": "signature",
            "type": "string"
          },
          "smartAccountAddress": {
            "description": "Smart Account EVM address for the new sub-account.",
            "examples": [
              "0x0000000000000000000000000000000000000000"
            ],
            "maxLength": 42,
            "minLength": 42,
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "smart_account_address",
            "type": "string"
          },
          "walletProvider": {
            "description": "Optional provider hint supplied by the client. Sub-account creation does not depend on this value.",
            "title": "wallet_provider",
            "type": "string"
          }
        },
        "required": [
          "smartAccountAddress",
          "nonce",
          "signature"
        ],
        "title": "CreateSubaccountRequest",
        "type": "object"
      },
      "auth.v1.CreateSubaccountResponse": {
        "additionalProperties": false,
        "description": "Response returned after creating a sub-account.",
        "properties": {
          "revision": {
            "description": "Initial monotonic resource revision. Clients can pass this value directly\n as expected_revision on the next revision-gated mutation.",
            "format": "int64",
            "title": "revision",
            "type": [
              "integer",
              "string"
            ]
          },
          "smartAccountSaltNonce": {
            "description": "Smart-account derivation salt nonce assigned to the created sub-account.\n Today this equals total_created for a successful create.",
            "title": "smart_account_salt_nonce",
            "type": "integer"
          },
          "subaccountId": {
            "description": "Identifier for the created sub-account (opaque ID).",
            "format": "int64",
            "title": "subaccount_id",
            "type": [
              "integer",
              "string"
            ]
          },
          "totalCreated": {
            "description": "Total number of sub-accounts that have ever been created for this root,\n including soft-deleted ones. Returned here so clients can immediately\n derive the next salt/index without requiring a fresh ListSubaccounts call.",
            "title": "total_created",
            "type": "integer"
          }
        },
        "title": "CreateSubaccountResponse",
        "type": "object"
      },
      "auth.v1.InviteSubaccountMemberResponse": {
        "additionalProperties": false,
        "description": "Response containing the created or refreshed invitation.",
        "properties": {
          "invite": {
            "$ref": "#/components/schemas/auth.v1.SubaccountInvite",
            "description": "Pending invitation.",
            "title": "invite"
          }
        },
        "title": "InviteSubaccountMemberResponse",
        "type": "object"
      },
      "auth.v1.ListSubaccountInvitesResponse": {
        "additionalProperties": false,
        "description": "Response containing sub-account invitations.",
        "properties": {
          "invites": {
            "description": "Invitations visible to the caller, ordered newest first. Owners and admins\n see all invitations for sub-accounts they administer, regardless of inviter.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.SubaccountInvite"
            },
            "title": "invites",
            "type": "array"
          }
        },
        "title": "ListSubaccountInvitesResponse",
        "type": "object"
      },
      "auth.v1.ListSubaccountMembersResponse": {
        "additionalProperties": false,
        "description": "Response containing the members of a sub-account.",
        "properties": {
          "members": {
            "description": "Members for the sub-account. The owner is first, followed by delegated members oldest first.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.SubaccountMemberView"
            },
            "title": "members",
            "type": "array"
          }
        },
        "title": "ListSubaccountMembersResponse",
        "type": "object"
      },
      "auth.v1.ListSubaccountsResponse": {
        "additionalProperties": false,
        "description": "Response containing sub-accounts visible to the caller.",
        "properties": {
          "subaccounts": {
            "description": "Sub-accounts owned by or shared with the caller, ordered by sub-account ID ascending.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.Subaccount"
            },
            "title": "subaccounts",
            "type": "array"
          },
          "totalCreated": {
            "description": "Total number of sub-accounts that have ever been created for this root,\n including soft-deleted ones. Clients use total_created + 1 only for the\n next new Smart Account; existing sub-accounts expose their assigned salt\n nonce on Subaccount when direct signing is available.",
            "title": "total_created",
            "type": "integer"
          }
        },
        "title": "ListSubaccountsResponse",
        "type": "object"
      },
      "auth.v1.RemoveSubaccountMemberResponse": {
        "additionalProperties": false,
        "description": "Empty response returned after removing a sub-account member.",
        "title": "RemoveSubaccountMemberResponse",
        "type": "object"
      },
      "auth.v1.RespondSubaccountInviteResponse": {
        "additionalProperties": false,
        "description": "Response containing the updated invitation.",
        "properties": {
          "invite": {
            "$ref": "#/components/schemas/auth.v1.SubaccountInvite",
            "description": "Invitation after applying the response action.",
            "title": "invite"
          }
        },
        "title": "RespondSubaccountInviteResponse",
        "type": "object"
      },
      "auth.v1.SetSubaccountMemberMFARequirementResponse": {
        "additionalProperties": false,
        "description": "Empty response returned after updating the delegated-member MFA requirement.",
        "title": "SetSubaccountMemberMFARequirementResponse",
        "type": "object"
      },
      "auth.v1.SubaccountInviteAction": {
        "description": "Action to take on a sub-account invitation.",
        "enum": [
          "UNSPECIFIED",
          "ACCEPT",
          "DECLINE",
          "CANCEL"
        ],
        "title": "SubaccountInviteAction",
        "type": "string"
      },
      "auth.v1.SubaccountInviteDirection": {
        "description": "Direction used to filter invitations relative to the caller.",
        "enum": [
          "DIRECTION_UNSPECIFIED",
          "INCOMING",
          "OUTGOING"
        ],
        "title": "SubaccountInviteDirection",
        "type": "string"
      },
      "auth.v1.SubaccountRole": {
        "description": "Role granted to a root account on a sub-account.",
        "enum": [
          "UNSPECIFIED",
          "VIEWER",
          "TRADER",
          "LEVERAGED_TRADER",
          "TREASURY",
          "ADMIN",
          "OWNER"
        ],
        "title": "SubaccountRole",
        "type": "string"
      },
      "auth.v1.UpdateSubaccountMemberRoleResponse": {
        "additionalProperties": false,
        "description": "Empty response returned after updating a member role.",
        "title": "UpdateSubaccountMemberRoleResponse",
        "type": "object"
      },
      "polyester.rest.enum.auth.v1.SubaccountStatus": {
        "enum": [
          "ACTIVE",
          "DISABLED"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "ACTIVE": "The sub-account can be used normally.",
          "DISABLED": "The sub-account is disabled and cannot be used until re-enabled."
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/subaccounts": {
      "get": {
        "description": "List sub-accounts owned by or shared with the caller, including role and label.",
        "operationId": "SubaccountService_ListSubaccounts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "subaccounts": [
                    {
                      "color": "#7C3AED",
                      "icon": "💰",
                      "id": "9eLaFXwP59",
                      "label": "Market Making",
                      "ownerAvatarUrl": "https://cdn.polyester.dev/avatars/trader-alpha.png",
                      "ownerRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                      "ownerUsername": "trader_alpha",
                      "requireMemberMfa": false,
                      "revision": "1",
                      "role": "VIEWER",
                      "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                      "smartAccountSaltNonce": 1,
                      "status": "ACTIVE",
                      "subaccountPolicyId": "627BigpnRg",
                      "updatedAt": "2025-01-01T00:00:00Z"
                    }
                  ],
                  "totalCreated": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.ListSubaccountsResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "List Subaccounts",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.ListSubaccountsRequest",
        "x-poly-response-type": "auth.v1.ListSubaccountsResponse"
      },
      "post": {
        "description": "Create a new sub-account under the caller's root account.",
        "operationId": "SubaccountService_CreateSubaccount",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "color": "#7C3AED",
                "icon": "💰",
                "label": "Market Making",
                "nonce": "example-nonce-12345",
                "primaryWalletAddress": "0x1111111111111111111111111111111111111111",
                "signature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
                "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                "walletProvider": "metamask"
              },
              "schema": {
                "$ref": "#/components/schemas/auth.v1.CreateSubaccountRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/auth.v1.CreateSubaccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "revision": "1",
                  "smartAccountSaltNonce": 1,
                  "subaccountId": "36u1pj4a2WL",
                  "totalCreated": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.CreateSubaccountResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Create Subaccount",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.CreateSubaccountRequest",
        "x-poly-response-type": "auth.v1.CreateSubaccountResponse"
      }
    },
    "/v1/auth/subaccounts/invites/{invite_id}:respond": {
      "post": {
        "description": "Accept or decline an invite as grantee, or cancel it as an authorized owner or admin. Acceptance requires an enrolled factor and a recently MFA-elevated session when the subaccount requires member MFA.",
        "operationId": "SubaccountService_RespondSubaccountInvite",
        "parameters": [
          {
            "description": "Invite identifier (opaque ID).",
            "example": "1",
            "in": "path",
            "name": "invite_id",
            "required": true,
            "schema": {
              "description": "Invite identifier (opaque ID).",
              "format": "int64",
              "title": "invite_id",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "action": "ACCEPT"
              },
              "schema": {
                "additionalProperties": false,
                "description": "Request to accept, decline, or cancel an invitation.",
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/auth.v1.SubaccountInviteAction",
                    "description": "Action to apply to the invitation.",
                    "not": {
                      "enum": [
                        0
                      ]
                    },
                    "title": "action"
                  }
                },
                "required": [
                  "action"
                ],
                "title": "RespondSubaccountInviteRequest",
                "type": "object"
              }
            },
            "application/proto": {
              "schema": {
                "additionalProperties": false,
                "description": "Request to accept, decline, or cancel an invitation.",
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/auth.v1.SubaccountInviteAction",
                    "description": "Action to apply to the invitation.",
                    "not": {
                      "enum": [
                        0
                      ]
                    },
                    "title": "action"
                  }
                },
                "required": [
                  "action"
                ],
                "title": "RespondSubaccountInviteRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "invite": {
                    "createdAt": "2025-01-01T00:00:00Z",
                    "granteeAccountId": "3J9Vz48X8Cs",
                    "granteeRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                    "granteeUsername": "trader_alpha",
                    "id": "4cU63p2qMQ",
                    "inviterAccountId": "3C1QrQLB2mg",
                    "inviterRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                    "inviterUsername": "trader_alpha",
                    "requireMemberMfa": false,
                    "respondedAt": "2025-01-01T00:00:00Z",
                    "role": "VIEWER",
                    "status": "PENDING",
                    "subaccountId": "35VhA2oEvkZ",
                    "subaccountLabel": "Market Making"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.RespondSubaccountInviteResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Respond Subaccount Invite",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "conditional",
        "x-poly-request-type": "auth.v1.RespondSubaccountInviteRequest",
        "x-poly-response-type": "auth.v1.RespondSubaccountInviteResponse"
      }
    },
    "/v1/auth/subaccounts/{subaccount_id}": {
      "patch": {
        "description": "Partially update subaccount metadata using If-Match revision control.",
        "operationId": "SubaccountService_UpdateSubaccount_REST",
        "parameters": [
          {
            "description": "Strong ETag revision returned by the latest read.",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "pattern": "^\"[1-9][0-9]*\"$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "subaccount_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "color": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "status": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/polyester.rest.enum.auth.v1.SubaccountStatus"
                      }
                    ]
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful patch",
            "headers": {
              "ETag": {
                "description": "Updated resource revision.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid patch"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Revision conflict"
          }
        },
        "summary": "Update Subaccount",
        "tags": [
          "Subaccounts"
        ],
        "x-poly-rest": true
      }
    },
    "/v1/auth/subaccounts/{subaccount_id}/invites": {
      "post": {
        "description": "Create a pending invitation to grant a role on a sub-account.",
        "operationId": "SubaccountService_InviteSubaccountMember",
        "parameters": [
          {
            "description": "Sub-account to share (opaque ID).",
            "example": "6789012345678",
            "in": "path",
            "name": "subaccount_id",
            "required": true,
            "schema": {
              "description": "Sub-account to share (opaque ID).",
              "exclusiveMinimum": 0,
              "format": "int64",
              "title": "subaccount_id",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "granteeAccountId": "7563897446546",
                "role": "VIEWER"
              },
              "schema": {
                "additionalProperties": false,
                "description": "Request to invite another root account to a sub-account.",
                "properties": {
                  "granteeAccountId": {
                    "description": "Root account ID of the grantee (opaque ID).",
                    "exclusiveMinimum": 0,
                    "format": "int64",
                    "title": "grantee_account_id",
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "role": {
                    "$ref": "#/components/schemas/auth.v1.SubaccountRole",
                    "description": "Role to grant if the invite is accepted.",
                    "not": {
                      "enum": [
                        0
                      ]
                    },
                    "title": "role"
                  }
                },
                "required": [
                  "role"
                ],
                "title": "InviteSubaccountMemberRequest",
                "type": "object"
              }
            },
            "application/proto": {
              "schema": {
                "additionalProperties": false,
                "description": "Request to invite another root account to a sub-account.",
                "properties": {
                  "granteeAccountId": {
                    "description": "Root account ID of the grantee (opaque ID).",
                    "exclusiveMinimum": 0,
                    "format": "int64",
                    "title": "grantee_account_id",
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "role": {
                    "$ref": "#/components/schemas/auth.v1.SubaccountRole",
                    "description": "Role to grant if the invite is accepted.",
                    "not": {
                      "enum": [
                        0
                      ]
                    },
                    "title": "role"
                  }
                },
                "required": [
                  "role"
                ],
                "title": "InviteSubaccountMemberRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "invite": {
                    "createdAt": "2025-01-01T00:00:00Z",
                    "granteeAccountId": "3J9Vz48X8Cs",
                    "granteeRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                    "granteeUsername": "trader_alpha",
                    "id": "4cU63p2qMQ",
                    "inviterAccountId": "3C1QrQLB2mg",
                    "inviterRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                    "inviterUsername": "trader_alpha",
                    "requireMemberMfa": false,
                    "respondedAt": "2025-01-01T00:00:00Z",
                    "role": "VIEWER",
                    "status": "PENDING",
                    "subaccountId": "35VhA2oEvkZ",
                    "subaccountLabel": "Market Making"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.InviteSubaccountMemberResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Invite Subaccount Member",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "fresh_step_up",
        "x-poly-request-type": "auth.v1.InviteSubaccountMemberRequest",
        "x-poly-response-type": "auth.v1.InviteSubaccountMemberResponse"
      }
    },
    "/v1/auth/subaccounts/{subaccount_id}/member-mfa": {
      "patch": {
        "description": "Enable or disable the owner-controlled MFA requirement for protected delegated-member actions.",
        "operationId": "SubaccountService_SetSubaccountMemberMFARequirement",
        "parameters": [
          {
            "description": "Sub-account whose delegated-member MFA requirement should be updated (opaque ID).",
            "example": "6789012345678",
            "in": "path",
            "name": "subaccount_id",
            "required": true,
            "schema": {
              "description": "Sub-account whose delegated-member MFA requirement should be updated (opaque ID).",
              "exclusiveMinimum": 0,
              "format": "int64",
              "title": "subaccount_id",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "requireMemberMfa": false
              },
              "schema": {
                "additionalProperties": false,
                "description": "Request to update the delegated-member MFA requirement for a sub-account.",
                "properties": {
                  "requireMemberMfa": {
                    "description": "When true, delegated interactive members must satisfy MFA requirements for\n protected sub-account actions. This does not apply to read-only real-time\n subscriptions.",
                    "title": "require_member_mfa",
                    "type": "boolean"
                  }
                },
                "title": "SetSubaccountMemberMFARequirementRequest",
                "type": "object"
              }
            },
            "application/proto": {
              "schema": {
                "additionalProperties": false,
                "description": "Request to update the delegated-member MFA requirement for a sub-account.",
                "properties": {
                  "requireMemberMfa": {
                    "description": "When true, delegated interactive members must satisfy MFA requirements for\n protected sub-account actions. This does not apply to read-only real-time\n subscriptions.",
                    "title": "require_member_mfa",
                    "type": "boolean"
                  }
                },
                "title": "SetSubaccountMemberMFARequirementRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {},
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.SetSubaccountMemberMFARequirementResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Set Subaccount Member MFA Requirement",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "conditional",
        "x-poly-request-type": "auth.v1.SetSubaccountMemberMFARequirementRequest",
        "x-poly-response-type": "auth.v1.SetSubaccountMemberMFARequirementResponse"
