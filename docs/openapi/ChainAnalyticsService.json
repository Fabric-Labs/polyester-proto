  "paths": {
    "/v1/chain/analytics/unified-asset-balances": {
      "get": {
        "description": "Get unified asset total balance chart columns.",
        "operationId": "ChainAnalyticsService_GetUnifiedAssetBalances",
        "parameters": [
          {
            "description": "Unified asset identifier.",
            "example": 100,
            "in": "query",
            "name": "assetId",
            "schema": {
              "description": "Unified asset identifier.",
              "exclusiveMinimum": 0,
              "title": "asset_id",
              "type": "integer"
            }
          },
          {
            "description": "Unified asset identifier.",
            "example": 100,
            "in": "query",
            "name": "asset_id",
            "required": true,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "Optional bucket duration. Valid buckets depend on range and must keep chart density useful.",
            "example": "1m",
            "in": "query",
            "name": "bucket",
            "required": false,
            "schema": {
              "enum": [
                "1m",
                "5m",
                "10m",
                "15m",
                "30m",
                "1h",
                "2h",
                "4h",
                "8h",
                "12h",
                "1d"
              ],
              "type": "string"
            }
          },
          {
            "description": "Optional inclusive end timestamp in seconds since Unix epoch.",
            "example": 1735689600,
            "in": "query",
            "name": "endTsSec",
            "schema": {
              "description": "Optional inclusive end timestamp in seconds since Unix epoch.",
              "exclusiveMinimum": 0,
              "title": "end_ts_sec",
              "type": "integer"
            }
          },
          {
            "description": "Optional inclusive end timestamp in seconds since Unix epoch.",
            "example": 1735689600,
            "in": "query",
            "name": "end_ts_sec",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "History window. Defaults to 1d.",
            "example": "DAY_1",
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "enum": [
                "1d",
                "7d",
                "30d",
                "90d",
                "180d",
                "365d"
              ],
              "type": "string"
            }
          },
          {
            "description": "Optional inclusive start timestamp in seconds since Unix epoch.",
            "example": 1735689600,
            "in": "query",
            "name": "startTsSec",
            "schema": {
              "description": "Optional inclusive start timestamp in seconds since Unix epoch.",
              "exclusiveMinimum": 0,
              "title": "start_ts_sec",
              "type": "integer"
            }
          },
          {
            "description": "Optional inclusive start timestamp in seconds since Unix epoch.",
            "example": 1735689600,
            "in": "query",
            "name": "start_ts_sec",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "assetId": 100,
                  "bucket": "1m",
                  "endTsSec": 1735689600,
                  "points": 1,
                  "range": "DAY_1",
                  "startTsSec": 1735689600,
                  "totalBalanceQ": "[1]"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.ChainAnalyticsService_GetUnifiedAssetBalances.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Unified Asset Balances",
        "tags": [
          "Chain Analytics"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.ChainAnalyticsService_GetUnifiedAssetBalances",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "chain.analytics.v1.GetUnifiedAssetBalancesRequest",
        "x-poly-response-type": "chain.analytics.v1.GetUnifiedAssetBalancesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
