      "polyester.rest.DustConversionService_ListDustBalances.Response": {
        "additionalProperties": false,
        "properties": {
          "balances": {
            "description": "Every nonzero available Trading balance, in asset id order.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "description": "The whole available Trading balance, as a decimal string in whole units of the asset: what no open order or other reservation holds.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "assetId": {
                  "description": "Canonical public unified asset id.",
                  "format": "int64",
                  "maximum": 4294967295,
                  "minimum": 0,
                  "type": "integer"
                },
                "eligibility": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/polyester.rest.enum.transfer.v1.DustAssetEligibility"
                    }
                  ],
                  "description": "Whether the balance converts, and why not otherwise."
                },
                "usdValue": {
                  "description": "The balance's USD value as a decimal string in whole USD, rounded down; absent when the asset has no current price.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                }
              },
              "required": [
                "amount",
                "assetId",
                "eligibility"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "feeBps": {
            "description": "The fee in basis points, taken from the payout.",
            "format": "int64",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "grossUsd": {
            "description": "The eligible balances' USD value before the fee, as a decimal string in whole USD.",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "type": "string"
          },
          "payout": {
            "description": "What converting the eligible balances would pay now, after the fee, as a decimal string in whole units of the target asset.",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "type": "string"
          },
          "targetAssetId": {
            "description": "Target asset id the balances were judged for.",
            "format": "int64",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "targetAvailable": {
            "description": "Whether the target can be paid now. When false, QuoteDustConversion is refused with DUST_TARGET_UNAVAILABLE.",
            "type": "boolean"
          },
          "targets": {
            "description": "Every asset id the account can convert dust into, in preference order.",
            "items": {
              "format": "int64",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "balances",
          "feeBps",
          "grossUsd",
          "payout",
          "targetAssetId",
          "targetAvailable",
          "targets"
        ],
        "type": "object"
      },
