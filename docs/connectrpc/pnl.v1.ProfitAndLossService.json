        {
          "name": "ListDailyProfitAndLoss",
          "path": "pnl.v1.ProfitAndLossService/ListDailyProfitAndLoss",
          "requestType": "pnl.v1.ListDailyProfitAndLossRequest",
          "responseType": "pnl.v1.ListDailyProfitAndLossResponse",
          "summary": "List Daily Profit and Loss",
          "doc": "List the account's PnL per UTC day, oldest first, with its equity at the\n day's start and end and its net external flows.\n\n Errors:\n - INVALID_ARGUMENT: the days, limit, page token or subaccount are invalid.\n - PERMISSION_DENIED, NOT_FOUND: the account cannot be read.\n - UNAVAILABLE: retry the same request.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "pnl.v1",
          "errorCatalog": "core:generic",
          "examples": {
