{
  "components": {
    "schemas": {
      "polyester.rest.InternalTransferService_CreateInternalTransfer.Request": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "description": "Transfer amount in canonical 18-decimal unified asset units. For example, 0.5 is encoded as 500000000000000000.",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "type": "string"
          },
          "assetId": {
            "description": "Canonical public unified asset id for the asset being transferred.",
            "format": "int32",
            "type": "integer"
          },
          "destinationAccountId": {
            "description": "Destination root account public id.",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "type": "string"
          },
          "destinationSmartAccountAddress": {
            "description": "Destination smart-account address.",
            "type": "string"
          },
          "destinationSubaccountId": {
            "description": "Destination subaccount public id.",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "type": "string"
          },
          "idempotencyKey": {
            "description": "Stable client-supplied idempotency key used to collapse safe retries.",
            "type": "string"
          },
          "subaccountId": {
            "description": "Optional source subaccount public id. When omitted, the authenticated caller's root account is used as the source account.",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "type": "string"
          }
        },
        "required": [
          "amount"
        ],
        "type": "object"
      },
      "polyester.rest.InternalTransferService_CreateInternalTransfer.Response": {
        "additionalProperties": false,
        "properties": {
          "acceptedAtTsNs": {
            "description": "Acceptance timestamp in nanoseconds since epoch (server time).",
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "amount": {
            "description": "Echoed transfer amount in canonical 18-decimal unified asset units.",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "type": "string"
          },
          "assetCode": {
            "description": "Resolved asset code for convenience.",
            "type": "string"
          },
          "assetId": {
            "description": "Echoed canonical public unified asset id.",
            "format": "int32",
            "type": "integer"
          },
          "destination": {
            "additionalProperties": false,
            "description": "Server-resolved destination summary.",
            "properties": {
              "rootAccountPublicId": {
                "description": "Destination root account public id.",
                "type": "string"
              },
              "smartAccountAddress": {
                "description": "Destination smart-account address resolved by the server.",
                "type": "string"
              },
              "subaccountPublicId": {
                "description": "Destination subaccount public id when the destination targets a subaccount.",
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          },
          "requestId": {
            "description": "Stable server-owned request identifier for this intake.",
            "type": "string"
          },
          "status": {
            "description": "Public status for the transfer request.",
            "enum": [
              "INTERNAL_TRANSFER_STATUS_ACCEPTED",
              "INTERNAL_TRANSFER_STATUS_REJECTED",
              "INTERNAL_TRANSFER_STATUS_FAILED"
            ],
            "type": "string"
          },
          "transferId": {
            "description": "Stable transfer identifier for the settled internal transfer.",
            "type": "string"
          },
          "uAssetId": {
            "description": "Resolved unified asset id used by downstream settlement.",
            "type": "string"
          }
        },
        "required": [
          "acceptedAtTsNs",
          "amount",
          "status"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/trading/internal-transfers": {
      "post": {
        "description": "Create or return one authenticated Trading to Trading internal transfer.",
        "operationId": "InternalTransferService_CreateInternalTransfer",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "amount": {
                  "hi": "1",
                  "lo": "1"
                },
                "assetId": 100,
                "destinationAccountId": "4Rh4iXdT",
                "destinationSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                "destinationSubaccountId": "45LUmqjT",
                "idempotencyKey": "a",
                "subaccountId": "45LUmqjT"
              },
              "schema": {
                "$ref": "#/components/schemas/polyester.rest.InternalTransferService_CreateInternalTransfer.Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "acceptedAtTsNs": "1735689600000000000",
                  "amount": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetCode": "value",
                  "assetId": 100,
                  "destination": {
                    "rootAccountPublicId": "value",
                    "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                    "subaccountPublicId": "value"
                  },
                  "requestId": "value",
                  "status": "accepted",
                  "transferId": "value",
                  "uAssetId": "100"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.InternalTransferService_CreateInternalTransfer.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Create Internal Transfer",
        "tags": [
          "Internal Transfers"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.InternalTransferService_CreateInternalTransfer",
        "x-poly-request-type": "transfer.v1.CreateInternalTransferRequest",
        "x-poly-response-type": "transfer.v1.CreateInternalTransferResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
