{
  "components": {
    "schemas": {
      "chain.guard.v1.BatchSignProtectedActionsRequest": {
        "additionalProperties": false,
        "description": "BatchSignProtectedActionsRequest requests ordered approvals for one batched\n SmartAccount transaction. The server reads the first nonce from chain and\n assigns subsequent nonces by incrementing locally within this response.",
        "properties": {
          "actions": {
            "description": "Ordered protected actions to sign, max 20 items.",
            "items": {
              "$ref": "#/components/schemas/chain.guard.v1.BatchSignProtectedActionItem"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "actions",
            "type": "array"
          },
          "subaccountId": {
            "description": "Optional subaccount public id. When omitted, the authenticated caller's\n root account is used as the target account.",
            "exclusiveMinimum": 0,
            "format": "int64",
            "title": "subaccount_id",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "title": "BatchSignProtectedActionsRequest",
        "type": "object"
      },
      "chain.guard.v1.BatchSignProtectedActionsResponse": {
        "additionalProperties": false,
        "description": "BatchSignProtectedActionsResponse returns approvals in the same order as the\n requested actions. Clients must submit them with the matching batched calls.",
        "properties": {
          "approvals": {
            "description": "Approval signatures in the same order as the requested actions.",
            "items": {
              "$ref": "#/components/schemas/chain.guard.v1.GuardApproval"
            },
            "title": "approvals",
            "type": "array"
          }
        },
        "title": "BatchSignProtectedActionsResponse",
        "type": "object"
      },
      "chain.guard.v1.CreateGuardSignerWalletRequest": {
        "additionalProperties": false,
        "description": "CreateGuardSignerWalletRequest creates a guard signer wallet for the selected\n account target.",
        "properties": {
          "subaccountId": {
            "description": "Optional subaccount public id. When omitted, the authenticated caller's\n root account is used as the target account.",
            "exclusiveMinimum": 0,
            "format": "int64",
            "title": "subaccount_id",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "title": "CreateGuardSignerWalletRequest",
        "type": "object"
      },
      "chain.guard.v1.CreateGuardSignerWalletResponse": {
        "additionalProperties": false,
        "description": "CreateGuardSignerWalletResponse returns the generated signer address.",
        "properties": {
          "signerAddress": {
            "description": "EVM address of the created guard signer wallet.",
            "maxLength": 42,
            "minLength": 42,
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "signer_address",
            "type": "string"
          }
        },
        "title": "CreateGuardSignerWalletResponse",
        "type": "object"
      },
      "chain.guard.v1.ExportGuardSignerWalletRequest": {
        "additionalProperties": false,
        "description": "ExportGuardSignerWalletRequest exports guard signer key material for an\n explicitly authorized account target. This is a high-risk sovereignty flow.",
        "properties": {
          "subaccountId": {
            "description": "Optional subaccount public id. When omitted, the authenticated caller's\n root account is used as the target account.",
            "exclusiveMinimum": 0,
            "format": "int64",
            "title": "subaccount_id",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "title": "ExportGuardSignerWalletRequest",
        "type": "object"
      },
      "chain.guard.v1.ExportGuardSignerWalletResponse": {
        "additionalProperties": false,
        "description": "ExportGuardSignerWalletResponse returns the authorized high-risk wallet export.",
        "properties": {
          "privateKey": {
            "description": "Hex-encoded private key returned only after export authorization succeeds.",
            "maxLength": 66,
            "minLength": 66,
            "pattern": "^0x[0-9a-fA-F]{64}$",
            "title": "private_key",
            "type": "string"
          }
        },
        "title": "ExportGuardSignerWalletResponse",
        "type": "object"
      },
      "chain.guard.v1.GetGuardSignerStatusResponse": {
        "additionalProperties": false,
        "description": "GetGuardSignerStatusResponse returns stored and on-chain signer state.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/chain.guard.v1.GuardSignerStatus",
            "description": "Stored and live guard signer status for the selected account target.",
            "title": "status"
          }
        },
        "title": "GetGuardSignerStatusResponse",
        "type": "object"
      },
      "chain.guard.v1.RotateGuardSignerWalletRequest": {
        "additionalProperties": false,
        "description": "RotateGuardSignerWalletRequest asks the backend to generate a replacement\n guard signer wallet and sign the on-chain rotation approval.",
        "properties": {
          "subaccountId": {
            "description": "Optional subaccount public id. When omitted, the authenticated caller's\n root account is used as the target account.",
            "exclusiveMinimum": 0,
            "format": "int64",
            "title": "subaccount_id",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "title": "RotateGuardSignerWalletRequest",
        "type": "object"
      },
      "chain.guard.v1.RotateGuardSignerWalletResponse": {
        "additionalProperties": false,
        "description": "RotateGuardSignerWalletResponse returns the backend-generated replacement\n signer and the approval needed to submit signer rotation on-chain.",
        "properties": {
          "approval": {
            "$ref": "#/components/schemas/chain.guard.v1.GuardApproval",
            "description": "Approval signature payload needed to submit the signer rotation.",
            "title": "approval"
          },
          "newSignerAddress": {
            "description": "EVM address of the replacement guard signer wallet.",
            "maxLength": 42,
            "minLength": 42,
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "new_signer_address",
            "type": "string"
          }
        },
        "title": "RotateGuardSignerWalletResponse",
        "type": "object"
      },
      "chain.guard.v1.SignProtectedActionRequest": {
        "additionalProperties": false,
        "description": "SignProtectedActionRequest requests an approval for a supported FundingAccount\n protected action.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/chain.guard.v1.ProtectedAction",
            "description": "Protected action to approve.",
            "not": {
              "enum": [
                0
              ]
            },
            "title": "action"
          },
          "args": {
            "$ref": "#/components/schemas/chain.guard.v1.ProtectedActionArgs",
            "description": "Business arguments for the selected protected action.",
            "title": "args"
          },
          "subaccountId": {
            "description": "Optional subaccount public id. When omitted, the authenticated caller's\n root account is used as the target account.",
            "exclusiveMinimum": 0,
            "format": "int64",
            "title": "subaccount_id",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "title": "SignProtectedActionRequest",
        "type": "object"
      },
      "chain.guard.v1.SignProtectedActionResponse": {
        "additionalProperties": false,
        "description": "SignProtectedActionResponse returns the contract submission approval.",
        "properties": {
          "approval": {
            "$ref": "#/components/schemas/chain.guard.v1.GuardApproval",
            "description": "Approval signature payload for the requested protected action.",
            "title": "approval"
          }
        },
        "title": "SignProtectedActionResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/chain/guard-signer/approvals": {
      "post": {
        "description": "Create an approval signature for a supported protected action.",
        "operationId": "GuardSignerService_SignProtectedAction",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "action": "PROTECTED_ACTION_FUNDING_SET_EXTERNAL_WHITELIST_REQUIRED",
                "args": {
                  "externalWhitelist": {
                    "addresses": [
                      "value"
                    ],
                    "polychainChainId": 1
                  },
                  "internalWhitelist": {
                    "addresses": [
                      "value"
                    ]
                  },
                  "whitelistRequirement": {
                    "required": false
                  }
                },
                "subaccountId": "6789012345678"
              },
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.SignProtectedActionRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.SignProtectedActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "approval": {
                    "deadlineUnix": "1",
                    "nonceSpace": "example-nonce-12345",
                    "signature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.guard.v1.SignProtectedActionResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Sign Protected Action",
        "tags": [
          "Guard Signer"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.guard.v1",
        "x-poly-request-type": "chain.guard.v1.SignProtectedActionRequest",
        "x-poly-response-type": "chain.guard.v1.SignProtectedActionResponse"
      }
    },
    "/v1/chain/guard-signer/approvals:batch": {
      "post": {
        "description": "Create ordered approval signatures for a batched SmartAccount protected action submission.",
        "operationId": "GuardSignerService_BatchSignProtectedActions",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "actions": [
                  {
                    "action": "PROTECTED_ACTION_FUNDING_SET_EXTERNAL_WHITELIST_REQUIRED",
                    "args": {
                      "externalWhitelist": {
                        "addresses": [
                          "value"
                        ],
                        "polychainChainId": 1
                      },
                      "internalWhitelist": {
                        "addresses": [
                          "value"
                        ]
                      },
                      "whitelistRequirement": {
                        "required": false
                      }
                    }
                  }
                ],
                "subaccountId": "6789012345678"
              },
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.BatchSignProtectedActionsRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.BatchSignProtectedActionsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "approvals": [
                    {
                      "deadlineUnix": "1",
                      "nonceSpace": "example-nonce-12345",
                      "signature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.guard.v1.BatchSignProtectedActionsResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Batch Sign Protected Actions",
        "tags": [
          "Guard Signer"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.guard.v1",
        "x-poly-request-type": "chain.guard.v1.BatchSignProtectedActionsRequest",
        "x-poly-response-type": "chain.guard.v1.BatchSignProtectedActionsResponse"
      }
    },
    "/v1/chain/guard-signer/status": {
      "get": {
        "description": "Return stored and live guard signer status.",
        "operationId": "GuardSignerService_GetGuardSignerStatus",
        "parameters": [
          {
            "description": "Optional subaccount public id. When omitted, the authenticated caller's\n root account is used as the target account.",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccountId",
            "schema": {
              "description": "Optional subaccount public id. When omitted, the authenticated caller's\n root account is used as the target account.",
              "exclusiveMinimum": 0,
              "format": "int64",
              "title": "subaccount_id",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": "accepted"
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.guard.v1.GetGuardSignerStatusResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Get Guard Signer Status",
        "tags": [
          "Guard Signer"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.guard.v1",
        "x-poly-request-type": "chain.guard.v1.GetGuardSignerStatusRequest",
        "x-poly-response-type": "chain.guard.v1.GetGuardSignerStatusResponse"
      }
    },
    "/v1/chain/guard-signer/wallets": {
      "post": {
        "description": "Create a guard signer wallet for one authenticated account target.",
        "operationId": "GuardSignerService_CreateGuardSignerWallet",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "subaccountId": "6789012345678"
              },
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.CreateGuardSignerWalletRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.CreateGuardSignerWalletRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "signerAddress": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.guard.v1.CreateGuardSignerWalletResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Create Guard Signer Wallet",
        "tags": [
          "Guard Signer"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.guard.v1",
        "x-poly-request-type": "chain.guard.v1.CreateGuardSignerWalletRequest",
        "x-poly-response-type": "chain.guard.v1.CreateGuardSignerWalletResponse"
      }
    },
    "/v1/chain/guard-signer/wallets:export": {
      "post": {
        "description": "Export guard signer key material after owner authorization and fresh step-up.",
        "operationId": "GuardSignerService_ExportGuardSignerWallet",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "subaccountId": "6789012345678"
              },
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.ExportGuardSignerWalletRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.ExportGuardSignerWalletRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "privateKey": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.guard.v1.ExportGuardSignerWalletResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Export Guard Signer Wallet",
        "tags": [
          "Guard Signer"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.guard.v1",
        "x-poly-request-type": "chain.guard.v1.ExportGuardSignerWalletRequest",
        "x-poly-response-type": "chain.guard.v1.ExportGuardSignerWalletResponse"
      }
    },
    "/v1/chain/guard-signer/wallets:rotate": {
      "post": {
        "description": "Generate a backend-managed replacement signer and return the rotateSigner approval.",
        "operationId": "GuardSignerService_RotateGuardSignerWallet",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "subaccountId": "6789012345678"
              },
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.RotateGuardSignerWalletRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/chain.guard.v1.RotateGuardSignerWalletRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "approval": {
                    "deadlineUnix": "1",
                    "nonceSpace": "example-nonce-12345",
                    "signature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
                  },
                  "newSignerAddress": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                },
                "schema": {
                  "$ref": "#/components/schemas/chain.guard.v1.RotateGuardSignerWalletResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Rotate Guard Signer Wallet",
        "tags": [
          "Guard Signer"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "chain.guard.v1",
        "x-poly-request-type": "chain.guard.v1.RotateGuardSignerWalletRequest",
        "x-poly-response-type": "chain.guard.v1.RotateGuardSignerWalletResponse"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
