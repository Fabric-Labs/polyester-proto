        {
          "name": "PreviewAutoWithdrawRun",
          "path": "chain.withdraw.v1.AutoWithdrawService/PreviewAutoWithdrawRun",
          "requestType": "chain.withdraw.v1.PreviewAutoWithdrawRunRequest",
          "responseType": "chain.withdraw.v1.PreviewAutoWithdrawRunResponse",
          "summary": "Preview the account's next auto-withdraw run from its balances now:",
          "doc": "Preview the account's next auto-withdraw run from its balances now:\n when it starts, whether it would pay, and per asset what it would pay,\n what would stay and why, its USD value and the expected network fee. It\n plans exactly as the run does; balances, prices and fees can change\n before the run starts. A price that is not current leaves the value\n unset instead of failing the read. When prices cannot be read at all,\n the values stay unset too, unless the rule has a USD minimum: prices\n then decide what pays, so the read answers UNAVAILABLE and can be\n retried.\n\n An API key needs READ_AUTO_WITHDRAW in its policy and reads only its own\n account. Both refusals answer PERMISSION_DENIED: a key whose policy lacks\n the action gets \"api key policy does not allow READ_AUTO_WITHDRAW\", and a\n key that names an account other than its own, such as a root-account key\n naming a subaccount, gets \"api key target scope mismatch\".",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "chain.withdraw.v1",
          "errorCatalog": "withdraw-api:withdrawerrors",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "assets": [
                {
                  "assetId": 100,
                  "availableE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "destinationAddress": "0x3333333333333333333333333333333333333333",
                  "destinationChainId": "1",
                  "heldBackE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "holdReason": "value",
