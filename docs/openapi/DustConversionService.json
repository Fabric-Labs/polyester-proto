    "securitySchemes": {
      "ApiKeyIdAuth": {
        "description": "ID of the API key that signs the request. An API-key request sends it with X-API-TIMESTAMP and X-API-SIGNATURE.",
        "in": "header",
        "name": "X-API-KEY-ID",
        "type": "apiKey"
      },
      "ApiKeySignatureAuth": {
        "description": "Ed25519 signature of the request, made with the API key's private key and encoded as hex or base64. An API-key request sends it with X-API-KEY-ID and X-API-TIMESTAMP.",
        "in": "header",
        "name": "X-API-SIGNATURE",
        "type": "apiKey"
      },
      "ApiKeyTimestampAuth": {
        "description": "Time the request was signed, in Unix milliseconds. An API-key request sends it with X-API-KEY-ID and X-API-SIGNATURE.",
        "in": "header",
        "name": "X-API-TIMESTAMP",
        "type": "apiKey"
      },
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "BrokerApiKeyAuth": {
        "description": "Broker API key, sent as a bearer token and accepted only by the QuickSwap broker API. The broker API key is a server credential. Call this API from the broker's backend, never from a browser or mobile app. The broker's members create, rotate and revoke keys through the QuickSwap broker API, and a key may rotate itself.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/trading/dust/balances": {
      "get": {
        "description": "List the account's available Trading balances with their eligibility for dust conversion and the payout the eligible ones would bring into a target now. Reserves nothing.",
        "operationId": "DustConversionService_ListDustBalances",
        "parameters": [
          {
            "description": "Public subaccount ID; omit for the caller's root account.\n\nPublic ID, as a base58 string.",
            "in": "query",
            "name": "subaccountId",
            "required": false,
            "schema": {
              "example": "45LUmqjT",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          },
          {
            "description": "Target asset ID; omit or 0 for the first target.",
            "in": "query",
            "name": "targetAssetId",
            "required": false,
            "schema": {
              "example": 100,
              "format": "int64",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "balances": [
                    {
                      "amount": "18.446744073709551617",
                      "assetId": 100,
                      "eligibility": "ELIGIBLE",
                      "usdValue": "18.446744073709551617"
                    }
                  ],
                  "feeBps": 1,
                  "grossUsd": "18.446744073709551617",
                  "payout": "18.446744073709551617",
                  "targetAssetId": 100,
                  "targetAvailable": false,
                  "targets": [
                    1
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.DustConversionService_ListDustBalances.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyIdAuth": [],
            "ApiKeySignatureAuth": [],
            "ApiKeyTimestampAuth": []
          }
        ],
        "summary": "List Dust Balances",
        "tags": [
          "Dust Conversion"
        ],
        "x-poly-authentication-methods": [
          "session_token",
          "api_key"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.DustConversionService_ListDustBalances",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "transfer.v1.ListDustBalancesRequest",
        "x-poly-response-type": "transfer.v1.ListDustBalancesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
