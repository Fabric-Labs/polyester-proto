{
  "types": [
    {
      "name": "transfer.v1.CreateInternalTransferRequest",
      "kind": "message",
      "doc": "CreateInternalTransferRequest creates or returns one accepted Trading\n to Trading internal transfer for the authenticated source account.",
      "message": {
        "oneofs": [
          {
            "name": "destination",
            "required": true,
            "fields": [
              "destination_account_id",
              "destination_subaccount_id",
              "destination_smart_account_address"
            ]
          }
        ],
        "fields": [
          {
            "name": "subaccount_id",
            "jsonName": "subaccountId",
            "number": 1,
            "doc": "Optional source subaccount public id. When omitted, the authenticated\n caller's root account is used as the source account.",
            "protoScalar": "fixed64",
            "jsonType": "string",
            "format": "fixed64",
            "validate": {
              "number": {
                "gt": "0"
              }
            }
          },
          {
            "name": "destination_account_id",
            "jsonName": "destinationAccountId",
            "number": 2,
            "doc": "Destination root account public id.",
            "protoScalar": "fixed64",
            "jsonType": "string",
            "format": "fixed64",
            "validate": {
              "number": {
                "gt": "0"
              }
            },
            "oneof": "destination"
          },
          {
            "name": "destination_subaccount_id",
            "jsonName": "destinationSubaccountId",
            "number": 3,
            "doc": "Destination subaccount public id.",
            "protoScalar": "fixed64",
            "jsonType": "string",
            "format": "fixed64",
            "validate": {
              "number": {
                "gt": "0"
              }
            },
            "oneof": "destination"
          },
          {
            "name": "destination_smart_account_address",
            "jsonName": "destinationSmartAccountAddress",
            "number": 4,
            "doc": "Destination smart-account address.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "minLen": 1,
                "maxLen": 128
              }
            },
            "oneof": "destination"
          },
          {
            "name": "asset_id",
            "jsonName": "assetId",
            "number": 5,
            "doc": "Canonical public unified asset id for the asset being transferred.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32",
            "validate": {
              "number": {
                "gt": "0"
              }
            }
          },
          {
            "name": "qty_scaled",
            "jsonName": "qtyScaled",
            "number": 6,
            "doc": "Quantity scaled by the unified asset's quantity_scale from SpotConfig for\n asset_id.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64",
            "validate": {
              "number": {
                "gt": "0"
              }
            }
          },
          {
            "name": "idempotency_key",
            "jsonName": "idempotencyKey",
            "number": 7,
            "doc": "Stable client-supplied idempotency key used to collapse safe retries.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "minLen": 1,
                "maxLen": 128
              }
            }
          }
        ]
      }
    },
    {
      "name": "transfer.v1.CreateInternalTransferResponse",
      "kind": "message",
      "doc": "CreateInternalTransferResponse returns the accepted request and transfer\n identifiers for later correlation.",
      "message": {
        "fields": [
          {
            "name": "request_id",
            "jsonName": "requestId",
            "number": 1,
            "doc": "Stable server-owned request identifier for this intake.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "transfer_id",
            "jsonName": "transferId",
            "number": 2,
            "doc": "Stable transfer identifier for the settled internal transfer.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "accepted_at_ts_ns",
            "jsonName": "acceptedAtTsNs",
            "number": 3,
            "doc": "Acceptance timestamp in nanoseconds since epoch (server time).",
            "protoScalar": "uint64",
            "jsonType": "string",
            "format": "uint64"
          },
          {
            "name": "asset_id",
            "jsonName": "assetId",
            "number": 4,
            "doc": "Echoed canonical public unified asset id.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "asset_code",
            "jsonName": "assetCode",
            "number": 5,
            "doc": "Resolved asset code for convenience.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "u_asset_id",
            "jsonName": "uAssetId",
            "number": 6,
            "doc": "Resolved unified asset id used by downstream settlement.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "qty_scaled",
            "jsonName": "qtyScaled",
            "number": 7,
            "doc": "Echoed transfer quantity scaled by the unified asset's quantity_scale from\n SpotConfig for asset_id.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "destination",
            "jsonName": "destination",
            "number": 8,
            "doc": "Server-resolved destination summary.",
            "protoRef": "transfer.v1.ResolvedDestination"
          },
          {
            "name": "status",
            "jsonName": "status",
            "number": 9,
            "doc": "Public status for the transfer request.",
            "protoRef": "transfer.v1.InternalTransferStatus"
          }
        ]
      }
    },
    {
      "name": "transfer.v1.InternalTransferStatus",
      "kind": "enum",
      "doc": "InternalTransferStatus is the public user-facing status for an internal\n transfer request.",
      "enum": {
        "values": [
          {
            "name": "INTERNAL_TRANSFER_STATUS_ACCEPTED",
            "number": 1,
            "doc": "The transfer request was accepted and has a durable transfer identifier."
          },
          {
            "name": "INTERNAL_TRANSFER_STATUS_REJECTED",
            "number": 2,
            "doc": "The transfer request was rejected before durable acceptance."
          },
          {
            "name": "INTERNAL_TRANSFER_STATUS_FAILED",
            "number": 3,
            "doc": "The transfer request failed terminally before durable acceptance."
          }
        ]
      }
    },
    {
      "name": "transfer.v1.ResolvedDestination",
      "kind": "message",
      "doc": "ResolvedDestination describes the normalized transfer destination selected by\n the server after public-id / smart-account resolution.",
      "message": {
        "fields": [
          {
            "name": "root_account_public_id",
            "jsonName": "rootAccountPublicId",
            "number": 1,
            "doc": "Destination root account public id.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "subaccount_public_id",
            "jsonName": "subaccountPublicId",
            "number": 2,
            "doc": "Destination subaccount public id when the destination targets a subaccount.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "smart_account_address",
            "jsonName": "smartAccountAddress",
            "number": 3,
            "doc": "Destination smart-account address resolved by the server.",
            "protoScalar": "string",
            "jsonType": "string"
          }
        ]
      }
    }
  ]
}
