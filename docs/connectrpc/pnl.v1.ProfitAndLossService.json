{
  "services": [
    {
      "name": "pnl.v1.ProfitAndLossService",
      "doc": "ProfitAndLossService reports the profit and loss of the main account or one\n subaccount, in USD. Spot PnL uses the weighted average cost of each asset:\n buying raises the cost of the holding, selling realizes the proceeds minus\n the average cost of what was sold, and every fee is a realized expense.\n Every trade is valued with the USD price at its execution time. Deposits,\n withdrawals and transfers are never PnL: deposited coins have no known\n cost, and a transfer between the main account and its subaccounts carries\n its cost along.\n\n Figures follow settled trades and transfers within seconds; as_of says when\n they were last published. Every read needs the READ_PNL action, which every subaccount role and\n every subaccount's read floor include; an API key needs it in its policy.",
      "methods": [
        {
          "name": "GetProfitAndLoss",
          "path": "pnl.v1.ProfitAndLossService/GetProfitAndLoss",
          "requestType": "pnl.v1.GetProfitAndLossRequest",
          "responseType": "pnl.v1.GetProfitAndLossResponse",
          "summary": "Get Profit and Loss",
          "doc": "Get the account's PnL over a period, by product and market, and its\n current holdings with their entry price and unrealized PnL.\n\n Errors:\n - INVALID_ARGUMENT: the window or subaccount is invalid.\n - PERMISSION_DENIED, NOT_FOUND: the account cannot be read.\n - UNAVAILABLE: retry the same request.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "pnl.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "product": "PROFIT_AND_LOSS_PRODUCT_SPOT",
              "subaccountId": "6789012345678",
              "symbolId": 1,
              "window": "PROFIT_AND_LOSS_WINDOW_TODAY"
            },
            "response": {
              "asOf": "2025-01-01T00:00:00Z",
              "feesUsd": "value",
              "holdings": [
                {
                  "assetId": 100,
                  "costUsd": "value",
                  "entryPriceUsd": "61000.25",
                  "markPriceUsd": "61000.25",
                  "positionQuantity": "100000",
                  "unrealizedPnlUsd": "value",
                  "untrackedQuantity": "100000"
                }
              ],
              "markTime": "2025-01-01T00:00:00Z",
              "markets": [
                {
                  "feesUsd": "value",
                  "product": "PROFIT_AND_LOSS_PRODUCT_SPOT",
                  "realizedPnlUsd": "value",
                  "symbolId": 1,
                  "tradeCount": "1",
                  "volumeUsd": "12.3456"
                }
              ],
              "notices": [
                "PROFIT_AND_LOSS_NOTICE_PRICE_UNAVAILABLE"
              ],
              "pnlUsd": "value",
              "products": [
                {
                  "feesUsd": "value",
                  "product": "PROFIT_AND_LOSS_PRODUCT_SPOT",
                  "realizedPnlUsd": "value",
                  "volumeUsd": "12.3456"
                }
              ],
              "realizedPnlUsd": "value",
