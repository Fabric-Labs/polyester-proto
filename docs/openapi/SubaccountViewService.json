    "/v1/auth/subaccounts/{subaccount_id}/events": {
      "get": {
        "description": "List audit and activity events for a sub-account, newest first.",
        "operationId": "SubaccountViewService_ListSubaccountActivity",
        "parameters": [
          {
            "description": "Target sub-account (opaque ID).",
            "example": "6789012345678",
            "in": "path",
            "name": "subaccount_id",
            "required": true,
            "schema": {
              "description": "Target sub-account (opaque ID).",
              "exclusiveMinimum": 0,
              "format": "int64",
              "title": "subaccount_id",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "description": "Maximum number of events to return. Defaults to 50 when omitted; maximum is\n 200.",
            "example": 100,
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum number of events to return. Defaults to 50 when omitted; maximum is\n 200.",
              "maximum": 200,
              "title": "limit",
              "type": "integer"
            }
          },
          {
            "description": "Opaque keyset cursor from a previous response. The cursor is exclusive and\n bound to the authenticated account and requested sub-account.",
            "example": "value",
            "in": "query",
            "name": "pageToken",
            "schema": {
              "description": "Opaque keyset cursor from a previous response. The cursor is exclusive and\n bound to the authenticated account and requested sub-account.",
              "maxLength": 512,
              "title": "page_token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "events": [
                    {
                      "actorAccountId": "3CT33BAbxNG",
                      "createdAt": "2025-01-01T00:00:00Z",
                      "entityKind": "value",
                      "eventAction": "value",
                      "ip": "value",
                      "payloadJson": "value",
                      "source": "value",
                      "userAgent": "value"
                    }
                  ],
                  "nextPageToken": "value"
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.ListSubaccountEventsResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "List Subaccount Activity",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-request-type": "auth.v1.ListSubaccountEventsRequest",
        "x-poly-response-type": "auth.v1.ListSubaccountEventsResponse"
      }
    }
