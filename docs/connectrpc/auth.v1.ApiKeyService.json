        {
          "name": "SetAssistantKeys",
          "path": "auth.v1.ApiKeyService/SetAssistantKeys",
          "requestType": "auth.v1.SetAssistantKeysRequest",
          "responseType": "auth.v1.SetAssistantKeysResponse",
          "summary": "Set Assistant Keys",
          "doc": "Create or replace the caller's Polyester AI assistant key set: one\n ASSISTANT key per enabled account, each bounded by its API policy or by a\n permission preset. One step-up covers the whole set, including the\n policies its presets create, and the change is all or nothing. An\n MFA-elevated session (one that completed an MFA challenge in the last 30\n minutes) needs no proof; any other session sends a fresh step-up proof in\n the X-Auth-Step-Up header, which the change consumes. Without either,\n PermissionDenied with AUTH_STEP_UP_REQUIRED. An entry whose account\n already has an assistant key with the same\n public key keeps that key, with its status, and takes the requested\n policy; any other entry replaces the account's key. Accounts left out of\n the set have their assistant key revoked. A sub-account entry needs the\n same access as CreateApiKey: owner, or a role that manages its API keys.\n The acting caller's root account must have accepted the current terms;\n otherwise FailedPrecondition with AUTH_TERMS_NOT_ACCEPTED is returned. A\n policy that allows a money-out action returns FailedPrecondition with\n AUTH_ASSISTANT_KEY_ACTION_NOT_ALLOWED. A new key is registered only with\n the registration proof and deadline the assistant issued with it\n (PrepareAssistantKeys), before that deadline: a missing or failing proof\n returns InvalidArgument with AUTH_ASSISTANT_KEY_PROOF_INVALID, a passed\n deadline FailedPrecondition with AUTH_ASSISTANT_KEY_REGISTRATION_EXPIRED,\n and one more than 15 minutes ahead InvalidArgument with\n AUTH_ASSISTANT_KEY_DEADLINE_TOO_FAR.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "recent_mfa",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "keys": [
                {
                  "preset": "READ_ONLY",
                  "publicKeyEd25519": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
                  "registrationDeadline": "2025-01-01T00:00:00Z",
                  "registrationProof": "AA==",
                  "subaccountId": "6789012345678"
                }
              ]
            },
            "response": {
              "apiKeys": [
                {
                  "color": "#7C3AED",
                  "createdAt": "2025-01-01T00:00:00Z",
                  "createdByActor": "dashboard",
                  "expiresAt": "2025-01-01T00:00:00Z",
                  "icon": "💰",
                  "ipWhitelist": [
                    "203.0.113.0/24"
                  ],
                  "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542",
                  "label": "Trading Bot",
                  "lastUsedAt": "2025-01-01T00:00:00Z",
                  "policyId": "2779655768052592500",
                  "publicKeyEd25519": "AA==",
                  "purpose": "STANDARD",
                  "revision": "1",
                  "status": "ACTIVE",
                  "strategyBotId": "4237083536359433371",
                  "subaccountId": "6789012345678",
                  "updatedAt": "2025-01-01T00:00:00Z"
                }
              ]
            }
          }
        },
        {
          "name": "UpdateApiKey",
          "path": "auth.v1.ApiKeyService/UpdateApiKey",
          "requestType": "auth.v1.UpdateApiKeyRequest",
          "responseType": "auth.v1.UpdateApiKeyResponse",
          "summary": "Update API Key",
          "doc": "Update API key metadata and allowed status transitions. Revocation must use\n DeleteApiKey. Promoting a key to an admin key, demoting one, and any change\n to an admin key always take a fresh step-up proof.\n\n An admin API key with MANAGE_API_KEYS may also update a standard key of\n the main account or of a sub-account it owns, without a session, when the\n key's policy allows no money-out action. The key's ip_whitelist after the\n update must lie within the admin key's own allowlist (else\n PermissionDenied with AUTH_ADMIN_KEY_SCOPE_EXCEEDED). It can never select\n purpose, nor change an admin or assistant key, itself included:\n PermissionDenied with AUTH_ADMIN_KEY_ESCALATION_DENIED or\n AUTH_ADMIN_KEY_FORBIDDEN_TARGET.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "admin_api_key"
          ],
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "apiKey": {
                "label": "Name Of My Subaccount"
              },
              "expectedRevision": "1",
              "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542",
              "updateMask": "label"
            },
            "response": {
              "apiKey": {
                "color": "#7C3AED",
                "createdAt": "2025-01-01T00:00:00Z",
                "createdByActor": "dashboard",
                "expiresAt": "2025-01-01T00:00:00Z",
                "icon": "💰",
                "ipWhitelist": [
                  "203.0.113.0/24"
                ],
                "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542",
                "label": "Trading Bot",
                "lastUsedAt": "2025-01-01T00:00:00Z",
                "policyId": "2779655768052592500",
                "publicKeyEd25519": "AA==",
                "purpose": "STANDARD",
                "revision": "1",
                "status": "ACTIVE",
                "strategyBotId": "4237083536359433371",
                "subaccountId": "6789012345678",
                "updatedAt": "2025-01-01T00:00:00Z"
              }
            }
          }
        }
      ]
    }
