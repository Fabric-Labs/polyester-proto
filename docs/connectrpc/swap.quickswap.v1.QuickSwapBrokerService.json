{
  "services": [
    {
      "name": "swap.quickswap.v1.QuickSwapBrokerService",
      "doc": "QuickSwapBrokerService administers a broker org, over ConnectRPC and REST.\n Every request names its broker. The caller is either the broker's API key,\n sent as a bearer token (see QuickSwapService), or a member's interactive\n session token; a person who is not a member of the broker gets NOT_FOUND /\n BROKER_NOT_FOUND. Each RPC maps to one broker action:\n\n | Action | Owner | Admin | Finance | Affiliate manager | Viewer | API key |\n | --- | --- | --- | --- | --- | --- | --- |\n | Read (GetBroker, ListKeys, ListVaults, GetVault, ListMembers, ListQuickSwaps, GetFeeTotals, GetBrokerStats) | yes | yes | yes | yes | yes | yes, except ListMembers |\n | Create vaults (CreateAffiliateVault, SetVaultStatus) | yes | yes | no | yes | no | yes |\n | Manage keys (CreateKey, RotateKey, RevokeKey) | yes | yes | no | no | no | RotateKey of itself only |\n | Manage members (InviteMember, SetMemberRole, RemoveMember) | yes | yes, never the Owner | no | no | no | no |\n | Transfer ownership | yes | no | no | no | no | no |\n\n A member managing keys or members must also send a fresh step-up proof in\n the X-Auth-Step-Up header, obtained by completing an MFA challenge for\n fresh step-up; each proof authorizes one change. Reads, vaults and a key\n rotating itself need none. A denied action fails with PERMISSION_DENIED /\n ACTION_DENIED, a missing or used proof with PERMISSION_DENIED /\n STEP_UP_REQUIRED.\n\n REST errors are application/problem+json (see ErrorDetail) with the HTTP\n statuses of QuickSwapService.",
      "methods": [
        {
          "name": "CreateAffiliateVault",
          "path": "swap.quickswap.v1.QuickSwapBrokerService/CreateAffiliateVault",
          "requestType": "swap.quickswap.v1.CreateAffiliateVaultRequest",
          "responseType": "swap.quickswap.v1.CreateAffiliateVaultResponse",
          "summary": "CreateAffiliateVault creates, or returns, the affiliate vault with label.",
          "doc": "CreateAffiliateVault creates, or returns, the affiliate vault with label.\n Create a vault before the first QuickSwap that credits it: a QuickSwap\n naming a vault that does not exist yet is refused. Concurrent and\n repeated requests with the same label return the same vault. No step-up\n proof is needed.\n\n Errors:\n - NOT_FOUND: BROKER_NOT_FOUND.\n - PERMISSION_DENIED: ACTION_DENIED.\n - RESOURCE_EXHAUSTED: BROKER_LIMIT, the broker's vault limit.",
          "authRequired": true,
          "authenticationMethods": [
            "broker_api_key",
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "broker": "value",
              "label": "Name Of My Subaccount"
            },
            "response": {
              "created": false,
              "vault": {
                "accountId": "7563897446546",
                "createdAt": "2025-01-01T00:00:00Z",
                "label": "Name Of My Subaccount",
                "status": "VAULT_ACTIVE",
                "updatedAt": "2025-01-01T00:00:00Z"
              }
            }
          }
        },
        {
