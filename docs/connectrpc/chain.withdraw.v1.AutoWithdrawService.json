{
  "services": [
    {
      "name": "chain.withdraw.v1.AutoWithdrawService",
      "doc": "AutoWithdrawService manages scheduled in-kind auto-withdraw rules for a\n root account or subaccount. A rule pays each asset's balance out on an\n hourly, daily, weekly, biweekly or monthly UTC slot, through the normal\n withdraw path, only to destinations on the account's external withdraw\n whitelist. Changing or\n resuming a rule requires a person with withdraw rights and a fresh\n single-use MFA step-up, and pausing it requires such a person without a\n step-up; API keys can read rules, runs and previews but never change\n them. An API key reads only when its policy grants READ_AUTO_WITHDRAW (or\n MANAGE_AUTO_WITHDRAW), and only its own account: a root-account key reads\n the root account, and a subaccount key reads its subaccount.",
      "methods": [
        {
          "name": "GetAutoWithdrawRule",
          "path": "chain.withdraw.v1.AutoWithdrawService/GetAutoWithdrawRule",
          "requestType": "chain.withdraw.v1.GetAutoWithdrawRuleRequest",
          "responseType": "chain.withdraw.v1.GetAutoWithdrawRuleResponse",
          "summary": "Read the account's latest rule version.",
          "doc": "Read the account's latest rule version.\n\n An API key needs READ_AUTO_WITHDRAW in its policy and reads only its own\n account. Both refusals answer PERMISSION_DENIED: a key whose policy lacks\n the action gets \"api key policy does not allow READ_AUTO_WITHDRAW\", and a\n key that names an account other than its own, such as a root-account key\n naming a subaccount, gets \"api key target scope mismatch\".",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "chain.withdraw.v1",
          "errorCatalog": "withdraw-api:withdrawerrors",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "rule": {
                "createdAt": "2025-01-01T00:00:00Z",
                "createdByAccountId": "7563897446546",
                "destinations": [
                  {
                    "assetId": 100,
                    "destinationAddress": "0x3333333333333333333333333333333333333333",
                    "destinationChainId": "1",
                    "maxAmountE18": {
                      "hi": "1",
                      "lo": "1"
                    },
                    "minAmountE18": {
                      "hi": "1",
                      "lo": "1"
                    },
                    "minFloorE18": {
                      "hi": "1",
                      "lo": "1"
                    }
                  }
                ],
                "enabled": false,
                "minUsdValueE18": {
                  "hi": "1",
                  "lo": "1"
                },
                "pause": {
                  "assetId": 100,
                  "pausedAt": "2025-01-01T00:00:00Z",
                  "reason": "value"
                },
                "schedule": {
                  "anchorDate": "",
                  "cadence": "DAILY",
                  "dayOfMonth": 0,
                  "minuteOfDay": 840,
                  "minuteOfHour": 0,
                  "weekday": "MONDAY"
                },
                "subaccountId": "6789012345678",
                "version": 1
              }
            }
          }
        },
        {
          "name": "ListAutoWithdrawRuns",
