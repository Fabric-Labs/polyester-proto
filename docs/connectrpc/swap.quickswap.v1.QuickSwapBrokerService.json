              }
            }
          }
        },
        {
          "name": "GetBrokerStats",
          "path": "swap.quickswap.v1.QuickSwapBrokerService/GetBrokerStats",
          "requestType": "swap.quickswap.v1.GetBrokerStatsRequest",
          "responseType": "swap.quickswap.v1.GetBrokerStatsResponse",
          "summary": "GetBrokerStats reads the broker's QuickSwap activity in a window, per UTC",
          "doc": "GetBrokerStats reads the broker's QuickSwap activity in a window, per UTC\n day or month: QuickSwaps created by status, deposits credited and\n payouts delivered per asset, and the service, broker and affiliate fees\n charged per asset.\n\n Errors:\n - NOT_FOUND: BROKER_NOT_FOUND.\n - INTERNAL: STATS_INCOMPLETE, with the swap_id of a QuickSwap whose\n   records the stats cannot read.",
          "authRequired": true,
          "authenticationMethods": [
            "broker_api_key",
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "broker": "value",
              "endTime": "2025-01-01T00:00:00Z",
              "groupBy": "DAY",
              "startTime": "2025-01-01T00:00:00Z"
            },
            "response": {
