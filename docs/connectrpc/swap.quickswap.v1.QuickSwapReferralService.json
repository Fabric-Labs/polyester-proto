        {
          "name": "GetReferredQuickSwap",
          "path": "swap.quickswap.v1.QuickSwapReferralService/GetReferredQuickSwap",
          "requestType": "swap.quickswap.v1.GetReferredQuickSwapRequest",
          "responseType": "swap.quickswap.v1.GetReferredQuickSwapResponse",
          "summary": "Get referred QuickSwap",
          "doc": "GetReferredQuickSwap returns one QuickSwap the caller referred.\n\n The QuickSwap can be in progress or done. Its breakdown shows the fee\n and commission rates, every commission credit and the commission's\n current US dollar value.\n\n Errors:\n - NOT_FOUND: REFERRAL_PARTNER_NOT_FOUND, or SWAP_NOT_FOUND for a\n   QuickSwap the caller did not refer.",
          "tags": [
            "quickswap"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
