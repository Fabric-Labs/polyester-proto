        {
          "name": "ProposeDeploy",
          "path": "strategies.v1.StrategiesService/ProposeDeploy",
          "requestType": "strategies.v1.ProposeDeployRequest",
          "responseType": "strategies.v1.ProposeDeployResponse",
          "summary": "Propose Deploy",
          "doc": "ProposeDeploy records an immutable deploy proposal and returns the link\n to the deploy page, where the user deploys it with MFA and a wallet\n signature. It never deploys, creates a subaccount or moves funds. The\n version must be valid, pass every behaviour example and have a finished\n backtest unless it cannot be backtested; its markets must be open to\n bots; the funding account must hold the funding; and the caller must be\n under their bot cap.\n\n Errors:\n - INVALID_ARGUMENT: malformed request, SETTINGS_INVALID or\n   FUNDING_INVALID.\n - NOT_FOUND: VERSION_NOT_FOUND, or FUNDING_SUBACCOUNT_NOT_FOUND.\n - FAILED_PRECONDITION: VERSION_INVALID, SCENARIOS_FAILING,\n   BACKTEST_MISSING, MARKET_NOT_ALLOWED, INSUFFICIENT_FUNDS or\n   BOT_CAP_REACHED.\n - RESOURCE_EXHAUSTED: INDICATOR_SETTINGS_LIMIT_REACHED.\n - ALREADY_EXISTS: IDEMPOTENCY_CONFLICT; the original proposal stands.\n - UNAVAILABLE: SERVICE_UNAVAILABLE; retry the same request.\n - PERMISSION_DENIED: AUTH_API_KEY_ACCESS_DENIED when the API key's policy\n   does not grant PROPOSE_STRATEGY_DEPLOY or the key is scoped to a\n   subaccount.\n - UNAUTHENTICATED: missing or invalid credentials.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "strategies.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "botName": "example",
              "funding": [
                {
                  "amount": "123.45",
                  "asset": "example"
                }
              ],
              "fundingSubaccountId": "6789012345678",
              "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
              "settings": [
                {
                  "name": "example",
                  "value": "value"
                }
              ],
              "versionId": "example"
            },
            "response": {
              "deployUrl": "value",
              "expiresAt": "2025-01-01T00:00:00Z",
              "proposalId": "1",
              "summary": {
                "backtest": {
                  "attempts": 1,
                  "backtestId": "1",
                  "heldBackMetrics": {
                    "exposurePercent": "value",
                    "fees": {
                      "amount": "123.45",
                      "asset": "example"
                    },
                    "maxDrawdownPercent": "value",
                    "returnPercent": "value",
