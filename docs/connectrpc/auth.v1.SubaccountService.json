{
  "services": [
    {
      "name": "auth.v1.SubaccountService",
      "doc": "Service for creating, updating, sharing, and listing sub-accounts.",
      "methods": [
        {
          "name": "CreateSubaccount",
          "path": "auth.v1.SubaccountService/CreateSubaccount",
          "requestType": "auth.v1.CreateSubaccountRequest",
          "responseType": "auth.v1.CreateSubaccountResponse",
          "summary": "Create a new sub-account under the caller's root account.",
          "doc": "Create a new sub-account under the caller's root account.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "color": "#7C3AED",
              "icon": "💰",
              "label": "Market Making",
              "nonce": "example-nonce-12345",
              "primaryWalletAddress": "0x1111111111111111111111111111111111111111",
              "signature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
              "smartAccountAddress": "0x2222222222222222222222222222222222222222",
              "walletProvider": "metamask"
            },
            "response": {
              "revision": "1",
              "smartAccountSaltNonce": 1,
              "subaccountId": "6789012345678",
              "totalCreated": 1
            }
          }
        },
        {
          "name": "InviteSubaccountMember",
          "path": "auth.v1.SubaccountService/InviteSubaccountMember",
          "requestType": "auth.v1.InviteSubaccountMemberRequest",
          "responseType": "auth.v1.InviteSubaccountMemberResponse",
          "summary": "Invite a member to a sub-account.",
          "doc": "Invite a member to a sub-account.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "fresh_step_up",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "granteeAccountId": "7563897446546",
              "role": "VIEWER",
              "subaccountId": "6789012345678"
            },
            "response": {
              "invite": {
                "createdAt": "2025-01-01T00:00:00Z",
                "granteeAccountId": "7563897446546",
                "granteeRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                "granteeUsername": "trader_alpha",
                "id": "1",
                "inviterAccountId": "7563897446546",
                "inviterRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                "inviterUsername": "trader_alpha",
                "requireMemberMfa": false,
                "respondedAt": "2025-01-01T00:00:00Z",
                "role": "VIEWER",
                "status": "SUBACCOUNT_INVITE_STATUS_PENDING",
                "subaccountId": "6789012345678",
                "subaccountLabel": "Market Making"
              }
            }
          }
        },
        {
          "name": "ListSubaccountInvites",
          "path": "auth.v1.SubaccountService/ListSubaccountInvites",
          "requestType": "auth.v1.ListSubaccountInvitesRequest",
          "responseType": "auth.v1.ListSubaccountInvitesResponse",
          "summary": "List incoming invitations and invitations for administered sub-accounts.",
          "doc": "List incoming invitations and invitations for administered sub-accounts.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "direction": "incoming"
            },
            "response": {
              "invites": [
                {
                  "createdAt": "2025-01-01T00:00:00Z",
                  "granteeAccountId": "7563897446546",
                  "granteeRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                  "granteeUsername": "trader_alpha",
                  "id": "1",
                  "inviterAccountId": "7563897446546",
                  "inviterRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                  "inviterUsername": "trader_alpha",
                  "requireMemberMfa": false,
                  "respondedAt": "2025-01-01T00:00:00Z",
                  "role": "VIEWER",
                  "status": "SUBACCOUNT_INVITE_STATUS_PENDING",
                  "subaccountId": "6789012345678",
                  "subaccountLabel": "Market Making"
                }
              ]
            }
          }
        },
        {
          "name": "ListSubaccountMembers",
          "path": "auth.v1.SubaccountService/ListSubaccountMembers",
          "requestType": "auth.v1.ListSubaccountMembersRequest",
          "responseType": "auth.v1.ListSubaccountMembersResponse",
          "summary": "List current members for a sub-account visible to any current member.",
          "doc": "List current members for a sub-account visible to any current member.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "members": [
                {
                  "accountId": "7563897446546",
                  "avatarUrl": "https://cdn.polyester.dev/avatars/trader-alpha.png",
                  "mfaEnrolled": false,
                  "role": "VIEWER",
                  "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                  "username": "trader_alpha"
                }
              ]
            }
          }
        },
        {
          "name": "ListSubaccounts",
          "path": "auth.v1.SubaccountService/ListSubaccounts",
          "requestType": "auth.v1.ListSubaccountsRequest",
          "responseType": "auth.v1.ListSubaccountsResponse",
          "summary": "List sub-accounts owned by or shared with the caller.",
          "doc": "List sub-accounts owned by or shared with the caller.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "subaccounts": [
                {
                  "color": "#7C3AED",
                  "icon": "💰",
                  "id": "1",
                  "label": "Market Making",
                  "ownerAvatarUrl": "https://cdn.polyester.dev/avatars/trader-alpha.png",
                  "ownerRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                  "ownerUsername": "trader_alpha",
                  "requireMemberMfa": false,
                  "revision": "1",
                  "role": "VIEWER",
                  "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                  "smartAccountSaltNonce": 1,
                  "status": "SUBACCOUNT_STATUS_ACTIVE",
                  "subaccountPolicyId": "1",
                  "updatedAt": "2025-01-01T00:00:00Z"
                }
              ],
              "totalCreated": 1
            }
          }
        },
        {
          "name": "RemoveSubaccountMember",
          "path": "auth.v1.SubaccountService/RemoveSubaccountMember",
          "requestType": "auth.v1.RemoveSubaccountMemberRequest",
          "responseType": "auth.v1.RemoveSubaccountMemberResponse",
          "summary": "Remove a member from a sub-account (owner/admin only).",
          "doc": "Remove a member from a sub-account (owner/admin only).",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "granteeAccountId": "7563897446546",
              "subaccountId": "6789012345678"
            },
            "response": {}
          }
        },
        {
          "name": "RespondSubaccountInvite",
          "path": "auth.v1.SubaccountService/RespondSubaccountInvite",
          "requestType": "auth.v1.RespondSubaccountInviteRequest",
          "responseType": "auth.v1.RespondSubaccountInviteResponse",
          "summary": "Accept or decline an invite as the grantee, or cancel it as a current owner or admin.",
          "doc": "Accept or decline an invite as the grantee, or cancel it as a current owner or admin.\n Acceptance requires an enrolled factor and a recently MFA-elevated session when the subaccount requires member MFA.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "action": "SUBACCOUNT_INVITE_ACTION_ACCEPT",
              "inviteId": "1"
            },
            "response": {
              "invite": {
                "createdAt": "2025-01-01T00:00:00Z",
                "granteeAccountId": "7563897446546",
                "granteeRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                "granteeUsername": "trader_alpha",
                "id": "1",
                "inviterAccountId": "7563897446546",
                "inviterRootSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                "inviterUsername": "trader_alpha",
                "requireMemberMfa": false,
                "respondedAt": "2025-01-01T00:00:00Z",
                "role": "VIEWER",
                "status": "SUBACCOUNT_INVITE_STATUS_PENDING",
                "subaccountId": "6789012345678",
                "subaccountLabel": "Market Making"
              }
            }
          }
        },
        {
          "name": "SetSubaccountMemberMFARequirement",
          "path": "auth.v1.SubaccountService/SetSubaccountMemberMFARequirement",
          "requestType": "auth.v1.SetSubaccountMemberMFARequirementRequest",
          "responseType": "auth.v1.SetSubaccountMemberMFARequirementResponse",
          "summary": "Toggle the delegated member MFA requirement for one sub-account (owner only).",
          "doc": "Toggle the delegated member MFA requirement for one sub-account (owner only).",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "requireMemberMfa": false,
              "subaccountId": "6789012345678"
            },
            "response": {}
          }
        },
        {
          "name": "UpdateSubaccount",
          "path": "auth.v1.SubaccountService/UpdateSubaccount",
          "requestType": "auth.v1.UpdateSubaccountRequest",
          "responseType": "auth.v1.UpdateSubaccountResponse",
          "summary": "Update mutable sub-account fields (label/status/icon/color).",
