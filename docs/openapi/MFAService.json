{
  "components": {
    "schemas": {
      "auth.v1.BeginMFAChallengeRequest": {
        "additionalProperties": false,
        "description": "Request to start an MFA challenge.",
        "properties": {
          "purpose": {
            "$ref": "#/components/schemas/auth.v1.MFAChallengePurpose",
            "description": "Desired challenge outcome: session elevation or fresh step-up.",
            "not": {
              "enum": [
                0
              ]
            },
            "title": "purpose"
          }
        },
        "required": [
          "purpose"
        ],
        "title": "BeginMFAChallengeRequest",
        "type": "object"
      },
      "auth.v1.BeginMFAChallengeResponse": {
        "additionalProperties": false,
        "description": "Response returned after starting an MFA challenge.",
        "properties": {
          "allowedFactorTypes": {
            "description": "Factor types the caller may use for this challenge. Maximum 8 unique values.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.MFAFactorType"
            },
            "maxItems": 8,
            "title": "allowed_factor_types",
            "type": "array",
            "uniqueItems": true
          },
          "challengeId": {
            "description": "Challenge identifier to submit when verifying a factor. Format: \"mfa_\" followed by 32 lowercase hex characters.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^mfa_[a-f0-9]{32}$",
            "title": "challenge_id",
            "type": "string"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/google.protobuf.Timestamp",
            "description": "Time when this challenge expires.",
            "title": "expires_at"
          },
          "publicKey": {
            "$ref": "#/components/schemas/google.protobuf.Struct",
            "description": "Passkey request options when passkey verification is available. Empty when passkeys are not available.",
            "title": "public_key"
          }
        },
        "title": "BeginMFAChallengeResponse",
        "type": "object"
      },
      "auth.v1.BeginPasskeyEnrollmentRequest": {
        "additionalProperties": false,
        "description": "Request to begin passkey enrollment.",
        "properties": {
          "label": {
            "description": "Optional human-friendly label for the passkey. Maximum 128 characters.",
            "maxLength": 128,
            "title": "label",
            "type": "string"
          }
        },
        "title": "BeginPasskeyEnrollmentRequest",
        "type": "object"
      },
      "auth.v1.BeginPasskeyEnrollmentResponse": {
        "additionalProperties": false,
        "description": "Response containing passkey enrollment options.",
        "properties": {
          "enrollmentId": {
            "description": "Enrollment challenge identifier. Format: \"mfa_\" followed by 32 lowercase hex characters.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^mfa_[a-f0-9]{32}$",
            "title": "enrollment_id",
            "type": "string"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/google.protobuf.Timestamp",
            "description": "Time when this enrollment challenge expires.",
            "title": "expires_at"
          },
          "publicKey": {
            "$ref": "#/components/schemas/google.protobuf.Struct",
            "description": "Passkey creation options to pass to the browser or device authenticator.",
            "title": "public_key"
          }
        },
        "title": "BeginPasskeyEnrollmentResponse",
        "type": "object"
      },
      "auth.v1.BeginTOTPEnrollmentRequest": {
        "additionalProperties": false,
        "description": "Request to begin authenticator-app enrollment.",
        "properties": {
          "label": {
            "description": "Optional human-friendly label. Defaults to \"Authenticator App\" when empty. Maximum 128 characters.",
            "maxLength": 128,
            "title": "label",
            "type": "string"
          }
        },
        "title": "BeginTOTPEnrollmentRequest",
        "type": "object"
      },
      "auth.v1.BeginTOTPEnrollmentResponse": {
        "additionalProperties": false,
        "description": "Response containing the authenticator-app enrollment secret.",
        "properties": {
          "enrollmentId": {
            "description": "Enrollment challenge identifier. Format: \"mfa_\" followed by 32 lowercase hex characters.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^mfa_[a-f0-9]{32}$",
            "title": "enrollment_id",
            "type": "string"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/google.protobuf.Timestamp",
            "description": "Time when this enrollment challenge expires.",
            "title": "expires_at"
          },
          "otpauthUri": {
            "description": "Authenticator-app setup URI for QR-code display. Returned only when enrollment begins.",
            "readOnly": true,
            "title": "otpauth_uri",
            "type": "string"
          },
          "secret": {
            "description": "Shared secret to enter into an authenticator app. Returned only when enrollment begins.",
            "readOnly": true,
            "title": "secret",
            "type": "string"
          }
        },
        "title": "BeginTOTPEnrollmentResponse",
        "type": "object"
      },
      "auth.v1.CompleteMFAChallengeResponse": {
        "additionalProperties": false,
        "description": "Response returned after an MFA challenge is completed.",
        "properties": {
          "accessToken": {
            "description": "MFA-elevated session token returned for session-elevation challenges. Empty for fresh step-up challenges.",
            "readOnly": true,
            "title": "access_token",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "$ref": "#/components/schemas/google.protobuf.Timestamp",
            "description": "Time when access_token expires. Empty when no access_token is returned.",
            "title": "access_token_expires_at"
          },
          "session": {
            "$ref": "#/components/schemas/auth.v1.SessionInfo",
            "description": "Session assurance details after completing the challenge.",
            "title": "session"
          },
          "stepUpExpiresAt": {
            "$ref": "#/components/schemas/google.protobuf.Timestamp",
            "description": "Time when step_up_token expires. Empty when no step_up_token is returned.",
            "title": "step_up_expires_at"
          },
          "stepUpToken": {
            "description": "Fresh step-up token returned for fresh step-up challenges. Empty for session-elevation challenges.",
            "readOnly": true,
            "title": "step_up_token",
            "type": "string"
          }
        },
        "title": "CompleteMFAChallengeResponse",
        "type": "object"
      },
      "auth.v1.DeleteMFAFactorResponse": {
        "additionalProperties": false,
        "description": "Empty response returned after an MFA factor is deleted.",
        "title": "DeleteMFAFactorResponse",
        "type": "object"
      },
      "auth.v1.FinishPasskeyEnrollmentRequest": {
        "additionalProperties": false,
        "description": "Request to finish passkey enrollment.",
        "properties": {
          "credential": {
            "$ref": "#/components/schemas/google.protobuf.Struct",
            "description": "Passkey creation response returned by the browser or device authenticator.",
            "title": "credential"
          },
          "enrollmentId": {
            "description": "Enrollment challenge identifier returned by BeginPasskeyEnrollment.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^mfa_[a-f0-9]{32}$",
            "title": "enrollment_id",
            "type": "string"
          }
        },
        "required": [
          "enrollmentId",
          "credential"
        ],
        "title": "FinishPasskeyEnrollmentRequest",
        "type": "object"
      },
      "auth.v1.FinishPasskeyEnrollmentResponse": {
        "additionalProperties": false,
        "description": "Response returned after passkey enrollment succeeds.",
        "properties": {
          "factor": {
            "$ref": "#/components/schemas/auth.v1.MFAFactor",
            "description": "Newly enrolled MFA factor.",
            "title": "factor"
          },
          "recoveryCodes": {
            "description": "One-time recovery codes generated for the account. Store these securely; they are only returned in this response.",
            "items": {
              "readOnly": true,
              "type": "string"
            },
            "readOnly": true,
            "title": "recovery_codes",
            "type": "array"
          }
        },
        "title": "FinishPasskeyEnrollmentResponse",
        "type": "object"
      },
      "auth.v1.FinishTOTPEnrollmentRequest": {
        "additionalProperties": false,
        "description": "Request to finish authenticator-app enrollment.",
        "properties": {
          "code": {
            "description": "Current 6 to 8 digit code from the authenticator app.",
            "pattern": "^[0-9]{6,8}$",
            "title": "code",
            "type": "string"
          },
          "enrollmentId": {
            "description": "Enrollment challenge identifier returned by BeginTOTPEnrollment.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^mfa_[a-f0-9]{32}$",
            "title": "enrollment_id",
            "type": "string"
          }
        },
        "required": [
          "enrollmentId",
          "code"
        ],
        "title": "FinishTOTPEnrollmentRequest",
        "type": "object"
      },
      "auth.v1.FinishTOTPEnrollmentResponse": {
        "additionalProperties": false,
        "description": "Response returned after authenticator-app enrollment succeeds.",
        "properties": {
          "factor": {
            "$ref": "#/components/schemas/auth.v1.MFAFactor",
            "description": "Newly enrolled MFA factor.",
            "title": "factor"
          },
          "recoveryCodes": {
            "description": "One-time recovery codes generated for the account. Store these securely; they are only returned in this response.",
            "items": {
              "readOnly": true,
              "type": "string"
            },
            "readOnly": true,
            "title": "recovery_codes",
            "type": "array"
          }
        },
        "title": "FinishTOTPEnrollmentResponse",
        "type": "object"
      },
      "auth.v1.ListMFAFactorsResponse": {
        "additionalProperties": false,
        "description": "Response containing the caller's enrolled MFA factors.",
        "properties": {
          "factors": {
            "description": "Enrolled MFA factors, ordered oldest first.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.MFAFactor"
            },
            "title": "factors",
            "type": "array"
          },
          "hasRecoveryCodes": {
            "description": "True when the caller has at least one unused recovery code.",
            "title": "has_recovery_codes",
            "type": "boolean"
          }
        },
        "title": "ListMFAFactorsResponse",
        "type": "object"
      },
      "auth.v1.RegenerateRecoveryCodesRequest": {
        "additionalProperties": false,
        "description": "Request to rotate recovery codes.",
        "title": "RegenerateRecoveryCodesRequest",
        "type": "object"
      },
      "auth.v1.RegenerateRecoveryCodesResponse": {
        "additionalProperties": false,
        "description": "Response containing newly generated recovery codes.",
        "properties": {
          "recoveryCodes": {
            "description": "New one-time recovery codes. Store these securely; they are only returned in this response.",
            "items": {
              "readOnly": true,
              "type": "string"
            },
            "readOnly": true,
            "title": "recovery_codes",
            "type": "array"
          }
        },
        "title": "RegenerateRecoveryCodesResponse",
        "type": "object"
      },
      "auth.v1.UpdateMFAFactorResponse": {
        "additionalProperties": false,
        "description": "Response containing the updated MFA factor.",
        "properties": {
          "factor": {
            "$ref": "#/components/schemas/auth.v1.MFAFactor",
            "description": "Updated MFA factor metadata.",
            "title": "factor"
          }
        },
        "title": "UpdateMFAFactorResponse",
        "type": "object"
      },
      "google.protobuf.Struct": {
        "additionalProperties": {
          "$ref": "#/components/schemas/google.protobuf.Value"
        },
        "description": "`Struct` represents a structured data value, consisting of fields\n which map to dynamically typed values. In some languages, `Struct`\n might be supported by a native representation. For example, in\n scripting languages like JS a struct is represented as an\n object. The details of that representation are described together\n with the proto support for the language.\n\n The JSON representation for `Struct` is JSON object.",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/mfa/challenges": {
      "post": {
        "description": "Start session elevation or fresh step-up using an enrolled MFA factor.",
        "operationId": "MFAService_BeginMFAChallenge",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "purpose": "MFA_CHALLENGE_PURPOSE_SESSION_ELEVATION"
              },
              "schema": {
                "$ref": "#/components/schemas/auth.v1.BeginMFAChallengeRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/auth.v1.BeginMFAChallengeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "allowedFactorTypes": [
                    "MFA_FACTOR_TYPE_TOTP"
                  ],
                  "challengeId": "mfa_11111111111111111111111111111111",
                  "expiresAt": "2025-01-01T00:00:00Z",
                  "publicKey": {
                    "challenge": "Y2hhbGxlbmdlLWZvci1kb2Nz",
                    "rpId": "polyester.exchange"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.BeginMFAChallengeResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Begin MFA Challenge",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.BeginMFAChallengeRequest",
        "x-poly-response-type": "auth.v1.BeginMFAChallengeResponse"
      }
    },
    "/v1/auth/mfa/challenges/{challenge_id}:finish-passkey": {
      "post": {
        "description": "Verify a passkey authentication response for session elevation or fresh step-up.",
        "operationId": "MFAService_FinishPasskeyChallenge",
        "parameters": [
          {
            "description": "Challenge identifier returned by BeginMFAChallenge.",
            "example": "mfa_11111111111111111111111111111111",
            "in": "path",
            "name": "challenge_id",
            "required": true,
            "schema": {
              "description": "Challenge identifier returned by BeginMFAChallenge.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^mfa_[a-f0-9]{32}$",
              "title": "challenge_id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "credential": {
                  "id": "credential-example",
                  "response": {
                    "clientDataJSON": "ZXhhbXBsZS1jbGllbnQtZGF0YQ"
                  },
                  "type": "public-key"
                }
              },
              "schema": {
                "additionalProperties": false,
                "description": "Request to verify an MFA challenge with a passkey.",
                "properties": {
                  "credential": {
                    "$ref": "#/components/schemas/google.protobuf.Struct",
                    "description": "Passkey authentication response returned by the browser or device authenticator.",
                    "title": "credential"
                  }
                },
                "required": [
                  "credential"
                ],
                "title": "FinishPasskeyChallengeRequest",
                "type": "object"
              }
            },
            "application/proto": {
              "schema": {
                "additionalProperties": false,
                "description": "Request to verify an MFA challenge with a passkey.",
                "properties": {
                  "credential": {
                    "$ref": "#/components/schemas/google.protobuf.Struct",
                    "description": "Passkey authentication response returned by the browser or device authenticator.",
                    "title": "credential"
                  }
                },
                "required": [
                  "credential"
                ],
                "title": "FinishPasskeyChallengeRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "accessToken": "eyJhbGciOiJFZERTQSJ9.example.signature",
                  "accessTokenExpiresAt": "2025-01-01T00:00:00Z",
                  "session": {
                    "authTime": "2025-01-01T00:00:00Z",
                    "authenticationMethods": [
                      "totp"
                    ],
                    "sessionId": "session_01J0EXAMPLE",
                    "sessionLevel": "PRIMARY_AUTHENTICATED"
                  },
                  "stepUpExpiresAt": "2025-01-01T00:00:00Z",
                  "stepUpToken": "eyJhbGciOiJFZERTQSJ9.step-up.signature"
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.CompleteMFAChallengeResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Finish Passkey Challenge",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.FinishPasskeyChallengeRequest",
        "x-poly-response-type": "auth.v1.CompleteMFAChallengeResponse"
      }
    },
    "/v1/auth/mfa/challenges/{challenge_id}:verify-recovery-code": {
      "post": {
        "description": "Consume a recovery code for session elevation or fresh step-up.",
        "operationId": "MFAService_VerifyRecoveryCodeChallenge",
        "parameters": [
          {
            "description": "Challenge identifier returned by BeginMFAChallenge.",
            "example": "mfa_11111111111111111111111111111111",
            "in": "path",
            "name": "challenge_id",
            "required": true,
            "schema": {
              "description": "Challenge identifier returned by BeginMFAChallenge.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^mfa_[a-f0-9]{32}$",
              "title": "challenge_id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "recoveryCode": "POLY-7H2K-9M4Q"
              },
              "schema": {
                "additionalProperties": false,
                "description": "Request to verify an MFA challenge with a recovery code.",
                "properties": {
                  "recoveryCode": {
                    "description": "One-time recovery code. Accepted format is 8 to 64 letters, numbers, or hyphens.",
                    "maxLength": 64,
                    "minLength": 8,
                    "pattern": "^[A-Za-z0-9-]+$",
                    "title": "recovery_code",
                    "type": "string"
                  }
                },
                "required": [
                  "recoveryCode"
                ],
                "title": "VerifyRecoveryCodeChallengeRequest",
                "type": "object"
              }
            },
            "application/proto": {
              "schema": {
                "additionalProperties": false,
                "description": "Request to verify an MFA challenge with a recovery code.",
                "properties": {
                  "recoveryCode": {
                    "description": "One-time recovery code. Accepted format is 8 to 64 letters, numbers, or hyphens.",
                    "maxLength": 64,
                    "minLength": 8,
                    "pattern": "^[A-Za-z0-9-]+$",
                    "title": "recovery_code",
                    "type": "string"
                  }
                },
                "required": [
                  "recoveryCode"
                ],
                "title": "VerifyRecoveryCodeChallengeRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "accessToken": "eyJhbGciOiJFZERTQSJ9.example.signature",
                  "accessTokenExpiresAt": "2025-01-01T00:00:00Z",
                  "session": {
                    "authTime": "2025-01-01T00:00:00Z",
                    "authenticationMethods": [
                      "totp"
                    ],
                    "sessionId": "session_01J0EXAMPLE",
                    "sessionLevel": "PRIMARY_AUTHENTICATED"
                  },
                  "stepUpExpiresAt": "2025-01-01T00:00:00Z",
                  "stepUpToken": "eyJhbGciOiJFZERTQSJ9.step-up.signature"
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.CompleteMFAChallengeResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Verify Recovery Code Challenge",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.VerifyRecoveryCodeChallengeRequest",
        "x-poly-response-type": "auth.v1.CompleteMFAChallengeResponse"
      }
    },
    "/v1/auth/mfa/challenges/{challenge_id}:verify-totp": {
      "post": {
        "description": "Verify a TOTP code for session elevation or fresh step-up.",
        "operationId": "MFAService_VerifyTOTPChallenge",
        "parameters": [
          {
            "description": "Challenge identifier returned by BeginMFAChallenge.",
            "example": "mfa_11111111111111111111111111111111",
            "in": "path",
            "name": "challenge_id",
            "required": true,
            "schema": {
              "description": "Challenge identifier returned by BeginMFAChallenge.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^mfa_[a-f0-9]{32}$",
              "title": "challenge_id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "code": "123456"
              },
              "schema": {
                "additionalProperties": false,
                "description": "Request to verify an MFA challenge with an authenticator-app code.",
                "properties": {
                  "code": {
                    "description": "Current 6 to 8 digit code from the authenticator app.",
                    "pattern": "^[0-9]{6,8}$",
                    "title": "code",
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ],
                "title": "VerifyTOTPChallengeRequest",
                "type": "object"
              }
            },
            "application/proto": {
              "schema": {
                "additionalProperties": false,
                "description": "Request to verify an MFA challenge with an authenticator-app code.",
                "properties": {
                  "code": {
                    "description": "Current 6 to 8 digit code from the authenticator app.",
                    "pattern": "^[0-9]{6,8}$",
                    "title": "code",
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ],
                "title": "VerifyTOTPChallengeRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "accessToken": "eyJhbGciOiJFZERTQSJ9.example.signature",
                  "accessTokenExpiresAt": "2025-01-01T00:00:00Z",
                  "session": {
                    "authTime": "2025-01-01T00:00:00Z",
                    "authenticationMethods": [
                      "totp"
                    ],
                    "sessionId": "session_01J0EXAMPLE",
                    "sessionLevel": "PRIMARY_AUTHENTICATED"
                  },
                  "stepUpExpiresAt": "2025-01-01T00:00:00Z",
                  "stepUpToken": "eyJhbGciOiJFZERTQSJ9.step-up.signature"
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.CompleteMFAChallengeResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Verify TOTP Challenge",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.VerifyTOTPChallengeRequest",
        "x-poly-response-type": "auth.v1.CompleteMFAChallengeResponse"
      }
    },
    "/v1/auth/mfa/factors": {
      "get": {
        "description": "List the caller's MFA factors and recovery-code availability.",
        "operationId": "MFAService_ListMFAFactors",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "factors": [
                    {
                      "createdAt": "2025-01-01T00:00:00Z",
                      "factorId": "mfa_33333333333333333333333333333333",
                      "factorType": "MFA_FACTOR_TYPE_TOTP",
                      "label": "Primary Authenticator",
                      "lastUsedAt": "2025-01-01T00:00:00Z"
