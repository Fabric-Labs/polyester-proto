{
  "types": [
    {
      "name": "marketoverview.v1.ErrorCode",
      "kind": "enum",
      "doc": "ErrorCode is a stable domain error code enum for Market Overview.\n It is used for consistent error surfaces across ConnectRPC and REST.",
      "enum": {
        "values": [
          {
            "name": "ERROR_CODE_BAD_REQUEST",
            "number": 1
          },
          {
            "name": "ERROR_CODE_INVALID_ARGUMENT",
            "number": 2
          },
          {
            "name": "ERROR_CODE_NOT_FOUND",
            "number": 3
          },
          {
            "name": "ERROR_CODE_UNAVAILABLE",
            "number": 4
          },
          {
            "name": "ERROR_CODE_UPSTREAM_ERROR",
            "number": 5
          }
        ]
      }
    },
    {
      "name": "marketoverview.v1.ErrorDetail",
      "kind": "message",
      "doc": "ErrorDetail carries a typed domain error code for machine-readable handling.",
      "message": {
        "fields": [
          {
            "name": "code",
            "jsonName": "code",
            "number": 1,
            "doc": "Stable error code for programmatic matching.",
            "protoRef": "marketoverview.v1.ErrorCode"
          }
        ]
      }
    },
    {
      "name": "marketoverview.v1.ListMarketOverviewRequest",
      "kind": "message",
      "message": {
        "fields": [
          {
            "name": "symbols",
            "jsonName": "symbols",
            "number": 1,
            "doc": "Filter by specific symbols; when empty, returns all enabled markets.",
            "repeated": true,
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "limit",
            "jsonName": "limit",
            "number": 2,
            "doc": "Pagination (simple page/limit). Page numbers are 1-based. Server defaults\n limit to 50 and clamps to a maximum of 2000.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "page",
            "jsonName": "page",
            "number": 3,
            "doc": "Page number (1-based). When unset/0, defaults to 1.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "order_by",
            "jsonName": "orderBy",
            "number": 4,
            "doc": "Sort key. When unset/UNSPECIFIED, defaults to 24h quote volume.",
            "protoRef": "marketoverview.v1.MarketOrderBy",
            "validate": {
              "enum": {
                "definedOnly": true
              }
            }
          },
          {
            "name": "sort",
            "jsonName": "sort",
            "number": 5,
            "doc": "Sort direction (DESC=newest/highest first).",
            "protoRef": "marketoverview.v1.SortDirection",
            "validate": {
              "enum": {
                "definedOnly": true
              }
            }
          },
          {
            "name": "include_sparklines",
            "jsonName": "includeSparklines",
            "number": 6,
            "doc": "When true, include sparklines in each MarketOverview.",
            "protoScalar": "bool",
            "jsonType": "boolean"
          },
          {
            "name": "sparkline_intervals",
            "jsonName": "sparklineIntervals",
            "number": 7,
            "doc": "Which sparklines to include. If empty and include_sparklines is true,\n server defaults to 24h.",
            "repeated": true,
            "protoRef": "marketoverview.v1.SparklineInterval"
          }
        ]
      }
    },
    {
      "name": "marketoverview.v1.ListMarketOverviewResponse",
      "kind": "message",
      "message": {
        "fields": [
          {
            "name": "markets",
            "jsonName": "markets",
            "number": 1,
            "doc": "Market overview rows for the requested page.",
            "repeated": true,
            "protoRef": "marketoverview.v1.MarketOverview"
          },
          {
            "name": "total",
            "jsonName": "total",
            "number": 2,
            "doc": "Total count (best-effort). When unset/zero, clients can treat as unknown.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          }
        ]
      }
    },
    {
      "name": "marketoverview.v1.MarketOrderBy",
      "kind": "enum",
      "enum": {
        "values": [
          {
            "name": "ORDER_BY_CHANGE_24H_BP",
            "number": 1,
            "doc": "Sort by absolute 24h change (basis points)."
          },
          {
            "name": "ORDER_BY_VOLUME_24H_QUOTE",
            "number": 2,
            "doc": "Sort by 24h quote volume (scaled quote units)."
          },
          {
            "name": "ORDER_BY_LAST_PRICE",
            "number": 3,
            "doc": "Sort by last price ticks."
          },
          {
            "name": "ORDER_BY_DATE_ADDED",
            "number": 4,
            "doc": "Sort by listing time (new listings first)."
          }
        ]
      }
    },
    {
      "name": "marketoverview.v1.MarketOverview",
      "kind": "message",
      "message": {
        "fields": [
          {
            "name": "symbol_id",
            "jsonName": "symbolId",
            "number": 1,
            "doc": "Engine symbol id.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "symbol",
            "jsonName": "symbol",
            "number": 2,
            "doc": "Canonical pair symbol, e.g. \"BTC-USDT\".",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "last_price_ticks",
            "jsonName": "lastPriceTicks",
            "number": 3,
            "doc": "Last traded price (ticks) and timestamp.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "last_trade_ts_ns",
            "jsonName": "lastTradeTsNs",
            "number": 4,
            "doc": "Last trade timestamp in nanoseconds since epoch.",
            "protoScalar": "uint64",
            "jsonType": "string",
            "format": "uint64"
          },
          {
            "name": "change_24h_bp",
            "jsonName": "change24hBp",
            "number": 5,
            "doc": "Rolling 24h change expressed in basis points (bp). Example: +123 = +1.23%.",
            "protoScalar": "int32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "high_24h_ticks",
            "jsonName": "high24hTicks",
            "number": 6,
            "doc": "Rolling 24h stats.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "low_24h_ticks",
            "jsonName": "low24hTicks",
            "number": 7,
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "volume_24h_base_scaled",
            "jsonName": "volume24hBaseScaled",
            "number": 8,
            "doc": "Rolling 24h base volume, in scaled base units.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "volume_24h_quote_scaled",
            "jsonName": "volume24hQuoteScaled",
            "number": 14,
            "doc": "Rolling 24h quote volume, in scaled quote units.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "listed_ts_ns",
            "jsonName": "listedTsNs",
            "number": 15,
            "doc": "Listing timestamp in nanoseconds since epoch.",
            "protoScalar": "uint64",
            "jsonType": "string",
            "format": "uint64"
          },
          {
            "name": "best_bid_ticks",
            "jsonName": "bestBidTicks",
            "number": 9,
            "doc": "Current top-of-book (ticks).",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "best_bid_qty_scaled",
            "jsonName": "bestBidQtyScaled",
            "number": 10,
            "doc": "Best bid quantity, in scaled base units.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "best_ask_ticks",
            "jsonName": "bestAskTicks",
            "number": 11,
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "best_ask_qty_scaled",
            "jsonName": "bestAskQtyScaled",
            "number": 12,
            "doc": "Best ask quantity, in scaled base units.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "sparklines",
            "jsonName": "sparklines",
            "number": 13,
            "doc": "Optional sparklines (requested explicitly).",
            "repeated": true,
            "protoRef": "marketoverview.v1.Sparkline"
          }
        ]
      }
    },
    {
      "name": "marketoverview.v1.MarketOverviewBatch",
      "kind": "message",
      "doc": "MarketOverviewBatch is a websocket payload carrying batched market overview\n updates. It is published to a single all-markets channel at a fixed cadence.",
      "message": {
        "fields": [
          {
            "name": "markets",
            "jsonName": "markets",
            "number": 1,
            "doc": "Market overviews included in this batch.",
            "repeated": true,
            "protoRef": "marketoverview.v1.MarketOverview"
          },
          {
            "name": "ts_ns",
            "jsonName": "tsNs",
            "number": 2,
            "doc": "Batch publish timestamp in nanoseconds since epoch.",
            "protoScalar": "uint64",
            "jsonType": "string",
            "format": "uint64"
          }
        ]
      }
    },
    {
      "name": "marketoverview.v1.SortDirection",
      "kind": "enum",
      "enum": {
        "values": [
          {
            "name": "SORT_ASC",
            "number": 1,
            "doc": "Ascending (oldest/lowest first)."
          },
          {
            "name": "SORT_DESC",
            "number": 2,
            "doc": "Descending (newest/highest first)."
          }
        ]
      }
    },
    {
      "name": "marketoverview.v1.Sparkline",
      "kind": "message",
      "message": {
        "fields": [
          {
            "name": "interval",
            "jsonName": "interval",
            "number": 1,
            "protoRef": "marketoverview.v1.SparklineInterval",
            "validate": {
              "enum": {
                "definedOnly": true
              }
            }
          },
          {
            "name": "close_ticks",
            "jsonName": "closeTicks",
            "number": 2,
            "doc": "Newest-first close prices (ticks).",
            "repeated": true,
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          }
        ]
      }
    },
    {
      "name": "marketoverview.v1.SparklineInterval",
      "kind": "enum",
      "enum": {
        "values": [
          {
            "name": "SPARKLINE_1H",
            "number": 1,
            "doc": "1 hour sparkline. Typically returns up to 60 points (1-minute buckets)."
          },
          {
            "name": "SPARKLINE_24H",
            "number": 2,
            "doc": "24 hour sparkline. Typically returns up to 1440 points (1-minute buckets)."
          },
          {
            "name": "SPARKLINE_1W",
            "number": 3,
            "doc": "1 week sparkline. Typically returns up to 168 points (1-hour buckets)."
          },
          {
            "name": "SPARKLINE_1M",
            "number": 4,
            "doc": "1 month sparkline. Typically returns up to 30 points (1-day buckets)."
          }
        ]
      }
    }
  ]
}
