      "polyester.rest.enum.changelog.v1.Audience": {
        "enum": [
          "ALL_USERS",
          "TRADERS",
          "MARKET_MAKERS",
          "DEVELOPERS"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "ALL_USERS": "Everyone.",
          "DEVELOPERS": "Developers and API integrators.",
          "MARKET_MAKERS": "Market makers.",
          "TRADERS": "Traders."
        }
      },
      "polyester.rest.enum.changelog.v1.ChangeCategory": {
        "enum": [
          "BREAKING_CHANGE",
          "NEW_FEATURE",
          "IMPROVEMENT",
          "BUG_FIX"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "BREAKING_CHANGE": "Breaking change: existing integrations may need to change.",
          "BUG_FIX": "Bug fix.",
          "IMPROVEMENT": "Improvement to existing behavior.",
          "NEW_FEATURE": "New capability."
        }
      },
      "polyester.rest.enum.changelog.v1.SortDirection": {
        "enum": [
          "ASC",
          "DESC"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "ASC": "Ascending (oldest first).",
          "DESC": "Descending (newest first)."
        }
      },
      "polyester.rest.enum.changelog.v1.Surface": {
        "enum": [
          "TRADING",
          "FUNDING",
          "ACCOUNTS",
          "API",
          "EXPLORER",
          "DOCUMENTATION",
          "PLATFORM",
          "MARKET_DATA",
          "QUICKSWAP",
          "REWARDS"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "ACCOUNTS": "Accounts, subaccounts and security.",
          "API": "Programmatic API.",
          "DOCUMENTATION": "Documentation.",
          "EXPLORER": "Block explorer.",
          "FUNDING": "Deposits, withdrawals and transfers.",
          "MARKET_DATA": "Market data: prices, candles, order book, heatmaps and market overviews.",
          "PLATFORM": "Platform-wide behavior.",
          "QUICKSWAP": "The QuickSwap swap app.",
          "REWARDS": "Rewards: daily claims, campaigns, VIP tiers and fee discounts.",
          "TRADING": "Orders, triggers and protective orders, and order outcomes."
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "BrokerApiKeyAuth": {
        "description": "Broker API key, sent as a bearer token and accepted only by the QuickSwap broker API. The broker API key is a server credential. Call this API from the broker's backend, never from a browser or mobile app. The broker's members create, rotate and revoke keys through the QuickSwap broker API, and a key may rotate itself.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/changelog/changes": {
      "get": {
        "description": "List changes across published posts, for example every breaking change since a given time.",
        "operationId": "ChangelogService_ListChanges",
        "parameters": [
          {
            "description": "When set, only changes whose actionRequired equals this value.",
            "in": "query",
            "name": "actionRequired",
            "required": false,
            "schema": {
              "example": false,
              "type": "boolean"
            }
          },
          {
            "description": "Audiences to include; repeat the parameter for several. Empty means all. Changes addressed to ALL_USERS always match.",
            "explode": true,
            "in": "query",
            "name": "audiences",
            "required": false,
            "schema": {
              "example": [
                "ALL_USERS"
              ],
              "items": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/polyester.rest.enum.changelog.v1.Audience"
                  }
                ]
              },
              "type": "array"
            },
            "style": "form"
          },
          {
            "description": "Categories to include; repeat the parameter for several. Empty means all.",
            "explode": true,
            "in": "query",
            "name": "categories",
            "required": false,
            "schema": {
              "example": [
                "BREAKING_CHANGE"
              ],
              "items": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/polyester.rest.enum.changelog.v1.ChangeCategory"
                  }
                ]
              },
              "type": "array"
            },
            "style": "form"
          },
          {
            "description": "Exclusive upper bound on post publication time, RFC 3339; must be after startTime when both are set.",
            "in": "query",
            "name": "endTime",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            },
            "x-poly-example-omitted": "cross-field-constraint"
          },
          {
            "description": "Maximum changes to return. 0 or omitted means the default of 100; maximum 500.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "example": 100,
              "maximum": 500,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Opaque, keyset-backed, exclusive cursor from a previous response. Reuse it only with the same filters, time bounds and sort.",
            "in": "query",
            "name": "pageToken",
            "required": false,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          },
          {
            "description": "Restrict to one post.",
            "in": "query",
            "name": "postSlug",
            "required": false,
            "schema": {
              "example": "value",
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "description": "Order of posts by publication time; changes keep publication order inside each post. Defaults to DESC.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/polyester.rest.enum.changelog.v1.SortDirection"
                }
              ],
              "example": "ASC"
            }
          },
          {
            "description": "Inclusive lower bound on post publication time, RFC 3339.",
            "in": "query",
            "name": "startTime",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            },
            "x-poly-example-omitted": "cross-field-constraint"
          },
          {
            "description": "Surfaces to include; repeat the parameter for several. Empty means all.",
            "explode": true,
            "in": "query",
            "name": "surfaces",
            "required": false,
            "schema": {
              "example": [
                "TRADING"
              ],
              "items": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/polyester.rest.enum.changelog.v1.Surface"
                  }
                ]
              },
              "type": "array"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "changes": [
                    {
                      "change": {
                        "actionRequired": false,
                        "audiences": [
                          "ALL_USERS"
                        ],
                        "category": "BREAKING_CHANGE",
                        "details": "value",
                        "id": "2",
                        "migrationGuidance": "value",
                        "summary": "value",
                        "surfaces": [
                          "TRADING"
                        ],
                        "title": "My Trading Board"
                      },
                      "postSlug": "value",
                      "publishedAt": "2025-01-01T00:00:00Z",
                      "sectionHeading": "value"
                    }
                  ],
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.ChangelogService_ListChanges.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "List Changelog Changes",
        "tags": [
          "Changelog Service"
        ],
        "x-poly-authentication-methods": [],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.ChangelogService_ListChanges",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "changelog.v1.ListChangesRequest",
        "x-poly-response-type": "changelog.v1.ListChangesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/changelog/posts": {
      "get": {
        "description": "List published post summaries, newest first. Use limit 1 to poll for the latest post.",
        "operationId": "ChangelogService_ListPosts",
        "parameters": [
          {
            "description": "Maximum posts to return. 0 or omitted means the default of 20; maximum 100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "example": 100,
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Opaque, keyset-backed, exclusive cursor from a previous response.",
            "in": "query",
            "name": "pageToken",
            "required": false,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0",
                  "posts": [
                    {
                      "actionRequiredCount": 1,
                      "breakingChangeCount": 1,
                      "bugFixCount": 1,
                      "changeCount": 1,
                      "coverageCutoff": "2025-01-01T00:00:00Z",
                      "improvementCount": 1,
                      "introduction": "value",
                      "newFeatureCount": 1,
                      "publishedAt": "2025-01-01T00:00:00Z",
                      "slug": "value",
                      "title": "My Trading Board"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.ChangelogService_ListPosts.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "List Changelog Posts",
        "tags": [
          "Changelog Service"
        ],
        "x-poly-authentication-methods": [],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.ChangelogService_ListPosts",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "changelog.v1.ListPostsRequest",
        "x-poly-response-type": "changelog.v1.ListPostsResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/changelog/posts/{slug}": {
      "get": {
        "description": "Get one complete published post by slug.",
        "operationId": "ChangelogService_GetPost",
        "parameters": [
          {
            "description": "Post slug.",
            "example": "example",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "post": {
                    "sections": [
                      {
                        "changes": [
                          {
                            "actionRequired": false,
                            "audiences": [
                              "ALL_USERS"
                            ],
                            "category": "BREAKING_CHANGE",
                            "details": "value",
                            "id": "2",
                            "migrationGuidance": "value",
                            "summary": "value",
                            "surfaces": [
                              "TRADING"
                            ],
                            "title": "My Trading Board"
                          }
                        ],
                        "heading": "value",
                        "summary": "value",
                        "surface": "TRADING"
                      }
                    ],
                    "summary": {
                      "actionRequiredCount": 1,
                      "breakingChangeCount": 1,
                      "bugFixCount": 1,
                      "changeCount": 1,
                      "coverageCutoff": "2025-01-01T00:00:00Z",
                      "improvementCount": 1,
                      "introduction": "value",
                      "newFeatureCount": 1,
                      "publishedAt": "2025-01-01T00:00:00Z",
                      "slug": "value",
                      "title": "My Trading Board"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.ChangelogService_GetPost.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "Get Changelog Post",
        "tags": [
          "Changelog Service"
        ],
        "x-poly-authentication-methods": [],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.ChangelogService_GetPost",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "changelog.v1.GetPostRequest",
        "x-poly-response-type": "changelog.v1.GetPostResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
