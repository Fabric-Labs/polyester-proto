{
  "services": [
    {
      "name": "auth.v1.SubaccountRoleService",
      "doc": "Read-only discovery of built-in role capabilities and caller-effective permissions.",
      "methods": [
        {
          "name": "GetEffectiveSubaccountPermissions",
          "path": "auth.v1.SubaccountRoleService/GetEffectiveSubaccountPermissions",
          "requestType": "auth.v1.GetEffectiveSubaccountPermissionsRequest",
          "responseType": "auth.v1.GetEffectiveSubaccountPermissionsResponse",
          "summary": "Return the authenticated caller's effective permissions for one sub-account.",
          "doc": "Return the authenticated caller's effective permissions for one sub-account.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "permissions": [
                "SUBACCOUNT_PERMISSION_READ_SUBACCOUNT"
              ],
              "role": "VIEWER",
              "subaccountPolicyId": "1"
            }
          }
        },
        {
          "name": "ListSubaccountRoles",
          "path": "auth.v1.SubaccountRoleService/ListSubaccountRoles",
          "requestType": "auth.v1.ListSubaccountRolesRequest",
          "responseType": "auth.v1.ListSubaccountRolesResponse",
          "summary": "List the authoritative built-in role and permission catalog. This metadata is public.",
          "doc": "List the authoritative built-in role and permission catalog. This metadata is public.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "permissions": [
                {
                  "description": "Example configuration for the API playground.",
                  "displayName": "value",
                  "permission": "SUBACCOUNT_PERMISSION_READ_SUBACCOUNT",
                  "policyAction": "TRADE_SPOT"
                }
              ],
              "roles": [
                {
                  "assignable": false,
                  "description": "Example configuration for the API playground.",
                  "displayName": "value",
                  "permissions": [
                    "SUBACCOUNT_PERMISSION_READ_SUBACCOUNT"
                  ],
                  "role": "VIEWER"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
