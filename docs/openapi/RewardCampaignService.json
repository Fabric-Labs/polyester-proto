  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/rewards/awards": {
      "get": {
        "description": "List published campaign awards for the authenticated root account. Requires a session token.",
        "operationId": "RewardCampaignService_ListMyRewardAwards",
        "parameters": [
          {
            "description": "Maximum awards to return. Zero uses 50; maximum 100.",
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum awards to return. Zero uses 50; maximum 100.",
              "example": 100,
              "maximum": 100,
              "title": "limit",
              "type": "integer"
            }
          },
          {
            "description": "Opaque exclusive continuation token bound to the authenticated root account.",
            "in": "query",
            "name": "pageToken",
            "schema": {
              "description": "Opaque exclusive continuation token bound to the authenticated root account.",
              "maxLength": 256,
              "title": "page_token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "awards": [
                    {
                      "amountBaseUnits": "123.45",
                      "assetId": 100,
                      "awardId": "value",
                      "campaignId": "value",
                      "campaignName": "value",
                      "fulfillmentMethod": "EXTERNAL_TESTNET",
                      "fulfillmentState": "AWAITING_DESTINATION",
                      "publishedAt": "2025-01-01T00:00:00Z"
                    }
                  ],
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
                },
                "schema": {
                  "$ref": "#/components/schemas/rewards.v1.ListMyRewardAwardsResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "List My Reward Awards",
        "tags": [
          "Rewards"
        ],
        "x-poly-authentication-methods": [
          "session_token"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "rewards.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "rewards.v1.ListMyRewardAwardsRequest",
        "x-poly-response-type": "rewards.v1.ListMyRewardAwardsResponse"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
