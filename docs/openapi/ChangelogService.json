                          "title": {
                            "description": "Short title.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "actionRequired",
                          "audiences",
                          "category",
                          "id",
                          "summary",
                          "surfaces",
                          "title"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "heading": {
                      "description": "Section heading.",
                      "type": "string"
                    },
                    "summary": {
                      "description": "Section summary. Omitted when absent.",
                      "type": "string"
                    },
                    "surface": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/polyester.rest.enum.changelog.v1.Surface"
                        }
                      ],
                      "description": "Product area of the section. Omitted for sections not tied to one area (for example changes that need your attention, or general)."
                    }
                  },
                  "required": [
                    "changes",
                    "heading"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "summary": {
                "additionalProperties": false,
                "description": "Post summary.",
                "properties": {
                  "actionRequiredCount": {
                    "description": "Exact number of changes with action_required.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "breakingChangeCount": {
                    "description": "Exact number of BREAKING_CHANGE changes.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "bugFixCount": {
                    "description": "Exact number of BUG_FIX changes.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "changeCount": {
                    "description": "Exact number of changes.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "coverageCutoff": {
                    "description": "Exclusive upper bound of the period covered. Omitted when unknown.",
                    "format": "date-time",
                    "type": "string"
                  },
                  "improvementCount": {
                    "description": "Exact number of IMPROVEMENT changes.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "introduction": {
                    "description": "Introduction.",
                    "type": "string"
                  },
                  "newFeatureCount": {
                    "description": "Exact number of NEW_FEATURE changes.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "publishedAt": {
                    "description": "Publication time.",
                    "format": "date-time",
                    "type": "string"
                  },
                  "slug": {
                    "description": "Stable post identifier, unique within this environment.",
                    "type": "string"
                  },
                  "title": {
                    "description": "Title.",
                    "type": "string"
                  }
                },
                "required": [
                  "actionRequiredCount",
                  "breakingChangeCount",
                  "bugFixCount",
                  "changeCount",
                  "improvementCount",
                  "introduction",
                  "newFeatureCount",
                  "publishedAt",
                  "slug",
                  "title"
                ],
                "type": "object"
              }
            },
            "required": [
              "sections",
              "summary"
            ],
            "type": "object"
          }
        },
        "required": [
          "post"
        ],
        "type": "object"
      },
