{
  "components": {
    "schemas": {
      "polyester.rest.LedgerReadService_GetBalanceHistory.Response": {
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "description": "Sampling interval between points, such as \"5m\" or \"1h\".",
            "type": "string"
          },
          "endTsSec": {
            "description": "Last point timestamp in seconds since epoch (UTC).",
            "format": "int32",
            "type": "integer"
          },
          "points": {
            "description": "Number of aligned points in each returned series.",
            "format": "int32",
            "type": "integer"
          },
          "range": {
            "description": "Resolved history window.",
            "enum": [
              "DAY_1",
              "DAY_7",
              "DAY_30",
              "DAY_90",
              "DAY_180",
              "DAY_365"
            ],
            "type": "string"
          },
          "series": {
            "description": "Balance series ordered by asset ID, then account bucket.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "account": {
                  "description": "account bucket",
                  "type": "string"
                },
                "asset": {
                  "description": "public unified asset id",
                  "type": "string"
                },
                "balance": {
                  "description": "Chart balance in asset units scaled by 1e7 (7 decimals). Values are downscaled from 18-decimal ledger balances for compact charting and align 1:1 with implicit timestamps.",
                  "items": {
                    "pattern": "^[0-9]+(\\.[0-9]+)?$",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "account",
                "asset",
                "balance"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "startTsSec": {
            "description": "First point timestamp in seconds since epoch (UTC).",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "range",
          "series"
        ],
        "type": "object"
      },
      "polyester.rest.LedgerReadService_GetBalances.Response": {
        "additionalProperties": false,
        "properties": {
          "balances": {
            "description": "One entry for every supported unified asset, including assets with zero balances. Sorted by available trading amount (highest first), then by asset symbol alphabetically.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "available": {
                  "description": "Amount currently available for new trading activity at fixed 18-decimal ledger scale. This value already accounts for active reservations.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "funding": {
                  "description": "Funding balance at fixed 18-decimal ledger scale.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "fundingRevision": {
                  "description": "Opaque monotonic revision for the funding value. Higher means newer; zero means no funding state has been observed.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "reserved": {
                  "description": "Reserved amount in the trading bucket at fixed 18-decimal ledger scale.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "symbol": {
                  "description": "Public unified asset id. Resolve symbol from SpotConfig; U128 amounts in this message always use fixed 18-decimal ledger scale.",
                  "type": "string"
                },
                "trading": {
                  "description": "Trading balance at fixed 18-decimal ledger scale.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "tradingRevision": {
                  "description": "Opaque monotonic revision for the atomic trading, reserved, and available values. Higher means newer; zero means no trading state has been observed.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                }
              },
              "required": [
                "available",
                "funding",
                "fundingRevision",
                "reserved",
                "symbol",
                "trading",
                "tradingRevision"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "balances"
        ],
        "type": "object"
      },
      "polyester.rest.LedgerReadService_GetEquityHistorySeries.Response": {
        "additionalProperties": false,
        "properties": {
          "btcPrices": {
            "description": "BTC-USDT close price at each timestamp, scaled by 1e6 (same as price_ticks). Enables client-side conversion to BTC denomination without refetch.",
            "items": {
              "pattern": "^[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            "type": "array"
          },
          "bucket": {
            "description": "Sampling interval between points, such as \"5m\" or \"1h\".",
            "type": "string"
          },
          "endTsSec": {
            "description": "Last point timestamp in seconds since epoch (UTC).",
            "format": "int32",
            "type": "integer"
          },
          "points": {
            "description": "Number of aligned points in each returned series.",
            "format": "int32",
            "type": "integer"
          },
          "quoteAsset": {
            "description": "Human-readable quote asset symbol (always \"USDT\").",
            "type": "string"
          },
          "range": {
            "description": "Resolved history window.",
            "enum": [
              "DAY_1",
              "DAY_7",
              "DAY_30",
              "DAY_90",
              "DAY_180",
              "DAY_365"
            ],
            "type": "string"
          },
          "series": {
            "description": "Equity series ordered by grouping identifier ascending.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "account": {
                  "additionalProperties": false,
                  "description": "set when group_by = ACCOUNT",
                  "properties": {
                    "accountCode": {
                      "description": "account bucket code",
                      "format": "int32",
                      "type": "integer"
                    },
                    "name": {
                      "description": "human-readable name (\"funding\", \"trading\")",
                      "type": "string"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "asset": {
                  "additionalProperties": false,
                  "description": "set when group_by = ASSET",
                  "properties": {
                    "id": {
                      "description": "public asset id (0 for \"OTHER\" bucket)",
                      "format": "int32",
                      "type": "integer"
                    },
                    "symbol": {
                      "description": "asset symbol (\"BTC\", \"ETH\", \"OTHER\")",
                      "type": "string"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "equity": {
                  "description": "Equity in quote currency (USDT) scaled by 1e4 (4 decimals). Values align 1:1 with timestamps.",
                  "items": {
                    "pattern": "^[0-9]+(\\.[0-9]+)?$",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "equity"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "startTsSec": {
            "description": "First point timestamp in seconds since epoch (UTC).",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "btcPrices",
          "range",
          "series"
        ],
        "type": "object"
      },
      "polyester.rest.LedgerReadService_ListTransfers.Response": {
        "additionalProperties": false,
        "properties": {
          "nextPageToken": {
            "description": "Opaque cursor for the next page. Empty when no more results exist.",
            "type": "string"
          },
          "transfers": {
            "description": "Transfer rows in requested order.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "account": {
                  "description": "Account bucket affected by this transfer.",
                  "type": "string"
                },
                "amount": {
                  "description": "Transfer amount at fixed 18-decimal ledger scale.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "asset": {
                  "description": "Public unified asset ID. Resolve its symbol through the spot configuration API. U128 amounts in this row always use a fixed 18-decimal ledger scale.",
                  "type": "string"
                },
                "balanceAfter": {
                  "description": "Post-transfer balance at fixed 18-decimal ledger scale.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "destination": {
                  "additionalProperties": false,
                  "description": "Credit side of the transfer. This relationship is debit-to-credit rather than row-relative; use is_debit to determine whether this row is the credit leg.",
                  "properties": {
                    "accountId": {
                      "description": "Public root account or subaccount ID when this side is safe to identify. Never populated for private counterparties or non-user ledger accounts.",
                      "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
                      "type": "string"
                    },
                    "address": {
                      "description": "Address for this side when known. For EXTERNAL_ADDRESS this is an external-chain wallet address from lifecycle correlation; for identifiable Polyester accounts this is a Polyester smart-account address. May be empty until the corresponding lifecycle details are available.",
                      "type": "string"
                    },
                    "chainId": {
                      "description": "PolyChain-registered external network identifier for EXTERNAL_ADDRESS. This matches chain.zipper.v1.ChainConfig.chain_id and is not the chain's native identifier (for example, an EIP-155 id) or the Polyester chain id.",
                      "format": "int32",
                      "type": "integer"
                    },
                    "kind": {
                      "description": "Display classification for this transfer side.",
                      "enum": [
                        "FUNDING_ACCOUNT",
                        "TRADING_ACCOUNT",
                        "EXTERNAL_ADDRESS",
                        "PRIVATE_COUNTERPARTY",
                        "FEE_ACCOUNT",
                        "SYSTEM_ACCOUNT"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "address",
                    "kind"
                  ],
                  "type": "object"
                },
                "flowId": {
                  "description": "Public lifecycle flow ID when this transfer belongs to a chain lifecycle flow.",
                  "type": "string"
                },
                "isDebit": {
                  "description": "True when this row is the debit leg; false when it is the credit leg.",
                  "type": "boolean"
                },
                "linkId": {
                  "description": "Correlation ID used to group related transfer legs. Zero when unavailable.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "source": {
                  "additionalProperties": false,
                  "description": "Debit side of the transfer. This relationship is debit-to-credit rather than row-relative; use is_debit to determine whether this row is the debit leg.",
                  "properties": {
                    "accountId": {
                      "description": "Public root account or subaccount ID when this side is safe to identify. Never populated for private counterparties or non-user ledger accounts.",
                      "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
                      "type": "string"
                    },
                    "address": {
                      "description": "Address for this side when known. For EXTERNAL_ADDRESS this is an external-chain wallet address from lifecycle correlation; for identifiable Polyester accounts this is a Polyester smart-account address. May be empty until the corresponding lifecycle details are available.",
                      "type": "string"
                    },
                    "chainId": {
                      "description": "PolyChain-registered external network identifier for EXTERNAL_ADDRESS. This matches chain.zipper.v1.ChainConfig.chain_id and is not the chain's native identifier (for example, an EIP-155 id) or the Polyester chain id.",
                      "format": "int32",
                      "type": "integer"
                    },
                    "kind": {
                      "description": "Display classification for this transfer side.",
                      "enum": [
                        "FUNDING_ACCOUNT",
                        "TRADING_ACCOUNT",
                        "EXTERNAL_ADDRESS",
                        "PRIVATE_COUNTERPARTY",
                        "FEE_ACCOUNT",
                        "SYSTEM_ACCOUNT"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "address",
                    "kind"
                  ],
                  "type": "object"
                },
                "timestamp": {
                  "description": "Transfer timestamp in microseconds since epoch (UTC).",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "transferCode": {
                  "description": "Product reason for this transfer.",
                  "type": "string"
                }
              },
              "required": [
                "account",
                "amount",
                "asset",
                "balanceAfter",
                "destination",
                "flowId",
                "isDebit",
                "linkId",
                "source",
                "timestamp",
                "transferCode"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "nextPageToken",
          "transfers"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/balances": {
      "get": {
        "description": "Retrieve the latest balances for an account. Supports optional subaccount scoping and returns asset symbols with decimal amounts.",
        "operationId": "LedgerReadService_GetBalances",
        "parameters": [
          {
            "description": "Optional subaccount public id (base58).",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccount_id",
            "required": false,
            "schema": {
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "balances": [
                    {
                      "available": "18.446744073709551617",
                      "funding": "18.446744073709551617",
                      "fundingRevision": "1",
                      "reserved": "18.446744073709551617",
                      "symbol": "USDT",
                      "trading": "18.446744073709551617",
                      "tradingRevision": "1"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.LedgerReadService_GetBalances.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Balances",
        "tags": [
          "Ledger Read"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.LedgerReadService_GetBalances",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "ledger.read.v1.GetBalancesRequest",
        "x-poly-response-type": "ledger.read.v1.GetBalancesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/balances/history": {
      "get": {
        "description": "Retrieve balance history buckets for an account. Supports optional subaccount, range, asset, and account-bucket filters.",
        "operationId": "LedgerReadService_GetBalanceHistory",
        "parameters": [
          {
            "description": "Optional account bucket filter (comma-separated codes or names: funding, trading).",
            "example": "FUNDING",
            "in": "query",
            "name": "account_code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional public asset filter.",
            "example": "1",
            "in": "query",
            "name": "ledger",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "History window (defaults to 1d).",
            "example": "DAY_1",
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "enum": [
                "1d",
                "7d",
                "30d",
                "90d",
                "180d",
                "365d"
              ],
              "type": "string"
            }
          },
          {
            "description": "Optional subaccount public id (base58).",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccount_id",
            "required": false,
            "schema": {
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "bucket": "1m",
                  "endTsSec": 1735689600,
                  "points": 1,
                  "range": "DAY_1",
                  "series": [
                    {
                      "account": "FUNDING",
                      "asset": "USDT",
                      "balance": [
                        "0.0000001"
                      ]
                    }
                  ],
                  "startTsSec": 1735689600
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.LedgerReadService_GetBalanceHistory.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Balance History",
        "tags": [
          "Ledger Read"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.LedgerReadService_GetBalanceHistory",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "ledger.read.v1.GetBalanceHistoryRequest",
        "x-poly-response-type": "ledger.read.v1.GetBalanceHistoryResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/equity/history/series": {
      "get": {
        "description": "Retrieve equity history as columnar series data. Supports optional subaccount, range, account-bucket filtering, and grouping by account or asset.",
        "operationId": "LedgerReadService_GetEquityHistorySeries",
        "parameters": [
          {
            "description": "Optional account bucket filter (comma-separated codes or names: funding, trading).",
            "example": "FUNDING",
            "in": "query",
            "name": "account_code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Grouping mode (defaults to account).",
            "example": "GROUP_BY_ACCOUNT",
            "in": "query",
            "name": "group_by",
            "required": false,
            "schema": {
              "enum": [
                "account",
                "asset"
              ],
              "type": "string"
            }
          },
          {
            "description": "History window (defaults to 1d).",
            "example": "DAY_1",
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "enum": [
                "1d",
                "7d",
                "30d",
                "90d",
                "180d",
                "365d"
              ],
              "type": "string"
            }
          },
          {
            "description": "Optional subaccount public id (base58).",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccount_id",
            "required": false,
            "schema": {
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "btcPrices": [
                    "5"
                  ],
                  "bucket": "1m",
                  "endTsSec": 1735689600,
                  "points": 1,
                  "quoteAsset": "USDT",
                  "range": "DAY_1",
                  "series": [
                    {
                      "account": {
                        "accountCode": 1,
                        "name": "Trading"
                      },
                      "equity": [
                        "0.0001"
                      ]
                    }
                  ],
                  "startTsSec": 1735689600
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.LedgerReadService_GetEquityHistorySeries.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Equity History Series",
        "tags": [
          "Ledger Read"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.LedgerReadService_GetEquityHistorySeries",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "ledger.read.v1.GetEquityHistorySeriesRequest",
        "x-poly-response-type": "ledger.read.v1.GetEquityHistorySeriesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/transfers": {
      "get": {
        "description": "List transfer history for an account. Supports optional subaccount, asset, ordering, cursor, and hold-state filters.",
        "operationId": "LedgerReadService_ListTransfers",
        "parameters": [
          {
            "description": "Optional public asset filter.",
            "example": 1,
            "in": "query",
            "name": "ledger",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "Maximum rows to return (default 100, max 1000).",
            "example": 100,
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "type": "integer"
            }
          },
          {
            "description": "Opaque keyset cursor returned by the previous response.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "true=newest first; false=oldest first.",
            "example": false,
            "in": "query",
            "name": "reversed",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "Optional subaccount public id (base58).",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccount_id",
            "required": false,
            "schema": {
              "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0",
                  "transfers": [
                    {
                      "account": "FUNDING",
                      "amount": "18.446744073709551617",
                      "asset": "USDT",
                      "balanceAfter": "18.446744073709551617",
                      "destination": {
                        "accountId": "4Rh4iXdT",
                        "address": "0x3333333333333333333333333333333333333333",
                        "chainId": 1,
                        "kind": "FUNDING_ACCOUNT"
                      },
                      "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhI",
                      "isDebit": false,
                      "linkId": "1",
                      "source": {
                        "accountId": "4Rh4iXdT",
                        "address": "0x3333333333333333333333333333333333333333",
                        "chainId": 1,
                        "kind": "FUNDING_ACCOUNT"
                      },
                      "timestamp": "1",
                      "transferCode": "DEPOSIT"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.LedgerReadService_ListTransfers.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "List Transfers",
        "tags": [
          "Ledger Read"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.LedgerReadService_ListTransfers",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "ledger.read.v1.ListTransfersRequest",
        "x-poly-response-type": "ledger.read.v1.ListTransfersResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
