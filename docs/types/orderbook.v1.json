{
  "types": [
    {
      "name": "orderbook.v1.Depth",
      "kind": "enum",
      "doc": "Depth specifies the number of price levels per side.",
      "enum": {
        "values": [
          {
            "name": "DEPTH_1",
            "number": 1,
            "doc": "1 level per side (top of book / best bid-ask)."
          },
          {
            "name": "DEPTH_5",
            "number": 2,
            "doc": "5 levels per side."
          },
          {
            "name": "DEPTH_10",
            "number": 3,
            "doc": "10 levels per side."
          },
          {
            "name": "DEPTH_20",
            "number": 4,
            "doc": "20 levels per side."
          },
          {
            "name": "DEPTH_50",
            "number": 5,
            "doc": "50 levels per side."
          },
          {
            "name": "DEPTH_100",
            "number": 6,
            "doc": "100 levels per side."
          },
          {
            "name": "DEPTH_200",
            "number": 7,
            "doc": "200 levels per side."
          },
          {
            "name": "DEPTH_500",
            "number": 8,
            "doc": "500 levels per side."
          },
          {
            "name": "DEPTH_1000",
            "number": 9,
            "doc": "1000 levels per side."
          }
        ]
      }
    },
    {
      "name": "orderbook.v1.GetOrderBookRequest",
      "kind": "message",
      "doc": "GetOrderBookRequest describes a snapshot view request.",
      "message": {
        "fields": [
          {
            "name": "symbol",
            "jsonName": "symbol",
            "number": 1,
            "doc": "e.g. \"BTC-USDT\"; resolved to symbol_id server-side.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "minLen": 1,
                "maxLen": 20
              }
            }
          },
          {
            "name": "depth",
            "jsonName": "depth",
            "number": 2,
            "doc": "Requested depth per side (number of price levels). Default is 50.",
            "protoRef": "orderbook.v1.Depth",
            "validate": {
              "enum": {
                "definedOnly": true
              }
            }
          }
        ]
      }
    },
    {
      "name": "orderbook.v1.GetOrderBookResponse",
      "kind": "message",
      "doc": "GetOrderBookResponse is a depth snapshot for the binary (protobuf) API (scaled integers).\n REST surfaces expose decimal strings via DTO conversion.",
      "message": {
        "fields": [
          {
            "name": "symbol_id",
            "jsonName": "symbolId",
            "number": 1,
            "doc": "Numeric symbol identifier (client resolves to symbol string).",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "book_seq",
            "jsonName": "bookSeq",
            "number": 2,
            "doc": "Monotonic book sequence for this symbol.",
            "protoScalar": "uint64",
            "jsonType": "string",
            "format": "uint64"
          },
          {
            "name": "bids",
            "jsonName": "bids",
            "number": 3,
            "doc": "Best bid first; descending price.",
            "repeated": true,
            "protoRef": "orderbook.v1.PriceLevel"
          },
          {
            "name": "asks",
            "jsonName": "asks",
            "number": 4,
            "doc": "Best ask first; ascending price.",
            "repeated": true,
            "protoRef": "orderbook.v1.PriceLevel"
          },
          {
            "name": "ts",
            "jsonName": "ts",
            "number": 5,
            "doc": "Timestamp associated with this snapshot (best-effort).",
            "protoRef": "google.protobuf.Timestamp",
            "jsonType": "string",
            "format": "date-time"
          }
        ]
      }
    },
    {
      "name": "orderbook.v1.OrderBookDelta",
      "kind": "message",
      "doc": "OrderBookDelta is an incremental update to the orderbook state.\n Uses scaled integers (binary protobuf) for realtime streaming performance.\n\n Semantics:\n - For each side, each [price_ticks] entry is a SET at that price:\n   - qty_scaled \u003e 0 =\u003e set/replace that level quantity\n   - qty_scaled == 0 =\u003e delete that level\n - reset=true indicates the book should be cleared before applying any levels.\n\n Clients are expected to initialize from GetOrderBook (snapshot) and then\n apply deltas in order. If a gap is detected, clients should refetch a\n snapshot.",
      "message": {
        "fields": [
          {
            "name": "symbol_id",
            "jsonName": "symbolId",
            "number": 1,
            "doc": "Numeric symbol identifier.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "book_seq_start",
            "jsonName": "bookSeqStart",
            "number": 2,
            "doc": "Monotonic book sequence range covered by this update.\n When reset=true, book_seq_start may be 0.",
            "protoScalar": "uint64",
            "jsonType": "string",
            "format": "uint64"
          },
          {
            "name": "book_seq_end",
            "jsonName": "bookSeqEnd",
            "number": 3,
            "protoScalar": "uint64",
            "jsonType": "string",
            "format": "uint64"
          },
          {
            "name": "bids",
            "jsonName": "bids",
            "number": 4,
            "doc": "Bid-side updates (SET semantics at price_ticks).",
            "repeated": true,
            "protoRef": "orderbook.v1.PriceLevel"
          },
          {
            "name": "asks",
            "jsonName": "asks",
            "number": 5,
            "doc": "Ask-side updates (SET semantics at price_ticks).",
            "repeated": true,
            "protoRef": "orderbook.v1.PriceLevel"
          },
          {
            "name": "reset",
            "jsonName": "reset",
            "number": 6,
            "doc": "If true, consumers should clear their local book state before applying\n updates.",
            "protoScalar": "bool",
            "jsonType": "boolean"
          },
          {
            "name": "ts",
            "jsonName": "ts",
            "number": 7,
            "doc": "Timestamp associated with this update (best-effort).",
            "protoRef": "google.protobuf.Timestamp",
            "jsonType": "string",
            "format": "date-time"
          }
        ]
      }
    },
    {
      "name": "orderbook.v1.PriceLevel",
      "kind": "message",
      "doc": "PriceLevel uses scaled integers for the binary (protobuf) API (low-latency).\n REST surfaces expose decimal strings via DTO conversion.",
      "message": {
        "fields": [
          {
            "name": "price_ticks",
            "jsonName": "priceTicks",
            "number": 1,
            "doc": "Price in quote units scaled by 1e6.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          },
          {
            "name": "qty_scaled",
            "jsonName": "qtyScaled",
            "number": 2,
            "doc": "Quantity scaled by the pair's base_quantity_scale from GetSpotConfig.",
            "protoScalar": "int64",
            "jsonType": "string",
            "format": "int64"
          }
        ]
      }
    }
  ]
}
