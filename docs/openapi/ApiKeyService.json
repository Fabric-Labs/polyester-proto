{
  "components": {
    "schemas": {
      "auth.v1.CreateApiKeyRequest": {
        "additionalProperties": false,
        "description": "CreateApiKeyRequest creates a new API key. Clients generate the Ed25519 key\n pair locally and submit only the public key.",
        "properties": {
          "color": {
            "description": "Optional user-chosen color token for UI display.",
            "maxLength": 32,
            "title": "color",
            "type": "string"
          },
          "icon": {
            "description": "Optional user-chosen icon/emoji for UI display.",
            "maxLength": 32,
            "title": "icon",
            "type": "string"
          },
          "ipWhitelist": {
            "description": "Optional CIDR whitelist. Empty means no IP restriction. Maximum 32 unique\n entries.",
            "items": {
              "description": "string.ip_with_prefixlen = true // value must be a valid IP prefix\nstring.ip_with_prefixlen_empty = true // value is empty, which is not a valid IP prefix\n",
              "maxItems": 32,
              "type": "string",
              "uniqueItems": true
            },
            "maxItems": 32,
            "title": "ip_whitelist",
            "type": "array",
            "uniqueItems": true
          },
          "label": {
            "description": "Human-readable label for the key. Required; 1 to 64 characters.",
            "maxLength": 64,
            "minLength": 1,
            "title": "label",
            "type": "string"
          },
          "publicKeyEd25519": {
            "description": "Ed25519 public key bytes. Must be exactly 32 bytes. The private key or seed\n must never be sent to the API.\nbytes.const = []\n",
            "format": "byte",
            "maxLength": 32,
            "minLength": 32,
            "title": "public_key_ed25519",
            "type": "string"
          },
          "subaccountId": {
            "description": "Optional sub-account to scope this key to (opaque ID). If unset, the key is\n root-level.",
            "format": "int64",
            "nullable": true,
            "title": "subaccount_id",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "label",
          "publicKeyEd25519"
        ],
        "title": "CreateApiKeyRequest",
        "type": "object"
      },
      "auth.v1.CreateApiKeyResponse": {
        "additionalProperties": false,
        "description": "CreateApiKeyResponse returns the created API key metadata.",
        "properties": {
          "apiKey": {
            "$ref": "#/components/schemas/auth.v1.ApiKey",
            "description": "Created API key metadata. The private key or seed is never returned.",
            "title": "api_key"
          }
        },
        "title": "CreateApiKeyResponse",
        "type": "object"
      },
      "auth.v1.DeleteApiKeyResponse": {
        "additionalProperties": false,
        "description": "DeleteApiKeyResponse is empty when revocation succeeds.",
        "title": "DeleteApiKeyResponse",
        "type": "object"
      },
      "auth.v1.GetApiKeyResponse": {
        "additionalProperties": false,
        "description": "GetApiKeyResponse returns one API key visible to the caller.",
        "properties": {
          "apiKey": {
            "$ref": "#/components/schemas/auth.v1.ApiKey",
            "description": "Matching API key metadata.",
            "title": "api_key"
          }
        },
        "title": "GetApiKeyResponse",
        "type": "object"
      },
      "auth.v1.ListApiKeysResponse": {
        "additionalProperties": false,
        "description": "ListApiKeysResponse contains matching API keys, newest first by creation time.",
        "properties": {
          "apiKeys": {
            "description": "Matching API keys, newest first. Revoked keys are excluded.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.ApiKey"
            },
            "title": "api_keys",
            "type": "array"
          }
        },
        "title": "ListApiKeysResponse",
        "type": "object"
      },
      "polyester.rest.enum.auth.v1.ApiKeyStatus": {
        "enum": [
          "ACTIVE",
          "REVOKED",
          "DISABLED"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "ACTIVE": "Key can authenticate requests.",
          "DISABLED": "Key is temporarily disabled and cannot authenticate requests until re-enabled.",
          "REVOKED": "Key has been permanently revoked and cannot be used again."
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/api-keys": {
      "get": {
        "description": "List non-revoked API keys for the caller account, or for a sub-account the caller owns or administers, newest first.",
        "operationId": "ApiKeyService_ListApiKeys",
        "parameters": [
          {
            "description": "Optional filter: only keys scoped to this sub-account (opaque ID). The\n caller must own or administer the sub-account. If unset, only non-revoked\n keys owned by the caller are returned.",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccountId",
            "schema": {
              "description": "Optional filter: only keys scoped to this sub-account (opaque ID). The\n caller must own or administer the sub-account. If unset, only non-revoked\n keys owned by the caller are returned.",
              "format": "int64",
              "title": "subaccount_id",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "apiKeys": [
                    {
                      "color": "#7C3AED",
                      "createdAt": "2025-01-01T00:00:00Z",
                      "createdByActor": "dashboard",
                      "expiresAt": "2025-01-01T00:00:00Z",
                      "icon": "💰",
                      "ipWhitelist": [
                        "203.0.113.0/24"
                      ],
                      "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542",
                      "label": "Trading Bot",
                      "lastUsedAt": "2025-01-01T00:00:00Z",
                      "policyId": "3Gxbxht1EK",
                      "publicKeyEd25519": "AA==",
                      "revision": "1",
                      "status": "ACTIVE",
                      "subaccountId": "37E2o5r2qHk",
                      "updatedAt": "2025-01-01T00:00:00Z"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.ListApiKeysResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "List API Keys",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.ListApiKeysRequest",
        "x-poly-response-type": "auth.v1.ListApiKeysResponse"
      },
      "post": {
        "description": "Create a new API key for the caller account, including public key material and metadata.",
        "operationId": "ApiKeyService_CreateApiKey",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "color": "#7C3AED",
                "icon": "💰",
                "ipWhitelist": [
                  "203.0.113.0/24"
                ],
                "label": "Trading Bot",
                "publicKeyEd25519": "AA==",
                "subaccountId": "6789012345678"
              },
              "schema": {
                "$ref": "#/components/schemas/auth.v1.CreateApiKeyRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/auth.v1.CreateApiKeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "apiKey": {
                    "color": "#7C3AED",
                    "createdAt": "2025-01-01T00:00:00Z",
                    "createdByActor": "dashboard",
                    "expiresAt": "2025-01-01T00:00:00Z",
                    "icon": "💰",
                    "ipWhitelist": [
                      "203.0.113.0/24"
                    ],
                    "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542",
                    "label": "Trading Bot",
                    "lastUsedAt": "2025-01-01T00:00:00Z",
                    "policyId": "ADVPd9FYi2",
                    "publicKeyEd25519": "AA==",
                    "revision": "1",
                    "status": "ACTIVE",
                    "subaccountId": "39HwgZg2gCw",
                    "updatedAt": "2025-01-01T00:00:00Z"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.CreateApiKeyResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Create API Key",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "fresh_step_up",
        "x-poly-request-type": "auth.v1.CreateApiKeyRequest",
        "x-poly-response-type": "auth.v1.CreateApiKeyResponse"
      }
    },
    "/v1/auth/api-keys/{key_id}": {
      "delete": {
        "description": "Revoke an API key owned by the caller account. Revocation is permanent.",
        "operationId": "ApiKeyService_DeleteApiKey",
        "parameters": [
          {
            "description": "Opaque API key identifier (e.g. \"ak_\u003chex\u003e\"). This is the stable public\n handle for a key.",
            "example": "ak_1a3c6de8153d5a5b04cd2a6529779542",
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "description": "Opaque API key identifier (e.g. \"ak_\u003chex\u003e\"). This is the stable public\n handle for a key.",
              "minLength": 1,
              "pattern": "^ak_[a-f0-9]{32}$",
              "title": "key_id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {},
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.DeleteApiKeyResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Delete API Key",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "fresh_step_up",
        "x-poly-request-type": "auth.v1.DeleteApiKeyRequest",
        "x-poly-response-type": "auth.v1.DeleteApiKeyResponse"
      },
      "get": {
        "description": "Retrieve a single API key owned by the caller account or scoped to a sub-account the caller administers.",
        "operationId": "ApiKeyService_GetApiKey",
        "parameters": [
          {
            "description": "Opaque API key identifier, formatted as \"ak_\" followed by 32 lowercase hex\n characters.",
            "example": "ak_1a3c6de8153d5a5b04cd2a6529779542",
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "description": "Opaque API key identifier, formatted as \"ak_\" followed by 32 lowercase hex\n characters.",
              "minLength": 1,
              "pattern": "^ak_[a-f0-9]{32}$",
              "title": "key_id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "apiKey": {
                    "color": "#7C3AED",
                    "createdAt": "2025-01-01T00:00:00Z",
                    "createdByActor": "dashboard",
                    "expiresAt": "2025-01-01T00:00:00Z",
                    "icon": "💰",
                    "ipWhitelist": [
                      "203.0.113.0/24"
                    ],
                    "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542",
                    "label": "Trading Bot",
                    "lastUsedAt": "2025-01-01T00:00:00Z",
                    "policyId": "ADVPd9FYi2",
                    "publicKeyEd25519": "AA==",
                    "revision": "1",
                    "status": "ACTIVE",
                    "subaccountId": "39HwgZg2gCw",
                    "updatedAt": "2025-01-01T00:00:00Z"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.GetApiKeyResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Get API Key",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.GetApiKeyRequest",
        "x-poly-response-type": "auth.v1.GetApiKeyResponse"
      },
      "patch": {
        "description": "Partially update API-key metadata using If-Match revision control.",
        "operationId": "ApiKeyService_UpdateApiKey_REST",
        "parameters": [
          {
            "description": "Strong ETag revision returned by the latest read.",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "pattern": "^\"[1-9][0-9]*\"$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "color": {
                    "type": "string"
                  },
                  "expiresAt": {
                    "format": "date-time",
                    "nullable": true,
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "ipWhitelist": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "label": {
                    "type": "string"
                  },
                  "status": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/polyester.rest.enum.auth.v1.ApiKeyStatus"
                      }
                    ]
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful patch",
            "headers": {
              "ETag": {
                "description": "Updated resource revision.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid patch"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Revision conflict"
          }
        },
        "summary": "Update API Key",
        "tags": [
          "API Keys"
        ],
        "x-poly-rest": true
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
