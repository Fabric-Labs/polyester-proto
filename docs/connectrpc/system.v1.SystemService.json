{
  "services": [
    {
      "name": "system.v1.SystemService",
      "doc": "SystemService serves facts about the environment itself.",
      "methods": [
        {
          "name": "GetTime",
          "path": "system.v1.SystemService/GetTime",
          "requestType": "system.v1.GetTimeRequest",
          "responseType": "system.v1.GetTimeResponse",
          "summary": "Get Server Time",
          "doc": "Get the server time in milliseconds since the Unix epoch. A request signed\n with an API key is accepted only while its X-API-TIMESTAMP is at most 1000\n ms ahead of the server time and at most its receive window behind it: the\n X-API-RECV-WINDOW header, from 1 to 60000 ms, or 5000 ms when omitted.\n Otherwise it is refused unprocessed with TIMESTAMP_SKEW, which carries the\n server time and the window too. Clients measure their clock's offset from\n this time, allowing for half the round trip. Answers are never cached.",
          "tags": [
            "changelog"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "system.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "serverTimeMs": "1763337600000"
            }
          }
        },
        {
          "name": "GetVersion",
          "path": "system.v1.SystemService/GetVersion",
          "requestType": "system.v1.GetVersionRequest",
          "responseType": "system.v1.GetVersionResponse",
          "summary": "Get Version",
          "doc": "Get the version and source revision of the build the environment serves.\n This public read supports cacheable ConnectRPC GET.",
          "tags": [
            "changelog"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "system.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "commit": "4e21a2f0967068fc944f5229eead01985df301b9",
              "environment": "testnet",
              "version": "0.10.0"
            }
          }
        },
        {
          "name": "ListStatusEvents",
          "path": "system.v1.SystemService/ListStatusEvents",
          "requestType": "system.v1.ListStatusEventsRequest",
          "responseType": "system.v1.ListStatusEventsResponse",
          "summary": "List Status Events",
          "doc": "List scheduled maintenance and incidents, the latest start first. With no\n states, it lists current and upcoming events. This public read supports\n cacheable ConnectRPC GET; answers can be up to 10 seconds old.",
          "tags": [
            "changelog"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "system.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "kinds": [
                "MAINTENANCE"
              ],
              "limit": 100,
              "pageToken": "eyJvZmZzZXQiOjEwMH0",
              "states": [
                "SCHEDULED"
              ]
            },
            "response": {
              "events": [
                {
                  "assets": [
                    "[SOL]"
                  ],
                  "cancelledAt": "2025-01-01T00:00:00Z",
                  "detailsUrl": "value",
                  "endTime": "2025-01-01T00:00:00Z",
                  "id": "2474492885707947775",
                  "impact": "DEGRADED",
                  "kind": "MAINTENANCE",
                  "markets": [
                    "value"
                  ],
                  "message": "SOL deposits are taking longer than usual to be credited. Funds are safe.",
                  "services": [
                    "TRADING"
                  ],
                  "startTime": "2026-11-12T19:30:00Z",
                  "state": "SCHEDULED",
                  "title": "SOL deposits delayed",
                  "updatedAt": "2026-11-12T19:45:00Z",
                  "updates": [
                    {
                      "createdAt": "2026-11-12T19:45:00Z",
                      "id": 1,
                      "message": "The cause is identified; credits are resuming."
                    }
                  ]
                }
              ],
              "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
            }
          }
        }
      ]
    }
  ]
}
