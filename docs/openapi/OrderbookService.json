{
  "components": {
    "schemas": {
      "orderbook.v1.Depth": {
        "description": "Depth specifies the number of price levels per side.",
        "enum": [
          "DEPTH_UNSPECIFIED",
          "DEPTH_1",
          "DEPTH_5",
          "DEPTH_10",
          "DEPTH_20",
          "DEPTH_50",
          "DEPTH_100",
          "DEPTH_200",
          "DEPTH_500",
          "DEPTH_1000"
        ],
        "title": "Depth",
        "type": "string"
      },
      "polyester.rest.OrderbookService_GetOrderBook.Response": {
        "additionalProperties": false,
        "properties": {
          "asks": {
            "description": "Best ask first; ascending price.",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "bids": {
            "description": "Best bid first; descending price.",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "bookSeq": {
            "description": "Monotonic book sequence for this symbol.",
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "symbol": {
            "description": "Trading pair symbol, e.g. BTC-USDT.",
            "type": "string"
          },
          "ts": {
            "description": "Snapshot timestamp as Unix epoch milliseconds.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "asks",
          "bids",
          "bookSeq",
          "symbol",
          "ts"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/orderbook/{symbol_id}": {
      "get": {
        "description": "Retrieve a spot order book depth snapshot for a symbol. Supports selectable depth per side and returns best bid/ask levels.",
        "operationId": "OrderbookService_GetOrderBook",
        "parameters": [
          {
            "description": "Stable numeric pair ID from GetSpotConfig.",
            "example": 1,
            "in": "path",
            "name": "symbol_id",
            "required": true,
            "schema": {
              "description": "Stable numeric pair ID from GetSpotConfig.",
              "exclusiveMinimum": 0,
              "title": "symbol_id",
              "type": "integer"
            }
          },
          {
            "description": "Requested depth per side (number of price levels). Default is 50.",
            "example": "DEPTH_1",
            "in": "query",
            "name": "depth",
            "schema": {
              "$ref": "#/components/schemas/orderbook.v1.Depth",
              "description": "Requested depth per side (number of price levels). Default is 50.",
              "title": "depth"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "asks": [
                    [
                      "5",
                      "100000"
                    ]
                  ],
                  "bids": [
                    [
                      "5",
                      "100000"
                    ]
                  ],
                  "bookSeq": "984321",
                  "symbol": "BTC-USDT",
                  "ts": 1735689600000
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.OrderbookService_GetOrderBook.Response"
                }
              }
            },
            "description": "Success"
          }
        },
        "security": [],
        "summary": "Get Order Book",
        "tags": [
          "Orderbook Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "orderbook.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "orderbook.v1.GetOrderBookRequest",
        "x-poly-response-type": "orderbook.v1.GetOrderBookResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/orderbook/{symbol}": {
      "get": {
        "description": "Retrieve a spot order book depth snapshot for a symbol. Bids are ordered best price first (descending), asks are ordered best price first (ascending), and each level is returned as a [price, quantity] tuple of decimal strings.",
        "operationId": "OrderbookService_GetOrderBook",
        "parameters": [
          {
            "description": "Trading pair symbol, e.g. BTC-USDT.",
            "example": "BTC-USDT",
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Number of price levels per side. Defaults to 50 when omitted; enum names like DEPTH_5 are also accepted.",
            "example": 1,
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "default": 50,
              "enum": [
                "1",
                "5",
                "10",
                "20",
                "50",
                "100",
                "200",
                "500",
                "1000"
              ],
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "asks": [
                    [
                      "5",
                      "100000"
                    ]
                  ],
                  "bids": [
                    [
                      "5",
                      "100000"
                    ]
                  ],
                  "bookSeq": "984321",
                  "symbol": "BTC-USDT",
                  "ts": 1735689600000
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.OrderbookService_GetOrderBook.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "Get Order Book",
        "tags": [
          "Orderbook Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.OrderbookService_GetOrderBook",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "orderbook.v1.GetOrderBookRequest",
        "x-poly-response-type": "orderbook.v1.GetOrderBookResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
