          "responseType": "chain.withdraw.v1.ListAutoWithdrawRunsResponse",
          "summary": "List the account's auto-withdraw runs with their payouts, newest first.",
          "doc": "List the account's auto-withdraw runs with their payouts, newest first.\n\n An API key needs READ_AUTO_WITHDRAW in its policy and reads only its own\n account. Both refusals answer PERMISSION_DENIED: a key whose policy lacks\n the action gets \"api key policy does not allow READ_AUTO_WITHDRAW\", and a\n key that names an account other than its own, such as a root-account key\n naming a subaccount, gets \"api key target scope mismatch\".",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
