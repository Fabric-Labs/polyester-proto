{
  "services": [
    {
      "name": "notifications.v1.NotificationService",
      "doc": "NotificationService serves the caller's notification center. Every method\n takes a session token: notifications of the account are read and marked on\n the website and in the app, never with an API key.",
      "methods": [
        {
          "name": "GetNotification",
          "path": "notifications.v1.NotificationService/GetNotification",
          "requestType": "notifications.v1.GetNotificationRequest",
          "responseType": "notifications.v1.GetNotificationResponse",
          "summary": "GetNotification reads one notification of the caller.",
          "doc": "GetNotification reads one notification of the caller.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "notifications.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "notificationId": "1"
            },
            "response": {
              "notification": {
                "category": "ALERTS",
                "createdAt": "2025-01-01T00:00:00Z",
                "notificationId": "1",
                "priceAlert": {
                  "alertId": "1",
                  "direction": "ABOVE",
                  "priceSource": "LAST_PRICE",
                  "priceTicks": "61000250000000",
                  "symbolId": 1,
                  "triggeredAt": "2025-01-01T00:00:00Z",
                  "triggeredPriceTicks": "61000250000000"
                },
                "readAt": "2025-01-01T00:00:00Z",
                "text": "value",
                "title": "My Trading Board",
                "type": "PRICE_ALERT"
              }
            }
          }
        },
        {
          "name": "GetNotificationCounts",
          "path": "notifications.v1.NotificationService/GetNotificationCounts",
          "requestType": "notifications.v1.GetNotificationCountsRequest",
          "responseType": "notifications.v1.GetNotificationCountsResponse",
          "summary": "GetNotificationCounts counts the caller's notifications and unread",
          "doc": "GetNotificationCounts counts the caller's notifications and unread\n notifications, by type.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "notifications.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "total": "1",
              "types": [
                {
                  "category": "ALERTS",
                  "total": "1",
                  "type": "PRICE_ALERT",
                  "unread": "1"
                }
              ],
              "unread": "1"
            }
          }
        },
        {
          "name": "ListNotifications",
          "path": "notifications.v1.NotificationService/ListNotifications",
          "requestType": "notifications.v1.ListNotificationsRequest",
          "responseType": "notifications.v1.ListNotificationsResponse",
          "summary": "ListNotifications lists the caller's notifications, newest first.",
          "doc": "ListNotifications lists the caller's notifications, newest first.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "notifications.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "categories": [
                "ALERTS"
              ],
              "endTime": "2025-01-01T00:00:00Z",
              "limit": 100,
              "pageToken": "eyJvZmZzZXQiOjEwMH0",
              "readState": "UNREAD",
              "startTime": "2025-01-01T00:00:00Z"
            },
            "response": {
              "nextPageToken": "eyJvZmZzZXQiOjIwMH0",
              "notifications": [
                {
                  "category": "ALERTS",
                  "createdAt": "2025-01-01T00:00:00Z",
                  "notificationId": "1",
                  "priceAlert": {
                    "alertId": "1",
                    "direction": "ABOVE",
                    "priceSource": "LAST_PRICE",
                    "priceTicks": "61000250000000",
                    "symbolId": 1,
                    "triggeredAt": "2025-01-01T00:00:00Z",
                    "triggeredPriceTicks": "61000250000000"
                  },
                  "readAt": "2025-01-01T00:00:00Z",
                  "text": "value",
                  "title": "My Trading Board",
                  "type": "PRICE_ALERT"
                }
              ]
            }
          }
        },
        {
          "name": "MarkAllNotificationsRead",
          "path": "notifications.v1.NotificationService/MarkAllNotificationsRead",
          "requestType": "notifications.v1.MarkAllNotificationsReadRequest",
          "responseType": "notifications.v1.MarkAllNotificationsReadResponse",
          "summary": "MarkAllNotificationsRead marks every unread notification of the caller",
          "doc": "MarkAllNotificationsRead marks every unread notification of the caller\n read, within the given categories and up to the given notification.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "notifications.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "categories": [
                "ALERTS"
              ],
              "throughNotificationId": "1"
            },
            "response": {
              "changed": "1"
            }
          }
        },
        {
          "name": "MarkNotificationsRead",
          "path": "notifications.v1.NotificationService/MarkNotificationsRead",
          "requestType": "notifications.v1.MarkNotificationsReadRequest",
          "responseType": "notifications.v1.MarkNotificationsReadResponse",
          "summary": "MarkNotificationsRead marks notifications of the caller read. Either",
          "doc": "MarkNotificationsRead marks notifications of the caller read. Either\n every ID is the caller's and each is marked, or nothing changes and the\n call fails with NOTIFICATION_NOT_FOUND.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "notifications.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "notificationIds": [
                "1"
              ]
            },
            "response": {
              "changed": 1
            }
          }
        },
        {
          "name": "MarkNotificationsUnread",
          "path": "notifications.v1.NotificationService/MarkNotificationsUnread",
          "requestType": "notifications.v1.MarkNotificationsUnreadRequest",
          "responseType": "notifications.v1.MarkNotificationsUnreadResponse",
          "summary": "MarkNotificationsUnread marks notifications of the caller unread. Either",
          "doc": "MarkNotificationsUnread marks notifications of the caller unread. Either\n every ID is the caller's and each is marked, or nothing changes and the\n call fails with NOTIFICATION_NOT_FOUND.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "notifications.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "notificationIds": [
                "1"
              ]
            },
            "response": {
              "changed": 1
            }
          }
        }
      ]
    }
  ]
}
