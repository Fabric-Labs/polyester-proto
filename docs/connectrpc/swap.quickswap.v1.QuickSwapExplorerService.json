{
  "services": [
    {
      "name": "swap.quickswap.v1.QuickSwapExplorerService",
      "doc": "QuickSwapExplorerService is the public, read-only view of QuickSwaps, over\n ConnectRPC and REST. It needs no credentials and lists QuickSwaps of every\n broker, Polyester's own QuickSwap app included.\n\n Only completed QuickSwaps are shown, listed or read by swap_id: one in\n progress, refunded, returned or expired never is. Each shows its assets\n and networks, the amounts deposited and delivered with their USD values\n fixed when they happened, the markets traded, and the transactions and\n addresses of its deposit and destination payout, as public on their\n networks. It shows no memo or destination tag, no return or refund\n address and nothing about the broker (see ExplorerQuickSwap).\n\n GetQuickSwapStats aggregates the same completed QuickSwaps over a window:\n totals with exact amounts per asset, a time series of counts and USD\n values, and per-route totals, with USD values fixed when they happened.\n\n QuickSwaps created before the Explorer launched are listed, but never\n match an asset filter and are not counted in statistics.\n\n Calls are rate limited per client address: over the limit a call fails\n with RESOURCE_EXHAUSTED and a Retry-After header.",
      "methods": [
        {
          "name": "GetCompletedQuickSwap",
          "path": "swap.quickswap.v1.QuickSwapExplorerService/GetCompletedQuickSwap",
          "requestType": "swap.quickswap.v1.GetCompletedQuickSwapRequest",
          "responseType": "swap.quickswap.v1.GetCompletedQuickSwapResponse",
          "summary": "Get a completed QuickSwap",
          "doc": "GetCompletedQuickSwap returns one completed QuickSwap of any broker by\n swap_id, as ListCompletedQuickSwaps lists it.\n\n Errors:\n - NOT_FOUND: SWAP_NOT_FOUND when no completed QuickSwap has this\n   swap_id: none has it, it is 0, or the QuickSwap has not completed,\n   whatever its status. Every such answer is the same, so it never tells\n   which.",
          "tags": [
            "quickswap"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "swap-api:quickswaperrors:swap.quickswap.v1.QuickSwapExplorerService/GetCompletedQuickSwap",
          "errorCodes": [
            "SWAP_NOT_FOUND"
          ],
          "examples": {
            "request": {
              "swapId": "1"
            },
            "response": {
              "quickSwap": {
                "completedAt": "2025-01-01T00:00:00Z",
                "deposits": [
                  {
                    "address": "0x3333333333333333333333333333333333333333",
                    "txHash": "0xabc123def4567890abc123def4567890abc123def4567890abc123def4567890"
                  }
                ],
                "destinationAmount": {
                  "baseUnits": "1000000",
                  "decimals": 6
                },
                "destinationValueUsd": {
                  "baseUnits": "1000000",
                  "decimals": 6
                },
                "destinationZippedAssetId": 100,
                "legs": [
                  {
                    "symbolId": 1
                  }
                ],
                "sourceAmount": {
                  "baseUnits": "1000000",
                  "decimals": 6
                },
                "sourceValueUsd": {
                  "baseUnits": "1000000",
                  "decimals": 6
                },
                "sourceZippedAssetId": 100,
                "swapId": "1",
                "withdrawals": [
                  {
                    "address": "0x3333333333333333333333333333333333333333",
                    "txHash": "0xabc123def4567890abc123def4567890abc123def4567890abc123def4567890"
                  }
                ]
              }
            }
          }
        },
        {
          "name": "GetQuickSwapStats",
          "path": "swap.quickswap.v1.QuickSwapExplorerService/GetQuickSwapStats",
          "requestType": "swap.quickswap.v1.GetQuickSwapStatsRequest",
          "responseType": "swap.quickswap.v1.GetQuickSwapStatsResponse",
          "summary": "Get QuickSwap statistics",
          "doc": "GetQuickSwapStats returns the activity of completed QuickSwaps of every\n broker over a window: its totals and the previous window's, a time\n series and every route's totals.\n\n Each window's outcome is shared for about a minute: an error too is\n returned for up to a minute before the statistics are read again.\n\n Errors:\n - INVALID_ARGUMENT: no window, or an unknown one.\n - INTERNAL: STATS_INCOMPLETE when a completed QuickSwap in the window\n   lacks its deposited or delivered amount; the error names its swap_id.",
          "tags": [
            "quickswap"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "swap-api:quickswaperrors:swap.quickswap.v1.QuickSwapExplorerService/GetQuickSwapStats",
          "errorCodes": [
            "STATS_INCOMPLETE"
          ],
          "examples": {
            "request": {
              "window": "LAST_24_HOURS"
            },
            "response": {
