{
  "types": [
    {
      "name": "changelog.v1.Audience",
      "kind": "enum",
      "doc": "Audience is a group of users a change is addressed to.",
      "enum": {
        "values": [
          {
            "name": "ALL_USERS",
            "number": 1,
            "doc": "Everyone."
          },
          {
            "name": "TRADERS",
            "number": 2,
            "doc": "Traders."
          },
          {
            "name": "MARKET_MAKERS",
            "number": 3,
            "doc": "Market makers."
          },
          {
            "name": "DEVELOPERS",
            "number": 4,
            "doc": "Developers and API integrators."
          }
        ]
      }
    },
    {
      "name": "changelog.v1.Change",
      "kind": "message",
      "doc": "Change is one announced change. Published content never changes.",
      "message": {
        "fields": [
          {
            "name": "id",
            "jsonName": "id",
            "number": 1,
            "doc": "Stable opaque 64-bit identifier, identical across environments.",
            "protoScalar": "fixed64",
            "jsonType": "string",
            "format": "fixed64"
          },
          {
            "name": "title",
            "jsonName": "title",
            "number": 2,
            "doc": "Short title.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "summary",
            "jsonName": "summary",
            "number": 3,
            "doc": "One-paragraph summary.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "details",
            "jsonName": "details",
            "number": 4,
            "doc": "Longer explanation; paragraphs separated by blank lines. Omitted when absent.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "category",
            "jsonName": "category",
            "number": 5,
            "doc": "Category.",
            "protoRef": "changelog.v1.ChangeCategory"
          },
          {
            "name": "action_required",
            "jsonName": "actionRequired",
            "number": 6,
            "doc": "True when users or integrators must act.",
            "protoScalar": "bool",
            "jsonType": "boolean"
          },
          {
            "name": "migration_guidance",
            "jsonName": "migrationGuidance",
            "number": 7,
            "doc": "What to do, when action is required. Omitted when absent.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "audiences",
            "jsonName": "audiences",
            "number": 8,
            "doc": "Audiences addressed. Never empty.",
            "repeated": true,
            "protoRef": "changelog.v1.Audience"
          },
          {
            "name": "surfaces",
            "jsonName": "surfaces",
            "number": 9,
            "doc": "Product areas affected. May be empty.",
            "repeated": true,
            "protoRef": "changelog.v1.Surface"
          }
        ]
      }
    },
    {
      "name": "changelog.v1.ChangeCategory",
      "kind": "enum",
      "doc": "ChangeCategory classifies one change.",
      "enum": {
        "values": [
          {
            "name": "BREAKING_CHANGE",
            "number": 1,
            "doc": "Breaking change: existing integrations may need to change."
          },
          {
            "name": "NEW_FEATURE",
            "number": 2,
            "doc": "New capability."
          },
          {
            "name": "IMPROVEMENT",
            "number": 3,
            "doc": "Improvement to existing behavior."
          },
          {
            "name": "BUG_FIX",
            "number": 4,
            "doc": "Bug fix."
          }
        ]
      }
    },
    {
      "name": "changelog.v1.ChangeEntry",
      "kind": "message",
      "doc": "ChangeEntry is one change with the post that announced it.",
      "message": {
        "fields": [
          {
            "name": "change",
            "jsonName": "change",
            "number": 1,
            "doc": "The change.",
            "protoRef": "changelog.v1.Change"
          },
          {
            "name": "post_slug",
            "jsonName": "postSlug",
            "number": 2,
            "doc": "Slug of the announcing post.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "published_at",
            "jsonName": "publishedAt",
            "number": 3,
            "doc": "Publication time of the announcing post.",
            "protoRef": "google.protobuf.Timestamp",
            "jsonType": "string",
            "format": "date-time"
          },
          {
            "name": "section_heading",
            "jsonName": "sectionHeading",
            "number": 4,
            "doc": "Heading of the section containing the change.",
            "protoScalar": "string",
            "jsonType": "string"
          }
        ]
      }
    },
    {
      "name": "changelog.v1.GetPostRequest",
      "kind": "message",
      "doc": "GetPostRequest selects one post.",
      "message": {
        "fields": [
          {
            "name": "slug",
            "jsonName": "slug",
            "number": 1,
            "doc": "Post slug.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "minLen": 1,
                "maxLen": 200
              }
            }
          }
        ]
      }
    },
    {
      "name": "changelog.v1.GetPostResponse",
      "kind": "message",
      "doc": "GetPostResponse returns one complete post.",
      "message": {
        "fields": [
          {
            "name": "post",
            "jsonName": "post",
            "number": 1,
            "doc": "The post with every section and change. A post can hold several hundred\n changes; use ListChanges with post_slug to page through them instead.",
            "protoRef": "changelog.v1.Post"
          }
        ]
      }
    },
    {
      "name": "changelog.v1.ListChangesRequest",
      "kind": "message",
      "doc": "ListChangesRequest queries changes across posts. Filters on different fields\n combine with AND; values within one field combine with OR.",
      "message": {
        "cel": [
          {
            "id": "list_changes_request.valid_window",
            "message": "end_time must be after start_time when both are set",
            "expression": "!has(this.start_time) || !has(this.end_time) || this.end_time \u003e this.start_time"
          }
        ],
        "fields": [
          {
            "name": "categories",
            "jsonName": "categories",
            "number": 1,
            "doc": "Categories to include. Empty means all.",
            "repeated": true,
            "protoRef": "changelog.v1.ChangeCategory",
            "validate": {
              "repeated": {
                "maxItems": 4,
                "unique": true
              }
            }
          },
          {
            "name": "action_required",
            "jsonName": "actionRequired",
            "number": 2,
            "doc": "When set, only changes whose action_required equals this value.",
            "protoScalar": "bool",
            "jsonType": "boolean"
          },
          {
            "name": "surfaces",
            "jsonName": "surfaces",
            "number": 3,
            "doc": "Surfaces to include. Empty means all.",
            "repeated": true,
            "protoRef": "changelog.v1.Surface",
            "validate": {
              "repeated": {
                "maxItems": 10,
                "unique": true
              }
            }
          },
          {
            "name": "audiences",
            "jsonName": "audiences",
            "number": 4,
            "doc": "Audiences to include. Empty means all. Changes addressed to ALL_USERS\n always match.",
            "repeated": true,
            "protoRef": "changelog.v1.Audience",
            "validate": {
              "repeated": {
                "maxItems": 4,
                "unique": true
              }
            }
          },
          {
            "name": "start_time",
            "jsonName": "startTime",
            "number": 5,
            "doc": "Inclusive lower bound on post publication time. Optional.",
            "protoRef": "google.protobuf.Timestamp",
            "jsonType": "string",
            "format": "date-time"
          },
          {
            "name": "end_time",
            "jsonName": "endTime",
            "number": 6,
            "doc": "Exclusive upper bound on post publication time. Optional; must be after\n start_time when both are set.",
            "protoRef": "google.protobuf.Timestamp",
            "jsonType": "string",
            "format": "date-time"
          },
          {
            "name": "post_slug",
            "jsonName": "postSlug",
            "number": 7,
            "doc": "Restrict to one post. Optional.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "maxLen": 200
              }
            }
          },
          {
            "name": "sort",
            "jsonName": "sort",
            "number": 8,
            "doc": "Order of posts. Changes keep publication order inside each post.",
            "protoRef": "changelog.v1.SortDirection",
            "validate": {
              "enum": {
                "definedOnly": true
              }
            }
          },
          {
            "name": "limit",
            "jsonName": "limit",
            "number": 9,
            "doc": "Maximum changes to return. 0 means the default of 100; maximum 500.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32",
            "validate": {
              "number": {
                "lte": "500"
              }
            }
          },
          {
            "name": "page_token",
            "jsonName": "pageToken",
            "number": 10,
            "doc": "Opaque, keyset-backed, exclusive cursor from a previous response. Reuse\n it only with the same filters, time bounds and sort.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "maxLen": 512
              }
            }
          }
        ]
      }
    },
    {
      "name": "changelog.v1.ListChangesResponse",
      "kind": "message",
      "doc": "ListChangesResponse returns matching changes.",
      "message": {
        "fields": [
          {
            "name": "changes",
            "jsonName": "changes",
            "number": 1,
            "doc": "Matching changes in the requested order.",
            "repeated": true,
            "protoRef": "changelog.v1.ChangeEntry"
          },
          {
            "name": "next_page_token",
            "jsonName": "nextPageToken",
            "number": 2,
            "doc": "Cursor for the next page. Empty when no more results exist.",
            "protoScalar": "string",
            "jsonType": "string"
          }
        ]
      }
    },
    {
      "name": "changelog.v1.ListPostsRequest",
      "kind": "message",
      "doc": "ListPostsRequest pages through published posts, newest first.",
      "message": {
        "fields": [
          {
            "name": "limit",
            "jsonName": "limit",
            "number": 1,
            "doc": "Maximum posts to return. 0 means the default of 20; maximum 100.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32",
            "validate": {
              "number": {
                "lte": "100"
              }
            }
          },
          {
            "name": "page_token",
            "jsonName": "pageToken",
            "number": 2,
            "doc": "Opaque, keyset-backed, exclusive cursor from a previous response.\n Bound to publication time and slug.",
            "protoScalar": "string",
            "jsonType": "string",
            "validate": {
              "string": {
                "maxLen": 512
              }
            }
          }
        ]
      }
    },
    {
      "name": "changelog.v1.ListPostsResponse",
      "kind": "message",
      "doc": "ListPostsResponse returns post summaries, newest first.",
      "message": {
        "fields": [
          {
            "name": "posts",
            "jsonName": "posts",
            "number": 1,
            "doc": "Post summaries ordered by publication time descending, then slug descending.",
            "repeated": true,
            "protoRef": "changelog.v1.PostSummary"
          },
          {
            "name": "next_page_token",
            "jsonName": "nextPageToken",
            "number": 2,
            "doc": "Cursor for the next page. Empty when no more results exist.",
            "protoScalar": "string",
            "jsonType": "string"
          }
        ]
      }
    },
    {
      "name": "changelog.v1.Post",
      "kind": "message",
      "doc": "Post is one complete published post.",
      "message": {
        "fields": [
          {
            "name": "summary",
            "jsonName": "summary",
            "number": 1,
            "doc": "Post summary.",
            "protoRef": "changelog.v1.PostSummary"
          },
          {
            "name": "sections",
            "jsonName": "sections",
            "number": 2,
            "doc": "Sections in publication order.",
            "repeated": true,
            "protoRef": "changelog.v1.Section"
          }
        ]
      }
    },
    {
      "name": "changelog.v1.PostSummary",
      "kind": "message",
      "doc": "PostSummary describes one published post without its changes.",
      "message": {
        "fields": [
          {
            "name": "slug",
            "jsonName": "slug",
            "number": 1,
            "doc": "Stable post identifier, unique within this environment.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "title",
            "jsonName": "title",
            "number": 2,
            "doc": "Title.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "introduction",
            "jsonName": "introduction",
            "number": 3,
            "doc": "Introduction.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "published_at",
            "jsonName": "publishedAt",
            "number": 4,
            "doc": "Publication time.",
            "protoRef": "google.protobuf.Timestamp",
            "jsonType": "string",
            "format": "date-time"
          },
          {
            "name": "coverage_cutoff",
            "jsonName": "coverageCutoff",
            "number": 5,
            "doc": "Exclusive upper bound of the period covered. Omitted when unknown.",
            "protoRef": "google.protobuf.Timestamp",
            "jsonType": "string",
            "format": "date-time"
          },
          {
            "name": "change_count",
            "jsonName": "changeCount",
            "number": 6,
            "doc": "Exact number of changes.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "breaking_change_count",
            "jsonName": "breakingChangeCount",
            "number": 7,
            "doc": "Exact number of BREAKING_CHANGE changes.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "action_required_count",
            "jsonName": "actionRequiredCount",
            "number": 8,
            "doc": "Exact number of changes with action_required.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "new_feature_count",
            "jsonName": "newFeatureCount",
            "number": 9,
            "doc": "Exact number of NEW_FEATURE changes.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "improvement_count",
            "jsonName": "improvementCount",
            "number": 10,
            "doc": "Exact number of IMPROVEMENT changes.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          },
          {
            "name": "bug_fix_count",
            "jsonName": "bugFixCount",
            "number": 11,
            "doc": "Exact number of BUG_FIX changes.",
            "protoScalar": "uint32",
            "jsonType": "integer",
            "format": "int32"
          }
        ]
      }
    },
    {
      "name": "changelog.v1.Section",
      "kind": "message",
      "doc": "Section groups related changes inside a post.",
      "message": {
        "fields": [
          {
            "name": "heading",
            "jsonName": "heading",
            "number": 1,
            "doc": "Section heading.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "summary",
            "jsonName": "summary",
            "number": 2,
            "doc": "Section summary. Omitted when absent.",
            "protoScalar": "string",
            "jsonType": "string"
          },
          {
            "name": "changes",
            "jsonName": "changes",
            "number": 3,
            "doc": "Changes in publication order.",
            "repeated": true,
            "protoRef": "changelog.v1.Change"
          },
          {
            "name": "surface",
            "jsonName": "surface",
            "number": 4,
            "doc": "Product area of the section. SURFACE_UNSPECIFIED for sections not tied to\n one area (for example changes that need your attention, or general).",
            "protoRef": "changelog.v1.Surface"
          }
        ]
      }
    },
    {
      "name": "changelog.v1.SortDirection",
      "kind": "enum",
      "doc": "SortDirection orders changes by post publication time.",
      "enum": {
        "values": [
          {
            "name": "SORT_ASC",
            "number": 1,
            "doc": "Ascending (oldest first)."
          },
          {
            "name": "SORT_DESC",
            "number": 2,
            "doc": "Descending (newest first)."
          }
        ]
      }
    },
    {
      "name": "changelog.v1.Surface",
      "kind": "enum",
      "doc": "Surface is the product area a change affects.",
      "enum": {
        "values": [
          {
            "name": "TRADING",
            "number": 1,
            "doc": "Orders, triggers and protective orders, and order outcomes."
          },
          {
            "name": "FUNDING",
            "number": 2,
            "doc": "Deposits, withdrawals and transfers."
          },
          {
            "name": "ACCOUNTS",
            "number": 3,
            "doc": "Accounts, subaccounts and security."
          },
          {
            "name": "API",
            "number": 4,
            "doc": "Programmatic API."
          },
          {
            "name": "EXPLORER",
            "number": 5,
            "doc": "Block explorer."
          },
          {
            "name": "DOCUMENTATION",
            "number": 6,
            "doc": "Documentation."
          },
          {
            "name": "PLATFORM",
            "number": 7,
            "doc": "Platform-wide behavior."
          },
          {
            "name": "MARKET_DATA",
            "number": 8,
            "doc": "Market data: prices, candles, order book, heatmaps and market overviews."
          },
          {
            "name": "QUICKSWAP",
            "number": 9,
            "doc": "The QuickSwap swap app."
          },
          {
            "name": "REWARDS",
            "number": 10,
            "doc": "Rewards: daily claims, campaigns, VIP tiers and fee discounts."
          }
        ]
      }
    }
  ]
}
