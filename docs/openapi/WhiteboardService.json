  "paths": {
    "/v1/collab/whiteboards": {
      "get": {
        "description": "List collaborative whiteboards visible to the caller in most-recently-updated order.",
        "operationId": "WhiteboardService_ListBoards",
        "parameters": [
          {
            "description": "When true, include archived boards in the response.",
            "example": false,
            "in": "query",
            "name": "includeArchived",
            "schema": {
              "description": "When true, include archived boards in the response.",
              "title": "include_archived",
              "type": "boolean"
            }
          },
          {
            "description": "Maximum number of boards to return. Defaults to 100 when omitted; maximum\n is 500.",
            "example": 100,
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum number of boards to return. Defaults to 100 when omitted; maximum\n is 500.",
              "maximum": 500,
              "title": "limit",
              "type": "integer"
            }
          },
          {
            "description": "Opaque keyset cursor from a previous response. The cursor is exclusive and\n bound to the authenticated caller, archive filter, and newest-updated sort\n order.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "pageToken",
            "schema": {
              "description": "Opaque keyset cursor from a previous response. The cursor is exclusive and\n bound to the authenticated caller, archive filter, and newest-updated sort\n order.",
              "maxLength": 512,
              "title": "page_token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "boards": [
                    {
                      "access": {
                        "permissions": {
                          "canEdit": false,
                          "canManage": false,
                          "canView": false
                        },
                        "role": "VIEWER"
                      },
                      "board": {
                        "accessVersion": "1",
                        "archivedAt": "2025-01-01T00:00:00Z",
                        "audience": "PRIVATE",
                        "boardId": "123e4567-e89b-42d3-a456-426614174000",
                        "createdAt": "2025-01-01T00:00:00Z",
                        "defaultRole": "VIEWER",
                        "initialSnapshot": {
                          "elements": [],
                          "version": 1
                        },
                        "ownerAccountId": "7563897446546",
                        "title": "My Trading Board",
                        "updatedAt": "2025-01-01T00:00:00Z"
                      }
                    }
                  ],
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
                },
                "schema": {
                  "$ref": "#/components/schemas/collab.v1.ListBoardsResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "List Whiteboards",
        "tags": [
          "Whiteboard Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "collab.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "collab.v1.ListBoardsRequest",
        "x-poly-response-type": "collab.v1.ListBoardsResponse"
      },
