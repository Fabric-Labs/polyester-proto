{
  "components": {
    "schemas": {
      "polyester.rest.OrderbookService_GetOrderBook.Response": {
        "additionalProperties": false,
        "properties": {
          "asks": {
            "description": "Best ask first; ascending price.",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "bids": {
            "description": "Best bid first; descending price.",
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "bookSeq": {
            "description": "Monotonic book sequence for this symbol.",
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "symbol": {
            "description": "Trading pair symbol, e.g. BTC-USDT.",
            "type": "string"
          },
          "ts": {
            "description": "Snapshot timestamp as Unix epoch milliseconds.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "asks",
          "bids",
          "bookSeq",
          "symbol",
          "ts"
        ],
        "type": "object"
      },
      "polyester.rest.enum.orderbook.v1.Depth.integer": {
        "enum": [
          1,
          5,
          10,
          20,
          50,
          100,
          200,
          500,
          1000
        ],
        "type": "integer",
        "x-poly-enum-descriptions": {
          "1": "1 level per side (top of book / best bid-ask).",
          "10": "10 levels per side.",
          "100": "100 levels per side.",
          "1000": "1000 levels per side.",
          "20": "20 levels per side.",
          "200": "200 levels per side.",
          "5": "5 levels per side.",
          "50": "50 levels per side.",
          "500": "500 levels per side."
        }
      }
