                        "baseUnits": "value",
                        "decimals": 36
                      },
                      "assetId": 100
                    }
                  ],
                  "fees": [
                    {
                      "affiliateFee": {
                        "baseUnits": "value",
                        "decimals": 36
                      },
                      "assetId": 100,
                      "brokerFee": {
                        "baseUnits": "value",
                        "decimals": 36
                      },
                      "serviceFee": {
                        "baseUnits": "value",
                        "decimals": 36
                      }
                    }
                  ],
