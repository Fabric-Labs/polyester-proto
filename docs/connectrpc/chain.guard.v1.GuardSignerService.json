{
  "services": [
    {
      "name": "chain.guard.v1.GuardSignerService",
      "doc": "GuardSignerService manages guard signer lifecycle and approval signatures.",
      "methods": [
        {
          "name": "BatchSignProtectedActions",
          "path": "chain.guard.v1.GuardSignerService/BatchSignProtectedActions",
          "requestType": "chain.guard.v1.BatchSignProtectedActionsRequest",
          "responseType": "chain.guard.v1.BatchSignProtectedActionsResponse",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "chain.guard.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "actions": [
                {
                  "action": "PROTECTED_ACTION_FUNDING_SET_EXTERNAL_WHITELIST_REQUIRED",
                  "args": {
                    "externalWhitelist": {
                      "addresses": [
                        "value"
                      ],
                      "polychainChainId": 1
                    },
                    "internalWhitelist": {
                      "addresses": [
                        "value"
                      ]
                    },
                    "whitelistRequirement": {
                      "required": false
                    }
                  }
                }
              ],
              "subaccountId": "6789012345678"
            },
            "response": {
              "approvals": [
                {
                  "deadlineUnix": "1",
                  "nonceSpace": "example-nonce-12345",
                  "signature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
                }
              ]
            }
          }
        },
        {
          "name": "CreateGuardSignerWallet",
          "path": "chain.guard.v1.GuardSignerService/CreateGuardSignerWallet",
          "requestType": "chain.guard.v1.CreateGuardSignerWalletRequest",
          "responseType": "chain.guard.v1.CreateGuardSignerWalletResponse",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "chain.guard.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "signerAddress": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          }
        },
        {
          "name": "ExportGuardSignerWallet",
          "path": "chain.guard.v1.GuardSignerService/ExportGuardSignerWallet",
          "requestType": "chain.guard.v1.ExportGuardSignerWalletRequest",
          "responseType": "chain.guard.v1.ExportGuardSignerWalletResponse",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "chain.guard.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "privateKey": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          }
        },
        {
          "name": "GetGuardSignerStatus",
          "path": "chain.guard.v1.GuardSignerService/GetGuardSignerStatus",
          "requestType": "chain.guard.v1.GetGuardSignerStatusRequest",
          "responseType": "chain.guard.v1.GetGuardSignerStatusResponse",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "chain.guard.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "status": "accepted"
            }
          }
        },
        {
          "name": "RotateGuardSignerWallet",
          "path": "chain.guard.v1.GuardSignerService/RotateGuardSignerWallet",
          "requestType": "chain.guard.v1.RotateGuardSignerWalletRequest",
          "responseType": "chain.guard.v1.RotateGuardSignerWalletResponse",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "chain.guard.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "approval": {
                "deadlineUnix": "1",
                "nonceSpace": "example-nonce-12345",
                "signature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
              },
              "newSignerAddress": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          }
        },
        {
          "name": "SignProtectedAction",
          "path": "chain.guard.v1.GuardSignerService/SignProtectedAction",
          "requestType": "chain.guard.v1.SignProtectedActionRequest",
          "responseType": "chain.guard.v1.SignProtectedActionResponse",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "chain.guard.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "action": "PROTECTED_ACTION_FUNDING_SET_EXTERNAL_WHITELIST_REQUIRED",
              "args": {
                "externalWhitelist": {
                  "addresses": [
                    "value"
                  ],
                  "polychainChainId": 1
                },
                "internalWhitelist": {
                  "addresses": [
                    "value"
                  ]
                },
                "whitelistRequirement": {
                  "required": false
                }
              },
              "subaccountId": "6789012345678"
            },
            "response": {
              "approval": {
                "deadlineUnix": "1",
                "nonceSpace": "example-nonce-12345",
                "signature": "0xabcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
              }
            }
          }
        }
      ]
    }
  ]
}
