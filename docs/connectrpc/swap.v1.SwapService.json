                }
              }
            }
          }
        },
        {
          "name": "QuoteSwap",
          "path": "swap.v1.SwapService/QuoteSwap",
          "requestType": "swap.v1.QuoteSwapRequest",
          "responseType": "swap.v1.QuoteSwapResponse",
          "summary": "QuoteSwap prices terms against current order-book depth and the account's",
          "doc": "QuoteSwap prices terms against current order-book depth and the account's\n taker fee. Nothing is reserved.\n\n Errors:\n - INVALID_ARGUMENT: malformed request, AMOUNT_OUT_OF_RANGE or\n   INVALID_SUBACCOUNT_ID.\n - FAILED_PRECONDITION: ROUTE_UNSUPPORTED, DIRECTION_UNSUPPORTED,\n   PROTECTION_UNACHIEVABLE or SUBACCOUNT_INACTIVE.\n - NOT_FOUND: SUBACCOUNT_NOT_FOUND.\n - PERMISSION_DENIED: SWAP_NOT_PERMITTED.\n - UNAVAILABLE: QUOTE_UNAVAILABLE or SERVICE_UNAVAILABLE; retry later.\n - UNAUTHENTICATED: missing or invalid credentials.",
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "maxSlippageBps": 1,
              "terms": {
