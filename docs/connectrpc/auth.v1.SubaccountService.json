              }
            }
          }
        },
        {
          "name": "UpdateSubaccountMemberRole",
          "path": "auth.v1.SubaccountService/UpdateSubaccountMemberRole",
          "requestType": "auth.v1.UpdateSubaccountMemberRoleRequest",
          "responseType": "auth.v1.UpdateSubaccountMemberRoleResponse",
          "summary": "Update an existing sub-account member's role (owner/admin only).",
          "doc": "Update an existing sub-account member's role (owner/admin only).",
          "tags": [
