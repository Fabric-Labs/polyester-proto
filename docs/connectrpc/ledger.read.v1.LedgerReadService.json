{
  "services": [
    {
      "name": "ledger.read.v1.LedgerReadService",
      "doc": "LedgerReadService exposes read-only ledger endpoints (balances, history, transfers, holds).",
      "methods": [
        {
          "name": "GetBalanceHistory",
          "path": "ledger.read.v1.LedgerReadService/GetBalanceHistory",
          "requestType": "ledger.read.v1.GetBalanceHistoryRequest",
          "responseType": "ledger.read.v1.GetBalanceHistoryResponse",
          "summary": "Retrieve balance history buckets for an account.",
          "doc": "Retrieve balance history buckets for an account.\n Supports optional subaccount, range, asset, and account-code filters.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "accountCodes": [
                "FUNDING"
              ],
              "ledger": 1,
              "range": "DAY_1",
              "subaccountId": "6789012345678"
            },
            "response": {
              "bucket": "1m",
              "endTsSec": 1735689600,
              "points": 1,
              "range": "DAY_1",
              "series": [
                {
                  "accountCode": "FUNDING",
                  "assetId": 100,
                  "balanceQ": [
                    "1"
                  ]
                }
              ],
              "startTsSec": 1735689600
            }
          }
        },
        {
          "name": "GetBalances",
          "path": "ledger.read.v1.LedgerReadService/GetBalances",
          "requestType": "ledger.read.v1.GetBalancesRequest",
          "responseType": "ledger.read.v1.GetBalancesResponse",
          "summary": "Retrieve the latest balances for an account.",
          "doc": "Retrieve the latest balances for an account.\n Supports optional subaccount scoping and returns asset symbols with decimal amounts on REST.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "balances": [
                {
                  "assetId": 100,
                  "available": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "funding": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "postedVersion": "1",
                  "reserved": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "reservedVersion": "1",
                  "trading": {
                    "hi": "1",
                    "lo": "1"
                  }
                }
              ]
            }
          }
        },
        {
          "name": "GetEquityHistorySeries",
          "path": "ledger.read.v1.LedgerReadService/GetEquityHistorySeries",
          "requestType": "ledger.read.v1.GetEquityHistorySeriesRequest",
          "responseType": "ledger.read.v1.GetEquityHistorySeriesResponse",
          "summary": "Retrieve equity history as columnar series data.",
          "doc": "Retrieve equity history as columnar series data.\n Supports optional subaccount, range, account-code filtering, and grouping by account or asset.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "accountCodes": [
                "FUNDING"
              ],
              "groupBy": "GROUP_BY_ACCOUNT",
              "range": "DAY_1",
              "subaccountId": "6789012345678"
            },
            "response": {
              "btcPricesQ": [
                "5000000"
              ],
              "bucket": "1m",
              "endTsSec": 1735689600,
              "points": 1,
              "quoteAsset": "value",
              "range": "DAY_1",
              "series": [
                {
                  "account": {
                    "accountCode": 1,
                    "name": "value"
                  },
                  "asset": {
                    "id": 1,
                    "symbol": "BTC-USDT"
                  },
                  "equityQ": [
                    "1"
                  ]
                }
              ],
              "startTsSec": 1735689600
            }
          }
        },
        {
          "name": "ListHolds",
          "path": "ledger.read.v1.LedgerReadService/ListHolds",
          "requestType": "ledger.read.v1.ListHoldsRequest",
          "responseType": "ledger.read.v1.ListHoldsResponse",
          "summary": "ListHolds returns pending holds with integer amounts (u128) and asset ids.",
          "doc": "ListHolds returns pending holds with integer amounts (u128) and asset ids.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "limit": 100,
              "pageToken": "value",
              "reversed": false,
              "subaccountId": "6789012345678"
            },
            "response": {
              "holds": [
                {
                  "amountReservedE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetId": 100,
                  "expiresAtNs": "1",
                  "holdId": "1"
                }
              ],
              "nextPageToken": "value"
            }
          }
        },
        {
          "name": "ListTransfers",
          "path": "ledger.read.v1.LedgerReadService/ListTransfers",
          "requestType": "ledger.read.v1.ListTransfersRequest",
          "responseType": "ledger.read.v1.ListTransfersResponse",
          "summary": "List finalized transfer history for an account.",
          "doc": "List finalized transfer history for an account.\n Supports optional subaccount, asset, ordering, and cursor filters.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "ledger": 1,
              "limit": 100,
              "pageToken": "value",
              "reversed": false,
              "subaccountId": "6789012345678",
              "transferCode": "DEPOSIT",
              "tsMaxUs": "1",
              "tsMinUs": "1"
            },
            "response": {
              "nextPageToken": "value",
              "transfers": [
                {
                  "accountCode": "FUNDING",
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetId": 100,
                  "balanceAfterE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "destination": {
                    "accountId": "7563897446546",
                    "address": "value",
                    "kind": "FUNDING_ACCOUNT"
                  },
                  "flowId": "value",
                  "isDebit": false,
                  "linkId": "1",
                  "source": {
                    "accountId": "7563897446546",
                    "address": "value",
                    "kind": "FUNDING_ACCOUNT"
                  },
                  "transferCode": "DEPOSIT",
                  "tsUs": "1"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
