{
  "components": {
    "schemas": {
      "auth.v1.GetSocialVerificationResponse": {
        "additionalProperties": false,
        "description": "GetSocialVerificationResponse contains the caller's current social\n verification state for one provider.",
        "properties": {
          "verification": {
            "$ref": "#/components/schemas/auth.v1.SocialVerification",
            "description": "Current verification state for the requested provider.",
            "title": "verification"
          }
        },
        "title": "GetSocialVerificationResponse",
        "type": "object"
      },
      "auth.v1.SocialProvider": {
        "description": "Social account provider used for account ownership verification.",
        "enum": [
          "PROVIDER_UNSPECIFIED",
          "TWITTER",
          "DISCORD"
        ],
        "title": "SocialProvider",
        "type": "string"
      },
      "auth.v1.SocialVerificationReadyRequest": {
        "additionalProperties": false,
        "description": "SocialVerificationReadyRequest tells the API that the challenge code has been\n placed and the provider account is ready to check.",
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/auth.v1.SocialProvider",
            "description": "Provider account to check.",
            "not": {
              "enum": [
                0
              ]
            },
            "title": "provider"
          }
        },
        "required": [
          "provider"
        ],
        "title": "SocialVerificationReadyRequest",
        "type": "object"
      },
      "auth.v1.SocialVerificationReadyResponse": {
        "additionalProperties": false,
        "description": "SocialVerificationReadyResponse returns the verification after it has been\n queued for a provider check.",
        "properties": {
          "verification": {
            "$ref": "#/components/schemas/auth.v1.SocialVerification",
            "description": "Current verification state after the provider check was requested.",
            "title": "verification"
          }
        },
        "title": "SocialVerificationReadyResponse",
        "type": "object"
      },
      "auth.v1.StartSocialVerificationRequest": {
        "additionalProperties": false,
        "description": "StartSocialVerificationRequest starts or restarts social account verification.\n Starting again for the same provider replaces the previous challenge.\ntwitter_handle_format // twitter handle must be 1-15 chars [A-Za-z0-9_], without '@'\n",
        "properties": {
          "handle": {
            "description": "Provider handle the user claims. A leading \"@\" is accepted and removed.\n X/Twitter handles must be 1 to 15 letters, digits, or underscores.\n Other provider handles can be up to 64 characters.\nhandle.no_angle_brackets // handle must not contain '\u003c' or '\u003e'\n",
            "maxLength": 64,
            "minLength": 1,
            "title": "handle",
            "type": "string"
          },
          "method": {
            "$ref": "#/components/schemas/auth.v1.SocialVerificationMethod",
            "description": "Verification method. If unspecified, profile verification is used.",
            "title": "method"
          },
          "provider": {
            "$ref": "#/components/schemas/auth.v1.SocialProvider",
            "description": "Provider account to verify.",
            "not": {
              "enum": [
                0
              ]
            },
            "title": "provider"
          }
        },
        "required": [
          "provider",
          "handle"
        ],
        "title": "StartSocialVerificationRequest",
        "type": "object"
      },
      "auth.v1.StartSocialVerificationResponse": {
        "additionalProperties": false,
        "description": "Response returned after starting social account verification.",
        "properties": {
          "challengeCode": {
            "description": "Challenge code the user must place according to the verification method.",
            "title": "challenge_code",
            "type": "string"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/google.protobuf.Timestamp",
            "description": "Time in UTC when the challenge code expires. Social verification challenges\n expire after 15 minutes.",
            "title": "expires_at"
          },
          "verification": {
            "$ref": "#/components/schemas/auth.v1.SocialVerification",
            "description": "Current verification state after issuing the challenge.",
            "title": "verification"
          }
        },
        "title": "StartSocialVerificationResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/social/verification": {
      "get": {
        "description": "Retrieve current social verification status for the caller.",
        "operationId": "SocialVerificationService_GetSocialVerification",
        "parameters": [
          {
            "description": "Provider account to inspect.",
            "example": "TWITTER",
            "in": "query",
            "name": "provider",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/auth.v1.SocialProvider",
              "description": "Provider account to inspect.",
              "not": {
                "enum": [
                  0
                ]
              },
              "title": "provider"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "verification": {
                    "attempts": 1,
                    "challengeCode": "POLY-VERIFY-7K2M",
                    "expiresAt": "2025-01-01T00:00:00Z",
                    "handle": "polyester_trader",
                    "id": "6ibQM6ok8k",
                    "lastError": "The profile could not be verified.",
                    "method": "METHOD_PROFILE",
                    "provider": "TWITTER",
                    "providerUserId": "123456789012345678",
                    "requestedAt": "2025-01-01T00:00:00Z",
                    "status": "STATUS_PENDING_USER_ACTION",
                    "updatedAt": "2025-01-01T00:00:00Z",
                    "verifiedAt": "2025-01-01T00:00:00Z"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.GetSocialVerificationResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Get Social Verification",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-request-type": "auth.v1.GetSocialVerificationRequest",
        "x-poly-response-type": "auth.v1.GetSocialVerificationResponse"
      }
    },
    "/v1/auth/social/verification:ready": {
      "post": {
        "description": "Mark verification as ready and request a provider account check.",
        "operationId": "SocialVerificationService_SocialVerificationReady",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "provider": "TWITTER"
              },
              "schema": {
                "$ref": "#/components/schemas/auth.v1.SocialVerificationReadyRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/auth.v1.SocialVerificationReadyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "verification": {
                    "attempts": 1,
                    "challengeCode": "POLY-VERIFY-7K2M",
                    "expiresAt": "2025-01-01T00:00:00Z",
                    "handle": "polyester_trader",
                    "id": "6ibQM6ok8k",
                    "lastError": "The profile could not be verified.",
                    "method": "METHOD_PROFILE",
                    "provider": "TWITTER",
                    "providerUserId": "123456789012345678",
                    "requestedAt": "2025-01-01T00:00:00Z",
                    "status": "STATUS_PENDING_USER_ACTION",
                    "updatedAt": "2025-01-01T00:00:00Z",
                    "verifiedAt": "2025-01-01T00:00:00Z"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.SocialVerificationReadyResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Mark Social Verification Ready",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-request-type": "auth.v1.SocialVerificationReadyRequest",
        "x-poly-response-type": "auth.v1.SocialVerificationReadyResponse"
      }
    },
    "/v1/auth/social/verification:start": {
      "post": {
        "description": "Issue a challenge code for the caller to place in the provider account.",
        "operationId": "SocialVerificationService_StartSocialVerification",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "handle": "polyester_trader",
                "method": "METHOD_PROFILE",
                "provider": "TWITTER"
              },
              "schema": {
                "$ref": "#/components/schemas/auth.v1.StartSocialVerificationRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/auth.v1.StartSocialVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "challengeCode": "POLY-VERIFY-7K2M",
                  "expiresAt": "2025-01-01T00:00:00Z",
                  "verification": {
                    "attempts": 1,
                    "challengeCode": "POLY-VERIFY-7K2M",
                    "expiresAt": "2025-01-01T00:00:00Z",
                    "handle": "polyester_trader",
                    "id": "6ibQM6ok8k",
                    "lastError": "The profile could not be verified.",
                    "method": "METHOD_PROFILE",
                    "provider": "TWITTER",
                    "providerUserId": "123456789012345678",
                    "requestedAt": "2025-01-01T00:00:00Z",
                    "status": "STATUS_PENDING_USER_ACTION",
                    "updatedAt": "2025-01-01T00:00:00Z",
                    "verifiedAt": "2025-01-01T00:00:00Z"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.StartSocialVerificationResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Start Social Verification",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-request-type": "auth.v1.StartSocialVerificationRequest",
        "x-poly-response-type": "auth.v1.StartSocialVerificationResponse"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
