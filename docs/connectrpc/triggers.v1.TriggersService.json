        {
          "name": "ListTriggers",
          "path": "triggers.v1.TriggersService/ListTriggers",
          "requestType": "triggers.v1.ListTriggersRequest",
          "responseType": "triggers.v1.ListTriggersResponse",
          "summary": "List Triggers",
          "doc": "List triggers for a sub-account with optional filters. A list shows every\n trigger request acknowledged before it, including a trigger that ended\n right after its create. While one of them is temporarily unreadable, the\n call fails with a retryable UNAVAILABLE rather than omitting the trigger\n or returning a stale state; retry the same request. An ended trigger\n stays listable for at least 24 hours after it ends. A list whose status\n filter names live statuses only (CREATED, ARMED, RUNNING, PAUSED) never\n reads ended-trigger history and is the cheapest to serve. To track\n triggers, follow realtime trigger updates and use ListTriggers to\n recover and reconcile, not to poll. Costs one unit of the account's\n trading read limit per 100 rows the limit asks for, rounded up.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "triggers.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "clientListId": "example",
              "clientTriggerId": "9155001234567",
              "limit": 100,
              "orderListId": "9155001234568",
              "pageToken": "eyJvZmZzZXQiOjEwMH0",
              "parentOrderId": "9876543210123",
              "status": [
                "STATUS_CREATED"
              ],
              "subaccountId": "6789012345678",
              "symbolId": 1,
              "triggerType": "STOP_LOSS"
