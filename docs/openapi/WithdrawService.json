{
  "components": {
    "schemas": {
      "polyester.rest.WithdrawService_CreateTradingWithdraw.Request": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "additionalProperties": false,
            "description": "Client-signed withdraw details.",
            "properties": {
              "action": {
                "description": "Destination for funds leaving Trading.",
                "enum": [
                  "TO_FUNDING",
                  "TO_EXTERNAL_CHAIN"
                ],
                "type": "string"
              },
              "amount": {
                "description": "Withdraw amount in canonical 18-decimal unified asset units. For example, 0.5 is encoded as 500000000000000000.",
                "pattern": "^[0-9]+(\\.[0-9]+)?$",
                "type": "string"
              },
              "assetId": {
                "description": "Unified asset identifier from Polyester asset metadata. amount_e18 is denominated in this asset at canonical 18-decimal scale.",
                "format": "int32",
                "type": "integer"
              },
              "deadlineTsSec": {
                "description": "Unix timestamp in seconds after which this signed user authorization is no longer accepted by the API. This is separate from the server-owned execution deadline used later for on-chain submission.",
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              "destinationAddress": {
                "description": "Destination address. For TO_EXTERNAL_CHAIN this is an address on destination_chain_id and is validated according to that network. For TO_FUNDING, omit it to move funds to the selected account's Funding account or provide another Polyester funding address for a Trading-to-Funding transfer.",
                "type": "string"
              },
              "destinationChainId": {
                "description": "External network id for TO_EXTERNAL_CHAIN. Omit for TO_FUNDING.",
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              "idempotencyKey": {
                "description": "Client-chosen idempotency key. Reusing the same key with the same payload returns the existing withdraw; reusing it with different payload fails.",
                "type": "string"
              },
              "nonce": {
                "description": "Client-generated unsigned 128-bit nonce bound to the signed request. This is an identifier, not a decimal amount.",
                "pattern": "^[0-9]+$",
                "type": "string"
              }
            },
            "required": [
              "action",
              "amount",
              "deadlineTsSec",
              "nonce"
            ],
            "type": "object"
          },
          "payloadSignature": {
            "description": "User/API signature over deterministic TradingWithdrawIntentPayload bytes.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "polyester.rest.WithdrawService_CreateTradingWithdraw.Response": {
        "additionalProperties": false,
        "properties": {
          "intentId": {
            "description": "Stable server-owned intent identifier for the accepted withdraw lifecycle. Clients use this id to follow later progress for the same withdraw flow.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "polyester.rest.WithdrawService_CreateWalletTradingWithdraw.Request": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "additionalProperties": false,
            "description": "Client-signed withdraw details.",
            "properties": {
              "action": {
                "description": "Destination for funds leaving Trading.",
                "enum": [
                  "TO_FUNDING",
                  "TO_EXTERNAL_CHAIN"
                ],
                "type": "string"
              },
              "amount": {
                "description": "Withdraw amount in canonical 18-decimal unified asset units. For example, 0.5 is encoded as 500000000000000000.",
                "pattern": "^[0-9]+(\\.[0-9]+)?$",
                "type": "string"
              },
              "assetId": {
                "description": "Unified asset identifier from Polyester asset metadata. amount_e18 is denominated in this asset at canonical 18-decimal scale.",
                "format": "int32",
                "type": "integer"
              },
              "deadlineTsSec": {
                "description": "Unix timestamp in seconds after which this signed user authorization is no longer accepted by the API. This is separate from the server-owned execution deadline used later for on-chain submission.",
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              "destinationAddress": {
                "description": "Destination address. For TO_EXTERNAL_CHAIN this is an address on destination_chain_id and is validated according to that network. For TO_FUNDING, omit it to move funds to the selected account's Funding account or provide another Polyester funding address for a Trading-to-Funding transfer.",
                "type": "string"
              },
              "destinationChainId": {
                "description": "External network id for TO_EXTERNAL_CHAIN. Omit for TO_FUNDING.",
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              "idempotencyKey": {
                "description": "Client-chosen idempotency key. Reusing the same key with the same payload returns the existing withdraw; reusing it with different payload fails.",
                "type": "string"
              },
              "nonce": {
                "description": "Client-generated unsigned 128-bit nonce bound to the signed request. This is an identifier, not a decimal amount.",
                "pattern": "^[0-9]+$",
                "type": "string"
              }
            },
            "required": [
              "action",
              "amount",
              "deadlineTsSec",
              "nonce"
            ],
            "type": "object"
          },
          "payloadSignature": {
            "description": "Wallet EIP-712 signature over the typed withdraw payload.",
            "type": "string"
          },
          "signerWallet": {
            "description": "Wallet address that produced payload_signature.",
            "type": "string"
          },
          "subaccountId": {
            "description": "Optional public subaccount id. Omit to withdraw from the JWT root account.",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "polyester.rest.WithdrawService_CreateWalletTradingWithdraw.Response": {
        "additionalProperties": false,
        "properties": {
          "intentId": {
            "description": "Stable server-owned intent identifier for the accepted withdraw lifecycle. Clients use this id to follow later progress for the same withdraw flow.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "polyester.rest.WithdrawService_ValidateWithdrawDestination.Request": {
        "additionalProperties": false,
        "properties": {
          "destinationAddress": {
            "description": "Destination address to validate for destination_chain_id.",
            "type": "string"
          },
          "destinationChainId": {
            "description": "External destination chain identifier.",
            "pattern": "^[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "destinationAddress",
          "destinationChainId"
        ],
        "type": "object"
      },
      "polyester.rest.WithdrawService_ValidateWithdrawDestination.Response": {
        "additionalProperties": false,
        "properties": {
          "canonicalDestinationAddress": {
            "description": "Canonical destination address when valid. Empty when valid is false.",
            "type": "string"
          },
          "code": {
            "description": "Public validation outcome code.",
            "enum": [
              "VALID",
              "INVALID_ADDRESS",
              "UNSUPPORTED_CHAIN",
              "POLYESTER_SMART_ACCOUNT",
              "TOKEN_CONTRACT",
              "DENYLISTED_ADDRESS"
            ],
            "type": "string"
          },
          "message": {
            "description": "User-safe explanation of the validation outcome.",
            "type": "string"
          },
          "valid": {
            "description": "Whether the destination may be used for a withdraw.",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "valid"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/chain/trading-withdraws": {
      "post": {
        "description": "Create or return one API-key-authorized withdraw from Trading.",
        "operationId": "WithdrawService_CreateTradingWithdraw",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "payload": {
                  "action": "TO_FUNDING",
                  "amount": "18.446744073709551617",
                  "assetId": 100,
                  "deadlineTsSec": "1735689600",
                  "destinationAddress": "0x3333333333333333333333333333333333333333",
                  "destinationChainId": "1",
                  "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                  "nonce": "18446744073709551617"
                },
                "payloadSignature": "AA=="
              },
              "schema": {
                "$ref": "#/components/schemas/polyester.rest.WithdrawService_CreateTradingWithdraw.Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "intentId": "9155001234567"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.WithdrawService_CreateTradingWithdraw.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Create Trading Withdraw",
        "tags": [
          "Trading Withdraws"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.WithdrawService_CreateTradingWithdraw",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "chain.withdraw.v1.CreateTradingWithdrawRequest",
        "x-poly-response-type": "chain.withdraw.v1.CreateTradingWithdrawResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/chain/trading-withdraws:wallet": {
      "post": {
        "description": "Create or return one wallet-authorized withdraw from Trading.",
        "operationId": "WithdrawService_CreateWalletTradingWithdraw",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "payload": {
                  "action": "TO_FUNDING",
                  "amount": "18.446744073709551617",
                  "assetId": 100,
                  "deadlineTsSec": "1735689600",
                  "destinationAddress": "0x3333333333333333333333333333333333333333",
                  "destinationChainId": "1",
                  "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                  "nonce": "18446744073709551617"
                },
                "payloadSignature": "AA==",
                "signerWallet": "0x5555555555555555555555555555555555555555",
                "subaccountId": "45LUmqjT"
              },
              "schema": {
                "$ref": "#/components/schemas/polyester.rest.WithdrawService_CreateWalletTradingWithdraw.Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "intentId": "9155001234567"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.WithdrawService_CreateWalletTradingWithdraw.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Create Wallet Trading Withdraw",
        "tags": [
          "Trading Withdraws"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.WithdrawService_CreateWalletTradingWithdraw",
        "x-poly-mfa-requirement": "conditional",
        "x-poly-request-type": "chain.withdraw.v1.CreateWalletTradingWithdrawRequest",
        "x-poly-response-type": "chain.withdraw.v1.CreateWalletTradingWithdrawResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
    "/v1/chain/withdraws:validate-destination": {
      "post": {
        "description": "Validate an external-chain withdraw destination without creating a withdraw.",
        "operationId": "WithdrawService_ValidateWithdrawDestination",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "destinationAddress": "0x3333333333333333333333333333333333333333",
                "destinationChainId": "1"
              },
              "schema": {
                "$ref": "#/components/schemas/polyester.rest.WithdrawService_ValidateWithdrawDestination.Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "canonicalDestinationAddress": "value",
                  "code": "VALID",
                  "message": "value",
                  "valid": false
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.WithdrawService_ValidateWithdrawDestination.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Validate Withdraw Destination",
        "tags": [
          "Withdrawals"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.WithdrawService_ValidateWithdrawDestination",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "chain.withdraw.v1.ValidateWithdrawDestinationRequest",
        "x-poly-response-type": "chain.withdraw.v1.ValidateWithdrawDestinationResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
