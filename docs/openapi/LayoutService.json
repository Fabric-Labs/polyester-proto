  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/layouts": {
      "get": {
        "description": "List saved layouts for the caller.",
        "operationId": "LayoutService_GetLayouts",
        "parameters": [
          {
            "description": "Maximum number of layouts to return. Defaults to 100 when omitted; maximum\n is 500.",
            "example": 100,
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum number of layouts to return. Defaults to 100 when omitted; maximum\n is 500.",
              "maximum": 500,
              "title": "limit",
              "type": "integer"
            }
          },
          {
            "description": "Opaque keyset cursor from a previous response. The cursor is exclusive and\n bound to the authenticated caller and newest-updated sort order.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "pageToken",
            "schema": {
              "description": "Opaque keyset cursor from a previous response. The cursor is exclusive and\n bound to the authenticated caller and newest-updated sort order.",
              "maxLength": 512,
              "title": "page_token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "layouts": [
                    {
                      "dockviewState": "AA==",
                      "isDefault": false,
                      "layoutId": "1",
                      "name": "BTC Trading",
                      "updatedAtMs": "1",
                      "viewerId": "1",
                      "widgets": [
                        {
                          "widgetConfig": "AA==",
                          "widgetId": "chart-main",
                          "widgetType": "CHART"
                        }
                      ]
                    }
                  ],
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
                },
                "schema": {
                  "$ref": "#/components/schemas/layout.v1.GetLayoutsResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "List Layouts",
        "tags": [
          "Layouts Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "layout.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "layout.v1.GetLayoutsRequest",
        "x-poly-response-type": "layout.v1.GetLayoutsResponse"
      },
      "post": {
        "description": "Create or update a layout, including layout editor state and widget configuration.",
        "operationId": "LayoutService_UpsertLayout",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "layout": {
                  "dockviewState": "AA==",
                  "isDefault": false,
                  "layoutId": "1",
                  "name": "BTC Trading",
                  "updatedAtMs": "1",
                  "viewerId": "1",
                  "widgets": [
                    {
                      "widgetConfig": "AA==",
                      "widgetId": "chart-main",
                      "widgetType": "CHART"
                    }
                  ]
                }
              },
              "schema": {
                "$ref": "#/components/schemas/layout.v1.UpsertLayoutRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/layout.v1.UpsertLayoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "layout": {
                    "dockviewState": "AA==",
                    "isDefault": false,
                    "layoutId": "1",
                    "name": "BTC Trading",
                    "updatedAtMs": "1",
                    "viewerId": "1",
                    "widgets": [
                      {
                        "widgetConfig": "AA==",
                        "widgetId": "chart-main",
                        "widgetType": "CHART"
                      }
                    ]
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/layout.v1.UpsertLayoutResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Upsert Layout",
        "tags": [
          "Layouts Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "layout.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "layout.v1.UpsertLayoutRequest",
        "x-poly-response-type": "layout.v1.UpsertLayoutResponse"
      }
    },
    "/v1/layouts/owners/{owner_id}/published": {
      "get": {
        "description": "List layouts the owner has published for discovery.",
        "operationId": "LayoutService_ListOwnerPublishedLayouts",
        "parameters": [
          {
            "description": "Owner whose published layouts should be listed.",
            "example": "1",
            "in": "path",
            "name": "owner_id",
            "required": true,
            "schema": {
              "description": "Owner whose published layouts should be listed.",
              "format": "int64",
              "title": "owner_id",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "description": "Maximum number of templates to return. Defaults to 100 when omitted;\n maximum is 500.",
            "example": 100,
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum number of templates to return. Defaults to 100 when omitted;\n maximum is 500.",
              "maximum": 500,
              "title": "limit",
              "type": "integer"
            }
          },
          {
            "description": "Opaque keyset cursor from a previous response. The cursor is exclusive and\n bound to owner and newest-published sort order.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "pageToken",
            "schema": {
              "description": "Opaque keyset cursor from a previous response. The cursor is exclusive and\n bound to owner and newest-published sort order.",
              "maxLength": 512,
              "title": "page_token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0",
                  "templates": [
                    {
                      "description": "Example configuration for the API playground.",
                      "isListed": false,
                      "latestVersion": 1,
                      "publishedAtMs": "1",
                      "tags": [
                        "spot"
                      ],
                      "template": {
                        "ownerId": "1",
                        "templateId": "1"
                      },
                      "title": "My Trading Board",
                      "updatedAtMs": "1"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/layout.v1.ListOwnerPublishedLayoutsResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "security": [],
        "summary": "List Owner Published Layouts",
        "tags": [
          "Layouts Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "layout.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "layout.v1.ListOwnerPublishedLayoutsRequest",
        "x-poly-response-type": "layout.v1.ListOwnerPublishedLayoutsResponse"
      }
    },
