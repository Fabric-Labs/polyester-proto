                    },
                    "status": "PLACING",
                    "symbolId": 1
                  }
                ],
                "reason": "INSUFFICIENT_BALANCE",
                "receivedAmountE18": {
                  "hi": "1",
                  "lo": "1"
                },
                "sourceAssetId": 100,
                "status": "EXECUTING",
                "subaccountId": "6789012345678",
                "swapId": "1",
                "unspentAmountE18": {
                  "hi": "1",
