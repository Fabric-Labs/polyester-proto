{
  "services": [
    {
      "name": "marketoverview.v1.MarketOverviewService",
      "doc": "List ticker-style market overview rows with optional sparklines.\n Supports symbol filtering, sorting, and pagination controls.",
      "methods": [
        {
          "name": "GetCurrencyConversionConfig",
          "path": "marketoverview.v1.MarketOverviewService/GetCurrencyConversionConfig",
          "requestType": "marketoverview.v1.GetCurrencyConversionConfigRequest",
          "responseType": "marketoverview.v1.GetCurrencyConversionConfigResponse",
          "summary": "Get supported fiat and stablecoin display metadata with default English names,",
          "doc": "Get supported fiat and stablecoin display metadata with default English names,\n symbols, and fraction digits. Clients may localize presentation.",
          "tags": [
            "marketdata"
          ],
          "authRequired": false,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "marketoverview.v1",
          "errorCatalog": "md-market-overview:marketoverviewerrors",
          "examples": {
            "response": {
              "fiat": [
                {
                  "code": "value",
                  "defaultEnglishName": "value",
                  "fractionDigits": 1,
                  "symbol": "BTC-USDT"
                }
              ],
              "stablecoins": [
                {
                  "code": "value",
                  "defaultEnglishName": "value",
                  "fractionDigits": 1,
                  "symbol": "BTC-USDT"
                }
              ]
            }
          }
        },
        {
          "name": "GetCurrencyConversionRates",
          "path": "marketoverview.v1.MarketOverviewService/GetCurrencyConversionRates",
          "requestType": "marketoverview.v1.GetCurrencyConversionRatesRequest",
          "responseType": "marketoverview.v1.GetCurrencyConversionRatesResponse",
          "summary": "Get fiat units per USD and USD per stablecoin unit, grouped with source freshness.",
          "doc": "Get fiat units per USD and USD per stablecoin unit, grouped with source freshness.",
          "tags": [
            "marketdata"
          ],
          "authRequired": false,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "marketoverview.v1",
          "errorCatalog": "md-market-overview:marketoverviewerrors",
          "examples": {
            "response": {
              "fiat": {
                "rates": [
                  {
                    "code": "value",
                    "unitsPerUsdE8": "1"
                  }
                ],
                "sourceTsSec": "1735689600",
                "stale": false
              },
              "snapshotTsSec": "1735689600",
              "stablecoins": [
                {
                  "code": "value",
                  "sourceTsSec": "1735689600",
                  "stale": false,
                  "usdPerUnitE8": "1"
                }
              ]
            }
          }
        },
        {
          "name": "GetSpotVolumeHistory",
          "path": "marketoverview.v1.MarketOverviewService/GetSpotVolumeHistory",
          "requestType": "marketoverview.v1.GetSpotVolumeHistoryRequest",
          "responseType": "marketoverview.v1.GetSpotVolumeHistoryResponse",
          "summary": "Get aligned pair-level and total trailing-24h USD volume, sampled every",
          "doc": "Get aligned pair-level and total trailing-24h USD volume, sampled every\n 15 minutes over the latest day. Unavailable valuations fail the request.",
          "tags": [
            "marketdata"
          ],
          "authRequired": false,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "marketoverview.v1",
          "errorCatalog": "md-market-overview:marketoverviewerrors",
          "examples": {
            "request": {
              "symbolId": [
                1
              ]
            },
            "response": {
              "bucket": "1m",
              "endTsSec": 1735689600,
              "pairs": [
                {
                  "symbolId": 1,
                  "volumeUsdScaled": [
                    "123456"
                  ]
                }
              ],
              "points": 1,
              "startTsSec": 1735689600,
              "totalVolumeUsdScaled": [
                "123456"
              ]
            }
          }
        },
        {
          "name": "ListMarketOverview",
          "path": "marketoverview.v1.MarketOverviewService/ListMarketOverview",
          "requestType": "marketoverview.v1.ListMarketOverviewRequest",
          "responseType": "marketoverview.v1.ListMarketOverviewResponse",
          "tags": [
            "marketdata"
          ],
          "authRequired": false,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "marketoverview.v1",
          "errorCatalog": "md-market-overview:marketoverviewerrors",
          "examples": {
            "request": {
              "includeSparklines": false,
              "limit": 100,
              "orderBy": "ORDER_BY_CHANGE_24H_BPS",
              "pageToken": "eyJvZmZzZXQiOjEwMH0",
              "sort": "SORT_ASC",
              "sparklineIntervals": [
                "SPARKLINE_1H"
              ],
              "symbolId": [
                1
              ]
            },
            "response": {
              "markets": [
                {
                  "bestAskQtyScaled": "100000",
                  "bestAskTicks": "1",
                  "bestBidQtyScaled": "100000",
                  "bestBidTicks": "1",
                  "change24hBps": 123,
                  "high24hTicks": "1",
                  "indexPriceTicks": "5000000",
                  "lastPriceTicks": "5000000",
                  "lastTradeTsNs": "1735689600000000000",
                  "listedTsNs": "1735689600000000000",
                  "low24hTicks": "1",
                  "sparklines": [
                    {
                      "closeTicks": [
                        "1"
                      ],
                      "interval": "SPARKLINE_1H"
                    }
                  ],
                  "symbolId": 1,
                  "volume24hBaseScaled": "123456",
                  "volume24hQuoteScaled": "123456",
                  "volume24hUsdScaled": "123456"
                }
              ],
              "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
            }
          }
        }
      ]
    }
  ]
}
