{
  "services": [
    {
      "name": "rewards.v1.RewardCampaignService",
      "doc": "RewardCampaignService exposes published rewards to authenticated recipients.",
      "methods": [
        {
          "name": "ListMyRewardAwards",
          "path": "rewards.v1.RewardCampaignService/ListMyRewardAwards",
          "requestType": "rewards.v1.ListMyRewardAwardsRequest",
          "responseType": "rewards.v1.ListMyRewardAwardsResponse",
          "summary": "List published awards for the authenticated root account, newest first.",
          "doc": "List published awards for the authenticated root account, newest first.",
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
