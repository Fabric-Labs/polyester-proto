{
  "services": [
    {
      "name": "fees.v1.FeeService",
      "doc": "FeeService serves authenticated effective spot trading fee rates.",
      "methods": [
        {
          "name": "GetSpotFeeRates",
          "path": "fees.v1.FeeService/GetSpotFeeRates",
          "requestType": "fees.v1.GetSpotFeeRatesRequest",
          "responseType": "fees.v1.GetSpotFeeRatesResponse",
          "summary": "Get effective maker and taker fee rates, the rates an order reserves its",
          "doc": "Get effective maker and taker fee rates, the rates an order reserves its\n fee at, and the components of the effective rates for the authenticated\n caller's root account or selected subaccount.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "fees.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678",
              "symbolId": [
                1
              ]
            },
            "response": {
              "feeRates": [
                {
                  "breakdown": {
                    "accountDiscounts": [
                      {
                        "allMarkets": false,
                        "effectiveFrom": "2025-01-01T00:00:00Z",
                        "effectiveTo": "2025-01-01T00:00:00Z",
                        "makerDiscountPercent": "example",
                        "takerDiscountPercent": "example"
                      }
                    ],
                    "marketMultiplier": {
                      "effectiveFrom": "2025-01-01T00:00:00Z",
                      "effectiveTo": "2025-01-01T00:00:00Z",
                      "makerMultiplierPercent": "example",
                      "takerMultiplierPercent": "example"
                    },
                    "referralDiscount": {
                      "allMarkets": false,
                      "effectiveFrom": "2025-01-01T00:00:00Z",
                      "effectiveTo": "2025-01-01T00:00:00Z",
                      "makerDiscountPercent": "example",
                      "takerDiscountPercent": "example"
                    },
                    "tierMakerFeeRatePercent": "example",
                    "tierTakerFeeRatePercent": "example"
                  },
                  "makerFeeRatePercent": "0.09",
                  "nextChangeAt": "2025-01-01T00:00:00Z",
                  "postOnlyReserveFeeRatePercent": "example",
                  "reserveFeeRatePercent": "example",
                  "symbolId": 1,
                  "takerFeeRatePercent": "0.03",
                  "vipTier": 1
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
