{
  "streams": [
    {
      "id": "trades",
      "description": "Public trades feed (per symbol).",
      "encodings": [
        "json",
        "proto"
      ],
      "subscribeExample": {
        "channel": "public:spot:market:trades:1",
        "type": "subscribe"
      },
      "messageTypeJson": "MarketTrade",
      "messageTypeProto": "marketdata.v1.MarketTrade"
    },
    {
      "id": "candles",
      "description": "Public candle updates (per symbol, per timeframe).",
      "encodings": [
        "json",
        "proto"
      ],
      "subscribeExample": {
        "channel": "public:spot:market:candles:1m:1",
        "type": "subscribe"
      },
      "messageTypeJson": "CandlePoint",
      "messageTypeProto": "marketdata.v1.CandlePoint"
    },
    {
      "id": "orderbook",
      "description": "Public spot orderbook deltas per symbol and depth tier. JSON channel is base; protobuf channel uses the ':proto' suffix.",
      "encodings": [
        "json",
        "proto"
      ],
      "subscribeExample": {
        "channel": "public:spot:orderbook:deltas:depth:{depth}:{symbolId}",
        "type": "subscribe"
      },
      "messageTypeJson": "OrderBookDelta",
      "messageTypeProto": "orderbook.v1.OrderBookDelta"
    },
    {
      "id": "public-spot-market-candles",
      "description": "Public spot current-candle updates per timeframe and symbol. JSON channel is base; protobuf channel uses the ':proto' suffix. JSON payload uses decimal strings for OHLCV and includes 'is_closed' to mark terminal bucket updates.",
      "encodings": [
        "json",
        "proto"
      ],
      "subscribeExample": {
        "channel": "public:spot:market:candles:{timeframe}:{symbolId}",
        "type": "subscribe"
      },
      "messageTypeJson": "CandlePoint",
      "messageTypeProto": "marketdata.v1.CandlePoint"
    },
    {
      "id": "market-overview-updates",
      "description": "All-markets market overview updates (batched ticker-like stats).",
      "encodings": [
        "proto"
      ],
      "subscribeExample": {
        "channel": "public:spot:market_overview:updates:proto",
        "type": "subscribe"
      },
      "messageTypeJson": "MarketOverviewBatch",
      "messageTypeProto": "marketoverview.v1.MarketOverviewBatch"
    },
    {
      "id": "public-chain-lifecycle-flow-detail",
      "description": "Public lifecycle flow detail updates for a specific public flow id, including ordered milestone steps.",
      "encodings": [
        "json",
        "proto"
      ],
      "subscribeExample": {
        "channel": "public:chain:lifecycle:flow:{flowId}",
        "type": "subscribe"
      },
      "messageTypeJson": "chain.lifecycle.v1.FlowDetailView",
      "messageTypeProto": "chain.lifecycle.v1.FlowDetailView"
    },
    {
      "id": "public-chain-lifecycle-flows",
      "description": "Public lifecycle flow summary updates for open chain-originated deposit, withdraw, and transfer flows.",
      "encodings": [
        "json",
        "proto"
      ],
      "subscribeExample": {
        "channel": "public:chain:lifecycle:flows",
        "type": "subscribe"
      },
      "messageTypeJson": "chain.lifecycle.v1.FlowSummaryView",
      "messageTypeProto": "chain.lifecycle.v1.FlowSummaryView"
    }
  ]
}
