{
  "services": [
    {
      "name": "claims.v1.ClaimsService",
      "doc": "ClaimsService provides daily campaign rewards. A session JWT is required; API keys are not accepted.",
      "methods": [
        {
          "name": "ClaimDailyReward",
          "path": "claims.v1.ClaimsService/ClaimDailyReward",
          "requestType": "claims.v1.ClaimDailyRewardRequest",
          "responseType": "claims.v1.ClaimDailyRewardResponse",
          "summary": "Claim today's reward once for the authenticated root account. All reward assets are transferred together, and retries return the same claim.",
          "doc": "Claim today's reward once for the authenticated root account. All reward assets are transferred together, and retries return the same claim.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "claims.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "campaign": {
                "campaignId": "value",
                "claimPolicy": "UTC_DAILY",
                "description": "Example configuration for the API playground.",
                "name": "value"
              },
              "claimId": "value",
              "claimedAt": "2025-01-01T00:00:00Z",
              "resetAt": "2025-01-01T00:00:00Z",
              "rewards": [
                {
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetCode": "USDC",
                  "assetId": 100
                }
              ],
              "state": "CLAIM_AVAILABLE",
              "transfers": [
                {
                  "assetId": 100,
                  "transferId": "9155001234569"
                }
              ]
            }
          }
        },
        {
          "name": "GetDailyClaimStatus",
          "path": "claims.v1.ClaimsService/GetDailyClaimStatus",
          "requestType": "claims.v1.GetDailyClaimStatusRequest",
          "responseType": "claims.v1.GetDailyClaimStatusResponse",
          "summary": "Get today's reward and claim status for the authenticated root account. Future reward schedules are not returned.",
          "doc": "Get today's reward and claim status for the authenticated root account. Future reward schedules are not returned.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "claims.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "campaign": {
                "campaignId": "value",
                "claimPolicy": "UTC_DAILY",
                "description": "Example configuration for the API playground.",
                "name": "value"
              },
              "claimId": "value",
              "resetAt": "2025-01-01T00:00:00Z",
              "rewards": [
                {
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetCode": "USDC",
                  "assetId": 100
                }
              ],
              "state": "CLAIM_AVAILABLE"
            }
          }
        }
      ]
    }
  ]
}
