      },
      "collab.v1.BoardAclEntry": {
        "additionalProperties": false,
        "description": "BoardAclEntry grants a role to one explicit ACL subject.",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/collab.v1.BoardRole",
            "description": "Granted role for the subject. Only VIEWER and EDITOR are valid ACL roles.",
            "enum": [
              1,
              2
            ],
            "title": "role"
          },
          "subjectId": {
            "description": "Subject public ID. For USER_SUBJECT this is an account ID; for GROUP_SUBJECT this is a group ID.",
            "exclusiveMinimum": 0,
            "format": "int64",
            "title": "subject_id",
            "type": [
              "integer",
              "string"
            ]
          },
          "subjectType": {
            "$ref": "#/components/schemas/collab.v1.BoardAclSubjectType",
            "description": "Subject domain for the ACL row.",
            "not": {
              "enum": [
                0
              ]
            },
            "title": "subject_type"
          }
        },
        "required": [
          "subjectType",
          "subjectId",
          "role"
        ],
        "title": "BoardAclEntry",
        "type": "object"
      },
      "collab.v1.BoardAudience": {
        "description": "BoardAudience controls which audience rule applies when no explicit ACL entry matches.",
        "enum": [
          "AUDIENCE_UNSPECIFIED",
          "PRIVATE",
          "PUBLIC",
          "FOLLOWERS"
        ],
        "title": "BoardAudience",
        "type": "string"
      },
      "collab.v1.BoardRole": {
        "description": "BoardRole is the resolved capability level for a caller on a board.",
        "enum": [
          "ROLE_UNSPECIFIED",
          "VIEWER",
          "EDITOR",
          "OWNER"
        ],
        "title": "BoardRole",
        "type": "string"
      },
      "collab.v1.CreateBoardRequest": {
        "additionalProperties": false,
        "description": "CreateBoardRequest creates a new board owned by the caller.\ncreate_board.acl_subjects_unique // acl_entries must not contain duplicate subjects\ncreate_board.title_non_blank // title must contain at least one non-whitespace character\n",
        "properties": {
          "aclEntries": {
            "description": "Optional explicit ACL entries created with the board, max 256 entries.",
            "items": {
              "$ref": "#/components/schemas/collab.v1.BoardAclEntry"
            },
            "maxItems": 256,
            "title": "acl_entries",
            "type": "array"
          },
          "audience": {
            "$ref": "#/components/schemas/collab.v1.BoardAudience",
            "description": "Initial audience policy for the board.",
            "not": {
              "enum": [
                0
              ]
            },
            "title": "audience"
          },
          "defaultRole": {
            "$ref": "#/components/schemas/collab.v1.BoardRole",
            "description": "Default audience role for callers admitted by PUBLIC or FOLLOWERS audience policy.",
            "enum": [
              1,
              2
            ],
            "title": "default_role"
          },
          "initialSnapshot": {
            "$ref": "#/components/schemas/google.protobuf.Struct",
