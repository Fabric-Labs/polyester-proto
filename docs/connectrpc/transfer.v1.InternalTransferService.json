{
  "services": [
    {
      "name": "transfer.v1.InternalTransferService",
      "doc": "InternalTransferService manages authenticated Trading to Trading internal\n transfer intake.",
      "methods": [
        {
          "name": "BatchCreateInternalTransfers",
          "path": "transfer.v1.InternalTransferService/BatchCreateInternalTransfers",
          "requestType": "transfer.v1.BatchCreateInternalTransfersRequest",
          "responseType": "transfer.v1.BatchCreateInternalTransfersResponse",
          "summary": "Batch Create Internal Transfers",
          "doc": "Move up to 500 Trading to Trading transfers together, authorized by one\n MFA check: every leg is credited, or none moves. Every leg passes the\n same checks as CreateInternalTransfer first; if one fails, the batch is\n refused, nothing moves and no step-up is used. The batch accepts an\n MFA-elevated session, one that completed an MFA challenge in the last 30\n minutes, when the root owner moves funds between its own accounts or to\n explicitly whitelisted destinations; any other leg requires one fresh\n step-up for the whole batch. Without them the batch is refused\n PERMISSION_DENIED with auth code AUTH_MFA_ELEVATION_REQUIRED or\n AUTH_STEP_UP_REQUIRED; REST answers HTTP 403 with that auth code. A batch\n whose outcome is not known within the request answers BATCH_PROCESSING\n and completes on its own; a retry with the same idempotency key returns\n its current state.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "transfer.v1",
          "errorCatalog": "internal-transfer-api:transfererrors",
          "examples": {
            "request": {
              "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
              "legs": [
                {
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetId": 100,
                  "destinationAccountId": "7563897446546",
                  "subaccountId": "6789012345678"
                }
              ]
            },
            "response": {
              "legs": [
                {
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetCode": "USDC",
                  "assetId": 100,
                  "creditedAtTsNs": "1735689600000000000",
                  "destination": {
                    "rootAccountPublicId": "7563897446546",
                    "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                    "subaccountPublicId": "6789012345678"
                  },
                  "errorCode": "ERROR_CODE_INSUFFICIENT_FUNDS",
                  "errorMessage": "value",
                  "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhJ",
                  "legIndex": 1,
                  "status": "LEG_PROCESSING",
                  "transferId": "9155001234569"
                }
              ],
              "requestId": "request_01J0EXAMPLE",
              "status": "BATCH_REFUSED"
            }
          }
        },
        {
          "name": "CreateInternalTransfer",
          "path": "transfer.v1.InternalTransferService/CreateInternalTransfer",
          "requestType": "transfer.v1.CreateInternalTransferRequest",
          "responseType": "transfer.v1.CreateInternalTransferResponse",
          "summary": "Create Internal Transfer",
          "doc": "Create or return one accepted Trading to Trading transfer.\n Root-owner same-owner transfers and root-owner transfers to explicitly\n whitelisted destinations accept an MFA-elevated session, one that\n completed an MFA challenge in the last 30 minutes; delegated and other\n interactive transfers require fresh step-up. Without them the transfer is\n refused PERMISSION_DENIED with auth code AUTH_MFA_ELEVATION_REQUIRED or\n AUTH_STEP_UP_REQUIRED; REST answers HTTP 403 with that auth code.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "transfer.v1",
          "errorCatalog": "internal-transfer-api:transfererrors",
          "examples": {
            "request": {
              "amountE18": {
                "hi": "1",
                "lo": "1"
              },
              "assetId": 100,
              "destinationAccountId": "7563897446546",
              "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
              "subaccountId": "6789012345678"
            },
            "response": {
              "acceptedAtTsNs": "1735689600000000000",
              "amountE18": {
                "hi": "1",
                "lo": "1"
              },
              "assetCode": "USDC",
              "assetId": 100,
              "destination": {
                "rootAccountPublicId": "7563897446546",
                "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                "subaccountPublicId": "6789012345678"
              },
              "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhJ",
              "requestId": "request_01J0EXAMPLE",
              "status": "INTERNAL_TRANSFER_STATUS_ACCEPTED",
              "transferId": "9155001234569",
              "uAssetId": "100"
            }
          }
        },
        {
          "name": "GetInternalTransfer",
          "path": "transfer.v1.InternalTransferService/GetInternalTransfer",
          "requestType": "transfer.v1.GetInternalTransferRequest",
          "responseType": "transfer.v1.GetInternalTransferResponse",
          "summary": "Get Internal Transfer",
          "doc": "Read an accepted transfer by request ID or transfer ID, scoped to its source\n account. JWT session authentication only; API keys are not supported.\n Returns NotFound for unknown, pending, or inaccessible transfers. This read\n does not submit or retry a transfer and requires no fresh MFA.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "transfer.v1",
          "errorCatalog": "internal-transfer-api:transfererrors",
          "examples": {
            "request": {
              "requestId": "request_01J0EXAMPLE",
              "subaccountId": "6789012345678"
            },
            "response": {
              "acceptedAtTsNs": "1735689600000000000",
              "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhJ",
              "requestId": "request_01J0EXAMPLE",
              "transferId": "9155001234569"
            }
          }
        },
        {
          "name": "GetInternalTransferBatch",
          "path": "transfer.v1.InternalTransferService/GetInternalTransferBatch",
          "requestType": "transfer.v1.GetInternalTransferBatchRequest",
          "responseType": "transfer.v1.GetInternalTransferBatchResponse",
          "summary": "Get Internal Transfer Batch",
          "doc": "Read a batch's current outcome and the state of every leg, by the\n request ID BatchCreateInternalTransfers returned: for example to follow\n a batch that answered BATCH_PROCESSING. The caller must be allowed to\n read the transfers of every source account of the batch; any other\n batch is not found. An API key whose policy does not grant\n READ_INTERNAL_TRANSFERS is refused PERMISSION_DENIED for any batch.\n This read does not submit or retry the batch and requires no fresh MFA.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "transfer.v1",
          "errorCatalog": "internal-transfer-api:transfererrors",
          "examples": {
            "request": {
              "requestId": "92640625967207661803151833376978068587"
            },
            "response": {
              "legs": [
                {
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "assetCode": "USDC",
                  "assetId": 100,
                  "creditedAtTsNs": "1735689600000000000",
                  "destination": {
                    "rootAccountPublicId": "7563897446546",
                    "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                    "subaccountPublicId": "6789012345678"
                  },
                  "errorCode": "ERROR_CODE_INSUFFICIENT_FUNDS",
                  "errorMessage": "value",
                  "flowId": "flow_7YWHMfk9JZeLMgZauHuiSxhJ",
                  "legIndex": 1,
                  "status": "LEG_PROCESSING",
                  "transferId": "9155001234569"
                }
              ],
              "requestId": "request_01J0EXAMPLE",
              "status": "BATCH_REFUSED"
            }
          }
        }
      ]
    }
  ]
}
