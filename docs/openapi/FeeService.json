{
  "components": {
    "schemas": {
      "polyester.rest.FeeService_GetSpotFeeRates.Response": {
        "additionalProperties": false,
        "properties": {
          "feeRates": {
            "description": "Effective spot fee rows ordered by symbol_id ascending. The result is a finite snapshot of the requested or currently listed, non-disabled spot market catalog and is not paginated.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "makerFeeRatePercent": {
                  "description": "Effective maker fee rate encoded as a base-10 percentage string without a percent sign. Values are between -100 and 100 inclusive.",
                  "type": "string"
                },
                "symbol": {
                  "description": "Trading pair symbol, e.g. BTC-USDT.",
                  "type": "string"
                },
                "takerFeeRatePercent": {
                  "description": "Effective taker fee rate encoded as a non-negative base-10 percentage string without a percent sign. Values are between 0 and 100 inclusive.",
                  "type": "string"
                },
                "vipTier": {
                  "description": "VIP tier used to resolve these rates, in the inclusive range 0 through 10.",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "makerFeeRatePercent",
                "symbol",
                "takerFeeRatePercent",
                "vipTier"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "feeRates"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/spot/fee-rates": {
      "get": {
        "description": "Get effective maker and taker fee rates for the authenticated account target.",
        "operationId": "FeeService_GetSpotFeeRates",
        "parameters": [
          {
            "description": "Optional sub-account public identifier.",
            "example": "6789012345678",
            "in": "query",
            "name": "subaccountId",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional trading pair symbols; repeat the query parameter to select multiple markets.",
            "example": "BTC-USDT",
            "explode": true,
            "in": "query",
            "name": "symbol",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "style": "form"
          },
          {
            "description": "Optional unique spot market identifier filter. When empty, all currently\n listed, non-disabled spot markets are returned. At most 100 identifiers\n may be requested.",
            "example": 1,
            "in": "query",
            "name": "symbolId",
            "schema": {
              "description": "Optional unique spot market identifier filter. When empty, all currently\n listed, non-disabled spot markets are returned. At most 100 identifiers\n may be requested.",
              "items": {
                "exclusiveMinimum": 0,
                "maxItems": 100,
                "type": "integer",
                "uniqueItems": true
              },
              "maxItems": 100,
              "title": "symbol_id",
              "type": "array",
              "uniqueItems": true
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "feeRates": [
                    {
                      "makerFeeRatePercent": "a",
                      "symbol": "BTC-USDT",
                      "takerFeeRatePercent": "a",
                      "vipTier": 1
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.FeeService_GetSpotFeeRates.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get Spot Fee Rates",
        "tags": [
          "Fee Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.FeeService_GetSpotFeeRates",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "fees.v1.GetSpotFeeRatesRequest",
        "x-poly-response-type": "fees.v1.GetSpotFeeRatesResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
