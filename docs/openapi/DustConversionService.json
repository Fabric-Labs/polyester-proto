      "polyester.rest.enum.transfer.v1.DustAssetEligibility": {
        "enum": [
          "ELIGIBLE",
          "TARGET_ASSET",
          "TRADABLE",
          "ABOVE_VALUE_LIMIT",
          "NO_PRICE",
          "UNSUPPORTED_ASSET",
          "SOURCE_LIMIT"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "ABOVE_VALUE_LIMIT": "The balance is worth more than 10 USD.",
          "ELIGIBLE": "The whole available balance is dust and converts.",
          "NO_PRICE": "The asset, or the quote asset of a market it trades on, has no current index price. A balance without a price is never valued at zero.",
          "SOURCE_LIMIT": "One conversion takes at most 20 balances, the highest-valued first; this one waits for the next conversion.",
          "TARGET_ASSET": "The asset is the conversion's target; it is never a source.",
          "TRADABLE": "An open market accepts an order for the balance at the current index price: sell it, or for an asset only quoted, spend it, instead.",
          "UNSUPPORTED_ASSET": "The asset is not convertible."
        }
      },
      "polyester.rest.enum.transfer.v1.DustConversionState": {
        "enum": [
          "PROCESSING",
          "COMPLETED",
          "REFUSED"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "COMPLETED": "Every source moved and the payout was credited, atomically.",
          "PROCESSING": "The conversion is accepted and being completed. It completes or is refused without any further request; read it again with GetDustConversion.",
          "REFUSED": "The conversion was refused: nothing moved. refusal_code says why. A refused conversion does not count toward the 6 hour conversion window."
        }
      },
