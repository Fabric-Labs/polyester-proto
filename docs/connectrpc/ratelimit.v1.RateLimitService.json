{
  "services": [
    {
      "name": "ratelimit.v1.RateLimitService",
      "doc": "RateLimitService serves public trading quota reference data and authenticated\n effective trading limits.",
      "methods": [
        {
          "name": "GetRateLimitConfig",
          "path": "ratelimit.v1.RateLimitService/GetRateLimitConfig",
          "requestType": "ratelimit.v1.GetRateLimitConfigRequest",
          "responseType": "ratelimit.v1.GetRateLimitConfigResponse",
          "summary": "Get the complete active placement and cancellation quota catalog for",
          "doc": "Get the complete active placement and cancellation quota catalog for\n VIP0 through VIP10.",
          "tags": [
            "trading"
          ],
          "authRequired": false,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ratelimit.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "effectiveFrom": "2025-01-01T00:00:00Z",
              "policyVersion": "1",
              "rules": [
                {
                  "burstWeight": "1",
                  "periodMs": "1",
                  "policyClass": "TRADING_RATE_LIMIT_CLASS_PLACE",
                  "quotaWeight": "1",
                  "vipTier": 1
                }
              ]
            }
          }
        },
        {
          "name": "GetTradingRateLimits",
          "path": "ratelimit.v1.RateLimitService/GetTradingRateLimits",
          "requestType": "ratelimit.v1.GetTradingRateLimitsRequest",
          "responseType": "ratelimit.v1.GetTradingRateLimitsResponse",
          "summary": "Get the effective placement and cancellation limits for the authenticated",
          "doc": "Get the effective placement and cancellation limits for the authenticated\n caller's root account or selected subaccount.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ratelimit.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "apiKeyRules": [
                {
                  "burstWeight": "1",
                  "periodMs": "1",
                  "policyClass": "TRADING_RATE_LIMIT_CLASS_PLACE",
                  "quotaWeight": "1",
                  "vipTier": 1
                }
              ],
              "effectiveFrom": "2025-01-01T00:00:00Z",
              "policyVersion": "1",
              "rules": [
                {
                  "burstWeight": "1",
                  "periodMs": "1",
                  "policyClass": "TRADING_RATE_LIMIT_CLASS_PLACE",
                  "quotaWeight": "1",
                  "vipTier": 1
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
