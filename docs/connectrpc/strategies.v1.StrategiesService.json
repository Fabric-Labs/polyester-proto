        {
          "name": "RunScenarios",
          "path": "strategies.v1.StrategiesService/RunScenarios",
          "requestType": "strategies.v1.RunScenariosRequest",
          "responseType": "strategies.v1.RunScenariosResponse",
          "summary": "Run Scenarios",
          "doc": "RunScenarios runs a version's behaviour examples against its code and\n records the results. The result is deterministic: a version always gets\n the same one.\n\n Errors:\n - INVALID_ARGUMENT: malformed request.\n - NOT_FOUND: VERSION_NOT_FOUND.\n - FAILED_PRECONDITION: VERSION_INVALID.\n - RESOURCE_EXHAUSTED: SCENARIO_RUN_LIMIT_REACHED; retry after\n   retry_after.\n - UNAVAILABLE: SERVICE_UNAVAILABLE; retry.\n - PERMISSION_DENIED: AUTH_API_KEY_ACCESS_DENIED when the API key's policy\n   does not grant DRAFT_STRATEGIES or the key is scoped to a subaccount.\n - UNAUTHENTICATED: missing or invalid credentials.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "strategies.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "versionId": "example"
            },
            "response": {
              "failed": 1,
              "passed": 1,
              "results": [
                {
                  "actual": [
                    {
                      "example": "data"
                    }
                  ],
                  "error": "value",
                  "expected": [
                    {
                      "example": "data"
                    }
                  ],
                  "logs": [
                    "value"
                  ],
                  "name": "value",
                  "passed": false
                }
              ],
              "versionId": "value"
            }
          }
        },
        {
