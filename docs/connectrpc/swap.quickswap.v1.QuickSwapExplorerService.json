        {
          "name": "ListCompletedQuickSwaps",
          "path": "swap.quickswap.v1.QuickSwapExplorerService/ListCompletedQuickSwaps",
          "requestType": "swap.quickswap.v1.ListCompletedQuickSwapsRequest",
          "responseType": "swap.quickswap.v1.ListCompletedQuickSwapsResponse",
          "summary": "List completed QuickSwaps",
          "doc": "ListCompletedQuickSwaps lists completed QuickSwaps of every broker,\n newest completion first, optionally by source and destination assets,\n on given networks or on all of them, and by a range of source USD value.\n\n Errors:\n - INVALID_ARGUMENT: malformed request; a USD bound off the grid; filters\n   that select more than 400 routes, or routes times USD value steps; a\n   max_source_value_usd not above min_source_value_usd; or\n   PAGE_TOKEN_INVALID for a page_token that is malformed, from other\n   filters, or from before a change of the networks the asset IDs cover.",
          "tags": [
            "quickswap"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "swap-api:quickswaperrors:swap.quickswap.v1.QuickSwapExplorerService/ListCompletedQuickSwaps",
          "errorCodes": [
            "PAGE_TOKEN_INVALID"
          ],
          "examples": {
