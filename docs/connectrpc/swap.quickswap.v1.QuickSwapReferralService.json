        },
        {
          "name": "ListReferredQuickSwaps",
          "path": "swap.quickswap.v1.QuickSwapReferralService/ListReferredQuickSwaps",
          "requestType": "swap.quickswap.v1.ListReferredQuickSwapsRequest",
          "responseType": "swap.quickswap.v1.ListReferredQuickSwapsResponse",
          "summary": "List referred QuickSwaps",
          "doc": "ListReferredQuickSwaps lists the QuickSwaps the caller referred.\n\n Newest first, filtered by status and creation time. Each QuickSwap\n carries its rates and the commission credited so far.\n\n Errors:\n - NOT_FOUND: REFERRAL_PARTNER_NOT_FOUND.\n - INVALID_ARGUMENT: a page_token from another partner, other filters or\n   malformed.",
          "tags": [
