        "x-poly-request-type": "auth.v1.GetApiPolicyRequest",
        "x-poly-response-type": "auth.v1.GetApiPolicyResponse"
      },
      "patch": {
        "description": "Partially update an API-key policy using If-Match revision control.",
        "operationId": "PolicyService_UpdateApiPolicy_REST",
        "parameters": [
          {
            "description": "Strong ETag revision returned by the latest read.",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "pattern": "^\"[1-9][0-9]*\"$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "policy_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/polyester.rest.PolicyService_UpdateApiPolicy_REST.Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful patch",
            "headers": {
              "ETag": {
                "description": "Updated resource revision.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid patch"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Revision conflict"
          }
        },
        "summary": "Update API Policy",
        "tags": [
          "Auth Policies"
        ],
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    },
