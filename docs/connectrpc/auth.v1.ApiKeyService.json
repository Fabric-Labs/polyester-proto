        {
          "name": "SetAssistantKeys",
          "path": "auth.v1.ApiKeyService/SetAssistantKeys",
          "requestType": "auth.v1.SetAssistantKeysRequest",
          "responseType": "auth.v1.SetAssistantKeysResponse",
          "summary": "Create or replace the caller's Polyester AI assistant key set: one",
          "doc": "Create or replace the caller's Polyester AI assistant key set: one\n ASSISTANT key per enabled account, each bounded by its API policy. One\n fresh step-up proof covers the whole set, and the change is all or\n nothing. An entry whose account already has an assistant key with the same\n public key keeps that key, with its status, and takes the requested\n policy; any other entry replaces the account's key. Accounts left out of\n the set have their assistant key revoked. A sub-account entry needs the\n same access as CreateApiKey: owner, or a role that manages its API keys.\n The acting caller's root account must have accepted the current terms;\n otherwise FailedPrecondition with AUTH_TERMS_NOT_ACCEPTED is returned. A\n policy that allows a money-out action returns FailedPrecondition with\n AUTH_ASSISTANT_KEY_ACTION_NOT_ALLOWED. A new key is registered only with\n the registration proof and deadline the assistant issued with it\n (PrepareAssistantKeys), before that deadline: a missing or failing proof\n returns InvalidArgument with AUTH_ASSISTANT_KEY_PROOF_INVALID, a passed\n deadline FailedPrecondition with AUTH_ASSISTANT_KEY_REGISTRATION_EXPIRED,\n and one more than 15 minutes ahead InvalidArgument with\n AUTH_ASSISTANT_KEY_DEADLINE_TOO_FAR.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "fresh_step_up",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "keys": [
                {
                  "policyId": "1",
                  "publicKeyEd25519": "AA==",
                  "registrationDeadline": "2025-01-01T00:00:00Z",
                  "registrationProof": "AA==",
                  "subaccountId": "6789012345678"
                }
              ]
            },
            "response": {
              "apiKeys": [
                {
                  "color": "#7C3AED",
                  "createdAt": "2025-01-01T00:00:00Z",
                  "createdByActor": "dashboard",
                  "expiresAt": "2025-01-01T00:00:00Z",
                  "icon": "💰",
                  "ipWhitelist": [
                    "203.0.113.0/24"
                  ],
                  "keyId": "ak_1a3c6de8153d5a5b04cd2a6529779542",
                  "label": "Trading Bot",
                  "lastUsedAt": "2025-01-01T00:00:00Z",
                  "policyId": "1",
                  "publicKeyEd25519": "AA==",
                  "purpose": "STANDARD",
                  "revision": "1",
                  "status": "ACTIVE",
                  "subaccountId": "6789012345678",
                  "updatedAt": "2025-01-01T00:00:00Z"
                }
              ]
            }
          }
