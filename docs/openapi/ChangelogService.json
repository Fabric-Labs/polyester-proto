                          "id": {
                            "description": "Stable opaque change identifier (base58), identical across environments.",
                            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
                            "type": "string"
                          },
                          "migrationGuidance": {
                            "description": "What to do, when action is required. Omitted when absent.",
                            "type": "string"
                          },
                          "summary": {
                            "description": "One-paragraph summary.",
                            "type": "string"
                          },
                          "surfaces": {
                            "description": "Product areas affected. May be empty.",
                            "items": {
                              "allOf": [
                                {
                                  "$ref": "#/components/schemas/polyester.rest.enum.changelog.v1.Surface"
                                }
                              ]
                            },
                            "type": "array"
