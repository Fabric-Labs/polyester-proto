        {
          "name": "QuoteQuickSwap",
          "path": "swap.quickswap.v1.QuickSwapService/QuoteQuickSwap",
          "requestType": "swap.quickswap.v1.QuoteQuickSwapRequest",
          "responseType": "swap.quickswap.v1.QuoteQuickSwapResponse",
          "summary": "QuoteQuickSwap prices terms without creating a QuickSwap or reserving a",
          "doc": "QuoteQuickSwap prices terms without creating a QuickSwap or reserving a\n deposit address. The quote states whether the route needs a refund\n address.\n\n Errors:\n - INVALID_ARGUMENT: malformed request, AMOUNT_OUT_OF_RANGE,\n   DECIMALS_MISMATCH or FEES_INVALID.\n - FAILED_PRECONDITION: ROUTE_UNSUPPORTED, PROTECTION_UNACHIEVABLE or\n   AFFILIATE_VAULT_UNKNOWN.\n - UNAVAILABLE: QUOTE_UNAVAILABLE; retry later.\n - PERMISSION_DENIED: BROKER_DISABLED.\n - RESOURCE_EXHAUSTED: BROKER_LIMIT, the quote request rate of the key.\n - UNAUTHENTICATED: missing or invalid broker API key.",
          "authRequired": true,
          "authenticationMethods": [
            "broker_api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
