{
  "components": {
    "schemas": {
      "polyester.rest.DustConversionService_CreateDustConversion.Request": {
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "description": "Stable client-supplied key collapsing retries for the account.",
            "type": "string"
          },
          "quoteId": {
            "description": "Quote from QuoteDustConversion, at most 30 seconds old. A quote converts once.",
            "type": "string"
          },
          "subaccountId": {
            "description": "Optional public subaccount ID; it must select the quote's account.\n\nPublic ID, as a base58 string.",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "type": "string"
          }
        },
        "required": [
          "idempotencyKey",
          "quoteId"
        ],
        "type": "object"
      },
      "polyester.rest.DustConversionService_CreateDustConversion.Response": {
        "additionalProperties": false,
        "properties": {
          "conversion": {
            "additionalProperties": false,
            "description": "The conversion: completed, or still processing when its outcome is not known yet.",
            "properties": {
              "completedAt": {
                "description": "When the conversion completed; unset until state is COMPLETED.",
                "format": "date-time",
                "type": "string"
              },
              "conversionId": {
                "description": "Stable conversion identifier.",
                "type": "string"
              },
              "createdAt": {
                "description": "When the conversion was created.",
                "format": "date-time",
                "type": "string"
              },
              "fee": {
                "description": "The fee taken from the payout, as a decimal string in whole units of the target asset.",
                "pattern": "^[0-9]+(\\.[0-9]+)?$",
                "type": "string"
              },
              "feeBps": {
                "description": "The fee in basis points.",
                "format": "int64",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "payout": {
                "description": "Payout after the fee, as a decimal string in whole units of the target asset: the sources' value at the index prices current when the conversion was created.",
                "pattern": "^[0-9]+(\\.[0-9]+)?$",
                "type": "string"
              },
              "quoteId": {
                "description": "The quote the conversion converted.",
                "type": "string"
              },
              "quotedPayout": {
                "description": "The payout the quote showed, as a decimal string in whole units of the target asset.",
                "pattern": "^[0-9]+(\\.[0-9]+)?$",
                "type": "string"
              },
              "refusalCode": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/polyester.rest.enum.transfer.v1.ErrorCode"
                  }
                ],
                "description": "Why the conversion was refused; unspecified unless state is REFUSED."
              },
              "sources": {
                "description": "Sources, in asset id order.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "amount": {
                      "description": "The whole quoted balance, as a decimal string in whole units of the asset.",
                      "pattern": "^[0-9]+(\\.[0-9]+)?$",
                      "type": "string"
                    },
                    "assetId": {
                      "description": "Canonical public unified asset id.",
                      "format": "int64",
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "amount",
                    "assetId"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "state": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/polyester.rest.enum.transfer.v1.DustConversionState"
                  }
                ],
                "description": "Current state."
              },
              "targetAssetId": {
                "description": "Target asset id.",
                "format": "int64",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "conversionId",
              "createdAt",
              "fee",
              "feeBps",
              "payout",
              "quoteId",
              "quotedPayout",
              "sources",
              "state",
              "targetAssetId"
            ],
            "type": "object"
          }
        },
        "required": [
          "conversion"
        ],
        "type": "object"
      },
