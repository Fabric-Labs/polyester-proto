{
  "services": [
    {
      "name": "swap.quickswap.v1.QuickSwapReferralService",
      "doc": "QuickSwapReferralService is a referral partner's own record, over\n ConnectRPC. A referral partner shares a link with their code; QuickSwaps\n made through it on Polyester's own QuickSwap app give the user a discount\n and pay the partner a commission, both out of the broker fee (see\n ReferralProgram). Referrals never apply to QuickSwaps through other\n brokers or the API.\n\n Every RPC takes the caller's interactive session token and acts only on\n the caller's own partner record; a broker API key is refused with\n PERMISSION_DENIED / ACTION_DENIED. A person who has not enrolled gets\n NOT_FOUND / REFERRAL_PARTNER_NOT_FOUND from every RPC but\n EnrollReferralPartner.\n\n A partner's code can be changed while it is not disabled, up to 9 times.\n The old code is retired and never given to anyone again; QuickSwaps\n already referred keep their partner.\n\n A partner reads the QuickSwaps it referred with ListReferredQuickSwaps\n and GetReferredQuickSwap, never another partner's or a QuickSwap without\n its referral. They return no identity of the person who swapped and no\n account, address, memo, transaction hash or flow ID; amounts are exact and\n times are rounded down to the minute.\n\n Every RPC is rate limited per account: over the limit it fails with\n RESOURCE_EXHAUSTED, a RateLimitDetail and a Retry-After header.",
      "methods": [
        {
          "name": "CheckReferralCode",
          "path": "swap.quickswap.v1.QuickSwapReferralService/CheckReferralCode",
          "requestType": "swap.quickswap.v1.CheckReferralCodeRequest",
          "responseType": "swap.quickswap.v1.CheckReferralCodeResponse",
          "summary": "Check referral code",
          "doc": "CheckReferralCode says whether the caller may take a referral code.\n\n Errors:\n - NOT_FOUND: REFERRAL_PARTNER_NOT_FOUND.",
          "tags": [
            "quickswap"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "swap-api:quickswaperrors:swap.quickswap.v1.QuickSwapReferralService/CheckReferralCode",
          "errorCodes": [
            "ACTION_DENIED",
            "REFERRAL_PARTNER_NOT_FOUND"
          ],
          "examples": {
            "request": {
              "code": "value"
            },
            "response": {
              "availability": "CODE_AVAILABLE",
              "code": "value"
            }
          }
        },
        {
          "name": "EnrollReferralPartner",
          "path": "swap.quickswap.v1.QuickSwapReferralService/EnrollReferralPartner",
          "requestType": "swap.quickswap.v1.EnrollReferralPartnerRequest",
          "responseType": "swap.quickswap.v1.EnrollReferralPartnerResponse",
          "summary": "Enroll referral partner",
          "doc": "EnrollReferralPartner applies to become a referral partner. The partner\n starts pending until Polyester approves it, with a random 8-character\n code that can be changed. Repeating the request returns the same\n partner.\n\n Errors:\n - FAILED_PRECONDITION: EARNINGS_ACCOUNT_INVALID.\n - ALREADY_EXISTS: REFERRAL_PARTNER_EXISTS.",
          "tags": [
            "quickswap"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "swap-api:quickswaperrors:swap.quickswap.v1.QuickSwapReferralService/EnrollReferralPartner",
          "errorCodes": [
            "ACTION_DENIED",
            "EARNINGS_ACCOUNT_INVALID",
            "REFERRAL_PARTNER_EXISTS"
          ],
          "examples": {
            "request": {
              "displayName": "example",
              "earningsSubaccountId": "6789012345678"
            },
            "response": {
              "partner": {
                "code": "value",
                "codeChangesRemaining": 1,
                "createdAt": "2025-01-01T00:00:00Z",
                "displayName": "value",
                "earningsSubaccountId": "6789012345678",
                "linkPath": "value",
                "partnerId": "1",
                "program": {
                  "bridging": {
                    "commissionBps": 1,
                    "discountBps": 1
                  },
                  "normal": {
                    "commissionBps": 1,
                    "discountBps": 1
                  },
                  "stablecoin": {
                    "commissionBps": 1,
                    "discountBps": 1
                  }
                },
                "status": "PARTNER_PENDING"
              }
            }
          }
        },
        {
