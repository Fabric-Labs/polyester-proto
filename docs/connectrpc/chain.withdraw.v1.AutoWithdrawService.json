        },
        {
          "name": "SetAutoWithdrawRuleEnabled",
          "path": "chain.withdraw.v1.AutoWithdrawService/SetAutoWithdrawRuleEnabled",
          "requestType": "chain.withdraw.v1.SetAutoWithdrawRuleEnabledRequest",
          "responseType": "chain.withdraw.v1.SetAutoWithdrawRuleEnabledResponse",
          "summary": "Pause or resume the account's rule, keeping its schedule and",
          "doc": "Pause or resume the account's rule, keeping its schedule and\n destinations. Requires a session login with withdraw rights on the\n account. Pausing needs no step-up. Resuming needs a fresh single-use\n step-up, checks again that every destination is still a valid\n destination on the account's external withdraw whitelist, and clears a\n pause the rule set itself; a refused destination answers the typed codes\n of SetAutoWithdrawRule, and the rule stays paused. A rule already in the\n requested state is returned unchanged. A stale expected_version answers\n VERSION_CONFLICT.",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "chain.withdraw.v1",
          "errorCatalog": "withdraw-api:withdrawerrors",
          "examples": {
