{
  "services": [
    {
      "name": "orderbook.v1.OrderbookService",
      "methods": [
        {
          "name": "GetOrderBook",
          "path": "orderbook.v1.OrderbookService/GetOrderBook",
          "requestType": "orderbook.v1.GetOrderBookRequest",
          "responseType": "orderbook.v1.GetOrderBookResponse",
          "summary": "Retrieve a spot order book depth snapshot for a symbol.",
          "doc": "Retrieve a spot order book depth snapshot for a symbol.\n Supports a selectable depth per side, up to the max_depth each response\n reports, and returns best bid/ask levels.",
          "tags": [
            "marketdata"
          ],
          "authRequired": false,
          "authenticationMethods": [],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "orderbook.v1",
          "errorCatalog": "md-orderbook:orderbookerrors",
          "examples": {
            "request": {
              "depth": 20,
              "symbolId": 1
            },
            "response": {
              "asks": [
                {
                  "priceTicks": "61000250000000",
                  "qtyScaled": "100000"
                }
              ],
              "available": true,
              "bids": [
                {
                  "priceTicks": "61000250000000",
                  "qtyScaled": "100000"
                }
              ],
              "bookEpoch": "3",
              "bookSeq": "984321",
              "maxDepth": 5000,
              "symbolId": 1,
              "ts": "2025-01-01T00:00:00Z"
            }
          }
        }
      ]
    }
  ]
}
