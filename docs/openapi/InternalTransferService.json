{
  "components": {
    "schemas": {
      "transfer.v1.CreateInternalTransferRequest": {
        "additionalProperties": false,
        "allOf": [
          {
            "properties": {
              "assetId": {
                "description": "Canonical public unified asset id for the asset being transferred.",
                "exclusiveMinimum": 0,
                "title": "asset_id",
                "type": "integer"
              },
              "idempotencyKey": {
                "description": "Stable client-supplied idempotency key used to collapse safe retries.",
                "maxLength": 128,
                "minLength": 1,
                "title": "idempotency_key",
                "type": "string"
              },
              "qtyScaled": {
                "description": "Quantity scaled by the unified asset's quantity_scale from SpotConfig for\n asset_id.",
                "exclusiveMinimum": 0,
                "format": "int64",
                "title": "qty_scaled",
                "type": [
                  "integer",
                  "string"
                ]
              },
              "subaccountId": {
                "description": "Optional source subaccount public id. When omitted, the authenticated\n caller's root account is used as the source account.",
                "exclusiveMinimum": 0,
                "format": "int64",
                "title": "subaccount_id",
                "type": [
                  "integer",
                  "string"
                ]
              }
            }
          },
          {
            "oneOf": [
              {
                "properties": {
                  "destinationAccountId": {
                    "description": "Destination root account public id.",
                    "exclusiveMinimum": 0,
                    "format": "int64",
                    "title": "destination_account_id",
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                },
                "required": [
                  "destinationAccountId"
                ],
                "title": "destination_account_id"
              },
              {
                "properties": {
                  "destinationSmartAccountAddress": {
                    "description": "Destination smart-account address.",
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "destination_smart_account_address",
                    "type": "string"
                  }
                },
                "required": [
                  "destinationSmartAccountAddress"
                ],
                "title": "destination_smart_account_address"
              },
              {
                "properties": {
                  "destinationSubaccountId": {
                    "description": "Destination subaccount public id.",
                    "exclusiveMinimum": 0,
                    "format": "int64",
                    "title": "destination_subaccount_id",
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                },
                "required": [
                  "destinationSubaccountId"
                ],
                "title": "destination_subaccount_id"
              }
            ]
          }
        ],
        "description": "CreateInternalTransferRequest creates or returns one accepted Trading\n to Trading internal transfer for the authenticated source account.",
        "title": "CreateInternalTransferRequest",
        "type": "object"
      },
      "transfer.v1.CreateInternalTransferResponse": {
        "additionalProperties": false,
        "description": "CreateInternalTransferResponse returns the accepted request and transfer\n identifiers for later correlation.",
        "properties": {
          "acceptedAtTsNs": {
            "description": "Acceptance timestamp in nanoseconds since epoch (server time).",
            "format": "int64",
            "title": "accepted_at_ts_ns",
            "type": [
              "integer",
              "string"
            ]
          },
          "assetCode": {
            "description": "Resolved asset code for convenience.",
            "title": "asset_code",
            "type": "string"
          },
          "assetId": {
            "description": "Echoed canonical public unified asset id.",
            "title": "asset_id",
            "type": "integer"
          },
          "destination": {
            "$ref": "#/components/schemas/transfer.v1.ResolvedDestination",
            "description": "Server-resolved destination summary.",
            "title": "destination"
          },
          "qtyScaled": {
            "description": "Echoed transfer quantity scaled by the unified asset's quantity_scale from\n SpotConfig for asset_id.",
            "format": "int64",
            "title": "qty_scaled",
            "type": [
              "integer",
              "string"
            ]
          },
          "requestId": {
            "description": "Stable server-owned request identifier for this intake.",
            "title": "request_id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/transfer.v1.InternalTransferStatus",
            "description": "Public status for the transfer request.",
            "title": "status"
          },
          "transferId": {
            "description": "Stable transfer identifier for the settled internal transfer.",
            "title": "transfer_id",
            "type": "string"
          },
          "uAssetId": {
            "description": "Resolved unified asset id used by downstream settlement.",
            "title": "u_asset_id",
            "type": "string"
          }
        },
        "title": "CreateInternalTransferResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/trading/internal-transfers": {
      "post": {
        "description": "Create or return one authenticated Trading to Trading internal transfer.",
        "operationId": "InternalTransferService_CreateInternalTransfer",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "assetId": 100,
                "destinationAccountId": "7563897446546",
                "destinationSmartAccountAddress": "0x2222222222222222222222222222222222222222",
                "destinationSubaccountId": "6789012345678",
                "idempotencyKey": "a",
                "qtyScaled": "100000",
                "subaccountId": "6789012345678"
              },
              "schema": {
                "$ref": "#/components/schemas/transfer.v1.CreateInternalTransferRequest"
              }
            },
            "application/proto": {
              "schema": {
                "$ref": "#/components/schemas/transfer.v1.CreateInternalTransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "acceptedAtTsNs": "1735689600000000000",
                  "assetCode": "value",
                  "assetId": 100,
                  "destination": {
                    "rootAccountPublicId": "value",
                    "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                    "subaccountPublicId": "value"
                  },
                  "qtyScaled": "100000",
                  "requestId": "value",
                  "status": "accepted",
                  "transferId": "value",
                  "uAssetId": "100"
                },
                "schema": {
                  "$ref": "#/components/schemas/transfer.v1.CreateInternalTransferResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Create Internal Transfer",
        "tags": [
          "Internal Transfers"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "transfer.v1",
        "x-poly-request-type": "transfer.v1.CreateInternalTransferRequest",
        "x-poly-response-type": "transfer.v1.CreateInternalTransferResponse"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
