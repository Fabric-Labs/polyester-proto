{
  "services": [
    {
      "name": "auth.v1.ProfileService",
      "doc": "ProfileService manages the authenticated caller's public profile.",
      "methods": [
        {
          "name": "ClaimGeneratedUsername",
          "path": "auth.v1.ProfileService/ClaimGeneratedUsername",
          "requestType": "auth.v1.ClaimGeneratedUsernameRequest",
          "responseType": "auth.v1.UserProfile",
          "summary": "Claim one username by its position in a valid generated offer. The",
          "doc": "Claim one username by its position in a valid generated offer. The\n selected value comes from the offer and cannot be supplied directly.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "offerToken": "a",
              "optionIndex": 5
            },
            "response": {
              "avatarUrl": "https://cdn.polyester.dev/avatars/trader-alpha.png",
              "bio": "Professional crypto trader and liquidity provider.",
              "createdAt": "2025-01-01T00:00:00Z",
              "discord": "polyester_trader",
              "discordVerified": false,
              "nextUsernameChangeAt": "2025-01-01T00:00:00Z",
              "twitter": "@polyester_exchange",
              "twitterVerified": false,
              "username": "trader_alpha",
              "usernameUnlocked": false,
              "vipTier": 1,
              "website": "https://polyester.exchange"
            }
          }
        },
        {
          "name": "GenerateUsernameOptions",
          "path": "auth.v1.ProfileService/GenerateUsernameOptions",
          "requestType": "auth.v1.GenerateUsernameOptionsRequest",
          "responseType": "auth.v1.GenerateUsernameOptionsResponse",
          "summary": "Generate five random username options for an account that has never",
          "doc": "Generate five random username options for an account that has never\n claimed a username. Calling this method again returns a fresh set.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "expiresAt": "2025-01-01T00:00:00Z",
              "offerToken": "value",
              "usernames": [
                "value"
              ]
            }
          }
        },
        {
          "name": "GetProfile",
          "path": "auth.v1.ProfileService/GetProfile",
          "requestType": "auth.v1.GetProfileRequest",
          "responseType": "auth.v1.UserProfile",
          "summary": "Get the caller's profile.",
          "doc": "Get the caller's profile.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "avatarUrl": "https://cdn.polyester.dev/avatars/trader-alpha.png",
              "bio": "Professional crypto trader and liquidity provider.",
              "createdAt": "2025-01-01T00:00:00Z",
              "discord": "polyester_trader",
              "discordVerified": false,
              "nextUsernameChangeAt": "2025-01-01T00:00:00Z",
              "twitter": "@polyester_exchange",
              "twitterVerified": false,
              "username": "trader_alpha",
              "usernameUnlocked": false,
              "vipTier": 1,
              "website": "https://polyester.exchange"
            }
          }
        },
        {
          "name": "GetUsernameHistory",
          "path": "auth.v1.ProfileService/GetUsernameHistory",
          "requestType": "auth.v1.GetUsernameHistoryRequest",
          "responseType": "auth.v1.GetUsernameHistoryResponse",
          "summary": "Get recent username history for the caller, newest first. Returns at most",
          "doc": "Get recent username history for the caller, newest first. Returns at most\n 20 entries.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "history": [
                {
                  "setAt": "2025-01-01T00:00:00Z",
                  "username": "trader_alpha"
                }
              ]
            }
          }
        },
        {
          "name": "UpdateProfile",
          "path": "auth.v1.ProfileService/UpdateProfile",
          "requestType": "auth.v1.UserProfilePatch",
          "responseType": "auth.v1.UserProfile",
          "summary": "Update the caller's mutable profile fields. Omitted fields are unchanged;",
          "doc": "Update the caller's mutable profile fields. Omitted fields are unchanged;\n present empty strings clear optional text fields.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "avatarUrl": "https://cdn.polyester.dev/avatars/trader-alpha.png",
              "bio": "Professional crypto trader and liquidity provider.",
