{
  "components": {
    "schemas": {
      "auth.v1.CreateApiPolicyRequest": {
        "additionalProperties": false,
        "description": "CreateApiPolicyRequest defines a new API key policy template.",
        "properties": {
          "assignToKeyId": {
            "description": "Optional API key identifier to bind this newly-created policy to\n atomically. When set, the caller must be allowed to manage the key and the\n create+assign operation consumes a single fresh step-up proof.",
            "pattern": "^$|^ak_[a-f0-9]{32}$",
            "title": "assign_to_key_id",
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/auth.v1.ApiPolicySpec",
            "description": "Complete mutable policy configuration.",
            "title": "policy"
          }
        },
        "required": [
          "policy"
        ],
        "title": "CreateApiPolicyRequest",
        "type": "object"
      },
      "auth.v1.CreateApiPolicyResponse": {
        "additionalProperties": false,
        "description": "CreateApiPolicyResponse returns the created API key policy.",
        "properties": {
          "policy": {
            "$ref": "#/components/schemas/auth.v1.ApiPolicyView",
            "description": "Created API key policy.",
            "title": "policy"
          }
        },
        "title": "CreateApiPolicyResponse",
        "type": "object"
      },
      "auth.v1.CreateSubaccountPolicyRequest": {
        "additionalProperties": false,
        "description": "CreateSubaccountPolicyRequest defines a new sub-account policy template, with\n an optional attach step for one target sub-account.",
        "properties": {
          "policy": {
            "$ref": "#/components/schemas/auth.v1.SubaccountPolicySpec",
            "description": "Complete mutable policy configuration.",
            "title": "policy"
          },
          "subaccountId": {
            "description": "Optional target sub-account to attach atomically after creation.",
            "exclusiveMinimum": 0,
            "format": "int64",
            "nullable": true,
            "title": "subaccount_id",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "policy"
        ],
        "title": "CreateSubaccountPolicyRequest",
        "type": "object"
      },
      "auth.v1.CreateSubaccountPolicyResponse": {
        "additionalProperties": false,
        "description": "CreateSubaccountPolicyResponse returns the created sub-account policy.",
        "properties": {
          "policy": {
            "$ref": "#/components/schemas/auth.v1.SubaccountPolicyView",
            "description": "Created sub-account policy.",
            "title": "policy"
          }
        },
        "title": "CreateSubaccountPolicyResponse",
        "type": "object"
      },
      "auth.v1.DeleteApiPolicyResponse": {
        "additionalProperties": false,
        "description": "DeleteApiPolicyResponse is empty when the delete succeeds.",
        "title": "DeleteApiPolicyResponse",
        "type": "object"
      },
      "auth.v1.DeleteSubaccountPolicyResponse": {
        "additionalProperties": false,
        "description": "DeleteSubaccountPolicyResponse is empty when the delete succeeds.",
        "title": "DeleteSubaccountPolicyResponse",
        "type": "object"
      },
      "auth.v1.GetApiPolicyResponse": {
        "additionalProperties": false,
        "description": "GetApiPolicyResponse returns the requested API key policy.",
        "properties": {
          "policy": {
            "$ref": "#/components/schemas/auth.v1.ApiPolicyView",
            "description": "Matching API key policy.",
            "title": "policy"
          }
        },
        "title": "GetApiPolicyResponse",
        "type": "object"
      },
      "auth.v1.GetSubaccountPolicyResponse": {
        "additionalProperties": false,
        "description": "GetSubaccountPolicyResponse returns the requested sub-account policy.",
        "properties": {
          "policy": {
            "$ref": "#/components/schemas/auth.v1.SubaccountPolicyView",
            "description": "Matching sub-account policy.",
            "title": "policy"
          }
        },
        "title": "GetSubaccountPolicyResponse",
        "type": "object"
      },
      "auth.v1.ListApiPoliciesResponse": {
        "additionalProperties": false,
        "description": "ListApiPoliciesResponse contains API key policy templates sorted by ascending\n policy ID.",
        "properties": {
          "policies": {
            "description": "API key policy templates visible to the caller.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.ApiPolicyView"
            },
            "title": "policies",
            "type": "array"
          }
        },
        "title": "ListApiPoliciesResponse",
        "type": "object"
      },
      "auth.v1.ListSubaccountPoliciesResponse": {
        "additionalProperties": false,
        "description": "ListSubaccountPoliciesResponse contains sub-account policy templates sorted\n by ascending policy ID.",
        "properties": {
          "policies": {
            "description": "Sub-account policy templates visible to the caller.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.SubaccountPolicyView"
            },
            "title": "policies",
            "type": "array"
          }
        },
        "title": "ListSubaccountPoliciesResponse",
        "type": "object"
      },
      "auth.v1.SetApiKeyPolicyResponse": {
        "additionalProperties": false,
        "description": "SetApiKeyPolicyResponse is empty when the policy binding succeeds.",
