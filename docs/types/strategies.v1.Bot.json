{
  "types": [
    {
      "name": "strategies.v1.Bot.Status",
      "kind": "enum",
      "doc": "Status is a bot's state.",
      "enum": {
        "values": [
          {
            "name": "DEPLOYING",
            "number": 1,
            "doc": "Being deployed."
          },
          {
            "name": "RUNNING",
            "number": 2,
            "doc": "Handling its events."
          },
          {
            "name": "STOPPING",
            "number": 3,
            "doc": "Being stopped."
          },
          {
            "name": "STOPPED",
            "number": 4,
            "doc": "Stopped by the user."
          },
          {
            "name": "PAUSED",
            "number": 5,
            "doc": "Paused, by itself or after an environment reset: status_reason says\n why. Its orders stay."
          },
          {
            "name": "QUARANTINED",
            "number": 6,
            "doc": "Paused because its calls kept failing to run: status_reason says why.\n Its orders stay."
          }
        ]
      }
    }
  ]
