{
  "services": [
    {
      "name": "auth.v1.ResolveService",
      "doc": "ResolveService resolves authenticated account destinations for sharing and\n transfer flows.",
      "methods": [
        {
          "name": "ResolveAccount",
          "path": "auth.v1.ResolveService/ResolveAccount",
          "requestType": "auth.v1.ResolveAccountRequest",
          "responseType": "auth.v1.ResolveAccountResponse",
          "summary": "Resolve an account by username, account ID, or smart-account address.",
          "doc": "Resolve an account by username, account ID, or smart-account address.\n Use this before sharing or transferring so the caller can confirm the target.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "hint": "USERNAME",
              "includeSubaccounts": false,
              "query": "trader_alpha"
            },
            "response": {
              "matches": [
                {
                  "accountId": "7563897446546",
                  "kind": "root",
                  "rootUsername": "trader_alpha",
                  "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                  "subaccountLabel": "Market Making"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
