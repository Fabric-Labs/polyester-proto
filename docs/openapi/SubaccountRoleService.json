{
  "components": {
    "schemas": {
      "auth.v1.GetEffectiveSubaccountPermissionsResponse": {
        "additionalProperties": false,
        "description": "Effective role-granted permissions for the caller on one sub-account.",
        "properties": {
          "permissions": {
            "description": "Permissions allowed by the role and current sub-account policy. Resource\n state, MFA, limits, and other request context may still deny an operation.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.SubaccountPermission"
            },
            "maxItems": 64,
            "title": "permissions",
            "type": "array",
            "uniqueItems": true
          },
          "role": {
            "$ref": "#/components/schemas/auth.v1.SubaccountRole",
            "description": "Current role of the caller on the sub-account.",
            "not": {
              "enum": [
                0
              ]
            },
            "title": "role"
          },
          "subaccountPolicyId": {
            "description": "Attached sub-account policy identifier, or zero when no policy is attached.",
            "format": "int64",
            "title": "subaccount_policy_id",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "title": "GetEffectiveSubaccountPermissionsResponse",
        "type": "object"
      },
      "auth.v1.ListSubaccountRolesResponse": {
        "additionalProperties": false,
        "description": "Public built-in sub-account role and permission catalog.",
        "properties": {
          "permissions": {
            "description": "Stable permission metadata in canonical permission order.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.SubaccountPermissionDefinition"
            },
            "title": "permissions",
            "type": "array"
          },
          "roles": {
            "description": "Built-in roles in display order from Owner through Viewer.",
            "items": {
              "$ref": "#/components/schemas/auth.v1.SubaccountRoleDefinition"
            },
            "title": "roles",
            "type": "array"
          }
        },
        "title": "ListSubaccountRolesResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/subaccount-roles": {
      "get": {
        "description": "List every built-in sub-account role and the exact permission definitions used by backend authorization.",
        "operationId": "SubaccountRoleService_ListSubaccountRoles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "permissions": [
                    {
                      "description": "Example configuration for the API playground.",
                      "displayName": "value",
                      "permission": "SUBACCOUNT_PERMISSION_READ_SUBACCOUNT",
                      "policyAction": "TRADE_SPOT"
                    }
                  ],
                  "roles": [
                    {
                      "assignable": false,
                      "description": "Example configuration for the API playground.",
                      "displayName": "value",
                      "permissions": [
                        "SUBACCOUNT_PERMISSION_READ_SUBACCOUNT"
                      ],
                      "role": "VIEWER"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.ListSubaccountRolesResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "List Subaccount Roles",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.ListSubaccountRolesRequest",
        "x-poly-response-type": "auth.v1.ListSubaccountRolesResponse"
      }
    },
    "/v1/auth/subaccounts/{subaccount_id}/permissions": {
      "get": {
        "description": "Return permissions granted by the caller's current role after applying the attached sub-account policy. Contextual checks such as MFA and resource state still apply.",
        "operationId": "SubaccountRoleService_GetEffectiveSubaccountPermissions",
        "parameters": [
          {
            "description": "Target sub-account (opaque ID).",
            "example": "6789012345678",
            "in": "path",
            "name": "subaccount_id",
            "required": true,
            "schema": {
              "description": "Target sub-account (opaque ID).",
              "exclusiveMinimum": 0,
              "format": "int64",
              "title": "subaccount_id",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "permissions": [
                    "SUBACCOUNT_PERMISSION_READ_SUBACCOUNT"
                  ],
                  "role": "VIEWER",
                  "subaccountPolicyId": "71dffC88R8"
                },
                "schema": {
                  "$ref": "#/components/schemas/auth.v1.GetEffectiveSubaccountPermissionsResponse"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Get Effective Subaccount Permissions",
        "tags": [
          "Auth Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "auth.v1",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "auth.v1.GetEffectiveSubaccountPermissionsRequest",
        "x-poly-response-type": "auth.v1.GetEffectiveSubaccountPermissionsResponse"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
