{
  "services": [
    {
      "name": "chain.withdraw.v1.AutoWithdrawService",
      "doc": "AutoWithdrawService manages scheduled in-kind auto-withdraw rules for a\n root account or subaccount. A rule pays each asset's balance out on an\n hourly, daily, weekly, biweekly or monthly UTC slot, through the normal\n withdraw path, only to destinations on the account's external withdraw\n whitelist. Changing a\n rule requires a person with withdraw rights and a fresh single-use MFA\n step-up; API keys can read rules and runs but never change them.",
      "methods": [
        {
          "name": "DisableAutoWithdrawRule",
          "path": "chain.withdraw.v1.AutoWithdrawService/DisableAutoWithdrawRule",
          "requestType": "chain.withdraw.v1.DisableAutoWithdrawRuleRequest",
          "responseType": "chain.withdraw.v1.DisableAutoWithdrawRuleResponse",
          "summary": "Disable the account's rule. Requires a session login with withdraw",
          "doc": "Disable the account's rule. Requires a session login with withdraw\n rights on the account and a fresh single-use step-up.",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "fresh_step_up",
          "stability": "stable",
          "errorProtoPkg": "chain.withdraw.v1",
          "errorCatalog": "withdraw-api:withdrawerrors",
          "examples": {
            "request": {
              "expectedVersion": 1,
              "subaccountId": "6789012345678"
            },
            "response": {
              "rule": {
                "createdAt": "2025-01-01T00:00:00Z",
                "destinations": [
                  {
                    "assetId": 100,
                    "destinationAddress": "0x3333333333333333333333333333333333333333",
                    "destinationChainId": "1",
                    "maxAmountE18": {
                      "hi": "1",
                      "lo": "1"
                    },
                    "minAmountE18": {
                      "hi": "1",
                      "lo": "1"
                    }
                  }
                ],
                "enabled": false,
                "minUsdValueE18": {
                  "hi": "1",
                  "lo": "1"
                },
                "pause": {
                  "assetId": 100,
                  "pausedAt": "2025-01-01T00:00:00Z",
                  "reason": "value"
                },
                "schedule": {
                  "anchorDate": "value",
                  "cadence": "DAILY",
                  "dayOfMonth": 31,
                  "minuteOfDay": 1439,
                  "minuteOfHour": 59,
                  "weekday": "MONDAY"
                },
                "subaccountId": "6789012345678",
                "version": 1
              }
            }
          }
        },
