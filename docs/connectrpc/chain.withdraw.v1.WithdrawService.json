{
  "services": [
    {
      "name": "chain.withdraw.v1.WithdrawService",
      "doc": "WithdrawService manages authenticated chain-facing withdraw request intake.",
      "methods": [
        {
          "name": "CreateTradingWithdraw",
          "path": "chain.withdraw.v1.WithdrawService/CreateTradingWithdraw",
          "requestType": "chain.withdraw.v1.CreateTradingWithdrawRequest",
          "responseType": "chain.withdraw.v1.CreateTradingWithdrawResponse",
          "summary": "Create or return one durable withdraw from Trading.",
          "doc": "Create or return one durable withdraw from Trading.",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "chain.withdraw.v1",
          "errorCatalog": "withdraw-api:withdrawerrors",
          "examples": {
            "request": {
              "payload": {
                "action": "TO_FUNDING",
                "amountE18": {
                  "hi": "1",
                  "lo": "1"
                },
                "assetId": 100,
                "deadlineTsSec": "1735689600",
                "destinationAddress": "0x3333333333333333333333333333333333333333",
                "destinationChainId": "1",
                "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                "nonce": {
                  "hi": "1",
                  "lo": "1"
                }
              },
              "payloadSignature": "AA=="
            },
            "response": {
              "intentId": "9155001234567"
            }
          }
        },
        {
          "name": "CreateWalletTradingWithdraw",
          "path": "chain.withdraw.v1.WithdrawService/CreateWalletTradingWithdraw",
          "requestType": "chain.withdraw.v1.CreateWalletTradingWithdrawRequest",
          "responseType": "chain.withdraw.v1.CreateWalletTradingWithdrawResponse",
          "summary": "Create or return one wallet/JWT withdraw from Trading.",
          "doc": "Create or return one wallet/JWT withdraw from Trading.\n Root-owner Trading to Funding and root-owner withdrawals to explicitly\n whitelisted external destinations accept recent MFA. Other external,\n cross-owner, and delegated movements require a fresh single-use step-up.",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "chain.withdraw.v1",
          "errorCatalog": "withdraw-api:withdrawerrors",
          "examples": {
            "request": {
              "payload": {
                "action": "TO_FUNDING",
                "amountE18": {
                  "hi": "1",
                  "lo": "1"
                },
                "assetId": 100,
                "deadlineTsSec": "1735689600",
                "destinationAddress": "0x3333333333333333333333333333333333333333",
                "destinationChainId": "1",
                "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                "nonce": {
                  "hi": "1",
                  "lo": "1"
                }
              },
              "payloadSignature": "AA==",
              "signerWallet": "0x5555555555555555555555555555555555555555",
              "subaccountId": "6789012345678"
            },
            "response": {
              "intentId": "9155001234567"
            }
          }
        },
        {
          "name": "GetWalletBalances",
          "path": "chain.withdraw.v1.WithdrawService/GetWalletBalances",
          "requestType": "chain.withdraw.v1.GetWalletBalancesRequest",
          "responseType": "chain.withdraw.v1.GetWalletBalancesResponse",
          "summary": "Read the zTokens the account's smart account wallet holds on Polyester",
          "doc": "Read the zTokens the account's smart account wallet holds on Polyester\n Chain, such as a rejected withdrawal's refund, which stays there until\n the account moves it. Balances are read live from the chain. An API key\n needs READ_BALANCES within its scope.",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "chain.withdraw.v1",
          "errorCatalog": "withdraw-api:withdrawerrors",
          "examples": {
            "request": {
              "subaccountId": "6789012345678"
            },
            "response": {
              "balances": [
                {
                  "amountE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "chainId": 1,
                  "unifiedAssetId": 100,
                  "zippedAssetId": 100,
                  "ztokenAddress": "0x6666666666666666666666666666666666666666"
                }
              ],
              "smartAccountAddress": "0x2222222222222222222222222222222222222222"
            }
          }
        },
        {
          "name": "ValidateWithdrawDestination",
          "path": "chain.withdraw.v1.WithdrawService/ValidateWithdrawDestination",
          "requestType": "chain.withdraw.v1.ValidateWithdrawDestinationRequest",
          "responseType": "chain.withdraw.v1.ValidateWithdrawDestinationResponse",
          "summary": "Validate an external-chain withdraw destination for an authenticated",
          "doc": "Validate an external-chain withdraw destination for an authenticated\n caller without creating, signing, or reserving a withdraw. An API key\n needs READ_WITHDRAW_VALIDATION within its scope.",
          "tags": [
            "chain"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "chain.withdraw.v1",
          "errorCatalog": "withdraw-api:withdrawerrors",
          "examples": {
            "request": {
              "destinationAddress": "0x3333333333333333333333333333333333333333",
              "destinationChainId": "1"
            },
            "response": {
              "canonicalDestinationAddress": "value",
              "code": "VALID",
              "message": "value",
              "valid": false
            }
          }
        }
      ]
    }
  ]
}
