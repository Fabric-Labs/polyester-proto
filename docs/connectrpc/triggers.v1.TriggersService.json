        {
          "name": "BatchCancelTriggers",
          "path": "triggers.v1.TriggersService/BatchCancelTriggers",
          "requestType": "triggers.v1.BatchCancelTriggersRequest",
          "responseType": "triggers.v1.BatchCancelTriggersResponse",
          "summary": "Cancel up to 50 of the account's triggers in one request, each canceled",
          "doc": "Cancel up to 50 of the account's triggers in one request, each canceled\n as CancelTrigger cancels it: a TWAP's or ladder's open child orders are\n canceled with it. Results come back per trigger, in request order: an\n accepted item's trigger events report when it is canceled;\n ERROR_CODE_TRIGGER_NOT_FOUND names an ID that is none of the account's\n triggers, and ERROR_CODE_TRIGGER_STATUS_INVALID a trigger that has\n already ended. Each trigger counts one against the account's cancel rate\n limit, as a CancelTrigger does. A request_id identifies the request for 2\n minutes: a retry with the same trigger_ids returns the original results,\n so retry a request that timed out unchanged.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "triggers.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "requestId": "request_01J0EXAMPLE",
              "subaccountId": "6789012345678",
              "triggerIds": [
                "9155001234567"
              ]
            },
            "response": {
              "acceptedCount": 1,
              "rejectedCount": 1,
              "results": [
                {
                  "code": "value",
                  "error": {
                    "code": "ERROR_CODE_BAD_REQUEST",
                    "existingOrderId": "9876543210123",
                    "rateLimit": {
                      "limit": "100",
                      "operationId": "value",
                      "policyClass": "AUTH_PUBLIC",
                      "policyVersion": "1",
                      "reason": "QUOTA_EXCEEDED",
                      "refillModel": "CONTINUOUS",
                      "remaining": "1",
                      "retryAfterMs": "1",
                      "scope": "CLIENT_IP"
                    },
                    "violations": [
                      {
                        "fieldPath": "value",
                        "message": "value",
                        "ruleId": "value"
                      }
                    ]
                  },
                  "status": "ACCEPTED",
                  "triggerId": "9155001234567"
                }
              ],
              "ts": "2025-01-01T00:00:00Z",
              "tsNs": "1735689600000000000"
            }
          }
        },
