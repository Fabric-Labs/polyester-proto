{
  "services": [
    {
      "name": "triggers.v1.TriggersService",
      "methods": [
        {
          "name": "BatchCancelTriggers",
          "path": "triggers.v1.TriggersService/BatchCancelTriggers",
          "requestType": "triggers.v1.BatchCancelTriggersRequest",
          "responseType": "triggers.v1.BatchCancelTriggersResponse",
          "summary": "Batch Cancel Triggers",
          "doc": "Cancel up to 50 of the account's triggers in one request, each canceled\n as CancelTrigger cancels it: a TWAP's or ladder's open child orders are\n canceled with it. Results come back per trigger, in request order: an\n accepted item's trigger events report when it is canceled;\n ERROR_CODE_TRIGGER_NOT_FOUND names an ID that is none of the account's\n triggers, and ERROR_CODE_TRIGGER_STATUS_INVALID a trigger that has\n already ended. Each trigger counts one against the account's cancel rate\n limit, as a CancelTrigger does. A request_id identifies the request for 2\n minutes: a retry with the same trigger_ids returns the original results,\n so retry a request that timed out unchanged.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "triggers.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "requestId": "request_01J0EXAMPLE",
              "subaccountId": "6789012345678",
              "triggerIds": [
                "9155001234567"
              ]
            },
            "response": {
              "acceptedCount": 1,
              "rejectedCount": 1,
              "results": [
                {
                  "code": "value",
                  "error": {
                    "causeCode": "ERROR_CODE_BAD_REQUEST",
                    "code": "ERROR_CODE_BAD_REQUEST",
                    "existingOrderId": "9876543210123",
                    "levelIndex": 1,
                    "priceBandLimitTicks": "61000250000000",
                    "rateLimit": {
                      "limit": "100",
                      "operationId": "value",
                      "policyClass": "AUTH_PUBLIC",
                      "policyVersion": "1",
                      "reason": "QUOTA_EXCEEDED",
                      "refillModel": "CONTINUOUS",
                      "remaining": "1",
                      "retryAfterMs": "1",
                      "scope": "CLIENT_IP"
                    },
                    "violations": [
                      {
                        "fieldPath": "value",
                        "message": "value",
                        "ruleId": "value"
                      }
                    ]
                  },
                  "status": "ACCEPTED",
                  "triggerId": "9155001234567"
                }
              ],
              "ts": "2025-01-01T00:00:00Z",
              "tsNs": "1735689600000000000"
            }
          }
        },
        {
          "name": "CancelAllTriggers",
          "path": "triggers.v1.TriggersService/CancelAllTriggers",
          "requestType": "triggers.v1.CancelAllTriggersRequest",
          "responseType": "triggers.v1.CancelAllTriggersResponse",
          "summary": "Cancel All Triggers",
          "doc": "Cancel all of the account's triggers that match the filters (symbols,\n side and trigger types) in one request, without canceling any order.\n Unless dry_run is set, what it cancels is fixed when its request_id is\n first accepted: every matching trigger created before that, and none\n created after it. Each ends canceled with reason\n TRIGGER_CANCEL_REASON_CANCEL_ALL and releases its reserved funds, and\n none places an order after the response. Its open orders are canceled\n with it, as CancelTrigger cancels them: a TWAP's working slice, a\n ladder's open levels, and the working exit of an attached take-profit,\n stop-loss or trailing leg. An order that a stop already placed when it\n fired is a plain order and stays open; so does the parent order of\n canceled attached legs, which then has no protection left. Use\n OrdersService.CancelAllOrders for orders; its `include_triggers` cancels\n orders and triggers in one request.\n\n Every request counts 10 against the account's cancel rate limit, as a\n CancelAllOrders does, however many triggers it cancels: a dry run and a\n retry with the same request_id count the same. A retry with the same\n request_id and criteria\n within two minutes returns the original outcome and cancels nothing\n again; the same request_id with other criteria is rejected with\n ERROR_CODE_CONFLICT_IDEMPOTENCY_KEY_REUSE. A rejected request, or one\n whose outcome is unknown, is no barrier: retry it with the same\n request_id, or list the triggers before relying on it.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "triggers.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "dryRun": false,
              "requestId": "request_01J0EXAMPLE",
              "side": "BUY",
              "subaccountId": "6789012345678",
              "symbolIds": [
                1
              ],
              "triggerTypes": [
                "STOP_LOSS"
              ]
            },
            "response": {
              "matchedTriggers": 1,
              "status": "SUBMITTED",
              "ts": "2025-01-01T00:00:00Z",
              "tsNs": "1735689600000000000"
            }
          }
        },
