        {
          "name": "GetReferralStats",
          "path": "swap.quickswap.v1.QuickSwapReferralService/GetReferralStats",
          "requestType": "swap.quickswap.v1.GetReferralStatsRequest",
          "responseType": "swap.quickswap.v1.GetReferralStatsResponse",
          "summary": "Get referral stats",
          "doc": "GetReferralStats reads the activity of the QuickSwaps the caller\n referred and the commission they credited it, over time, with an\n optional breakdown by route, source asset or destination asset.\n\n A QuickSwap counts in the bucket it was created in, with its current\n status. A commission counts in the bucket it was credited in on the\n totals series, and in its QuickSwap's bucket on a group. The window's\n totals over ReferralPartner.created_at to now are the lifetime totals.\n Times are minute-granular (see GetReferralStatsRequest). A disabled\n partner still reads its stats.\n\n Errors:\n - NOT_FOUND: REFERRAL_PARTNER_NOT_FOUND.\n - INVALID_ARGUMENT: the window, breakdown or drill-down.\n - RESOURCE_EXHAUSTED: BROKER_LIMIT, with a Retry-After header: the\n   caller's read rate, shared with GetBrokerStats, is spent.\n - UNAVAILABLE: the stats cannot be read; retry the same request.",
          "tags": [
            "quickswap"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "swap-api:quickswaperrors:swap.quickswap.v1.QuickSwapReferralService/GetReferralStats",
          "errorCodes": [
            "ACTION_DENIED",
            "BROKER_LIMIT",
            "REFERRAL_PARTNER_NOT_FOUND"
          ],
          "examples": {
            "request": {
