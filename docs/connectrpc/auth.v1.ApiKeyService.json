        {
          "name": "DeleteAssistantKeys",
          "path": "auth.v1.ApiKeyService/DeleteAssistantKeys",
          "requestType": "auth.v1.DeleteAssistantKeysRequest",
          "responseType": "auth.v1.DeleteAssistantKeysResponse",
          "summary": "Revoke the caller's whole Polyester AI assistant key set. Revocation only",
          "doc": "Revoke the caller's whole Polyester AI assistant key set. Revocation only\n removes access, so it needs no step-up proof. Revocation is permanent. As\n for DeleteApiKey, key management sees it at once, and requests signed with\n a revoked key are refused within a few seconds of the response.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "auth.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "response": {
              "revokedKeyIds": [
                "ak_1a3c6de8153d5a5b04cd2a6529779542"
              ]
            }
          }
        },
