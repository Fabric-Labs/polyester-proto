        {
          "name": "SetReferralCode",
          "path": "swap.quickswap.v1.QuickSwapReferralService/SetReferralCode",
          "requestType": "swap.quickswap.v1.SetReferralCodeRequest",
          "responseType": "swap.quickswap.v1.SetReferralCodeResponse",
          "summary": "Set referral code",
          "doc": "SetReferralCode replaces the caller's referral code. The old code is\n retired for good, so a partner can change its code at most 9 times (see\n ReferralPartner.code_changes_remaining). Setting the current code again\n changes nothing.\n\n Errors:\n - INVALID_ARGUMENT: REFERRAL_CODE_INVALID.\n - NOT_FOUND: REFERRAL_PARTNER_NOT_FOUND.\n - ALREADY_EXISTS: REFERRAL_CODE_TAKEN.\n - FAILED_PRECONDITION: REFERRAL_CODE_RESERVED, REFERRAL_CODE_LIMIT or\n   REFERRAL_PARTNER_DISABLED.\n - RESOURCE_EXHAUSTED: the caller's rate limit; retry after Retry-After.",
          "tags": [
            "quickswap"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "swap-api:quickswaperrors:swap.quickswap.v1.QuickSwapReferralService/SetReferralCode",
          "errorCodes": [
            "ACTION_DENIED",
            "REFERRAL_CODE_INVALID",
            "REFERRAL_CODE_LIMIT",
            "REFERRAL_CODE_RESERVED",
            "REFERRAL_CODE_TAKEN",
            "REFERRAL_PARTNER_DISABLED",
            "REFERRAL_PARTNER_NOT_FOUND"
          ],
          "examples": {
