{
  "components": {
    "schemas": {
      "marketoverview.v1.MarketOrderBy": {
        "enum": [
          "UNSPECIFIED",
          "CHANGE_24H_BPS",
          "VOLUME_24H_QUOTE",
          "LAST_PRICE",
          "DATE_ADDED"
        ],
        "title": "MarketOrderBy",
        "type": "string"
      },
      "marketoverview.v1.SparklineInterval": {
        "description": "SparklineInterval identifies the time range and sampling resolution for a\n sparkline.",
        "enum": [
          "UNSPECIFIED",
          "1h",
          "24h",
          "1w",
          "1mo"
        ],
        "title": "SparklineInterval",
        "type": "string"
      },
      "polyester.rest.MarketOverviewService_ListMarketOverview.Response": {
        "additionalProperties": false,
        "properties": {
          "markets": {
            "description": "Market overview rows for the requested page.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "bestAskQtyScaled": {
                  "description": "Best ask quantity scaled by the pair's base_quantity_scale from GetSpotConfig.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "bestAskTicks": {
                  "description": "Current best ask price in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "bestBidQtyScaled": {
                  "description": "Best bid quantity scaled by the pair's base_quantity_scale from GetSpotConfig.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "bestBidTicks": {
                  "description": "Current best bid price in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "change24hBps": {
                  "description": "Rolling 24h change expressed in basis points (bp). Example: +123 = +1.23%.",
                  "format": "int32",
                  "type": "integer"
                },
                "high24hTicks": {
                  "description": "Rolling 24h stats. Highest traded price in the 24h window, in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "indexPriceTicks": {
                  "description": "Current multi-venue index price in quote units scaled by 1e6. Zero when no fresh, valid index price is available.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "lastPriceTicks": {
                  "description": "Last traded price in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "lastTradeTsNs": {
                  "description": "Last trade timestamp in nanoseconds since epoch.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "listedTsNs": {
                  "description": "Listing timestamp in nanoseconds since epoch.",
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                "low24hTicks": {
                  "description": "Lowest traded price in the 24h window, in quote units scaled by 1e6.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "sparklines": {
                  "description": "Optional sparklines (requested explicitly).",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "closeTicks": {
                        "description": "Newest-first close prices in quote units scaled by 1e6.",
                        "items": {
                          "pattern": "^[0-9]+(\\.[0-9]+)?$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "interval": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/polyester.rest.enum.marketoverview.v1.SparklineInterval"
                          }
                        ],
                        "description": "Time range and sampling resolution represented by these close prices."
                      }
                    },
                    "required": [
                      "closeTicks",
                      "interval"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "symbol": {
                  "description": "Trading pair symbol, e.g. BTC-USDT.",
                  "type": "string"
                },
                "volume24hBaseScaled": {
                  "description": "Rolling 24h base volume scaled by the pair's base_quantity_scale from GetSpotConfig.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "volume24hQuoteScaled": {
                  "description": "Rolling 24h quote volume scaled by the pair's quote_quantity_scale from GetSpotConfig.",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                }
              },
              "required": [
                "bestAskQtyScaled",
                "bestAskTicks",
                "bestBidQtyScaled",
                "bestBidTicks",
                "change24hBps",
                "high24hTicks",
                "indexPriceTicks",
                "lastPriceTicks",
                "lastTradeTsNs",
                "listedTsNs",
                "low24hTicks",
                "sparklines",
                "symbol",
                "volume24hBaseScaled",
                "volume24hQuoteScaled"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "nextPageToken": {
            "description": "Opaque cursor for the next page. Empty when no more results exist.",
            "type": "string"
          }
        },
        "required": [
          "markets",
          "nextPageToken"
        ],
        "type": "object"
      },
      "polyester.rest.enum.marketoverview.v1.MarketOrderBy": {
        "enum": [
          "CHANGE_24H_BPS",
          "VOLUME_24H_QUOTE",
          "LAST_PRICE",
          "DATE_ADDED"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "CHANGE_24H_BPS": "Sort by absolute 24h change (basis points).",
          "DATE_ADDED": "Sort by listing time (new listings first).",
          "LAST_PRICE": "Sort by last price in quote units scaled by 1e6.",
          "VOLUME_24H_QUOTE": "Sort by 24h quote volume scaled by the pair's quote_quantity_scale from GetSpotConfig."
        }
      },
      "polyester.rest.enum.marketoverview.v1.SortDirection": {
        "enum": [
          "ASC",
          "DESC"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "ASC": "Ascending (oldest/lowest first).",
          "DESC": "Descending (newest/highest first)."
        }
      },
      "polyester.rest.enum.marketoverview.v1.SparklineInterval": {
        "enum": [
          "1h",
          "24h",
          "1w",
          "1mo"
        ],
        "type": "string",
        "x-poly-enum-descriptions": {
          "1h": "1 hour sparkline. Typically returns up to 60 points (1-minute buckets).",
          "1mo": "1 month sparkline. Typically returns up to 180 points (4-hour buckets).",
          "1w": "1 week sparkline. Typically returns up to 168 points (1-hour buckets).",
          "24h": "24 hour sparkline. Typically returns up to 96 points (15-minute buckets)."
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public trading API for market makers and integrators.\nConnect RPC over HTTP/1.1 and HTTP/2 with JSON and Protobuf.\n",
    "title": "Polyester API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/spot/markets/overview": {
      "get": {
        "description": "List ticker-style market overview rows with optional sparklines. Supports symbol filtering, sorting, and pagination controls.",
        "operationId": "MarketOverviewService_ListMarketOverview",
        "parameters": [
          {
            "description": "When true, include sparklines in each MarketOverview.",
            "example": false,
            "in": "query",
            "name": "includeSparklines",
            "schema": {
              "description": "When true, include sparklines in each MarketOverview.",
              "title": "include_sparklines",
              "type": "boolean"
            }
          },
          {
            "description": "When true, include sparklines in each market.",
            "example": false,
            "in": "query",
            "name": "include_sparklines",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "Maximum markets to return (server default 50, max 2000).",
            "example": 100,
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "type": "integer"
            }
          },
          {
            "description": "Sort key. When unset/UNSPECIFIED, defaults to 24h quote volume.",
            "example": "CHANGE_24H_BPS",
            "in": "query",
            "name": "orderBy",
            "schema": {
              "$ref": "#/components/schemas/marketoverview.v1.MarketOrderBy",
              "description": "Sort key. When unset/UNSPECIFIED, defaults to 24h quote volume.",
              "title": "order_by"
            }
          },
          {
            "description": "Sort key.",
            "example": "CHANGE_24H_BPS",
            "in": "query",
            "name": "order_by",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/polyester.rest.enum.marketoverview.v1.MarketOrderBy"
                }
              ]
            }
          },
          {
            "description": "Opaque cursor from the previous response.",
            "example": "eyJvZmZzZXQiOjEwMH0",
            "in": "query",
            "name": "pageToken",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sort direction.",
            "example": "ASC",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/polyester.rest.enum.marketoverview.v1.SortDirection"
                }
              ]
            }
          },
          {
            "description": "Which sparklines to include. If empty and include_sparklines is true,\n server defaults to 24h.",
            "example": [
              "1h"
            ],
            "in": "query",
            "name": "sparklineIntervals",
            "schema": {
              "description": "Which sparklines to include. If empty and include_sparklines is true,\n server defaults to 24h.",
              "items": {
                "$ref": "#/components/schemas/marketoverview.v1.SparklineInterval"
              },
              "title": "sparkline_intervals",
              "type": "array"
            }
          },
          {
            "description": "Sparkline intervals; repeat query param.",
            "example": "1h",
            "in": "query",
            "name": "sparkline_intervals",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/polyester.rest.enum.marketoverview.v1.SparklineInterval"
                }
              ]
            }
          },
          {
            "description": "Filter by stable numeric pair IDs from GetSpotConfig. When empty, returns\n all enabled markets.",
            "example": [
              1
            ],
            "in": "query",
            "name": "symbolId",
            "schema": {
              "description": "Filter by stable numeric pair IDs from GetSpotConfig. When empty, returns\n all enabled markets.",
              "items": {
                "exclusiveMinimum": 0,
                "maxItems": 2000,
                "type": "integer",
                "uniqueItems": true
              },
              "maxItems": 2000,
              "title": "symbol_id",
              "type": "array",
              "uniqueItems": true
            }
          },
          {
            "description": "Filter by specific symbols; repeat query param (e.g., ?symbols=BTC-USDT\u0026symbols=ETH-USDT).",
            "in": "query",
            "name": "symbols",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "markets": [
                    {
                      "bestAskQtyScaled": "100000",
                      "bestAskTicks": "0.000001",
                      "bestBidQtyScaled": "100000",
                      "bestBidTicks": "0.000001",
                      "change24hBps": 123,
                      "high24hTicks": "0.000001",
                      "indexPriceTicks": "5",
                      "lastPriceTicks": "5",
                      "lastTradeTsNs": "1735689600000000000",
                      "listedTsNs": "1735689600000000000",
                      "low24hTicks": "0.000001",
                      "sparklines": [
                        {
                          "closeTicks": [
                            "0.000001"
                          ],
                          "interval": "1h"
                        }
                      ],
                      "symbol": "BTC-USDT",
                      "volume24hBaseScaled": "123456",
                      "volume24hQuoteScaled": "123456"
                    }
                  ],
                  "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
                },
                "schema": {
                  "$ref": "#/components/schemas/polyester.rest.MarketOverviewService_ListMarketOverview.Response"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [],
        "summary": "List Market Overviews",
        "tags": [
          "Market Overview Service"
        ],
        "x-poly-error-catalog": "core:generic",
        "x-poly-error-proto-pkg": "polyester.rest.MarketOverviewService_ListMarketOverview",
        "x-poly-mfa-requirement": "none",
        "x-poly-request-type": "marketoverview.v1.ListMarketOverviewRequest",
        "x-poly-response-type": "marketoverview.v1.ListMarketOverviewResponse",
        "x-poly-rest": true,
        "x-poly-rest-note": "This operation uses REST-friendly types: decimal strings for quantities/prices, base58 strings for IDs."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
