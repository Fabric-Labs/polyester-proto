{
  "services": [
    {
      "name": "transfer.v1.InternalTransferService",
      "doc": "InternalTransferService manages authenticated Trading to Trading internal\n transfer intake.",
      "methods": [
        {
          "name": "CreateInternalTransfer",
          "path": "transfer.v1.InternalTransferService/CreateInternalTransfer",
          "requestType": "transfer.v1.CreateInternalTransferRequest",
          "responseType": "transfer.v1.CreateInternalTransferResponse",
          "summary": "Create or return one accepted Trading to Trading transfer.",
          "doc": "Create or return one accepted Trading to Trading transfer.\n Root-owner same-owner transfers and root-owner transfers to explicitly\n whitelisted destinations accept recent MFA; delegated and other\n interactive transfers require fresh step-up.",
          "tags": [
            "trading"
          ],
          "authRequired": true,
          "mfaRequirement": "conditional",
          "stability": "stable",
          "errorProtoPkg": "transfer.v1",
          "errorCatalog": "core:generic",
          "examples": {
            "request": {
              "amountE18": {
                "hi": "1",
                "lo": "1"
              },
              "assetId": 100,
              "destinationAccountId": "7563897446546",
              "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
              "subaccountId": "6789012345678"
            },
            "response": {
              "acceptedAtTsNs": "1735689600000000000",
              "amountE18": {
                "hi": "1",
                "lo": "1"
              },
              "assetCode": "USDC",
              "assetId": 100,
              "destination": {
                "rootAccountPublicId": "7563897446546",
                "smartAccountAddress": "0x2222222222222222222222222222222222222222",
                "subaccountPublicId": "6789012345678"
              },
              "requestId": "request_01J0EXAMPLE",
              "status": "INTERNAL_TRANSFER_STATUS_ACCEPTED",
              "transferId": "9155001234569",
              "uAssetId": "100"
            }
          }
        }
      ]
    }
  ]
}
