{
  "services": [
    {
      "name": "ledger.read.v1.StatementExportService",
      "doc": "StatementExportService produces whole-period account statements in the\n background as one CSV file each. It covers the same account, asset and\n period choices as LedgerReadService.ExportStatement, with the same access\n rules: API keys need the READ_STATEMENTS policy action. A root account has\n at most 5 exports QUEUED or PROCESSING at a time, one account produces one\n export at a time, and a READY file can be downloaded for 7 days.",
      "methods": [
        {
          "name": "CreateStatementExport",
          "path": "ledger.read.v1.StatementExportService/CreateStatementExport",
          "requestType": "ledger.read.v1.CreateStatementExportRequest",
          "responseType": "ledger.read.v1.CreateStatementExportResponse",
          "summary": "Create a statement export, or return the existing one for the same",
          "doc": "Create a statement export, or return the existing one for the same\n idempotency key.\n\n Errors:\n - INVALID_ARGUMENT: the period, asset or idempotency key is invalid.\n - FAILED_PRECONDITION (IDEMPOTENCY_KEY_REUSED): the key was used for a\n   request with other fields.\n - RESOURCE_EXHAUSTED (STATEMENT_EXPORT_LIMIT_REACHED): the root account\n   has 5 exports QUEUED or PROCESSING.\n - PERMISSION_DENIED, NOT_FOUND: the account cannot be read.\n - UNAVAILABLE: retry the same request.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "assetId": 100,
              "endTime": "2025-01-01T00:00:00Z",
              "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
              "startTime": "2025-01-01T00:00:00Z",
              "subaccountId": "6789012345678"
            },
            "response": {
              "export": {
                "assetId": 100,
                "bytes": "1",
                "completeThrough": "2025-01-01T00:00:00Z",
                "createdAt": "2025-01-01T00:00:00Z",
                "endTime": "2025-01-01T00:00:00Z",
                "expiresAt": "2025-01-01T00:00:00Z",
                "exportId": "4477789102458798759",
                "failureReason": "STATEMENT_EXPORT_FAILURE_REASON_TOO_LARGE",
                "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                "movements": "1",
                "readyAt": "2025-01-01T00:00:00Z",
                "startTime": "2025-01-01T00:00:00Z",
                "status": "STATEMENT_EXPORT_STATUS_QUEUED",
                "subaccountId": "6789012345678"
              }
            }
          }
        },
        {
          "name": "GetStatementExport",
          "path": "ledger.read.v1.StatementExportService/GetStatementExport",
          "requestType": "ledger.read.v1.GetStatementExportRequest",
          "responseType": "ledger.read.v1.GetStatementExportResponse",
          "summary": "Get one statement export.",
          "doc": "Get one statement export.\n\n Errors:\n - NOT_FOUND: no such export for the authenticated account.\n - PERMISSION_DENIED: the export's account cannot be read.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "exportId": "4477789102458798759"
            },
            "response": {
              "export": {
                "assetId": 100,
                "bytes": "1",
                "completeThrough": "2025-01-01T00:00:00Z",
                "createdAt": "2025-01-01T00:00:00Z",
                "endTime": "2025-01-01T00:00:00Z",
                "expiresAt": "2025-01-01T00:00:00Z",
                "exportId": "4477789102458798759",
                "failureReason": "STATEMENT_EXPORT_FAILURE_REASON_TOO_LARGE",
                "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                "movements": "1",
                "readyAt": "2025-01-01T00:00:00Z",
                "startTime": "2025-01-01T00:00:00Z",
                "status": "STATEMENT_EXPORT_STATUS_QUEUED",
                "subaccountId": "6789012345678"
              }
            }
          }
        },
        {
          "name": "ListStatementExports",
          "path": "ledger.read.v1.StatementExportService/ListStatementExports",
          "requestType": "ledger.read.v1.ListStatementExportsRequest",
          "responseType": "ledger.read.v1.ListStatementExportsResponse",
          "summary": "List one account's statement exports, newest first.",
          "doc": "List one account's statement exports, newest first.\n\n Errors:\n - INVALID_ARGUMENT: the limit or page token is invalid.\n - PERMISSION_DENIED, NOT_FOUND: the account cannot be read.",
          "tags": [
            "account"
          ],
          "authRequired": true,
          "authenticationMethods": [
            "session_token",
            "api_key"
          ],
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "ledger.read.v1",
          "errorCatalog": "ledger-api-read:ledgererrors",
          "examples": {
            "request": {
              "limit": 100,
              "pageToken": "eyJvZmZzZXQiOjEwMH0",
              "subaccountId": "6789012345678"
            },
            "response": {
              "exports": [
                {
                  "assetId": 100,
                  "bytes": "1",
                  "completeThrough": "2025-01-01T00:00:00Z",
                  "createdAt": "2025-01-01T00:00:00Z",
                  "endTime": "2025-01-01T00:00:00Z",
                  "expiresAt": "2025-01-01T00:00:00Z",
                  "exportId": "4477789102458798759",
                  "failureReason": "STATEMENT_EXPORT_FAILURE_REASON_TOO_LARGE",
                  "idempotencyKey": "idem_01J5EXAMPLE0000000000000",
                  "movements": "1",
                  "readyAt": "2025-01-01T00:00:00Z",
                  "startTime": "2025-01-01T00:00:00Z",
                  "status": "STATEMENT_EXPORT_STATUS_QUEUED",
                  "subaccountId": "6789012345678"
                }
              ],
              "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
            }
          }
        }
      ]
    }
  ]
}
