        "additionalProperties": false,
        "description": "ListMyRewardAwardsResponse contains newest awards first.",
        "properties": {
          "awards": {
            "description": "Awards ordered by publication time and award identifier, newest first.",
            "items": {
              "$ref": "#/components/schemas/rewards.v1.RewardAward"
            },
            "title": "awards",
            "type": "array"
          },
          "nextPageToken": {
            "description": "Opaque continuation token. Empty when no more results exist.",
            "title": "next_page_token",
            "type": "string"
