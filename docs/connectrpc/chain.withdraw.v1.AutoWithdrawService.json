                    "hi": "1",
                    "lo": "1"
                  },
                  "networkFeeE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "networkFeeSampledAt": "2025-01-01T00:00:00Z",
                  "payableE18": {
                    "hi": "1",
                    "lo": "1"
                  },
                  "payableFrom": "2025-01-01T00:00:00Z",
                  "pricedAt": "2025-01-01T00:00:00Z",
                  "valueUsdE18": {
                    "hi": "1",
                    "lo": "1"
                  }
                }
              ],
              "computedAt": "2025-01-01T00:00:00Z",
              "minUsdValueE18": {
                "hi": "1",
                "lo": "1"
              },
              "nextRunAt": "2025-01-01T00:00:00Z",
              "pause": {
                "assetId": 100,
