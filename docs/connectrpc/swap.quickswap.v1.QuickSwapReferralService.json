          "stability": "stable",
          "errorProtoPkg": "swap.quickswap.v1",
          "errorCatalog": "swap-api:quickswaperrors:swap.quickswap.v1.QuickSwapReferralService/EnrollReferralPartner",
          "errorCodes": [
            "ACTION_DENIED",
            "EARNINGS_ACCOUNT_INVALID",
            "REFERRAL_PARTNER_EXISTS"
          ],
