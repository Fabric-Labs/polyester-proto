{
  "services": [
    {
      "name": "marketoverview.v1.MarketOverviewService",
      "doc": "List ticker-style market overview rows with optional sparklines.\n Supports symbol filtering, sorting, and pagination controls.",
      "methods": [
        {
          "name": "ListMarketOverview",
          "path": "marketoverview.v1.MarketOverviewService/ListMarketOverview",
          "requestType": "marketoverview.v1.ListMarketOverviewRequest",
          "responseType": "marketoverview.v1.ListMarketOverviewResponse",
          "tags": [
            "marketdata"
          ],
          "authRequired": false,
          "mfaRequirement": "none",
          "stability": "stable",
          "errorProtoPkg": "marketoverview.v1",
          "errorCatalog": "md-market-overview:marketoverviewerrors",
          "examples": {
            "request": {
              "includeSparklines": false,
              "limit": 100,
              "orderBy": "ORDER_BY_CHANGE_24H_BPS",
              "pageToken": "eyJvZmZzZXQiOjEwMH0",
              "sort": "SORT_ASC",
              "sparklineIntervals": [
                "SPARKLINE_1H"
              ],
              "symbols": [
                "BTC-USDT"
              ]
            },
            "response": {
              "markets": [
                {
                  "bestAskQtyScaled": "0.612345678901234567",
                  "bestAskTicks": "42000.100000",
                  "bestBidQtyScaled": "0.523456789012345678",
                  "bestBidTicks": "42000.000000",
                  "change24hBps": 123,
                  "high24hTicks": "42500.000000",
                  "lastPriceTicks": "42000.050000",
                  "lastTradeTsNs": "1735689600000000000",
                  "listedTsNs": "1735689600000000000",
                  "low24hTicks": "41000.000000",
                  "sparklines": [
                    {
                      "closeTicks": [
                        "1"
                      ],
                      "interval": "SPARKLINE_1H"
                    }
                  ],
                  "symbol": "BTC-USDT",
                  "symbolId": 1,
                  "volume24hBaseScaled": "12.345678901234567890",
                  "volume24hQuoteScaled": "518230.123456"
                }
              ],
              "nextPageToken": "eyJvZmZzZXQiOjIwMH0"
            }
          }
        }
      ]
    }
  ]
}
